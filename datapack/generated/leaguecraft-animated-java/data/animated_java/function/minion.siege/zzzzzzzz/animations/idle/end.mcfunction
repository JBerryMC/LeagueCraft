execute if score @s aj.minion.siege.animation.idle.loop_mode = $aj.loop_mode.loop aj.i run function animated_java:minion.siege/zzzzzzzz/animations/idle/end_loop
execute if score @s aj.minion.siege.animation.idle.loop_mode = $aj.loop_mode.once aj.i run function animated_java:minion.siege/animations/idle/stop
execute if score @s aj.minion.siege.animation.idle.loop_mode = $aj.loop_mode.hold aj.i run function animated_java:minion.siege/animations/idle/pause