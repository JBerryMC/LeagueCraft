# _champion:  (converted from the 1.20.2 LeagueCraft datapack)

function bar_display {
    execute store result score @s pos_x1 on passengers as @s[tag=bar_owner] on origin run data get entity @s Pos[0] 1000
    execute store result score @s pos_y1 on passengers as @s[tag=bar_owner] on origin run data get entity @s Pos[1] 1000
    execute store result score @s pos_z1 on passengers as @s[tag=bar_owner] on origin run data get entity @s Pos[2] 1000

    scoreboard players add @s pos_y1 1300
    execute store success score @s pos_y2 on passengers as @s[tag=bar_owner] on origin if predicate _lol:is_flying
    execute as @s[scores={pos_y2=1..}] run scoreboard players add @s pos_y1 500

    execute store result entity @s Pos[0] double 0.001 run scoreboard players get @s pos_x1
    execute store result entity @s Pos[1] double 0.001 run scoreboard players get @s pos_y1
    execute store result entity @s Pos[2] double 0.001 run scoreboard players get @s pos_z1

    execute store success score @s hp.percentage_old on passengers as @s[tag=bar_owner] on origin if entity @s[tag=update.bar.hp]
    execute as @s[scores={hp.percentage_old=1..},tag=blue] run function _champion:hp/macro_dummy_blue
    execute as @s[scores={hp.percentage_old=1..},tag=red] run function _champion:hp/macro_dummy_red
    execute as @s[scores={hp.percentage_old=1..}] on passengers as @s[tag=bar_owner] on origin run tag @s remove update.bar.hp

    execute store success score @s mana.percentage_old on passengers as @s[tag=bar_owner] on origin if entity @s[tag=update.bar.mana]
    execute as @s[scores={mana.percentage_old=1..}] run function _champion:mana/macro_dummy
    execute as @s[scores={mana.percentage_old=1..}] on passengers as @s[tag=bar_owner] on origin run tag @s remove update.bar.mana

    execute store success score @s temp on passengers as @s[tag=bar_owner] on origin if entity @s[tag=remove.bar]
    execute as @s[scores={temp=1..}] on passengers as @s[tag=bar_owner] on origin run tag @s remove remove.bar
    execute as @s[scores={temp=1..}] on passengers run kill @s
    execute as @s[scores={temp=1..}] run kill @s

    execute store success score @s shield.all on passengers as @s[tag=bar_owner] on origin if entity @s[tag=update.shield_all]
    execute as @s[scores={shield.all=1..}] run function _champion:hp/macro_shield_all
    execute as @s[scores={shield.all=1..}] on passengers as @s[tag=bar_owner] on origin run tag @s remove update.shield_all

    ## HIDE ON BUSH
    execute store success score @s temp on passengers as @s[tag=bar_owner] on origin if score @s fx.invis matches 1..
    execute if score @s temp matches 1 on passengers run data modify entity @s view_range set value 0.0
    execute if score @s temp matches 0 if score .world settings.show_stats matches 1 on passengers run data modify entity @s view_range set value 1.0

    ## ------------------------- MARKING -------------------------------

    ### EZREAL W
    execute store success score @s temp on passengers as @s[tag=bar_owner] on origin if entity @s[tag=update.mark.ezreal.w]
    execute if score @s temp matches 1 on passengers if entity @s[tag=ezreal.w.mark] on passengers run kill @s
    execute if score @s temp matches 1 on passengers if entity @s[tag=ezreal.w.mark] run kill @s
    execute if score @s temp matches 1 at @s run summon item_display ~ ~ ~ {interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[700211f]}}},Tags:["ezreal.w.mark","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:80,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if score @s temp matches 1 run ride @e[type=item_display,tag=temp,tag=ezreal.w.mark,limit=1,sort=nearest] mount @s
    execute if score @s temp matches 1 on passengers as @s[tag=bar_owner] on origin run tag @s remove update.mark.ezreal.w

    execute store success score @s temp on passengers as @s[tag=bar_owner] on origin if entity @s[tag=remove.mark.ezreal.w]
    execute if score @s temp matches 1 on passengers if entity @s[tag=ezreal.w.mark] on passengers run kill @s
    execute if score @s temp matches 1 on passengers if entity @s[tag=ezreal.w.mark] run kill @s
    execute if score @s temp matches 1 on passengers as @s[tag=bar_owner] on origin run tag @s remove remove.mark.ezreal.w

    ## ------------------------- VISUAL FX -------------------------------

    ### GAREN E - 1200101
    execute store success score @s temp on passengers as @s[tag=bar_owner] on origin if entity @s[tag=update.fx.garen.e]
    execute if score @s temp matches 1 on passengers if entity @s[tag=garen.e.fx] on passengers run kill @s
    execute if score @s temp matches 1 on passengers if entity @s[tag=garen.e.fx] run kill @s
    execute if score @s temp matches 1 at @s run summon item_display ~ ~ ~ {interpolation_duration:5,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[1200101f]}}},Tags:["spin_lv_2","garen.e.fx","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:60,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if score @s temp matches 1 run ride @e[type=item_display,tag=temp,tag=garen.e.fx,limit=1,sort=nearest] mount @s
    execute if score @s temp matches 1 on passengers as @s[tag=bar_owner] on origin run tag @s remove update.fx.garen.e

    execute store success score @s temp on passengers as @s[tag=bar_owner] on origin if entity @s[tag=remove.fx.garen.e]
    execute if score @s temp matches 1 on passengers if entity @s[tag=garen.e.fx] on passengers run kill @s
    execute if score @s temp matches 1 on passengers if entity @s[tag=garen.e.fx] run kill @s
    execute if score @s temp matches 1 on passengers as @s[tag=bar_owner] on origin run tag @s remove remove.fx.garen.e

    ## ------------------------- SHIELDING -------------------------------

    ### ANNIE - 1500301
    execute store success score @s temp on passengers as @s[tag=bar_owner] on origin if entity @s[tag=update.shield.annie]
    execute if score @s temp matches 1 on passengers if entity @s[tag=annie.e.shield] on passengers run kill @s
    execute if score @s temp matches 1 on passengers if entity @s[tag=annie.e.shield] run kill @s
    execute if score @s temp matches 1 at @s run summon item_display ~ ~ ~ {interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}},Tags:["annie.e.shield","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[-22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[45.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"area_effect_cloud",Duration:50,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if score @s temp matches 1 run ride @e[type=item_display,tag=temp,tag=annie.e.shield,limit=1,sort=nearest] mount @s
    execute if score @s temp matches 1 on passengers as @s[tag=bar_owner] on origin run tag @s remove update.shield.annie

