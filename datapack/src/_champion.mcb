function dead {
    tag @s add dead
    tag @s add remove.bar
    tag @s add unvalid

    scoreboard players set @s hp.left 0
    scoreboard players set @s mana 0
    function _game:announce/takedown/champion

    ## Yone
    execute if entity @s[tag=yone,team=red] as @e[tag=yone.e.body,tag=red] on passengers run kill @s
    execute if entity @s[tag=yone,team=blue] as @e[tag=yone.e.body,tag=blue] on passengers run kill @s

    ## Aatrox
    execute on attacker if entity @s[tag=aatrox,scores={mana=1..}] at @s run function aatrox:skills/r.extend

    execute if entity @s[tag=aatrox] on vehicle if entity @s[tag=aatrox.r] run function aatrox:skills/r.end

    ## Annie
    execute if entity @s[tag=annie,team=red] as @e[tag=annie.r,team=red,type=#can_aggro] run function annie:skills/r.revenge
    execute if entity @s[tag=annie,team=blue] as @e[tag=annie.r,team=blue,type=#can_aggro] run function annie:skills/r.revenge

    title @s times 0 20 0

    function _champion:abilities/reload
    scoreboard players set @s death_time 200
    effect give @s blindness 13 0 true

    gamemode spectator @s[tag=!e.soul]
}

function hud {
    execute store result score @s status.hotbar run data get entity @s SelectedItemSlot

    execute if score @s cd_q matches 0 run scoreboard players set @s status.q 1
    execute if score @s cd_w matches 0 run scoreboard players set @s status.w 1
    execute if score @s cd_e matches 0 run scoreboard players set @s status.e 1
    execute if score @s cd_r matches 0 run scoreboard players set @s status.r 1
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 1 run scoreboard players set @s status.spell.1 1
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 2 run scoreboard players set @s status.spell.1 2
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 3 run scoreboard players set @s status.spell.1 3
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 4 run scoreboard players set @s status.spell.1 4
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 5 run scoreboard players set @s status.spell.1 5
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 6 run scoreboard players set @s status.spell.1 6
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 7 run scoreboard players set @s status.spell.1 7
    execute if score @s cd_spell.1 matches 0 if score @s spell.1 matches 8 run scoreboard players set @s status.spell.1 8
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 1 run scoreboard players set @s status.spell.2 1
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 2 run scoreboard players set @s status.spell.2 2
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 3 run scoreboard players set @s status.spell.2 3
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 4 run scoreboard players set @s status.spell.2 4
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 5 run scoreboard players set @s status.spell.2 5
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 6 run scoreboard players set @s status.spell.2 6
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 7 run scoreboard players set @s status.spell.2 7
    execute if score @s cd_spell.2 matches 0 if score @s spell.2 matches 8 run scoreboard players set @s status.spell.2 8

    execute if score @s cd_q matches 1.. run scoreboard players set @s status.q 0
    execute if score @s cd_w matches 1.. run scoreboard players set @s status.w 0
    execute if score @s cd_e matches 1.. run scoreboard players set @s status.e 0
    execute if score @s cd_r matches 1.. run scoreboard players set @s status.r 0
    execute if score @s cd_spell.1 matches 1.. run scoreboard players set @s status.spell.1 0
    execute if score @s cd_spell.2 matches 1.. run scoreboard players set @s status.spell.2 0

    execute if score @s mana < @s mana_q run scoreboard players set @s status.q 8
    execute if score @s mana < @s mana_w run scoreboard players set @s status.w 8
    execute if score @s mana < @s mana_e run scoreboard players set @s status.e 8
    execute if score @s mana < @s mana_r run scoreboard players set @s status.r 8

    execute if entity @s[tag=cced] run scoreboard players set @s status.q 9
    execute if entity @s[tag=cced] run scoreboard players set @s status.w 9
    execute if entity @s[tag=cced] run scoreboard players set @s status.e 9
    execute if entity @s[tag=cced] run scoreboard players set @s status.r 9
    execute if entity @s[tag=cced] unless score @s spell.1 matches 3 run scoreboard players set @s status.spell.1 9
    execute if entity @s[tag=cced] unless score @s spell.1 matches 3 run scoreboard players set @s status.spell.2 9

    execute if entity @s[tag=r.animation] run scoreboard players set @s status.q 9
    execute if entity @s[tag=r.animation] run scoreboard players set @s status.w 9
    execute if entity @s[tag=r.animation] run scoreboard players set @s status.e 9
    execute if entity @s[tag=r.animation] run scoreboard players set @s status.r 9
    execute if entity @s[tag=r.animation] run scoreboard players set @s status.spell.1 9
    execute if entity @s[tag=r.animation] run scoreboard players set @s status.spell.2 9

    execute if entity @s[tag=e.animation] run scoreboard players set @s status.q 9
    execute if entity @s[tag=e.animation] run scoreboard players set @s status.w 9
    execute if entity @s[tag=e.animation] run scoreboard players set @s status.e 9
    execute if entity @s[tag=e.animation] run scoreboard players set @s status.r 9
    execute if entity @s[tag=e.animation] run scoreboard players set @s status.spell.1 9
    execute if entity @s[tag=e.animation] run scoreboard players set @s status.spell.2 9

    execute if score @s cc.root matches 1.. if score @s spell.1 matches 1 run scoreboard players set @s status.spell.1 9

    ## 9	1
    ## 8	3
    ## 7	8
    ## 6	21
    ## 5	55
    ## 4	144
    ## 3	377
    ## 2	987
    ## 1	2584
    ## -	-6765

    execute if score @s cd_p matches 0..9 run scoreboard players set @s space.passive 779
    execute if score @s cd_p matches 10..99 run scoreboard players set @s space.passive 789
    execute if score @s cd_p matches 100..999 run scoreboard players set @s space.passive 889

    execute if score @s cd_q matches 0..9 run scoreboard players set @s space.q 68
    execute if score @s cd_q matches 10..99 run scoreboard players set @s space.q 7799
    execute if score @s cd_q matches 100..999 run scoreboard players set @s space.q 789

    execute if score @s cd_w matches 0..9 run scoreboard players set @s space.w 68
    execute if score @s cd_w matches 10..99 run scoreboard players set @s space.w 7799
    execute if score @s cd_w matches 100..999 run scoreboard players set @s space.w 789

    execute if score @s cd_e matches 0..9 run scoreboard players set @s space.e 699
    execute if score @s cd_e matches 10..99 run scoreboard players set @s space.e 779
    execute if score @s cd_e matches 100..999 run scoreboard players set @s space.e 78

    execute if score @s cd_r matches 0..9 run scoreboard players set @s space.r 6899
    execute if score @s cd_r matches 10..99 run scoreboard players set @s space.r 7789
    execute if score @s cd_r matches 100..999 run scoreboard players set @s space.r 788

    execute if score @s cd_spell.1 matches 0..9 run scoreboard players set @s space.spell.1 7799
    execute if score @s cd_spell.1 matches 10..99 run scoreboard players set @s space.spell.1 7899
    execute if score @s cd_spell.1 matches 100..999 run scoreboard players set @s space.spell.1 8899

    execute if score @s cd_spell.2 matches 0..9 run scoreboard players set @s space.spell.2 7799
    execute if score @s cd_spell.2 matches 10..99 run scoreboard players set @s space.spell.2 7899
    execute if score @s cd_spell.2 matches 100..999 run scoreboard players set @s space.spell.2 8899

    execute if score @s hp.left matches 0..9 run scoreboard players set @s space.hp1 679
    execute if score @s hp.left matches 10..99 run scoreboard players set @s space.hp1 68
    execute if score @s hp.left matches 100..999 run scoreboard players set @s space.hp1 7799
    execute if score @s hp.left matches 1000..9999 run scoreboard players set @s space.hp1 789
    execute if score @s hp.left matches 10000..99999 run scoreboard players set @s space.hp1 88
    execute if score @s hp.max matches 0..9 run scoreboard players set @s space.hp2 679
    execute if score @s hp.max matches 10..99 run scoreboard players set @s space.hp2 68
    execute if score @s hp.max matches 100..999 run scoreboard players set @s space.hp2 7799
    execute if score @s hp.max matches 1000..9999 run scoreboard players set @s space.hp2 789
    execute if score @s hp.max matches 10000..99999 run scoreboard players set @s space.hp2 88

    execute if score @s mana matches 0..9 run scoreboard players set @s space.mana1 679
    execute if score @s mana matches 10..99 run scoreboard players set @s space.mana1 68
    execute if score @s mana matches 100..999 run scoreboard players set @s space.mana1 7799
    execute if score @s mana matches 1000..9999 run scoreboard players set @s space.mana1 789
    execute if score @s mana matches 10000..99999 run scoreboard players set @s space.mana1 88
    execute if score @s mana.max matches 0..9 run scoreboard players set @s space.mana2 679
    execute if score @s mana.max matches 10..99 run scoreboard players set @s space.mana2 68
    execute if score @s mana.max matches 100..999 run scoreboard players set @s space.mana2 7799
    execute if score @s mana.max matches 1000..9999 run scoreboard players set @s space.mana2 789
    execute if score @s mana.max matches 10000..99999 run scoreboard players set @s space.mana2 88
}

function respawn {
    tag @s remove dead
    tag @s remove unvalid
    scoreboard players operation @s hp.left = @s hp.max
    execute unless entity @s[tag=!useEnergy,tag=!useMana] run scoreboard players operation @s mana = @s mana.max
    gamemode adventure @s

    title @s title {text:" "}

    tp @s[team=red] 0 188 210 180 0
    tp @s[team=blue] 0 188 -210 0 0

    tag @s remove has_display_bar

    effect give @s speed 20 4
    # No saturation: the plugin keeps champions' hunger at 6 so they can't sprint.
    effect give @s resistance infinite 127 true

    execute if entity @s[tag=!has_display_bar] run summon block_display ~ ~ ~ {Tags:["temp","lol.bar_display"],Passengers:[{id:"area_effect_cloud",Tags:["bar_owner"],Duration:2147483647,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"text_display",Tags:["hp","stats_bar"],background:0,billboard:"vertical"},{id:"text_display",Tags:["mana","stats_bar"],background:0,billboard:"vertical"},{id:"text_display",Tags:["shield_all","stats_bar"],background:0,billboard:"vertical"}]}
    execute if entity @s[tag=!has_display_bar] as @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=hp] {transformation:{scale:[0.325,0.375,0.325]}}
    execute if entity @s[tag=!has_display_bar] as @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=mana] {transformation:{scale:[0.325,0.375,0.325],translation:[0.0,0.0,0.0001]}}
    execute if entity @s[tag=!has_display_bar] as @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=shield_all] {transformation:{scale:[0.325,0.375,0.325],translation:[0.0,0.0,0.0001]}}
    execute if entity @s[tag=!has_display_bar] at @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=bar_owner,limit=1,sort=nearest] Owner set from entity @s UUID
    execute if entity @s[tag=!has_display_bar,team=red] run tag @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] add red
    execute if entity @s[tag=!has_display_bar,team=blue] run tag @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] add blue
    execute if entity @s[tag=!has_display_bar] if score .world settings.show_stats matches 0 as @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] on passengers run data modify entity @s[tag=stats_bar] view_range set value 0.0
    execute if entity @s[tag=!has_display_bar] run tag @e[tag=lol.bar_display,tag=temp,limit=1,sort=nearest] remove temp
}

