function garen {
    function _lol:champion/_choose

    execute if score .world lang matches 0 as @s run function _lol:lang/champion/eng.garen
    execute if score .world lang matches 1 as @s run function _lol:lang/champion/vie.aatrox

    scoreboard players set @s champ_id 12

    tag @s add garen
    tag @s add champion
