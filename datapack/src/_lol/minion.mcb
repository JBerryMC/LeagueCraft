        execute as @e[tag=lol.minion,tag=temp] at @s run function animated_java:minion.siege/summon/red
        execute as @e[tag=lol.minion,tag=temp] run ride @e[type=#animated_java:root,tag=aj.minion.siege.root,limit=1,sort=nearest] mount @s
        execute as @e[tag=lol.minion,tag=temp] on passengers as @s[type=#animated_java:root,tag=aj.minion.siege.root] run function animated_java:minion.siege/animations/idle/play

        scoreboard players set @e[tag=lol.minion,tag=temp] channeling -1
        scoreboard players set @e[tag=lol.minion,tag=temp] attack_damage 66
        scoreboard players set @e[tag=lol.minion,tag=temp] dmg_debuff 30

        scoreboard players set @e[tag=lol.minion,tag=temp] armor 0
        scoreboard players set @e[tag=lol.minion,tag=temp] magic_resist 0

        scoreboard players set @e[tag=lol.minion,tag=temp] armor.pen 0
        scoreboard players set @e[tag=lol.minion,tag=temp] magic_resist.pen 0

        scoreboard players set @e[tag=lol.minion,tag=temp] aa.cd 0
        scoreboard players set @e[tag=lol.minion,tag=temp] aa.spd 8
        scoreboard players set @e[tag=lol.minion,tag=temp] aa.range 70

        scoreboard players set @e[tag=lol.minion,tag=temp] hp.regen 0
        scoreboard players set @e[tag=lol.minion,tag=temp] hp.max 2291
        scoreboard players operation @e[tag=lol.minion,tag=temp] hp.left = @e[tag=lol.minion,tag=temp] hp.max

        tag @e[tag=lol.minion,tag=temp] remove temp
    }
}

dir super {
    function aa {
        execute on passengers as @s[tag=lol.animation] run function animated_java:minion.super/animations/aa/tween_play
    }

    function dead {
        tag @s add is_dead
        scoreboard players set @s hp.left 0

        execute on passengers as @s[type=#animated_java:root,tag=aj.minion.super.root,tag=lol.animation] at @s run function animated_java:minion.super/animations/death/play

