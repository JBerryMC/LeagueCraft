# _lol:minion/  (converted from the 1.20.2 LeagueCraft datapack)

function aggro {
    tag @s add aggro

    attribute @s[tag=!is_pet] minecraft:movement_speed base set 0.15
    scoreboard players set @s[tag=!is_pet] dmg_debuff 0

    data modify entity @s[team=red] angry_at set from entity @e[team=blue,limit=1,sort=nearest,tag=!unvalid,type=!#unvalid,tag=!untargettable,scores={fx.invis=-1}] UUID
    data modify entity @s[team=blue] angry_at set from entity @e[team=red,limit=1,sort=nearest,tag=!unvalid,type=!#unvalid,tag=!untargettable,scores={fx.invis=-1}] UUID
}

function aggro_check {
    execute if entity @s[tag=is_pet,tag=annie.r] unless entity @e[tag=annie.r.target] run tag @s add can_aggro
    execute if entity @s[tag=is_pet,tag=annie.r] if entity @e[tag=annie.r.target] run tag @s remove can_aggro
    execute if entity @s[tag=is_pet,tag=annie.r] if entity @e[tag=annie.r.target,distance=..6] run tag @s add aggro

    execute if entity @s[tag=can_aggro] run function _lol:minion/aggro
}

function ai {
    execute on passengers as @s[tag=lol.animation] store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0]
    execute on passengers on passengers as @s[tag=minion.body] store result entity @s Rotation[0] float 1 on vehicle on vehicle run data get entity @s Rotation[0] 1

    execute if entity @s[team=red,tag=!aggro] if entity @e[tag=lol.structure.entity,team=blue,tag=!untargettable] run function _lol:minion/pathfind
    execute if entity @s[team=red,tag=!aggro] unless entity @e[tag=lol.structure.entity,team=blue,tag=!untargettable] run function _lol:minion/de_aggro

    execute if entity @s[team=blue,tag=!aggro] if entity @e[tag=lol.structure.entity,team=red,tag=!untargettable] run function _lol:minion/pathfind
    execute if entity @s[team=blue,tag=!aggro] unless entity @e[tag=lol.structure.entity,team=red,tag=!untargettable] run function _lol:minion/de_aggro

    execute if entity @s[tag=melee,team=red,tag=!aggro] if entity @e[team=blue,distance=..5,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/aggro_check
    execute if entity @s[tag=melee,team=red,tag=aggro] unless entity @e[team=blue,distance=..5,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/de_aggro

    execute if entity @s[tag=ranged,team=red,tag=!aggro] if entity @e[team=blue,distance=..9,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/aggro_check
    execute if entity @s[tag=ranged,team=red,tag=aggro] unless entity @e[team=blue,distance=..9,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/de_aggro

    execute if entity @s[tag=melee,team=blue,tag=!aggro] if entity @e[team=red,distance=..5,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/aggro_check
    execute if entity @s[tag=melee,team=blue,tag=aggro] unless entity @e[team=red,distance=..5,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/de_aggro

    execute if entity @s[tag=ranged,team=blue,tag=!aggro] if entity @e[team=red,distance=..9,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/aggro_check
    execute if entity @s[tag=ranged,team=blue,tag=aggro] unless entity @e[team=red,distance=..9,type=!#unvalid,tag=!unvalid,tag=!untargettable,scores={fx.invis=-1}] run function _lol:minion/de_aggro

    execute if entity @s[tag=aggro] run function _champion:aa/check
}

function de_aggro {
    tag @s remove aggro

    data remove entity @s angry_at
    data remove entity @s anger_end_time

    attribute @s[tag=!is_pet] minecraft:movement_speed base set 0.0
    scoreboard players set @s[tag=!is_pet] dmg_debuff 60
    scoreboard players set @s[tag=!is_pet,tag=minion.siege] dmg_debuff 30
}

function pathfind {
    data modify entity @s[team=red] angry_at set from entity @e[team=blue,tag=lol.structure.entity,limit=1,sort=nearest,tag=!untargettable] UUID
    data modify entity @s[team=blue] angry_at set from entity @e[team=red,tag=lol.structure.entity,limit=1,sort=nearest,tag=!untargettable] UUID

    execute if entity @s[team=red,tag=melee] if entity @e[team=blue,distance=..5.5,tag=lol.structure.entity,tag=!untargettable] run function _champion:aa/check
    execute if entity @s[team=red,tag=ranged] if entity @e[team=blue,distance=..9,tag=lol.structure.entity,tag=!untargettable] run function _champion:aa/check

    execute if entity @s[team=blue,tag=melee] if entity @e[team=red,distance=..5.5,tag=lol.structure.entity,tag=!untargettable] run function _champion:aa/check
    execute if entity @s[team=blue,tag=ranged] if entity @e[team=red,distance=..9,tag=lol.structure.entity,tag=!untargettable] run function _champion:aa/check

    attribute @s[tag=!is_pet] minecraft:movement_speed base set 0.15
}

dir caster {
    function aa {
        execute on passengers as @s[tag=lol.animation] run function animated_java:minion.caster/animations/aa/tween_play

        execute if entity @s[team=red] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.minion.caster","aa","homing","red","temp","speed.slow","block_by_windwall"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.minion.caster","aa","homing","blue","temp","speed.slow","block_by_windwall"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    }

    function dead {
        tag @s add is_dead
        scoreboard players set @s hp.left 0

        execute at @s[team=blue] rotated ~ 0 run function animated_java:minion.caster/summon
        execute at @s[team=red] rotated ~ 0 run function animated_java:minion.caster/summon/red
        execute at @s as @e[type=#animated_java:root,tag=aj.minion.caster.root,limit=1,sort=nearest,tag=lol.animation] at @s run function animated_java:minion.caster/animations/death/play

        function _champion:hp/percentage
    }

    function spawn.blue {
        summon zombified_piglin ~ ~ ~ {CustomName:"Blue Caster Minion",active_effects:[{id:"invisibility",duration:-1,amplifier:0,show_particles:0b}],IsBaby:1,PersistenceRequired:1,Team:"blue",Tags:["minion.caster","can_aggro","blue","has_health_bar","lol.minion","ranged","temp","use_custom_model","can_reduce_tower_armor"],Silent:1,attributes:[{id:"minecraft:follow_range",base:1048.0d},{id:"minecraft:attack_damage",base:0.0d},{id:"minecraft:max_health",base:1000.0d},{id:"minecraft:knockback_resistance",base:1.0d}],Health:1000.0f,Passengers:[{id:"item_display",Passengers:[{teleport_duration:1,id:"item_display",item_display:"head",Tags:["minion.body","blue"],item:{id:"turtle_scute",count:1,components:{"minecraft:custom_model_data":{floats:[1000f]}}}}]},{id:"text_display",Tags:["hp","stats_bar"],background:0,billboard:"vertical"}]}

        execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=hp] {transformation:{scale:[0.1,0.2,0.0],translation:[0.0,-0.5,0.0]}}

        #execute as @e[tag=lol.minion,tag=temp] at @s run function animated_java:minion.caster/summon
        #execute as @e[tag=lol.minion,tag=temp] run ride @e[type=#animated_java:root,tag=aj.minion.caster.root,limit=1,sort=nearest] mount @s
        #execute as @e[tag=lol.minion,tag=temp] on passengers as @s[type=#animated_java:root,tag=aj.minion.caster.root] run function animated_java:minion.caster/animations/idle/play

        scoreboard players set @e[tag=lol.minion,tag=temp] channeling -1
        scoreboard players set @e[tag=lol.minion,tag=temp] attack_damage 88
        scoreboard players set @e[tag=lol.minion,tag=temp] dmg_debuff 60

        scoreboard players set @e[tag=lol.minion,tag=temp] armor 0
        scoreboard players set @e[tag=lol.minion,tag=temp] magic_resist 0

        scoreboard players set @e[tag=lol.minion,tag=temp] armor.pen 0
        scoreboard players set @e[tag=lol.minion,tag=temp] magic_resist.pen 0

        scoreboard players set @e[tag=lol.minion,tag=temp] aa.cd 0
        scoreboard players set @e[tag=lol.minion,tag=temp] aa.spd 5
        scoreboard players set @e[tag=lol.minion,tag=temp] aa.range 128

        scoreboard players set @e[tag=lol.minion,tag=temp] hp.regen 0
        scoreboard players set @e[tag=lol.minion,tag=temp] hp.max 427
        scoreboard players operation @e[tag=lol.minion,tag=temp] hp.left = @e[tag=lol.minion,tag=temp] hp.max

        tag @e[tag=lol.minion,tag=temp] remove temp
    }

    function spawn.red {
        summon zombified_piglin ~ ~ ~ {CustomName:"Red Caster Minion",active_effects:[{id:"invisibility",duration:-1,amplifier:0,show_particles:0b}],IsBaby:1,PersistenceRequired:1,Team:"red",Tags:["minion.caster","can_aggro","red","has_health_bar","lol.minion","ranged","temp","use_custom_model","can_reduce_tower_armor"],Silent:1,attributes:[{id:"minecraft:follow_range",base:1048.0d},{id:"minecraft:attack_damage",base:0.0d},{id:"minecraft:max_health",base:1000.0d},{id:"minecraft:knockback_resistance",base:1.0d}],Health:1000.0f,Passengers:[{id:"item_display",Passengers:[{teleport_duration:1,id:"item_display",item_display:"head",Tags:["minion.body","red"],item:{id:"turtle_scute",count:1,components:{"minecraft:custom_model_data":{floats:[1001f]}}}}]},{id:"text_display",Tags:["hp","stats_bar"],background:0,billboard:"vertical"}]}

        execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=hp] {transformation:{scale:[0.1,0.2,0.0],translation:[0.0,-0.5,0.0]}}

        #execute as @e[tag=lol.minion,tag=temp] at @s run function animated_java:minion.caster/summon/red
