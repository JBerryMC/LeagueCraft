function percentage {
    scoreboard players operation temp hp.left = @s hp.left
    scoreboard players operation temp hp.left *= 100 integer

    scoreboard players operation temp hp.left /= @s hp.max
    scoreboard players operation @s hp.percentage = temp hp.left

    execute if score @s hp.left = @s hp.max run scoreboard players set @s hp.percentage 100
    execute if score @s hp.percentage matches 0 if score @s hp.left matches 1.. run scoreboard players set @s hp.percentage 1
    execute if score @s hp.left matches ..-1 run scoreboard players set @s hp.left 0

    execute if score @s hp.percentage matches 41.. run tag @s remove is_low_hp
    execute if score @s hp.percentage matches ..40 run tag @s add is_low_hp

    execute if score @s[tag=lol.structure.tower] hp.left matches 0 run function _lol:structure/tower/destroy
    execute if score @s[tag=lol.structure.inhib] hp.left matches 0 run function _lol:structure/inhib/destroy
    execute if score @s[tag=lol.structure.nexus] hp.left matches 0 run function _lol:structure/nexus/destroy
    execute if score @s[type=!#unvalid,type=!player,tag=!dummy,tag=!champion,tag=!dead] hp.left matches 0 run function _minecraft:dead
    execute if score @s[type=!#unvalid,tag=champion,tag=!dead] hp.left matches 0 run function _champion:dead

    scoreboard players operation 100 integer -= @s hp.percentage
    scoreboard players operation @s hp.percentage_lost = 100 integer
    scoreboard players set 100 integer 100

    execute unless score @s hp.percentage = @s hp.percentage_old run function _champion:hp/update
}

function percentage_shield_all {
    scoreboard players operation temp shield.all = @s shield.all
    scoreboard players operation temp shield.all *= 100 integer

    scoreboard players operation temp shield.all /= @s hp.max
    scoreboard players operation @s shield_all.percentage = temp shield.all

    execute if score @s shield.all > @s hp.max run scoreboard players set @s shield_all.percentage 100
    execute if score @s shield_all.percentage matches 0 if score @s shield.all matches 1.. run scoreboard players set @s shield_all.percentage 1

    execute unless score @s shield_all.percentage = @s shield_all.percentage_old run tag @s[type=player] add update.shield_all
    execute unless score @s shield_all.percentage = @s shield_all.percentage_old as @s[type=!player] run function _champion:hp/macro_shield_all
    execute unless score @s shield_all.percentage = @s shield_all.percentage_old run scoreboard players operation @s shield_all.percentage_old = @s shield_all.percentage
}

function update {
    execute as @s[type=player] run function _champion:hp/macro with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
    tag @s[type=player] add update.bar.hp

    execute as @s[tag=champion,team=blue,type=!player] run function _champion:hp/macro_dummy_blue
    execute as @s[tag=champion,team=red,type=!player] run function _champion:hp/macro_dummy_red
    execute as @s[type=!#unvalid,team=!red,team=!blue,type=!player] run function _champion:hp/macro_mob

    execute as @s[tag=blue,type=!player] run function _champion:hp/macro_bar_blue
    execute as @s[tag=red,type=!player] run function _champion:hp/macro_bar_red

    scoreboard players operation @s hp.percentage_old = @s hp.percentage
}
