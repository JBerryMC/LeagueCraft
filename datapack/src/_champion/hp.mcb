function macro_mob {
    execute if score @s hp.percentage matches 0 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.0",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 1 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.1",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 2 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.2",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 3 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.3",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 4 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.4",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 5 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.5",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 6 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.6",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 7 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.7",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 8 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.8",interpret:true,font:"minecraft:hp_mob"}
    execute if score @s hp.percentage matches 9 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.9",interpret:true,font:"minecraft:hp_mob"}

