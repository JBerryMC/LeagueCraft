function macro_bar_blue {
    execute if score @s hp.percentage matches 0 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.0",interpret:true,font:"minecraft:hp_bar_blue"}
    execute if score @s hp.percentage matches 1 on passengers as @s[tag=hp] run data modify entity @s text set value {storage:"lol:main",nbt:"hp.1",interpret:true,font:"minecraft:hp_bar_blue"}
