# _champion:aa/  (converted from the 1.20.2 LeagueCraft datapack)

function cd {
    scoreboard players operation 100 integer /= @s aa.spd
    scoreboard players operation @s aa.cd = 100 integer
    scoreboard players set 100 integer 100

    scoreboard players operation @s[scores={cc.cripple=0..}] aa.cd *= 2 integer

    scoreboard players operation @s channeling = @s aa.cd

    scoreboard players operation @s aa.cd *= 2 integer
    scoreboard players operation @s[tag=lol.minion,tag=ranged] channeling = @s aa.cd
}

function check {
    advancement revoke @s only _champion:aa
    execute if score @s aa.cd matches 0 run scoreboard players operation @s aa.range.count = @s aa.range

    execute if score @s aa.cd matches 0 if entity @s[scores={channeling=..0},tag=!cced,tag=!airborne] as @s[tag=melee] anchored eyes run function _champion:aa/melee
    execute if score @s aa.cd matches 0 if entity @s[scores={channeling=..0},tag=!cced,tag=!airborne] as @s[tag=ranged] anchored eyes run function _champion:aa/ranged
}

function melee {
    execute if entity @s[team=red] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[dx=0,team=!red,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=!temp_dmg] add temp_dmg
    execute if entity @s[team=red] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=blue] add temp_dmg

    execute if entity @s[team=red] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[dx=0,team=!red,tag=!unvalid,type=!#unvalid,tag=temp_dmg] run function _champion:aa/melee.success
    execute if entity @s[team=red] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=temp_dmg,tag=blue] run function _champion:aa/melee.structure

    execute if entity @s[team=red] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[dx=0,team=!red,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=temp_dmg] remove temp_dmg
    execute if entity @s[team=red] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=blue] remove temp_dmg

    execute if entity @s[team=blue] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[dx=0,team=!blue,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=!temp_dmg] add temp_dmg
    execute if entity @s[team=blue] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=red] add temp_dmg

    execute if entity @s[team=blue] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[dx=0,team=!blue,tag=!unvalid,type=!#unvalid,tag=temp_dmg] run function _champion:aa/melee.success
    execute if entity @s[team=blue] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=temp_dmg,tag=red] run function _champion:aa/melee.structure

    execute if entity @s[team=blue] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[dx=0,team=!blue,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=temp_dmg] remove temp_dmg
    execute if entity @s[team=blue] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=red] remove temp_dmg

    scoreboard players remove @s aa.range.count 1
    execute if score @s aa.range.count matches 1.. if score @s aa.cd matches 0 positioned ^ ^ ^0.1 if block ~ ~ ~ #minecraft:like_air run function _champion:aa/melee
}

function melee.structure {
    function _champion:aa/cd

    function _champion:aa/sfx

    scoreboard players set @s dmg_physical.deal 0
    scoreboard players set @s dmg_magic.deal 0

    scoreboard players operation @s dmg_physical.deal = @s attack_damage
    scoreboard players operation @s[tag=magic.aa] dmg_magic.deal = @s ability_power
    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
}

function melee.success {
    function _champion:aa/cd

    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s

    function _champion:aa/sfx

    scoreboard players set @s dmg_physical.deal 0
    scoreboard players set @s dmg_magic.deal 0

    scoreboard players operation @s dmg_physical.deal = @s attack_damage
    scoreboard players operation @s[tag=magic.aa] dmg_magic.deal = @s ability_power
    function _champion:aa/on_hit
    function _champion:aa/special_modifiers
    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
}

function on_hit {
    execute if entity @s[tag=ashe] run effect give @e[type=!#unvalid,tag=!unvalid,tag=temp_dmg,limit=1,sort=nearest] slowness 1 1 false

    execute if entity @s[tag=yone,tag=e.soul,team=red] run tag @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] add yone.e.mark
    execute if entity @s[tag=yone,tag=e.soul,team=blue] run tag @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] add yone.e.mark

    execute if entity @s[tag=zed,team=red] run scoreboard players operation @e[tag=zed.r.mark.red,team=!red,tag=temp_dmg,limit=1,sort=nearest] zed.r.dmg += @s dmg_physical.deal
    execute if entity @s[tag=zed,team=blue] run scoreboard players operation @e[tag=zed.r.mark.blue,team=!blue,tag=temp_dmg,limit=1,sort=nearest] zed.r.dmg += @s dmg_physical.deal

    execute if entity @s[tag=malphite,tag=malphite.w] run function malphite:skills/w.damage
}

function on_hit_structure {
    execute if entity @s[tag=ezreal,team=red] if entity @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] positioned as @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] run function ezreal:skills/w.detonate
    execute if entity @s[tag=ezreal,team=blue] if entity @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] positioned as @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] run function ezreal:skills/w.detonate
}

function ranged {
    execute if entity @s[team=red] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[tag=!lol.structure,dx=0,team=!red,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=!temp_dmg] add temp_dmg
    execute if entity @s[team=red] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=blue] add temp_dmg

    execute if entity @s[team=red] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[tag=!lol.structure,dx=0,team=!red,tag=!unvalid,type=!#unvalid,tag=temp_dmg] run function _champion:aa/ranged.success
    execute if entity @s[team=red] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=temp_dmg,tag=blue] run function _champion:aa/ranged.structure

    execute if entity @s[team=red] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[tag=!lol.structure,dx=0,team=!red,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=temp_dmg] remove temp_dmg
    execute if entity @s[team=red] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=blue] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=blue] remove temp_dmg

    execute if entity @s[team=blue] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[tag=!lol.structure,dx=0,team=!blue,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=!temp_dmg] add temp_dmg
    execute if entity @s[team=blue] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=red] add temp_dmg

    execute if entity @s[team=blue] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[tag=!lol.structure,dx=0,team=!blue,tag=!unvalid,type=!#unvalid,tag=temp_dmg] run function _champion:aa/ranged.success
    execute if entity @s[team=blue] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] positioned ~-0.9 ~-0.9 ~-0.9 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=temp_dmg,tag=red] run function _champion:aa/ranged.structure

    execute if entity @s[team=blue] positioned ^ ^ ^0.1 unless entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[tag=!lol.structure,dx=0,team=!blue,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest,tag=temp_dmg] remove temp_dmg
    execute if entity @s[team=blue] positioned ^ ^ ^0.1 if entity @e[tag=lol.structure,type=interaction,dx=0,tag=red] run tag @e[tag=lol.structure,type=interaction,dx=0,limit=1,sort=nearest,tag=red] remove temp_dmg

    scoreboard players remove @s aa.range.count 1
    execute if score @s aa.range.count matches 1.. if score @s aa.cd matches 0 positioned ^ ^ ^0.1 if block ~ ~ ~ #minecraft:like_air run function _champion:aa/ranged
}

function ranged.basic {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 0
    scoreboard players set @s dmg_magic.deal 0

    scoreboard players operation @s dmg_physical.deal = @s attack_damage
    function _champion:aa/on_hit
    function _champion:aa/special_modifiers
    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
}

function ranged.basic_structure {
    execute if entity @s[team=red] run damage @e[tag=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 0
    scoreboard players set @s dmg_magic.deal 0

    scoreboard players operation @s dmg_physical.deal = @s attack_damage
    function _champion:aa/on_hit_structure
    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] run tag @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] run tag @e[tag=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
}

function ranged.hit {
    execute if entity @s[tag=aa,tag=!ashe.q] on passengers as @s[tag=initial] on origin run function _champion:aa/ranged.basic

    execute if entity @s[tag=ashe.q,tag=!decor] on passengers as @s[tag=initial] on origin run function ashe:skills/q.hit

    execute if entity @s[tag=ezreal.e.missile] on passengers as @s[tag=initial] on origin run function ezreal:skills/e.hit

    execute if entity @s[tag=soraka.q.refund] on passengers as @s[tag=initial] on origin run scoreboard players set @s soraka.passive 3

    execute if entity @s[tag=malphite.q] on passengers as @s[tag=initial] on origin run function malphite:skills/q.hit

    execute if entity @s[tag=annie.q] on passengers as @s[tag=initial] on origin run function annie:skills/q.hit
}

function ranged.hit_structure {
    execute if entity @s[tag=aa,tag=!ashe.q] on passengers as @s[tag=initial] on origin run function _champion:aa/ranged.basic_structure
    execute if entity @s[tag=ashe.q,tag=!decor] on passengers as @s[tag=initial] on origin run function ashe:skills/q.hit_structure
}

function ranged.homing {
    function _champion:aa/ranged.particle

    ## STRUCTURE
    execute store success score @s temp on passengers as @s[tag=target] on origin if entity @s[tag=lol.structure.entity]
    execute if score @s temp matches 1 store success score @s temp on passengers as @s[tag=target] on origin positioned ~-0.5 ~-0.5 ~-0.5 if entity @s[dx=0]
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin on vehicle run tag @s[tag=lol.structure] add temp_dmg
    execute if score @s temp matches 1 run function _champion:aa/ranged.hit_structure
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin on vehicle run tag @s[tag=lol.structure] remove temp_dmg
    execute if score @s temp matches 1 on passengers run kill @s
    execute if score @s temp matches 1 run kill @s

    ## REGULAR TARGET
    execute store success score @s temp on passengers as @s[tag=target] on origin unless entity @s[tag=lol.structure.entity]
    execute if score @s temp matches 1 store success score @s temp on passengers as @s[tag=target] on origin positioned ~-0.5 ~-0.5 ~-0.5 if entity @s[dx=0]
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin run tag @s add temp_dmg
    execute if score @s temp matches 1 run function _champion:aa/ranged.hit
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin run tag @s remove temp_dmg
    execute if score @s temp matches 1 on passengers run kill @s
    execute if score @s temp matches 1 run kill @s

    ## FOLLOW TARGET
    execute store success score @s temp on passengers as @s[tag=target] on origin positioned ~-0.5 ~-0.5 ~-0.5 if entity @s[dx=0]
    execute if score @s temp matches 0 on passengers as @s[tag=target] on origin run tag @s add temp_owner
    execute if score @s temp matches 0 facing entity @e[tag=temp_owner,limit=1,sort=nearest] eyes rotated ~ ~-10 run tp @s[tag=!feet,tag=!speed.slow] ^ ^ ^1 ~ ~
    execute if score @s temp matches 0 facing entity @e[tag=temp_owner,limit=1,sort=nearest] eyes rotated ~ ~-10 run tp @s[tag=!feet,tag=speed.slow] ^ ^ ^0.5 ~ ~
    execute if score @s temp matches 0 facing entity @e[tag=temp_owner,limit=1,sort=nearest] feet run tp @s[tag=feet] ^ ^ ^1 ~ ~
    execute if score @s temp matches 0 on passengers as @s[tag=target] on origin run tag @s remove temp_owner

    ## NO MORE TARGET
    execute store success score @s temp on passengers as @s[tag=target] if data entity @s Owner
    execute if score @s temp matches 0 on passengers run kill @s
    execute if score @s temp matches 0 run kill @s
}

function ranged.initial {
    execute at @s run summon area_effect_cloud ~ ~ ~ {Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner

    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=!lol.structure,team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] UUID
    execute if entity @s[team=red] run tag @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] remove temp

    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=!lol.structure,team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] UUID
    execute if entity @s[team=blue] run tag @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] remove temp
}

function ranged.initial_structure {
    execute at @s run summon area_effect_cloud ~ ~ ~ {Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner

    execute if entity @s[team=red] as @e[tag=lol.structure,type=interaction,tag=blue,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] add ranged_temp_target
    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=ranged_temp_target,type=silverfish,team=blue,limit=1,sort=nearest] UUID
    execute if entity @s[team=red] run tag @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] remove temp
    execute if entity @s[team=red] as @e[tag=lol.structure,type=interaction,tag=blue,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] remove ranged_temp_target

    execute if entity @s[team=blue] as @e[tag=lol.structure,type=interaction,tag=red,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] add ranged_temp_target
    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=ranged_temp_target,type=silverfish,team=red,limit=1,sort=nearest] UUID
    execute if entity @s[team=blue] run tag @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] remove temp
    execute if entity @s[team=blue] as @e[tag=lol.structure,type=interaction,tag=red,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] remove ranged_temp_target
}

function ranged.particle {
    execute if entity @s[tag=aa.ashe] run particle dust{color:[0.5,0.9,1],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.vayne] run particle crit ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.ezreal] run particle dust{color:[1,0.957,0.553],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=ezreal.e.missile] run particle minecraft:dust{color:[1,1,0],scale:1} ^ ^ ^ 0 0 0 0 1 force

    execute if entity @s[tag=aa.jhin] run particle dust{color:[0.5,0.9,1],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.soraka] run particle end_rod ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=soraka.q.refund] run particle happy_villager ~ ~-0.4 ~ 0.1 0.1 0.1 0 2 force

    execute if entity @s[tag=malphite.q] run particle block{block_state:"ancient_debris"} ~ ~ ~ 0.1 0 0.1 0.1 2 force
    execute if entity @s[tag=malphite.q] run particle item{item:"ancient_debris"} ~ ~ ~ 0.1 0 0.1 0.1 2 force

    execute if entity @s[tag=aa.lux] run particle electric_spark ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.annie] run particle flame ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=annie.q] run particle flame ~ ~-0.4 ~ 0.2 0.2 0.2 0.01 10 force

    ## Minion
    execute if entity @s[tag=aa.minion.caster,tag=red] run particle dust{color:[1,0,0],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=aa.minion.siege,tag=red] run particle dust{color:[1,0,0],scale:1.5} ~ ~-0.4 ~ 0.1 0.1 0.1 0 2 force

    execute if entity @s[tag=aa.minion.caster,tag=blue] run particle dust{color:[0,0.5,1],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=aa.minion.siege,tag=blue] run particle dust{color:[0,0.5,1],scale:1.5} ~ ~-0.4 ~ 0.1 0.1 0.1 0 2 force
}

function ranged.structure {
    function _champion:aa/cd
    function _champion:aa/sfx

    function _champion:aa/ranged.initial_structure
}

function ranged.success {
    function _champion:aa/cd
    function _champion:aa/sfx

    function _champion:aa/ranged.initial
}

function sfx {
    execute if entity @s[tag=yasuo] run function yasuo:aa
    execute if entity @s[tag=yone] run function yone:aa
    execute if entity @s[tag=zed] run function zed:aa
    execute if entity @s[tag=leesin] run function leesin:aa
    execute if entity @s[tag=aatrox] run function aatrox:aa

    execute if entity @s[tag=ashe] run function ashe:aa
    execute if entity @s[tag=vayne] run function vayne:aa
    execute if entity @s[tag=ezreal] run function ezreal:aa
    execute if entity @s[tag=jhin] run function jhin:aa

    execute if entity @s[tag=leona] run function leona:aa
    execute if entity @s[tag=soraka] run function soraka:aa

    execute if entity @s[tag=garen] run function garen:aa
    execute if entity @s[tag=malphite] run function malphite:aa

    execute if entity @s[tag=lux] run function lux:aa
    execute if entity @s[tag=annie] run function annie:aa
    execute if entity @s[tag=annie.r] run function annie:skills/r.aa

    ## Minion
    execute if entity @s[tag=minion.melee] run function _lol:minion/melee/aa
    execute if entity @s[tag=minion.super] run function _lol:minion/super/aa
    execute if entity @s[tag=minion.caster] run function _lol:minion/caster/aa
    execute if entity @s[tag=minion.siege] run function _lol:minion/siege/aa
}

function special_modifiers {
    execute if entity @s[tag=ashe] run function ashe:skills/q.stack.gain

    execute if entity @s[tag=ezreal,team=red] if entity @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] positioned as @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] run function ezreal:skills/w.detonate
    execute if entity @s[tag=ezreal,team=blue] if entity @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] positioned as @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] run function ezreal:skills/w.detonate

    execute if entity @s[tag=yone] run function yone:passive

    execute if entity @s[tag=leesin] if score @s stack_p matches 1.. run function leesin:skills/passive.aa

    execute if entity @s[tag=zed,team=red] if score @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] hp.percentage matches ..50 unless score @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] zed_p_cd matches 1.. run function zed:passive
    execute if entity @s[tag=zed,team=blue] if score @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] hp.percentage matches ..50 unless score @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] zed_p_cd matches 1.. run function zed:passive

    execute if entity @s[tag=aatrox] if score @s cd_p matches 0 run function aatrox:passive
    execute if entity @s[tag=aatrox] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 2

    execute if entity @s[tag=leona,tag=leona.q] run function leona:skills/q.damage
    execute if entity @s[tag=garen,tag=garen.q] run function garen:skills/q.damage

    execute if entity @s[tag=lux,team=red] if entity @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] positioned as @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] run function lux:passive
    execute if entity @s[tag=lux,team=blue] if entity @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] positioned as @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] run function lux:passive

    execute if entity @s[tag=annie.r] if score @s aa.spd matches 10.. run scoreboard players remove @s aa.spd 4
}
