# _champion:abilities/  (converted from the 1.20.2 LeagueCraft datapack)

function model {
    execute store result storage lol:main temp.model int 1 run scoreboard players get @s status.weapon

    item modify entity @s hotbar.0 _champion:set_model
    item modify entity @s hotbar.1 _champion:set_model
    item modify entity @s hotbar.2 _champion:set_model
    item modify entity @s hotbar.3 _champion:set_model

    scoreboard players operation @s status.weapon_old = @s status.weapon
}

function reload {
    clear @s phantom_membrane[minecraft:custom_data~{lol_item:1}]

    item replace entity @s hotbar.0 with phantom_membrane[minecraft:custom_name=" ",minecraft:custom_data={kill_item:1,lol_item:1,skill_q:1,used:1}]
    item replace entity @s hotbar.1 with phantom_membrane[minecraft:custom_name=" ",minecraft:custom_data={kill_item:1,lol_item:1,skill_w:1,used:1}]
    item replace entity @s hotbar.2 with phantom_membrane[minecraft:custom_name=" ",minecraft:custom_data={kill_item:1,lol_item:1,skill_e:1,used:1}]
    item replace entity @s hotbar.3 with phantom_membrane[minecraft:custom_name=" ",minecraft:custom_data={kill_item:1,lol_item:1,skill_r:1,used:1}]
    item replace entity @s hotbar.4 with phantom_membrane[minecraft:custom_name=" ",minecraft:custom_model_data={floats:[9999f]},minecraft:custom_data={kill_item:1,lol_item:1,uuid:1}]

    function _champion:abilities/model
    item modify entity @s hotbar.4 _champion:set_uuid
    function _champion:abilities/keybind/default with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function use_e {
    function _champion:abilities/reload


    item modify entity @s hotbar.0 _champion:use_ability
    item modify entity @s hotbar.1 _champion:use_ability
    item modify entity @s hotbar.2 _champion:used_ability
    item modify entity @s hotbar.3 _champion:use_ability

    #say E
    execute if score @s status.e matches 1..5 run function _champion:abilities/trigger/e
}

function use_q {
    function _champion:abilities/reload

    item modify entity @s hotbar.0 _champion:used_ability
    item modify entity @s hotbar.1 _champion:use_ability
    item modify entity @s hotbar.2 _champion:use_ability
    item modify entity @s hotbar.3 _champion:use_ability
    #say Q
    execute if score @s status.q matches 1..5 run function _champion:abilities/trigger/q
}

function use_r {
    function _champion:abilities/reload


    item modify entity @s hotbar.0 _champion:use_ability
    item modify entity @s hotbar.1 _champion:use_ability
    item modify entity @s hotbar.2 _champion:use_ability
    item modify entity @s hotbar.3 _champion:used_ability

    execute if score @s status.r matches 1..5 run function _champion:abilities/trigger/r
}

function use_w {
    function _champion:abilities/reload


    item modify entity @s hotbar.0 _champion:use_ability
    item modify entity @s hotbar.1 _champion:used_ability
    item modify entity @s hotbar.2 _champion:use_ability
    item modify entity @s hotbar.3 _champion:use_ability
    #say W
    execute if score @s status.w matches 1..5 run function _champion:abilities/trigger/w
}

dir cooldown {
    function e {
        execute unless entity @s[tag=!useMana,tag=!useEnergy] run scoreboard players operation @s mana -= @s mana_e

        execute store result score @s temp run scoreboard players operation 100 integer += @s haste
        scoreboard players set 100 integer 100

        execute store result score @s temp run scoreboard players operation 10000 integer /= @s temp
        scoreboard players set 10000 integer 10000

        scoreboard players operation @s temp *= @s base_cd.e
        execute store result score @s cd_e run scoreboard players operation @s temp /= 100 integer
        scoreboard players reset @s temp
    }

    function q {
        execute unless entity @s[tag=!useMana,tag=!useEnergy] run scoreboard players operation @s mana -= @s mana_q

        execute store result score @s temp run scoreboard players operation 100 integer += @s haste
        scoreboard players set 100 integer 100

        execute store result score @s temp run scoreboard players operation 10000 integer /= @s temp
        scoreboard players set 10000 integer 10000

        scoreboard players operation @s temp *= @s base_cd.q
        execute store result score @s cd_q run scoreboard players operation @s temp /= 100 integer
        scoreboard players reset @s temp
    }

    function q_aa.spd {
        scoreboard players operation @s temp = @s aa.spd
        scoreboard players remove @s temp 10

        scoreboard players operation @s temp *= 2 integer
        scoreboard players operation @s temp *= 2 integer

        scoreboard players operation @s temp += 100 integer

        execute store result score @s temp run scoreboard players operation 10000 integer /= @s temp
        scoreboard players set 10000 integer 10000

        scoreboard players operation @s temp *= @s base_cd.q
        execute store result score @s cd_q run scoreboard players operation @s temp /= 100 integer
        scoreboard players reset @s temp
    }

    function r {
        execute unless entity @s[tag=!useMana,tag=!useEnergy] run scoreboard players operation @s mana -= @s mana_r

        execute store result score @s temp run scoreboard players operation 100 integer += @s haste
        scoreboard players set 100 integer 100

        execute store result score @s temp run scoreboard players operation 10000 integer /= @s temp
        scoreboard players set 10000 integer 10000

        scoreboard players operation @s temp *= @s base_cd.r
        execute store result score @s cd_r run scoreboard players operation @s temp /= 100 integer
        scoreboard players reset @s temp
    }

    function w {
        execute unless entity @s[tag=!useMana,tag=!useEnergy] run scoreboard players operation @s mana -= @s mana_w

        execute store result score @s temp run scoreboard players operation 100 integer += @s haste
        scoreboard players set 100 integer 100

        execute store result score @s temp run scoreboard players operation 10000 integer /= @s temp
        scoreboard players set 10000 integer 10000

        scoreboard players operation @s temp *= @s base_cd.w
        execute store result score @s cd_w run scoreboard players operation @s temp /= 100 integer
        scoreboard players reset @s temp
    }

    function w_aa.spd {
        scoreboard players operation @s temp = @s aa.spd
        scoreboard players remove @s temp 10

        scoreboard players operation @s temp *= 2 integer
        scoreboard players operation @s temp *= 2 integer

        scoreboard players operation @s temp += 100 integer

        execute store result score @s temp run scoreboard players operation 10000 integer /= @s temp
        scoreboard players set 10000 integer 10000

        scoreboard players operation @s temp *= @s base_cd.w
        execute store result score @s cd_w run scoreboard players operation @s temp /= 100 integer
        scoreboard players reset @s temp
    }
}

dir keybind {
    function default {
        # Key labels under the HUD icons, for the plugin's controls: hotbar keys 1-4 cast Q/W/E/R
        # and drop casts summoner 1. Keybind components show each player's own binds. The plugin
        # only writes these when its config asks for different labels.
        $data modify storage lol:main keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4) set value [{keybind:"key.hotbar.1"}]
        $data modify storage lol:main keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4) set value [{keybind:"key.hotbar.2"}]
        $data modify storage lol:main keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4) set value [{keybind:"key.hotbar.3"}]
        $data modify storage lol:main keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4) set value [{keybind:"key.hotbar.4"}]
        $data modify storage lol:main keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4) set value [{keybind:"key.drop",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"}]
    }
}

dir reset {
    function default {
        loot replace entity @s container.0 loot _champion:default
        $data modify entity @s Items[{Slot:0b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:1b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:2b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:3b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
    }

    function qer {
        loot replace entity @s container.0 loot _champion:use_w
        $data modify entity @s Items[{Slot:0b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:1b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:2b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:3b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        #$say $(model)
    }

    function qwe {
        loot replace entity @s container.0 loot _champion:use_r
        $data modify entity @s Items[{Slot:0b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:1b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:2b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:3b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        #$say $(model)
    }

    function qwer {
        loot replace entity @s container.0 loot _champion:reset
        $data modify entity @s Items[{Slot:0b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:1b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:2b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:3b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        #$say $(model)
    }

    function qwr {
        loot replace entity @s container.0 loot _champion:use_e
        $data modify entity @s Items[{Slot:0b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:1b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:2b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:3b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        #$say $(model)
    }

    function wer {
        loot replace entity @s container.0 loot _champion:use_q
        $data modify entity @s Items[{Slot:0b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:1b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:2b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        $data modify entity @s Items[{Slot:3b}].components."minecraft:custom_model_data" set value {floats:[$(model)]}
        #$say $(model)
    }
}

dir trigger {
    function e {
        execute if entity @s[tag=yasuo] at @s anchored eyes positioned ^ ^ ^ run function yasuo:use_e.check

        execute if entity @s[tag=yone,tag=e.soul] run function yone:use_e2
        execute if entity @s[tag=yone,tag=!e.soul] run function yone:use_e

        execute if entity @s[tag=zed] run function zed:use_e

        execute if entity @s[tag=leesin] if score @s status.e matches 1 run function leesin:use_e
        execute if entity @s[tag=leesin] if score @s status.e matches 2 run function leesin:use_e2

        execute if entity @s[tag=ashe] run function ashe:use_e
        execute if entity @s[tag=jhin] run function jhin:use_e
        execute if entity @s[tag=vayne] run function vayne:use_e
        execute if entity @s[tag=ezreal] run function ezreal:use_e

        execute if entity @s[tag=aatrox] run function aatrox:use_e

        execute if entity @s[tag=leona] run function leona:use_e
        execute if entity @s[tag=soraka] run function soraka:use_e

        execute if entity @s[tag=garen] if score @s status.e matches 1 run function garen:use_e
        execute if entity @s[tag=garen,team=red] if score @s status.e matches 2 as @e[tag=garen.e.cd,tag=red] run function garen:skills/e.end
        execute if entity @s[tag=garen,team=blue] if score @s status.e matches 2 as @e[tag=garen.e.cd,tag=blue] run function garen:skills/e.end
        execute if entity @s[tag=malphite] run function malphite:use_e

        execute if entity @s[tag=lux] if score @s status.e matches 1 run function lux:use_e
        execute if entity @s[tag=lux,team=red] if score @s status.e matches 2 as @e[tag=lux.e.area,tag=red] at @s run function lux:skills/e.end
        execute if entity @s[tag=lux,team=blue] if score @s status.e matches 2 as @e[tag=lux.e.area,tag=blue] at @s run function lux:skills/e.end

        execute if entity @s[tag=annie] anchored eyes positioned ^ ^ ^ run function annie:use_e.check
    }

    function q {
        execute if entity @s[tag=yasuo] run function yasuo:use_q
        execute if entity @s[tag=yone] run function yone:use_q
        execute if entity @s[tag=zed] run function zed:use_q

        execute if entity @s[tag=leesin] if score @s status.q matches 1 run function leesin:use_q
        execute if entity @s[tag=leesin] if score @s status.q matches 2 run function leesin:use_q2

        execute if entity @s[tag=ashe] run function ashe:use_q
        execute if entity @s[tag=jhin] run function jhin:use_q
        execute if entity @s[tag=vayne] run function vayne:use_q
        execute if entity @s[tag=ezreal] run function ezreal:use_q

        execute if entity @s[tag=aatrox,team=red] unless entity @e[tag=aatrox.q.delay,tag=red] run function aatrox:use_q
        execute if entity @s[tag=aatrox,team=blue] unless entity @e[tag=aatrox.q.delay,tag=blue] run function aatrox:use_q

        execute if entity @s[tag=leona] run function leona:use_q
        execute if entity @s[tag=soraka] run function soraka:use_q

        execute if entity @s[tag=garen] run function garen:use_q
        execute if entity @s[tag=malphite] at @s anchored eyes positioned ^ ^ ^ run function malphite:use_q.check

        execute if entity @s[tag=lux] run function lux:use_q

        execute if entity @s[tag=annie] at @s anchored eyes positioned ^ ^ ^ run function annie:use_q.check
    }

    function r {
        execute if entity @s[tag=yasuo] run function yasuo:use_r
        execute if entity @s[tag=yone] run function yone:use_r

        execute if entity @s[tag=zed] unless score @s status.r matches 2 at @s anchored eyes positioned ^ ^ ^ run function zed:use_r.check
        execute if entity @s[tag=zed] if score @s status.r matches 2 run function zed:use_r2

        execute if entity @s[tag=leesin] at @s anchored eyes positioned ^ ^ ^ run function leesin:use_r.check

        execute if entity @s[tag=ashe] run function ashe:use_r
        execute if entity @s[tag=jhin] run function jhin:use_r
        execute if entity @s[tag=vayne] run function vayne:use_r
        execute if entity @s[tag=ezreal] run function ezreal:use_r

        execute if entity @s[tag=aatrox] run function aatrox:use_r

        execute if entity @s[tag=leona] run function leona:use_r
        execute if entity @s[tag=soraka] run function soraka:use_r

        execute if entity @s[tag=garen] at @s anchored eyes positioned ^ ^ ^ run function garen:use_r.check
        execute if entity @s[tag=malphite] run function malphite:use_r

        execute if entity @s[tag=annie] if score @s status.r matches 1 run function annie:use_r
        execute if entity @s[tag=annie] if score @s status.r matches 2 run function annie:use_r.check
        execute if entity @s[tag=lux] run function lux:use_r
    }

    function w {
        execute if entity @s[tag=yasuo] run function yasuo:use_w
        execute if entity @s[tag=yone] run function yone:use_w

        execute if entity @s[tag=zed] unless score @s status.w matches 2 run function zed:use_w
        execute if entity @s[tag=zed] if score @s status.w matches 2 run function zed:use_w2

        execute if entity @s[tag=leesin] if score @s status.w matches 1 at @s anchored eyes positioned ^ ^ ^ run function leesin:use_w.check
        execute if entity @s[tag=leesin] if score @s status.w matches 2 run function leesin:use_w2

        execute if entity @s[tag=ashe] run function ashe:use_w
        execute if entity @s[tag=jhin] run function jhin:use_w
        execute if entity @s[tag=vayne] run function vayne:use_w
        execute if entity @s[tag=ezreal] run function ezreal:use_w

        execute if entity @s[tag=aatrox] run function aatrox:use_w

        execute if entity @s[tag=leona] run function leona:use_w
        execute if entity @s[tag=soraka] at @s anchored eyes positioned ^ ^ ^ run function soraka:use_w.check

        execute if entity @s[tag=garen] run function garen:use_w
        execute if entity @s[tag=malphite] run function malphite:use_w

        execute if entity @s[tag=lux] run function lux:use_w

        execute if entity @s[tag=annie] run function annie:use_w
    }
}
