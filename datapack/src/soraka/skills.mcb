# soraka:skills/  (converted from the 1.20.2 LeagueCraft datapack)

function e.animation {
    tp @s ~ ~ ~ ~6 ~
    particle end_rod ^ ^ ^3 0 0 0 0 1 force @a
    particle end_rod ^ ^ ^-3 0 0 0 0 1 force @a

    execute if entity @s[tag=red] positioned ~-3 ~-0.5 ~-3 run scoreboard players set @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] cc.silence 2
    execute if entity @s[tag=blue] positioned ~-3 ~-0.5 ~-3 run scoreboard players set @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] cc.silence 2

    execute if entity @s[tag=red,tag=!spawned] positioned ~-3 ~-0.5 ~-3 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add soraka.e.hit
    execute if entity @s[tag=red,tag=!spawned] run tag @e[team=!red,tag=soraka.e.hit] add soraka.e.temp_dmg
    execute if entity @s[tag=red,tag=!spawned] if entity @e[tag=soraka.e.hit,team=!red] as @p[tag=soraka,team=red] run function soraka:skills/e.damage
    execute if entity @s[tag=red,tag=!spawned] run tag @e[team=!red,tag=soraka.e.hit] remove soraka.e.hit

    execute if entity @s[tag=blue,tag=!spawned] positioned ~-3 ~-0.5 ~-3 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add soraka.e.hit
    execute if entity @s[tag=blue,tag=!spawned] run tag @e[team=!blue,tag=soraka.e.hit] add soraka.e.temp_dmg
    execute if entity @s[tag=blue,tag=!spawned] if entity @e[tag=soraka.e.hit,team=!blue] as @p[tag=soraka,team=blue] run function soraka:skills/e.damage
    execute if entity @s[tag=blue,tag=!spawned] run tag @e[team=!blue,tag=soraka.e.hit] remove soraka.e.hit

    tag @s add spawned

    execute if entity @s[tag=red] unless data entity @s Passengers positioned ~-3 ~-0.5 ~-3 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add soraka.e.hit
    execute if entity @s[tag=red] unless data entity @s Passengers run scoreboard players set @e[team=!red,tag=soraka.e.hit] cc.root 40
    execute if entity @s[tag=red] unless data entity @s Passengers run tag @e[team=!red,tag=soraka.e.hit] add soraka.e.temp_dmg
    execute if entity @s[tag=red] unless data entity @s Passengers if entity @e[tag=soraka.e.hit,team=!red] as @p[tag=soraka,team=red] run function soraka:skills/e.damage
    execute if entity @s[tag=red] unless data entity @s Passengers run tag @e[team=!red,tag=soraka.e.hit] remove soraka.e.hit

    execute if entity @s[tag=blue] unless data entity @s Passengers positioned ~-3 ~-0.5 ~-3 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add soraka.e.hit
    execute if entity @s[tag=blue] unless data entity @s Passengers run scoreboard players set @e[team=!blue,tag=soraka.e.hit] cc.root 40
    execute if entity @s[tag=blue] unless data entity @s Passengers run tag @e[team=!blue,tag=soraka.e.hit] add soraka.e.temp_dmg
    execute if entity @s[tag=blue] unless data entity @s Passengers if entity @e[tag=soraka.e.hit,team=!blue] as @p[tag=soraka,team=blue] run function soraka:skills/e.damage
    execute if entity @s[tag=blue] unless data entity @s Passengers run tag @e[team=!blue,tag=soraka.e.hit] remove soraka.e.hit
}

function e.damage {
    execute if entity @s[team=red] run damage @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players operation @s dmg_magic.deal = @s ability_power
    scoreboard players operation @s dmg_magic.deal *= 40 integer
    scoreboard players operation @s dmg_magic.deal /= 100 integer
    scoreboard players add @s dmg_magic.deal 170

    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=soraka.e.hit,type=!#unvalid,tag=soraka.e.temp_dmg,limit=1,sort=nearest] remove soraka.e.temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!red] run function soraka:skills/e.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=soraka.e.hit,type=!#unvalid,tag=soraka.e.temp_dmg,limit=1,sort=nearest] remove soraka.e.temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!blue] run function soraka:skills/e.damage
}

function e.end {
    execute if entity @s[tag=red] if entity @e[tag=leona.e.dmg,team=!red] at @p[tag=leona,team=red] run tag @e[tag=leona.e.dmg,team=!red,limit=1,sort=furthest] add leona.e.target
    execute if entity @s[tag=red] if entity @e[tag=leona.e.dmg,team=!red] run tag @e[tag=leona.e.dmg,team=!red] remove leona.e.dmg

    execute if entity @s[tag=red] if entity @e[tag=leona.e.target,team=!red] run scoreboard players set @e[tag=leona.e.target,team=!red] cc.root 10
    execute if entity @s[tag=red] if entity @e[tag=leona.e.target,team=!red] as @p[tag=leona,team=red] at @s run function leona:use_e2

    execute if entity @s[tag=blue] if entity @e[tag=leona.e.dmg,team=!blue] at @p[tag=leona,team=blue] run tag @e[tag=leona.e.dmg,team=!blue,limit=1,sort=furthest] add leona.e.target
    execute if entity @s[tag=blue] if entity @e[tag=leona.e.dmg,team=!blue] run tag @e[tag=leona.e.dmg,team=!blue] remove leona.e.dmg

    execute if entity @s[tag=blue] if entity @e[tag=leona.e.target,team=!blue] run scoreboard players set @e[tag=leona.e.target,team=!blue] cc.root 10
    execute if entity @s[tag=blue] if entity @e[tag=leona.e.target,team=!blue] as @p[tag=leona,team=blue] at @s run function leona:use_e2
}

function e.position {
    execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air run playsound soraka.sfx.e master @a ~ ~ ~
    execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=red] run summon item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100301f]}}},Tags:["lol.auto_clear","red","soraka.e"],Passengers:[{id:"area_effect_cloud",Duration:30,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=blue] run summon item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100301f]}}},Tags:["lol.auto_clear","blue","soraka.e"],Passengers:[{id:"area_effect_cloud",Duration:30,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if block ~ ~ ~ #like_air if block ~ ~-1 ~ #like_air positioned ~ ~-1 ~ run function soraka:skills/e.position

    execute unless block ~ ~ ~ #like_air positioned ~ ~1 ~ run function soraka:skills/e.position
}

function passive.healing {
    scoreboard players operation @s healing = @s ability_power
    scoreboard players operation @s healing *= 6 integer
    scoreboard players operation @s healing /= 100 integer
    scoreboard players add @s healing 48

    execute if entity @s[team=red] at @e[tag=is_heal_target,team=red] anchored eyes run particle happy_villager ^ ^-0.5 ^ 0.2 0.2 0.2 0.1 20 force

    execute if entity @s[team=blue] at @e[tag=is_heal_target,team=blue] anchored eyes run particle happy_villager ^ ^-0.5 ^ 0.2 0.2 0.2 0.1 20 force
}

function q.damage {
    execute if entity @s[team=red] run damage @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players operation @s dmg_magic.deal = @s ability_power
    scoreboard players operation @s dmg_magic.deal *= 35 integer
    scoreboard players operation @s dmg_magic.deal /= 100 integer
    scoreboard players add @s dmg_magic.deal 225

    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=soraka.q.hit,type=!#unvalid,tag=soraka.q.temp_dmg,limit=1,sort=nearest] remove soraka.q.temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!red] run function soraka:skills/q.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=soraka.q.hit,type=!#unvalid,tag=soraka.q.temp_dmg,limit=1,sort=nearest] remove soraka.q.temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!blue] run function soraka:skills/q.damage
}

