function q.sonic {
    tp @s ^ ^ ^1.5
    particle minecraft:dust{color:[0.6,0.9,1],scale:3} ^ ^ ^0.5 0.2 0.2 0.2 0 5 force
    particle minecraft:dust{color:[0.6,0.9,1],scale:1} ^ ^ ^ 0.2 0.2 0.2 0 10 force
    particle minecraft:dust{color:[0.6,0.9,1],scale:0.5} ^ ^ ^-0.5 0.2 0.2 0.2 0 5 force

    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!red,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] run function leesin:skills/q.sonic.hit

    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!blue,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] run function leesin:skills/q.sonic.hit
}

function q.sonic.hit {
    playsound leesin.sfx.q.hit master @a ~ ~ ~
    execute if entity @s[tag=red] run tag @e[team=!red,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add leesin.q.target.red
    execute if entity @s[tag=red] as @p[tag=leesin,team=red] run function leesin:skills/q1.damage
    execute if entity @s[tag=red] run summon area_effect_cloud ~ ~ ~ {Duration:60,Tags:["red","leesin.q.mark.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=red] as @e[tag=leesin.q.target.red,limit=1,sort=nearest] anchored eyes run summon item_display ^ ^ ^ {brightness:{sky:15,block:15},Glowing:1,Tags:["red","leesin.q.mark","lol.auto_clear"],teleport_duration:1,billboard:"vertical",item_display:"head",item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200111f]}}},Passengers:[{id:"area_effect_cloud",Tags:["cd"],Duration:200,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[tag=red] run scoreboard players set @e[tag=leesin.q.target.red,limit=1,sort=nearest] fx.sight 60

    execute if entity @s[tag=blue] run tag @e[team=!blue,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add leesin.q.target.blue
    execute if entity @s[tag=blue] as @p[tag=leesin,team=blue] run function leesin:skills/q1.damage
    execute if entity @s[tag=blue] run summon area_effect_cloud ~ ~ ~ {Duration:60,Tags:["blue","leesin.q.mark.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=blue] as @e[tag=leesin.q.target.blue,limit=1,sort=nearest] anchored eyes run summon item_display ^ ^ ^ {brightness:{sky:15,block:15},Glowing:1,Tags:["blue","leesin.q.mark","lol.auto_clear"],teleport_duration:1,billboard:"vertical",item_display:"head",item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200111f]}}},Passengers:[{id:"area_effect_cloud",Tags:["cd"],Duration:200,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[tag=blue] run scoreboard players set @e[tag=leesin.q.target.blue,limit=1,sort=nearest] fx.sight 60

    kill @s
}

function q1.damage {
    execute if entity @s[team=red] run damage @e[tag=leesin.q.target.red,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=leesin.q.target.blue,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 155
    scoreboard players operation @s dmg_physical.deal += @s attack_damage

    function _champion:dmg/calc.debuff
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.q.target.red,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.q.target.red,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.q.target.blue,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.q.target.blue,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
}

function q2.damage {
    execute if entity @s[team=red] run damage @e[tag=leesin.q.target.red,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=leesin.q.target.blue,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 155
    scoreboard players operation @s dmg_physical.deal += @s attack_damage
    scoreboard players operation dmg temp = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation dmg temp *= @e[tag=leesin.q.target.red,type=!#unvalid,team=!red,limit=1,sort=nearest] hp.percentage_lost
    execute if entity @s[team=blue] run scoreboard players operation dmg temp *= @e[tag=leesin.q.target.blue,type=!#unvalid,team=!blue,limit=1,sort=nearest] hp.percentage_lost
    scoreboard players operation dmg temp /= 100 integer

    scoreboard players operation @s dmg_physical.deal += dmg temp

    function _champion:dmg/calc.debuff
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.q.target.red,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.q.target.red,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.q.target.blue,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.q.target.blue,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
}

function q2.dash {
    execute if entity @s[tag=red] on passengers on vehicle facing entity @e[tag=leesin.q.target.red,limit=1,sort=nearest] feet rotated ~ ~-20 run tp @s ^ ^ ^1.5
    execute if entity @s[tag=red] if score @p[team=red,tag=leesin] channeling matches -1 run ride @p[team=red,tag=leesin] mount @s

    execute if entity @s[tag=red] run scoreboard players set @e[tag=leesin.q.target.red] fx.sight 2

    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] as @p[tag=leesin,team=red] run function leesin:skills/q2.damage
    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] as @e[tag=leesin.q.mark,tag=red] on passengers run kill @s
    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] run tag @p[tag=leesin,team=red] remove q2.dash
    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] on passengers run kill @s[tag=cd]
    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] run tag @e[tag=leesin.q.target.red] remove leesin.q.target.red

    execute if entity @s[tag=blue] on passengers on vehicle facing entity @e[tag=leesin.q.target.blue,limit=1,sort=nearest] feet rotated ~ ~-20 run tp @s ^ ^ ^1.5
    execute if entity @s[tag=blue] if score @p[team=blue,tag=leesin] channeling matches -1 run ride @p[team=blue,tag=leesin] mount @s

    execute if entity @s[tag=blue] run scoreboard players set @e[tag=leesin.q.target.blue] fx.sight 2

    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] as @p[tag=leesin,team=blue] run function leesin:skills/q2.damage
    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] as @e[tag=leesin.q.mark,tag=blue] on passengers run kill @s
    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] run tag @p[tag=leesin,team=blue] remove q2.dash
    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] on passengers run kill @s[tag=cd]
    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] run tag @e[tag=leesin.q.target.blue] remove leesin.q.target.blue
}

function q2.dash.cancel {
    execute if entity @s[tag=red] run tag @e[tag=leesin.q.target.red] remove leesin.q.target.red
    execute if entity @s[tag=red] as @e[tag=leesin.q.mark.model,tag=red] on passengers run kill @s
    execute if entity @s[tag=red] run tag @p[tag=leesin,team=red] remove q2.dash
    execute if entity @s[tag=red] on passengers run data modify entity @s Age set value 2147483646

    execute if entity @s[tag=blue] run tag @e[tag=leesin.q.target.blue] remove leesin.q.target.blue
    execute if entity @s[tag=blue] as @e[tag=leesin.q.mark.model,tag=blue] on passengers run kill @s
    execute if entity @s[tag=blue] run tag @p[tag=leesin,team=blue] remove q2.dash
    execute if entity @s[tag=blue] on passengers run data modify entity @s Age set value 2147483646
}

function r.animation {
    execute anchored feet run particle dust{color:[1,0.5,0],scale:1} ^ ^0.5 ^ 0.2 0.2 0.2 1 10 force

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=!leesin.r.target,team=!blue,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unvalid,type=!#unvalid] as @p[team=blue,tag=leesin] run function leesin:skills/r.damage.collide
    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=!leesin.r.target,team=!blue,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unvalid,type=!#unvalid] as @e[tag=!leesin.r.target,team=!blue,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unstoppable] positioned ~1 ~1 ~1 at @s run function leesin:skills/r.knockup.collide

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=!leesin.r.target,team=!red,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unvalid,type=!#unvalid] as @p[team=red,tag=leesin] run function leesin:skills/r.damage.collide
    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=!leesin.r.target,team=!red,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unvalid,type=!#unvalid] as @e[tag=!leesin.r.target,team=!red,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unstoppable] positioned ~1 ~1 ~1 at @s run function leesin:skills/r.knockup.collide

    execute unless data entity @s[team=red,type=player] RootVehicle{Entity:{Tags:["leesin.r"]}} run tag @e[tag=leesin.r.collide,team=red] remove leesin.r.collide
    execute unless data entity @s[team=blue,type=player] RootVehicle{Entity:{Tags:["leesin.r"]}} run tag @e[tag=leesin.r.collide,team=blue] remove leesin.r.collide
    execute unless data entity @s[type=player] RootVehicle{Entity:{Tags:["leesin.r"]}} run tag @s remove leesin.r.target

    execute if entity @s[team=red,type=!player] if entity @s[tag=!airborne] run tag @e[team=!blue,tag=leesin.r.collide] remove leesin.r.collide
    execute if entity @s[team=blue,type=!player] if entity @s[tag=!airborne] run tag @e[team=!red,tag=leesin.r.collide] remove leesin.r.collide
    execute if entity @s[type=!player] run tag @s[tag=!airborne] remove leesin.r.target
}

function r.cast {
    #execute on origin run tp @s ~ ~ ~ ~ ~

    execute if entity @s[nbt={Age:3}] on origin if entity @s[team=red] at @e[tag=leesin.r.target.temp,team=!red] anchored feet run particle crit ^ ^0.5 ^ 0 0 0 1 50 force
    execute if entity @s[nbt={Age:3}] on origin if entity @s[team=blue] at @e[tag=leesin.r.target.temp,team=!blue] anchored feet run particle crit ^ ^0.5 ^ 0 0 0 1 50 force

    execute if entity @s[nbt={Age:5}] on origin run tag @s remove r.animation

    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=red] run tag @e[tag=leesin.r.target.temp,team=!red] add leesin.r.target
    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=red] run tag @e[tag=leesin.r.target.temp,team=!red] remove leesin.r.target.temp

    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=blue] run tag @e[tag=leesin.r.target.temp,team=!blue] add leesin.r.target
    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=blue] run tag @e[tag=leesin.r.target.temp,team=!blue] remove leesin.r.target.temp

    execute if entity @s[nbt={Age:5}] on origin run function leesin:skills/r.damage

    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=red] as @e[tag=leesin.r.target,team=!red,tag=!unstoppable,tag=champion,limit=1] at @s unless predicate _lol:is_flying facing entity @p[tag=leesin,team=red] feet rotated ~ ~-5 run function leesin:skills/r.knockup
    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=red] as @e[tag=leesin.r.target,team=!red,tag=!unstoppable,tag=champion,limit=1] at @s if predicate _lol:is_flying on vehicle at @s[tag=lol.is_flying] facing entity @p[tag=leesin,team=red] feet rotated ~ ~-5 on passengers as @s[tag=champion] run function leesin:skills/r.knockup

    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=blue] as @e[tag=leesin.r.target,team=!blue,tag=!unstoppable,tag=champion,limit=1] at @s unless predicate _lol:is_flying facing entity @p[tag=leesin,team=blue] feet rotated ~ ~-5 run function leesin:skills/r.knockup
    execute if entity @s[nbt={Age:5}] on origin if entity @s[team=blue] as @e[tag=leesin.r.target,team=!blue,tag=!unstoppable,tag=champion,limit=1] at @s if predicate _lol:is_flying on vehicle at @s[tag=lol.is_flying] facing entity @p[tag=leesin,team=blue] feet rotated ~ ~-5 on passengers as @s[tag=champion] run function leesin:skills/r.knockup
}

function r.damage {
    execute if entity @s[team=red] run damage @e[tag=leesin.r.target,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=leesin.r.target,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 625
    scoreboard players operation dmg temp = @s attack_damage
    scoreboard players operation dmg temp *= 200 integer
    scoreboard players operation dmg temp /= 100 integer

    scoreboard players operation @s dmg_physical.deal += dmg temp

    function _champion:dmg/calc.debuff
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] armoruced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] armoruced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
}

function r.damage.collide {
    execute if entity @s[team=red] run damage @e[tag=!leesin.r.collide,tag=!leesin.r.target,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=!leesin.r.collide,tag=!leesin.r.target,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 625
    scoreboard players operation dmg temp = @s attack_damage
    scoreboard players operation dmg temp *= 200 integer
    scoreboard players operation dmg temp /= 100 integer

    scoreboard players operation @s dmg_physical.deal += dmg temp

    execute if entity @s[team=red] run scoreboard players operation dmg temp = @e[team=!red,tag=leesin.r.target] hp.max
    execute if entity @s[team=blue] run scoreboard players operation dmg temp = @e[team=!blue,tag=leesin.r.target] hp.max

    scoreboard players operation dmg temp *= 20 integer
    scoreboard players operation dmg temp /= 100 integer

    scoreboard players operation @s dmg_physical.deal += dmg temp

    function _champion:dmg/calc.debuff
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=!leesin.r.collide,tag=!leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] armoruced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=!leesin.r.collide,tag=!leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=!leesin.r.collide,tag=!leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] armoruced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=!leesin.r.collide,tag=!leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
}

function r.knockup {
    function _champion:cc/cancel
    scoreboard players set @s cc.airborne 20

    summon item ~ ~0.2 ~ {Invulnerable:1,Age:5980,PickupDelay:32767,NoGravity:1,Tags:["leesin.r","knockup","cc","temp"],Item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[9999f]}}}}
    data modify entity @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] Thrower set from entity @s UUID

    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] at @s store result score @s pos_x1 run data get entity @s Pos[0] 1000
    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] at @s store result score @s pos_y1 run data get entity @s Pos[1] 1000
    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] at @s store result score @s pos_z1 run data get entity @s Pos[2] 1000

    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] run tp @s ^ ^0.2 ^-0.1

    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] at @s store result score @s pos_x2 run data get entity @s Pos[0] 1000
    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] at @s store result score @s pos_y2 run data get entity @s Pos[1] 1000
    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] at @s store result score @s pos_z2 run data get entity @s Pos[2] 1000

    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] store result entity @s Motion[0] double 0.0075 run scoreboard players operation @s pos_x2 -= @s pos_x1
    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] store result entity @s Motion[1] double 0.0075 run scoreboard players operation @s pos_y2 -= @s pos_y1
    execute as @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] store result entity @s Motion[2] double 0.0075 run scoreboard players operation @s pos_z2 -= @s pos_z1

    tag @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] remove temp
}

function r.knockup.collide {
    tag @s add leesin.r.collide

    function _champion:cc/cancel
    scoreboard players set @s cc.airborne 20

    summon item ~ ~ ~ {Invulnerable:1,Age:5980,PickupDelay:32767,Motion:[0.0,0.375,0.0],Tags:["knockup","cc","temp"],Item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[9999f]}}}}
    data modify entity @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] Thrower set from entity @s UUID
    tag @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] remove temp
}

function r.particle {
    #execute if entity @s[tag=red] run tp @p[tag=leesin,team=red] ~ ~ ~
    #execute if entity @s[tag=blue] run tp @p[tag=leesin,team=blue] ~ ~ ~

    tp @s ~ ~ ~ ~-30 ~-10

    particle dust{color:[1,0.5,0],scale:2} ^1 ^0.5 ^1.75 0 0 0 1 1 force
    particle dust{color:[1,0.5,0],scale:2} ^0.5 ^0.5 ^1.75 0 0 0 1 1 force
    particle dust{color:[1,0.5,0],scale:3} ^ ^0.5 ^1.75 0 0 0 1 1 force
    particle dust{color:[1,0.5,0],scale:1} ^-0.25 ^0.5 ^1.75 0 0 0 0 1 force
    particle dust{color:[1,0.5,0],scale:1} ^-0.5 ^0.5 ^1.75 0 0 0 0 1 force
    particle dust{color:[1,0.5,0],scale:1} ^-0.75 ^0.5 ^1.75 0 0 0 0 1 force
    particle dust{color:[1,0.5,0],scale:1} ^-1 ^0.5 ^1.75 0 0 0 0 1 force

    #particle dust 1 0.5 0 2 ^ ^ ^1.5 0.1 0.1 0.1 1 2 force
}

function w.dash {
    tp @s ^ ^ ^1
    execute if entity @s[tag=red] run ride @p[team=red,tag=leesin] mount @s
    execute if entity @s[tag=blue] run ride @p[team=blue,tag=leesin] mount @s

    execute if entity @s[tag=red] if entity @e[tag=leesin.w.stop,distance=..1] positioned ~-1 ~-1 ~-1 as @e[tag=champion,tag=leesin.w.target,team=red,dx=1,dz=1,dy=1] at @s run function leesin:skills/w.shield.ally
    execute if entity @s[tag=red] if entity @e[tag=leesin.w.stop,distance=..1] run tag @e[tag=leesin.w.target,team=red] remove leesin.w.target
    execute if entity @s[tag=red] if entity @e[tag=leesin.w.stop,distance=..1] on passengers run kill @s[tag=cd]

    execute if entity @s[tag=blue] if entity @e[tag=leesin.w.stop,distance=..1] positioned ~-1 ~-1 ~-1 as @e[tag=champion,tag=leesin.w.target,team=blue,dx=1,dz=1,dy=1] at @s run function leesin:skills/w.shield.ally
    execute if entity @s[tag=blue] if entity @e[tag=leesin.w.stop,distance=..1] run tag @e[tag=leesin.w.target,team=blue] remove leesin.w.target
    execute if entity @s[tag=blue] if entity @e[tag=leesin.w.stop,distance=..1] on passengers run kill @s[tag=cd]
}

function w.dash.cancel {
    execute if entity @s[tag=red] run tag @e[tag=leesin.w.target,team=red] remove leesin.w.target
    execute if entity @s[tag=red] run kill @e[tag=leesin.w.stop,tag=red]
    execute if entity @s[tag=red] on passengers run kill @s[tag=cd]

    execute if entity @s[tag=blue] run tag @e[tag=leesin.w.target,team=blue] remove leesin.w.target
    execute if entity @s[tag=blue] run kill @e[tag=leesin.w.stop,tag=blue]
    execute if entity @s[tag=blue] on passengers run kill @s[tag=cd]
}

function w.shield.ally {
    tag @s add leesin.w.ally

    execute if entity @s[tag=has_display_bar] run tag @s add update.shield.leesin

    execute if entity @s[type=!player] on passengers as @s[tag=leesin.w.shield] on passengers run kill @s
    execute if entity @s[type=!player] on passengers as @s[tag=leesin.w.shield] run kill @s
    execute if entity @s[type=!player] run summon item_display ~ ~ ~ {interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}},Tags:["leesin.w.shield","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[200201f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[120.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[200201f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[-120.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[200201f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[-22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[45.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}}},{id:"area_effect_cloud",Duration:40,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[type=!player] run ride @e[type=item_display,tag=temp,tag=leesin.w.shield,limit=1,sort=nearest] mount @s
    execute if entity @s[type=!player] on passengers run data merge entity @s[tag=leesin.w.shield] {transformation:{translation:[0.0,-0.6,0.0]}}
    execute if entity @s[type=!player] on passengers as @s[tag=leesin.w.shield] on passengers run data merge entity @s {transformation:{translation:[0.0,-0.6,0.0]}}

    summon area_effect_cloud ~ ~ ~ {Duration:999999,Tags:["leesin.w","shield.all","new"],Passengers:[{id:"area_effect_cloud",Tags:["cd"],Duration:40,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID
    scoreboard players set @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all 250
    scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all
    tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new
}
