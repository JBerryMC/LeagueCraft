function passive.aa {
    execute if score @s stack_p matches 2 run scoreboard players add @s mana 40
    execute if score @s stack_p matches 1 run scoreboard players add @s mana 20

    scoreboard players remove @s stack_p 1
}

function passive.end {
    scoreboard players set @s stack_p 0
    scoreboard players remove @s aa.spd 20
    execute if entity @s[team=red] run kill @e[tag=leesin.passive.cd,tag=red]
    execute if entity @s[team=blue] run kill @e[tag=leesin.passive.cd,tag=blue]
}

function passive.start {
    scoreboard players set @s stack_p 2

    execute if entity @s[team=red] unless entity @e[tag=leesin.passive.cd,tag=red] run scoreboard players add @s aa.spd 20
    execute if entity @s[team=blue] unless entity @e[tag=leesin.passive.cd,tag=blue] run scoreboard players add @s aa.spd 20

    execute if entity @s[team=red] run kill @e[tag=leesin.passive.cd,tag=red]
    execute if entity @s[team=blue] run kill @e[tag=leesin.passive.cd,tag=blue]

    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:60,Tags:["leesin.passive.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:60,Tags:["leesin.passive.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function q.mark {
    ## RED
    execute if entity @s[tag=red,nbt=!{Age:59}] run scoreboard players set @e[tag=leesin.q.target.red,team=!red,type=#has_health_bar] fx.sight 2
    execute if entity @s[tag=red,nbt={Age:59}] run tag @e[tag=leesin.q.target.red,team=!red] remove leesin.q.target.red

    ## BLUE
    execute if entity @s[tag=blue,nbt=!{Age:59}] run scoreboard players set @e[tag=leesin.q.target,team=!blue,type=#has_health_bar] fx.sight 2
    execute if entity @s[tag=blue,nbt={Age:59}] run tag @e[tag=leesin.q.target,team=!blue] remove leesin.q.target

    execute if entity @s[type=player] run particle dust{color:[0.6,0.9,1],scale:0.5} ^ ^1 ^-0.4 0.1 0.2 0.1 1 50 force
}

function q.mark.model {
    execute as @e[tag=leesin.q.target.red,team=!red,limit=1] at @s anchored eyes run summon area_effect_cloud ^ ^ ^ {Tags:["temp_anchor","red"],Duration:1,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute as @e[tag=leesin.q.target.blue,team=!blue,limit=1] at @s anchored eyes run summon area_effect_cloud ^ ^ ^ {Tags:["temp_anchor","blue"],Duration:1,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[tag=red] store result score @s pos_x1 run data get entity @e[tag=leesin.q.target.red,team=!red,limit=1] Pos[0] 1000
    execute if entity @s[tag=red] store result score @s pos_y1 run data get entity @e[tag=temp_anchor,tag=red,limit=1,sort=nearest] Pos[1] 1000
    execute if entity @s[tag=red] store result score @s pos_z1 run data get entity @e[tag=leesin.q.target.red,team=!red,limit=1] Pos[2] 1000

    execute if entity @s[tag=blue] store result score @s pos_x1 run data get entity @e[tag=leesin.q.target.blue,team=!blue,limit=1] Pos[0] 1000
    execute if entity @s[tag=blue] store result score @s pos_y1 run data get entity @e[tag=temp_anchor,tag=blue,limit=1,sort=nearest] Pos[1] 1000
    execute if entity @s[tag=blue] store result score @s pos_z1 run data get entity @e[tag=leesin.q.target.blue,team=!blue,limit=1] Pos[2] 1000

    execute store result entity @s Pos[0] double 0.001 run scoreboard players get @s pos_x1
    execute store result entity @s Pos[1] double 0.001 run scoreboard players get @s pos_y1
    execute store result entity @s Pos[2] double 0.001 run scoreboard players get @s pos_z1

    execute if entity @s[tag=red] unless entity @e[tag=leesin.q.target.red,team=!red,limit=1] on passengers run kill @s
    execute if entity @s[tag=blue] unless entity @e[tag=leesin.q.target.blue,team=!blue,limit=1] on passengers run kill @s
}

