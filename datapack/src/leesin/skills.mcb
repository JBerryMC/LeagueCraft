# leesin:skills/  (converted from the 1.20.2 LeagueCraft datapack)

function e.damage {
    execute if entity @s[team=red] run damage @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players set @s dmg_magic.deal 135
    scoreboard players operation @s dmg_magic.deal += @s attack_damage

    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=leesin.e.mark,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!red] run function leesin:skills/e.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=leesin.e.mark,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!blue] run function leesin:skills/e.damage
}

function e.particle {
    execute if entity @s[nbt={Age:0}] positioned ~ ~0.4 ~ run function leesin:skills/e.particle.1
    execute if entity @s[nbt={Age:3}] positioned ~ ~0.3 ~ run function leesin:skills/e.particle.2
}

