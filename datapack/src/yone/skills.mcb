function r.damage {
    execute if entity @s[team=red] run damage @e[tag=yone.r.hit,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=yone.r.hit,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 300
    scoreboard players operation dmg temp = @s attack_damage
    scoreboard players operation dmg temp *= 40 integer
    scoreboard players operation dmg temp /= 100 integer

    scoreboard players operation @s dmg_physical.deal += dmg temp
    scoreboard players operation @s dmg_magic.deal = @s dmg_physical.deal

    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=yone.r.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=yone.r.hit,tag=temp_dmg,type=!#unvalid,team=!red] run function yone:skills/r.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=yone.r.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=yone.r.hit,tag=temp_dmg,type=!#unvalid,team=!blue] run function yone:skills/r.damage
}

function r.knockup {
    function _champion:cc/cancel
    scoreboard players set @s cc.airborne 15

    summon item ~ ~ ~ {Invulnerable:1,Age:5985,PickupDelay:32767,Motion:[0.0,0.35,0.0],Tags:["knockup","cc","temp"],Item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[9999f]}}}}
    data modify entity @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] Thrower set from entity @s UUID
    tag @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] remove temp
}

function w.animation {
    function yone:skills/w.particle
    execute rotated ~-12 ~ run function yone:skills/w.particle

    tp @s ~ ~ ~ ~-24 ~

    ## RED
    execute if entity @s[tag=red] positioned ^ ^ ^1 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!red,tag=!yone.w.hit] add yone.w.hit
    execute if entity @s[tag=red] positioned ^ ^ ^2 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!red,tag=!yone.w.hit] add yone.w.hit
    execute if entity @s[tag=red] positioned ^ ^ ^3 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!red,tag=!yone.w.hit] add yone.w.hit
    execute if entity @s[tag=red] positioned ^ ^ ^4 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!red,tag=!yone.w.hit] add yone.w.hit

    execute if entity @s[tag=red,nbt={Age:4}] on origin store result score @s yone.w.count run tag @e[tag=yone.w.hit,team=!red] add temp_dmg
    execute on origin if entity @e[tag=yone.w.hit,team=!red,tag=temp_dmg] run function yone:skills/w.damage
    execute if entity @s[tag=red,nbt={Age:4}] on origin if entity @s[team=red,tag=e.soul] run tag @e[tag=yone.w.hit,team=!red] add yone.e.mark

    execute if entity @s[tag=red,nbt={Age:4}] on origin if score @s yone.w.count matches 1.. run function yone:skills/w.shield.trigger
    execute if entity @s[tag=red,nbt={Age:4}] run tag @e[tag=yone.w.hit,team=!red] remove yone.w.hit

    ## BLUE
    execute if entity @s[tag=blue] positioned ^ ^ ^1 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!blue,tag=!yone.w.hit] add yone.w.hit
    execute if entity @s[tag=blue] positioned ^ ^ ^2 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!blue,tag=!yone.w.hit] add yone.w.hit
    execute if entity @s[tag=blue] positioned ^ ^ ^3 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!blue,tag=!yone.w.hit] add yone.w.hit
    execute if entity @s[tag=blue] positioned ^ ^ ^4 run tag @e[type=!#unvalid,tag=!unvalid,dx=0,team=!blue,tag=!yone.w.hit] add yone.w.hit

    execute if entity @s[tag=blue,nbt={Age:4}] on origin store result score @s yone.w.count run tag @e[tag=yone.w.hit,team=!blue] add temp_dmg
    execute on origin if entity @e[tag=yone.w.hit,team=!blue,tag=temp_dmg] run function yone:skills/w.damage
    execute if entity @s[tag=blue,nbt={Age:4}] on origin if entity @s[team=blue,tag=e.soul] run tag @e[tag=yone.w.hit,team=!blue] add yone.e.mark

    execute if entity @s[tag=blue,nbt={Age:4}] on origin if score @s yone.w.count matches 1.. run function yone:skills/w.shield.trigger
    execute if entity @s[tag=blue,nbt={Age:4}] run tag @e[tag=yone.w.hit,team=!blue] remove yone.w.hit
}

function w.damage {
    execute if entity @s[team=red] run damage @e[tag=yone.w.hit,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=yone.w.hit,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 25
    execute if entity @s[team=red] run scoreboard players operation dmg temp = @e[tag=yone.w.hit,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] hp.max
    execute if entity @s[team=blue] run scoreboard players operation dmg temp = @e[tag=yone.w.hit,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] hp.max
    scoreboard players operation dmg temp *= 8 integer
    scoreboard players operation dmg temp /= 100 integer

    scoreboard players operation @s dmg_physical.deal += dmg temp
    scoreboard players operation @s dmg_magic.deal = @s dmg_physical.deal

    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=yone.w.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=yone.w.hit,tag=temp_dmg,type=!#unvalid,team=!red] run function yone:skills/w.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.w.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=yone.w.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=yone.w.hit,tag=temp_dmg,type=!#unvalid,team=!blue] run function yone:skills/w.damage
}

function w.particle {
    particle dust{color:[1,0.75,0.75],scale:1} ^ ^ ^1 0.2 0 0.2 1 5 force
    particle dust{color:[1,0.75,0.75],scale:1} ^ ^ ^1.25 0.2 0 0.2 1 5 force

    particle dust{color:[1,0.5,0.5],scale:1} ^ ^ ^1.5 0.2 0 0.2 1 5 force
    particle dust{color:[1,0.5,0.5],scale:1} ^ ^ ^1.75 0.2 0 0.2 1 5 force

    particle dust{color:[1,0.25,0.25],scale:1} ^ ^ ^2 0.2 0 0.2 1 5 force
    particle dust{color:[1,0.25,0.25],scale:1} ^ ^ ^2.25 0.2 0 0.2 1 5 force

    particle dust{color:[1,0,0],scale:1} ^ ^ ^2.5 0.2 0 0.2 1 5 force
    particle dust{color:[1,0,0],scale:1} ^ ^ ^2.75 0.2 0 0.2 1 5 force

    particle dust{color:[0.75,0,0],scale:1} ^ ^ ^3 0.2 0 0.2 1 5 force
    particle dust{color:[0.75,0,0],scale:1} ^ ^ ^3.25 0.2 0 0.2 1 5 force

    particle dust{color:[0.5,0,0],scale:1} ^ ^ ^3.5 0.2 0 0.2 1 5 force
    particle dust{color:[0.5,0,0],scale:1} ^ ^ ^3.75 0.2 0 0.2 1 5 force

    particle dust{color:[0.25,0,0],scale:1} ^ ^ ^4 0.2 0 0.2 1 5 force
}

function w.shield.particle {
    particle dust{color:[1,0.75,0.75],scale:1} ^ ^1 ^0.1 0 0 0 1 1 force

    particle dust{color:[1,0.5,0.5],scale:1} ^ ^0.9 ^0.2 0 0 0 1 1 force
    particle dust{color:[1,0.5,0.5],scale:1} ^ ^0.8 ^0.5 0 0 0 1 1 force

    particle dust{color:[1,0.5,0.5],scale:1} ^ ^0.7 ^0.7 0 0 0 1 1 force

    particle dust{color:[1,0.25,0.25],scale:1} ^ ^0.5 ^0.8 0 0 0 1 1 force
    particle dust{color:[1,0.25,0.25],scale:1} ^ ^0.2 ^0.9 0 0 0 1 1 force

    particle dust{color:[1,0,0],scale:1} ^ ^ ^1 0 0 0 1 1 force

    particle dust{color:[0.75,0,0],scale:1} ^ ^-0.2 ^0.9 0 0 0 1 1 force
    particle dust{color:[0.75,0,0],scale:1} ^ ^-0.5 ^0.8 0 0 0 1 1 force

    particle dust{color:[0.5,0,0],scale:1} ^ ^-0.7 ^0.7 0 0 0 1 1 force

    particle dust{color:[0.5,0,0],scale:1} ^ ^-0.8 ^0.5 0 0 0 1 1 force
    particle dust{color:[0.5,0,0],scale:1} ^ ^-0.9 ^0.2 0 0 0 1 1 force

    particle dust{color:[0.25,0,0],scale:1} ^ ^-1 ^0.1 0 0 0 1 1 force
}

function w.shield.trigger {
    tag @s add update.shield.yone
    summon area_effect_cloud ~ ~ ~ {Duration:999999,Tags:["shield.all","new"],Passengers:[{id:"area_effect_cloud",Tags:["cd"],Duration:40,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID

    ## 65% AD to shield
    scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all = @s attack_damage
    scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all *= 65 integer
    scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all /= 100 integer

    ## 80 base shield
    scoreboard players add @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all 80

    ## Double the shield if hits 2 or more targets
    execute if score @s yone.w.count matches 2.. run scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all *= 2 integer

    scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all

    tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new
}
