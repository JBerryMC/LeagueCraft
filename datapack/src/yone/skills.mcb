    execute if entity @s[tag=blue,nbt={Age:19}] positioned as @e[tag=yone.r.animation,tag=blue,type=minecraft:area_effect_cloud] run summon minecraft:area_effect_cloud ^-1 ^0.5 ^ {Duration:20,Tags:["yone.r.particle","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=blue,nbt={Age:19}] positioned as @e[tag=yone.r.animation,tag=blue,type=minecraft:area_effect_cloud] run summon minecraft:area_effect_cloud ^-1.5 ^0.5 ^ {Duration:20,Tags:["yone.r.particle","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=blue,nbt={Age:19}] as @e[tag=yone.r.mark,tag=blue,type=minecraft:area_effect_cloud,limit=1,sort=nearest] at @s run function yone:skills/r.animation
