    execute if entity @s[tag=red,nbt={Age:19}] positioned as @e[tag=yone.r.animation,tag=red,type=minecraft:area_effect_cloud] run summon minecraft:area_effect_cloud ^1 ^0.5 ^ {Duration:20,Tags:["yone.r.particle","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
