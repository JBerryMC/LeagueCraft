# soraka:  (converted from the 1.20.2 LeagueCraft datapack)

function aa {
    playsound soraka.sfx.aa master @a ~ ~ ~

    execute if entity @s[team=red] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.soraka","aa","homing","red","temp","block_by_windwall"],item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.soraka","aa","homing","blue","temp","block_by_windwall"],item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:soraka"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:soraka/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:soraka/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:soraka/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:soraka/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:soraka/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function _champion:hud

    ## P
    execute if entity @s[tag=passive.active] run scoreboard players set @s status.p 1

    ## W
    execute if score @s hp.percentage matches ..4 run scoreboard players set @s status.w 8

    function soraka:hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=soraka.q.projectile,type=area_effect_cloud] at @s run function soraka:skills/q.projectile

    execute as @e[tag=soraka.e,type=item_display] at @s run function soraka:skills/e.animation

    execute as @e[tag=soraka.fx,type=area_effect_cloud] at @s run function soraka:skills/r.cast
}

function main {
    ## HUD
    function soraka:hud_display

    ## Item Handling
    execute unless predicate _champion:slot/head run function soraka:item/headwear
    execute unless predicate _champion:slot/offhand run function soraka:item/offhand

    function soraka:passive

    ## Re-use
    execute if predicate _champion:hold_q if score @s use_ability matches 1.. run function _champion:abilities/use_q
    execute if predicate _champion:hold_w if score @s use_ability matches 1.. run function _champion:abilities/use_w
    execute if predicate _champion:hold_e if score @s use_ability matches 1.. run function _champion:abilities/use_e
    execute if predicate _champion:hold_r if score @s use_ability matches 1.. run function _champion:abilities/use_r

    ## First use
    execute if predicate _champion:use_q run function _champion:abilities/use_q

    execute if predicate _champion:use_w run function _champion:abilities/use_w

    execute if predicate _champion:use_e run function _champion:abilities/use_e

    execute if predicate _champion:use_r run function _champion:abilities/use_r
}

function passive {
    execute if entity @s[team=red] if predicate soraka:look_at_red run tag @s add passive.active
    execute if entity @s[team=red] if predicate soraka:look_at_red run effect give @s speed 1 9 false
    execute if entity @s[team=red] if predicate soraka:look_at_red anchored feet run particle instant_effect ^ ^ ^ 0.2 0.1 0.2 1 2 force

    execute if entity @s[team=red] unless predicate soraka:look_at_red run effect clear @s[tag=passive.active] speed
    execute if entity @s[team=red] unless predicate soraka:look_at_red run tag @s[tag=passive.active] remove passive.active

    execute if entity @s[team=blue] if predicate soraka:look_at_red run tag @s add passive.active
    execute if entity @s[team=blue] if predicate soraka:look_at_red run effect give @s speed 1 9 false
    execute if entity @s[team=blue] if predicate soraka:look_at_red anchored feet run particle instant_effect ^ ^ ^ 0.2 0.1 0.2 1 2 force

    execute if entity @s[team=blue] unless predicate soraka:look_at_red run effect clear @s[tag=passive.active] speed
    execute if entity @s[team=blue] unless predicate soraka:look_at_red run tag @s[tag=passive.active] remove passive.active
}

function use_e {
    function _champion:abilities/cooldown/e

    scoreboard players set @s channeling 5

    execute anchored eyes positioned ^ ^ ^9.25 run summon area_effect_cloud ~ ~ ~ {Duration:2,Tags:["soraka.e.position"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute anchored eyes positioned ^ ^ ^9.25 run data modify entity @e[tag=soraka.e.position,type=area_effect_cloud,limit=1,sort=nearest] Owner set from entity @s UUID
    execute anchored eyes positioned ^ ^ ^9.25 as @e[tag=soraka.e.position,type=area_effect_cloud,limit=1,sort=nearest] at @s run function soraka:skills/e.position
}

function use_q {
    function _champion:abilities/cooldown/q
    playsound soraka.sfx.q master @a ~ ~ ~
    scoreboard players set @s channeling 5

    execute anchored eyes positioned ^ ^ ^8 run summon area_effect_cloud ~ ~ ~ {Duration:2,Tags:["soraka.q.position"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute anchored eyes positioned ^ ^ ^8 run data modify entity @e[tag=soraka.q.position,type=area_effect_cloud,limit=1,sort=nearest] Owner set from entity @s UUID
    execute anchored eyes positioned ^ ^ ^8 as @e[tag=soraka.q.position,type=area_effect_cloud,limit=1,sort=nearest] at @s run function soraka:skills/q.position

    execute if entity @s[team=red] anchored eyes run summon area_effect_cloud ^ ^3 ^ {Duration:20,Tags:["soraka.q.projectile","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] anchored eyes run summon area_effect_cloud ^ ^3 ^ {Duration:20,Tags:["soraka.q.projectile","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_r {
    function _champion:abilities/cooldown/r

    playsound minecraft:soraka.sfx.r master @a ~ ~ ~
    playsound minecraft:soraka.ultimate master @a ~ ~ ~

    scoreboard players set @s channeling 5

    execute if entity @s[team=red] as @e[tag=champion,team=red,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] at @s anchored eyes run summon area_effect_cloud ^ ^-0.5 ^ {Duration:12,Tags:["soraka.r.fx","soraka.fx"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] as @e[tag=champion,team=blue,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] at @s anchored eyes run summon area_effect_cloud ^ ^-0.5 ^ {Duration:12,Tags:["soraka.r.fx","soraka.fx"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[team=red] run tag @e[tag=champion,team=red,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] add is_heal_target
    execute if entity @s[team=blue] run tag @e[tag=champion,team=blue,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] add is_heal_target
    function soraka:skills/r.healing
}

function use_w {
    function _champion:abilities/cooldown/w
    scoreboard players set @s channeling 5

    playsound minecraft:soraka.sfx.w master @a ~ ~ ~

    scoreboard players operation soraka.w.hp_cost temp = @s hp.max
    execute unless score @s soraka.passive matches 1.. run scoreboard players operation soraka.w.hp_cost temp *= 10 integer
    execute if score @s soraka.passive matches 1.. run scoreboard players operation soraka.w.hp_cost temp *= 2 integer
    scoreboard players operation soraka.w.hp_cost temp /= 100 integer

    execute if score @s hp.left > soraka.w.hp_cost temp run scoreboard players operation @s hp.left -= soraka.w.hp_cost temp
    execute if score @s hp.left <= soraka.w.hp_cost temp run scoreboard players set @s hp.left 1

    execute at @e[tag=soraka.w.temp_target] anchored eyes run summon area_effect_cloud ^ ^-0.5 ^ {Duration:5,Tags:["soraka.w.fx","soraka.fx"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[team=red,scores={soraka.passive=1..}] run scoreboard players set @e[tag=soraka.w.temp_target,team=red,type=!#unvalid] soraka.passive 3
    execute if entity @s[team=red] run tag @e[tag=soraka.w.temp_target,team=red,type=!#unvalid] add is_heal_target

    execute if entity @s[team=blue,scores={soraka.passive=1..}] run scoreboard players set @e[tag=soraka.w.temp_target,team=blue,type=!#unvalid] soraka.passive 3
    execute if entity @s[team=blue] run tag @e[tag=soraka.w.temp_target,team=blue,type=!#unvalid] add is_heal_target

    function soraka:skills/w.healing
}

function use_w.check {
    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!soraka.w.temp_target,tag=!soraka] add soraka.w.temp_target

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=champion,dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,tag=!soraka] at @s run function soraka:use_w

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,limit=1,sort=nearest,tag=!soraka] remove soraka.w.temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!soraka.w.temp_target,tag=!soraka] add soraka.w.temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=champion,dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,tag=!soraka] at @s run function soraka:use_w

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,limit=1,sort=nearest,tag=!soraka] remove soraka.w.temp_target

    execute if entity @s[distance=..6] if score @s cd_w matches 0 positioned ^ ^ ^0.1 run function soraka:use_w.check
}

predicate look_at_blue {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:type_specific/player": {
            "looking_at": {
                "minecraft:nbt": "{Tags:[\"is_low_hp\"]}",
                "minecraft:team": "blue",
                "minecraft:distance": {
                    "absolute": {
                        "min": 0,
                        "max": 25
                    }
                }
            }
        },
        "minecraft:team": "blue"
    }
}

predicate look_at_red {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:type_specific/player": {
            "looking_at": {
                "minecraft:nbt": "{Tags:[\"is_low_hp\"]}",
                "minecraft:team": "red",
                "minecraft:distance": {
                    "absolute": {
                        "min": 0,
                        "max": 25
                    }
                }
            }
        },
        "minecraft:team": "red"
    }
}
