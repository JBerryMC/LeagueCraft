# ezreal:skills/  (converted from the 1.20.2 LeagueCraft datapack)

function e.animation {
    execute if block ~ ~ ~ #like_air on passengers as @s[tag=e.blink] on origin unless predicate _lol:is_flying if data entity @s RootVehicle on vehicle run function ezreal:skills/e.blink

    execute if block ~ ~ ~ #like_air on passengers as @s[tag=e.blink] on origin unless predicate _lol:is_flying if data entity @s RootVehicle.Entity{Tags:["interrupt_by_blink"]} on vehicle run function _animation:abilities/interrupt
    execute if block ~ ~ ~ #like_air on passengers as @s[tag=e.blink] on origin if predicate _lol:is_flying if data entity @s RootVehicle.Entity{Tags:["interrupt_by_blink"]} on vehicle on vehicle run function _animation:abilities/interrupt
    execute if block ~ ~ ~ #like_air on passengers as @s[tag=e.blink] on origin if predicate _lol:is_flying unless data entity @s RootVehicle.Entity{Tags:["interrupt_by_blink"]} on vehicle run function ezreal:skills/e.blink

    execute if block ~ ~ ~ #like_air on passengers as @s[tag=e.blink] on origin unless data entity @s RootVehicle run function ezreal:skills/e.blink

    execute unless block ~ ~ ~ #like_air positioned ~ ~1 ~ run function ezreal:skills/e.animation
}

function e.blink {
    execute if entity @s[team=red] positioned ~-3 ~-3 ~-3 if entity @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=5,tag=ezreal.w.target] positioned ~3 ~3 ~3 run tag @e[team=!red,tag=ezreal.w.target,limit=1,sort=nearest] add ezreal.e.target
    execute if entity @s[team=red] unless entity @e[team=!red,tag=ezreal.e.target] positioned ~-3 ~-3 ~-3 if entity @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=5] positioned ~3 ~3 ~3 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add ezreal.e.target
    execute if entity @s[team=red] if entity @e[team=!red,tag=ezreal.e.target] run function ezreal:skills/e.spawn

    execute if entity @s[team=blue] positioned ~-3 ~-3 ~-3 if entity @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=5,tag=ezreal.w.target] positioned ~3 ~3 ~3 run tag @e[team=!blue,tag=ezreal.w.target,limit=1,sort=nearest] add ezreal.e.target
    execute if entity @s[team=blue] unless entity @e[team=!blue,tag=ezreal.e.target] positioned ~-3 ~-3 ~-3 if entity @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=5] positioned ~3 ~3 ~3 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add ezreal.e.target
    execute if entity @s[team=blue] if entity @e[team=!blue,tag=ezreal.e.target] run function ezreal:skills/e.spawn

    tp @s ~ ~0.5 ~
    particle falling_dust{block_state:"gold_block"} ^ ^1 ^ 0.2 0.5 0.2 0.09 10 force
    particle block{block_state:"gold_block"} ^ ^1 ^ 0.2 0.5 0.2 0.09 10 force
    particle end_rod ^ ^1 ^ 0.2 0.2 0.2 0.09 10 force
    particle wax_on ^ ^1 ^ 0.2 0.2 0.2 0.09 10 force
}

function e.damage {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=ezreal.e.target,limit=1,sort=nearest] 1 _lol:dmg_magic by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=ezreal.e.target,limit=1,sort=nearest] 1 _lol:dmg_magic by @s

    scoreboard players operation temp attack_damage = @s attack_damage
    scoreboard players operation temp attack_damage *= 50 integer
    scoreboard players operation temp attack_damage /= 100 integer

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 75 integer
    scoreboard players operation temp ability_power /= 100 integer

    scoreboard players operation temp attack_damage += temp ability_power
    scoreboard players add temp attack_damage 280

    scoreboard players operation @s dmg_magic.deal = temp attack_damage
    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ezreal.e.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ezreal.e.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=ezreal.e.target,limit=1,sort=nearest] remove ezreal.e.target

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ezreal.e.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ezreal.e.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=ezreal.e.target,limit=1,sort=nearest] remove ezreal.e.target
}

function e.hit {
    playsound ezreal.sfx.e.missile master @a ~ ~ ~
    execute if entity @s[team=red] run function ezreal:passive
    execute if entity @s[team=red] if entity @e[tag=ezreal.e.target,team=!red,tag=ezreal.w.target] positioned as @e[tag=ezreal.e.target,team=!red,tag=ezreal.w.target,limit=1] run function ezreal:skills/w.detonate
    execute if entity @s[team=red] if entity @e[tag=ezreal.e.target,team=!red] as @p[tag=ezreal,team=red] run function ezreal:skills/e.damage

    execute if entity @s[team=blue] run function ezreal:passive
    execute if entity @s[team=blue] if entity @e[tag=ezreal.e.target,team=!blue,tag=ezreal.w.target] positioned as @e[tag=ezreal.e.target,team=!blue,tag=ezreal.w.target,limit=1] run function ezreal:skills/w.detonate
    execute if entity @s[team=blue] if entity @e[tag=ezreal.e.target,team=!blue] as @p[tag=ezreal,team=blue] run function ezreal:skills/e.damage
}

function e.spawn {
    execute if entity @s[team=red] run summon item_display ~ ~1 ~ {teleport_duration:1,Tags:["can_reveal","ezreal.e.missile","homing","red","temp"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run summon item_display ~ ~1 ~ {teleport_duration:1,Tags:["can_reveal","ezreal.e.missile","homing","blue","temp"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute at @s run summon area_effect_cloud ~ ~ ~ {Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

    execute if entity @s[team=red] as @e[tag=ezreal.e.missile,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
    execute if entity @s[team=blue] as @e[tag=ezreal.e.missile,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner

    execute if entity @s[team=red] as @e[tag=ezreal.e.missile,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[team=!red,tag=ezreal.e.target,limit=1,sort=nearest] UUID
    execute if entity @s[team=red] run tag @e[tag=ezreal.e.missile,tag=temp,tag=red,limit=1,sort=nearest] remove temp

    execute if entity @s[team=blue] as @e[tag=ezreal.e.missile,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[team=!blue,tag=ezreal.e.target,limit=1,sort=nearest] UUID
    execute if entity @s[team=blue] run tag @e[tag=ezreal.e.missile,tag=temp,tag=blue,limit=1,sort=nearest] remove temp
}

function passive.stack.lost {
    scoreboard players remove @s ezreal.p.stack 1
    scoreboard players remove @s aa.spd 3
    execute if score @s[team=red] ezreal.p.stack matches 1.. run summon area_effect_cloud ~ ~ ~ {Duration:20,Tags:["ezreal.p.stack.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if score @s[team=blue] ezreal.p.stack matches 1.. run summon area_effect_cloud ~ ~ ~ {Duration:20,Tags:["ezreal.p.stack.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function q.animation {
    tp @s ^ ^ ^2 ~ ~
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^0.5 0 0 0 0 1 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^0.75 0 0 0 0 1 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1 0.05 0.05 0.05 0 2 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1.25 0.05 0.05 0.05 0 2 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1.5 0.1 0.1 0.1 0 3 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1.75 0.05 0.05 0.05 0 2 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^2 0.05 0.05 0.05 0 2 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^2.25 0 0 0 0 1 force
    particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^2.5 0 0 0 0 1 force

    particle end_rod 0.5 0.7 1 ^ ^ ^2.5 0.05 5 force

    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!red,dx=0,type=!#unvalid,tag=!unvalid] run tag @e[team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add ezreal.q.hit
    execute if entity @s[tag=red] unless entity @e[tag=ezreal.q.hit,team=!red] positioned ^ ^ ^-1 positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!red,dx=0,type=!#unvalid,tag=!unvalid] run tag @e[team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add ezreal.q.hit

    execute if entity @s[tag=red] if entity @e[tag=ezreal.q.hit,team=!red] run function ezreal:skills/q.hit

    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!blue,dx=0,type=!#unvalid,tag=!unvalid] run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add ezreal.q.hit
    execute if entity @s[tag=blue] unless entity @e[tag=ezreal.q.hit,team=!blue] positioned ^ ^ ^-1 positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!blue,dx=0,type=!#unvalid,tag=!unvalid] run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add ezreal.q.hit

    execute if entity @s[tag=blue] if entity @e[tag=ezreal.q.hit,team=!blue] run function ezreal:skills/q.hit
}

function q.damage {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=ezreal.q.hit,limit=1,sort=nearest] 1 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=ezreal.q.hit,limit=1,sort=nearest] 1 _lol:dmg_physical by @s

    scoreboard players operation temp attack_damage = @s attack_damage
    scoreboard players operation temp attack_damage *= 130 integer
    scoreboard players operation temp attack_damage /= 100 integer

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 15 integer
    scoreboard players operation temp ability_power /= 100 integer

    scoreboard players operation temp attack_damage += temp ability_power
    scoreboard players add temp attack_damage 120

    scoreboard players operation @s dmg_physical.deal = temp attack_damage
    function _champion:aa/on_hit
    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ezreal.q.hit,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ezreal.q.hit,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=ezreal.q.hit,limit=1,sort=nearest] remove ezreal.q.hit

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ezreal.q.hit,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ezreal.q.hit,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=ezreal.q.hit,limit=1,sort=nearest] remove ezreal.q.hit
}

function q.hit {
    playsound ezreal.sfx.q.hit master @a ~ ~ ~

    execute if entity @s[tag=red] as @p[tag=ezreal,team=red] run function ezreal:skills/q.passive
    execute if entity @s[tag=red] as @p[tag=ezreal,team=red] run function ezreal:passive
    execute if entity @s[tag=red] if entity @e[tag=ezreal.q.hit,team=!red,tag=ezreal.w.target] as @p[tag=ezreal,team=red] positioned as @e[tag=ezreal.q.hit,team=!red,tag=ezreal.w.target,limit=1] run function ezreal:skills/w.detonate
    execute if entity @s[tag=red] if entity @e[tag=ezreal.q.hit,team=!red] as @p[tag=ezreal,team=red] run function ezreal:skills/q.damage

    execute if entity @s[tag=blue] as @p[tag=ezreal,team=blue] run function ezreal:skills/q.passive
    execute if entity @s[tag=blue] as @p[tag=ezreal,team=blue] run function ezreal:passive
    execute if entity @s[tag=blue] if entity @e[tag=ezreal.q.hit,team=!blue,tag=ezreal.w.target] as @p[tag=ezreal,team=blue] positioned as @e[tag=ezreal.q.hit,team=!blue,tag=ezreal.w.target,limit=1] run function ezreal:skills/w.detonate
    execute if entity @s[tag=blue] if entity @e[tag=ezreal.q.hit,team=!blue] as @p[tag=ezreal,team=blue] run function ezreal:skills/q.damage

    kill @s
}

function q.passive {
    scoreboard players remove @s[scores={cd_q=1..}] cd_q 1
    scoreboard players remove @s[scores={cd_w=1..}] cd_w 1
    scoreboard players remove @s[scores={cd_e=1..}] cd_e 1
    scoreboard players remove @s[scores={cd_r=1..}] cd_r 1
}

function r.animation {
    tp @s ^ ^ ^2.5

    particle minecraft:dust{color:[1,1,0],scale:0.5} ^ ^ ^ 0.7 0.5 0.7 1 150 force
    particle minecraft:dust{color:[1,1,0],scale:0.5} ^1.5 ^ ^-1.5 0.2 0.1 0.2 1 100 force
    particle minecraft:dust{color:[1,1,0],scale:0.5} ^-1.5 ^ ^-1.5 0.2 0.1 0.2 1 50 force
    particle minecraft:dust{color:[1,1,0],scale:0.5} ^-1.5 ^ ^-2.25 0.1 0.1 0.1 1 10 force
    particle minecraft:dust{color:[1,1,0],scale:0.5} ^1.5 ^ ^-2.25 0.1 0.1 0.1 1 5 force

    particle minecraft:end_rod ^ ^ ^ 0.7 0.000001 0.7 0 50 force
    particle minecraft:wax_on ^ ^ ^ 0.7 0.000001 0.7 0 100 force

    execute if entity @s[tag=red] positioned ~-1.5 ~-1 ~-1.5 if entity @e[team=!red,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] as @p[tag=ezreal,team=red] run function ezreal:passive
    execute if entity @s[tag=red] positioned ~-1.5 ~-1 ~-1.5 run scoreboard players add @e[team=!red,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] fx.sight 10
    execute if entity @s[tag=red] positioned ~-1.5 ~-1 ~-1.5 as @e[team=!red,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] at @s run playsound ezreal.sfx.r.hit master @a ~ ~ ~
    execute if entity @s[tag=red] positioned ~-1.5 ~-1 ~-1.5 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] add ezreal.r.hit
    execute if entity @s[tag=red] if entity @e[tag=ezreal.r.hit,team=!red,tag=ezreal.w.target] as @p[tag=ezreal,team=red] positioned as @e[tag=ezreal.r.hit,team=!red,tag=ezreal.w.target,limit=1] run function ezreal:skills/w.detonate
    execute if entity @s[tag=red] if entity @e[tag=ezreal.r.hit,team=!red] run tag @e[tag=ezreal.r.hit,team=!red,tag=!ezreal.r.damage] add r_temp_dmg
    execute if entity @s[tag=red] if entity @e[tag=ezreal.r.hit,team=!red] as @p[tag=ezreal,team=red] run function ezreal:skills/r.damage
    execute if entity @s[tag=red] if entity @e[tag=ezreal.r.hit,team=!red] run tag @e[tag=ezreal.r.hit,team=!red,tag=!ezreal.r.damage] add ezreal.r.damage
    execute if entity @s[tag=red] if entity @e[tag=ezreal.r.hit,team=!red] run tag @e[tag=ezreal.r.hit,team=!red,tag=ezreal.r.damage] remove ezreal.r.hit

    execute if entity @s[tag=blue] positioned ~-1.5 ~-1 ~-1.5 if entity @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] as @p[tag=ezreal,team=blue] run function ezreal:passive
    execute if entity @s[tag=blue] positioned ~-1.5 ~-1 ~-1.5 run scoreboard players add @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] fx.sight 10
    execute if entity @s[tag=blue] positioned ~-1.5 ~-1 ~-1.5 as @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] at @s run playsound ezreal.sfx.r.hit master @a ~ ~ ~
    execute if entity @s[tag=blue] positioned ~-1.5 ~-1 ~-1.5 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=!ezreal.r.hit,dx=2,dz=2,dy=1] add ezreal.r.hit
    execute if entity @s[tag=blue] if entity @e[tag=ezreal.r.hit,team=!blue,tag=ezreal.w.target] as @p[tag=ezreal,team=blue] positioned as @e[tag=ezreal.r.hit,team=!blue,tag=ezreal.w.target,limit=1] run function ezreal:skills/w.detonate
    execute if entity @s[tag=blue] if entity @e[tag=ezreal.r.hit,team=!blue] run tag @e[tag=ezreal.r.hit,team=!blue,tag=!ezreal.r.damage] add r_temp_dmg
    execute if entity @s[tag=blue] if entity @e[tag=ezreal.r.hit,team=!blue] as @p[tag=ezreal,team=blue] run function ezreal:skills/r.damage
    execute if entity @s[tag=blue] if entity @e[tag=ezreal.r.hit,team=!blue] run tag @e[tag=ezreal.r.hit,team=!blue,tag=!ezreal.r.damage] add ezreal.r.damage
    execute if entity @s[tag=blue] if entity @e[tag=ezreal.r.hit,team=!blue] run tag @e[tag=ezreal.r.hit,team=!blue,tag=ezreal.r.damage] remove ezreal.r.hit
}

function r.cast {
    #execute if entity @s[tag=mid] run particle minecraft:dust 1 1 0 1.5 ^ ^1 ^1 0 0 0 1 1 force
    execute if entity @s[tag=left] run particle minecraft:dust{color:[1,1,0],scale:1} ^0.5 ^ ^1 0 0 0 1 1 force
    execute if entity @s[tag=right] run particle minecraft:dust{color:[1,1,0],scale:1} ^-0.5 ^ ^1 0 0 0 1 1 force

    execute if entity @s[tag=left] run tp @s ~ ~ ~ ~6 ~
    execute if entity @s[tag=right] run tp @s ~ ~ ~ ~-6 ~

    execute if entity @s[nbt={Age:19},tag=red,tag=mid] run scoreboard players set @p[tag=ezreal,team=red] status.weapon 700101
    execute if entity @s[nbt={Age:19},tag=red,tag=mid] run tag @p[tag=ezreal,team=red] remove r.animation
    execute if entity @s[nbt={Age:19},tag=red,tag=mid] run summon item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[700401f]}}},Tags:["ezreal.r","red","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:100,Tags:["cd","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[nbt={Age:19},tag=red,tag=mid] run tp @e[tag=red,tag=ezreal.r,limit=1,sort=nearest] ~ ~ ~ ~ ~

    execute if entity @s[nbt={Age:19},tag=blue,tag=mid] run scoreboard players set @p[tag=ezreal,team=blue] status.weapon 700101
    execute if entity @s[nbt={Age:19},tag=blue,tag=mid] run tag @p[tag=ezreal,team=blue] remove r.animation
    execute if entity @s[nbt={Age:19},tag=blue,tag=mid] run summon item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[700401f]}}},Tags:["ezreal.r","blue","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:100,Tags:["cd","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[nbt={Age:19},tag=blue,tag=mid] run tp @e[tag=blue,tag=ezreal.r,limit=1,sort=nearest] ~ ~ ~ ~ ~
}

function r.clear {
    execute if entity @s[tag=red] run tag @e[tag=ezreal.r.damage,team=!red] remove ezreal.r.damage
    execute if entity @s[team=red] run tag @e[tag=ezreal.r.damage,team=!red] remove ezreal.r.damage

    execute if entity @s[tag=blue] run tag @e[tag=ezreal.r.damage,team=!blue] remove ezreal.r.damage
    execute if entity @s[team=blue] run tag @e[tag=ezreal.r.damage,team=!blue] remove ezreal.r.damage
}

function r.damage {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=r_temp_dmg,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=r_temp_dmg,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players operation temp attack_damage = @s attack_damage

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 90 integer
    scoreboard players operation temp ability_power /= 100 integer

    scoreboard players operation temp attack_damage += temp ability_power
    scoreboard players add temp attack_damage 675

    scoreboard players operation @s dmg_magic.deal = temp attack_damage
    function _champion:dmg/calc.debuff

    ## RED

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=r_temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=r_temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=r_temp_dmg,limit=1,sort=nearest] remove r_temp_dmg

    ## BLUE

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=r_temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=r_temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=r_temp_dmg,limit=1,sort=nearest] remove r_temp_dmg
}

function w.animation {
    tp @s ^ ^ ^1.75
    particle minecraft:dust{color:[1,1,0],scale:1} ^ ^ ^ 0.5 0.1 0.5 1 10 force

    execute if entity @s[tag=red] positioned ~-1 ~-0.5 ~-1 as @e[tag=!red,dx=1,dz=1,dy=0,tag=lol.structure,limit=1,sort=nearest,tag=!is_destroyed] at @s run function ezreal:skills/w.mark
    execute if entity @s[tag=red] if entity @e[tag=!red,tag=ezreal.w.target,tag=lol.structure,limit=1,sort=nearest] run kill @s

    execute if entity @s[tag=blue] positioned ~-1 ~-0.5 ~-1 as @e[tag=!blue,dx=1,dz=1,dy=0,tag=lol.structure,limit=1,sort=nearest,tag=!is_destroyed] at @s run function ezreal:skills/w.mark
    execute if entity @s[tag=blue] if entity @e[tag=!blue,tag=ezreal.w.target,tag=lol.structure,limit=1,sort=nearest] run kill @s

    execute if entity @s[tag=red] positioned ~-1 ~-0.5 ~-1 as @e[tag=champion,team=!red,dx=1,dz=1,dy=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=has_health_bar] at @s run function ezreal:skills/w.mark
    execute if entity @s[tag=red] if entity @e[team=!red,tag=ezreal.w.target,type=!#unvalid,tag=!unvalid] as @p[team=red,tag=ezreal] run function ezreal:passive
    execute if entity @s[tag=red] if entity @e[team=!red,tag=ezreal.w.target,type=!#unvalid,tag=!unvalid] run kill @s

    execute if entity @s[tag=blue] positioned ~-1 ~-0.5 ~-1 as @e[tag=champion,team=!blue,dx=1,dz=1,dy=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=has_health_bar] at @s run function ezreal:skills/w.mark
    execute if entity @s[tag=blue] if entity @e[team=!blue,tag=ezreal.w.target,type=!#unvalid,tag=!unvalid] as @p[team=blue,tag=ezreal] run function ezreal:passive
    execute if entity @s[tag=blue] if entity @e[team=!blue,tag=ezreal.w.target,type=!#unvalid,tag=!unvalid] run kill @s
}

function w.damage {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=w_temp_dmg,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=w_temp_dmg,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players operation temp attack_damage = @s attack_damage

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 90 integer
    scoreboard players operation temp ability_power /= 100 integer

    scoreboard players operation temp attack_damage += temp ability_power
    scoreboard players add temp attack_damage 300

    scoreboard players operation @s dmg_magic.deal = temp attack_damage
    function _champion:dmg/calc.debuff

    ## RED

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] run function _champion:dmg/calc.magic
    execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] run function _champion:dmg/taken/magic
    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] remove w_temp_dmg

    ## BLUE

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] run function _champion:dmg/calc.magic
    execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] run function _champion:dmg/taken/magic
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] remove w_temp_dmg
}

function w.damage_structure {
    execute if entity @s[team=red] run damage @e[tag=!red,type=!#unvalid,tag=w_temp_dmg,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=!blue,type=!#unvalid,tag=w_temp_dmg,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    particle firework ~ ~3 ~ 2 1 2 0.2 20 force
    particle minecraft:dust{color:[1,1,0],scale:4.0} ^ ^3 ^ 2 1 2 1 50 force

    scoreboard players operation temp attack_damage = @s attack_damage

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 90 integer
    scoreboard players operation temp ability_power /= 100 integer

    scoreboard players operation temp attack_damage += temp ability_power
    scoreboard players add temp attack_damage 300

    scoreboard players operation @s dmg_magic.deal = temp attack_damage
    function _champion:dmg/calc.debuff

    ## RED

    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] run tag @e[tag=!red,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] remove w_temp_dmg

    ## BLUE

    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] run tag @e[tag=!blue,tag=has_health_bar,tag=w_temp_dmg,limit=1,sort=nearest] remove w_temp_dmg
}

function w.detonate {
    playsound ezreal.sfx.w.detonate master @a ~ ~ ~
    particle firework ~ ~1 ~ 0 0 0 0.2 5 force
    particle minecraft:dust{color:[1,1,0],scale:2} ^ ^1 ^ 0.5 0.1 0.5 1 20 force

    execute if entity @s[team=red] run tag @e[team=!red,tag=ezreal.w.target] add w_temp_dmg
    execute if entity @s[team=red] run tag @e[tag=!red,tag=lol.structure,tag=ezreal.w.target] add w_temp_dmg
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=ezreal.w.target] add w_temp_dmg
    execute if entity @s[team=blue] run tag @e[tag=!blue,tag=lol.structure,tag=ezreal.w.target] add w_temp_dmg
    execute if entity @e[tag=w_temp_dmg,tag=!lol.structure] run function ezreal:skills/w.damage
    execute if entity @e[tag=w_temp_dmg,tag=lol.structure] run function ezreal:skills/w.damage_structure

    execute if entity @s[team=red] if entity @e[tag=ezreal.w.target,team=!red,tag=ezreal.q.hit] run scoreboard players add @s mana 100
    execute if entity @s[team=red] if entity @e[tag=ezreal.w.target,team=!red,tag=ezreal.e.target] run scoreboard players add @s mana 130
    execute if entity @s[team=red] if entity @e[tag=ezreal.w.target,team=!red,tag=ezreal.r.hit] run scoreboard players add @s mana 160

    execute if entity @s[team=red] run tag @p[team=!red,tag=ezreal.w.target] add remove.mark.ezreal.w
    execute if entity @s[team=red] as @e[team=!red,tag=ezreal.w.target,type=!player] on passengers as @s[tag=ezreal.w.mark] on passengers run kill @s
    execute if entity @s[team=red] as @e[team=!red,tag=ezreal.w.target,type=!player] on passengers as @s[tag=ezreal.w.mark] run kill @s
    execute if entity @s[team=red] as @e[tag=!red,tag=ezreal.w.target,type=interaction] on passengers as @s[tag=ezreal.w.mark] on passengers run kill @s
    execute if entity @s[team=red] as @e[tag=!red,tag=ezreal.w.target,type=interaction] on passengers as @s[tag=ezreal.w.mark] run kill @s

    execute if entity @s[team=red] run tag @e[team=!red,tag=ezreal.w.target] remove ezreal.w.target
    execute if entity @s[team=red] run tag @e[tag=!red,tag=lol.structure,tag=ezreal.w.target] remove ezreal.w.target

    execute if entity @s[team=blue] if entity @e[tag=ezreal.w.target,team=!blue,tag=ezreal.q.hit] run scoreboard players add @s mana 100
    execute if entity @s[team=blue] if entity @e[tag=ezreal.w.target,team=!blue,tag=ezreal.e.target] run scoreboard players add @s mana 130
    execute if entity @s[team=blue] if entity @e[tag=ezreal.w.target,team=!blue,tag=ezreal.r.hit] run scoreboard players add @s mana 160

    execute if entity @s[team=blue] run tag @p[team=!blue,tag=ezreal.w.target] add remove.mark.ezreal.w
    execute if entity @s[team=blue] as @e[team=!blue,tag=ezreal.w.target,type=!player] on passengers as @s[tag=ezreal.w.mark] on passengers run kill @s
    execute if entity @s[team=blue] as @e[team=!blue,tag=ezreal.w.target,type=!player] on passengers as @s[tag=ezreal.w.mark] run kill @s
    execute if entity @s[team=blue] as @e[tag=!blue,tag=ezreal.w.target,type=interaction] on passengers as @s[tag=ezreal.w.mark] on passengers run kill @s
    execute if entity @s[team=blue] as @e[tag=!blue,tag=ezreal.w.target,type=interaction] on passengers as @s[tag=ezreal.w.mark] run kill @s

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=ezreal.w.target] remove ezreal.w.target
    execute if entity @s[team=blue] run tag @e[tag=!blue,tag=lol.structure,tag=ezreal.w.target] remove ezreal.w.target
}

function w.end {
    execute if entity @s[tag=red] run tag @e[tag=ezreal.w.target,team=!red] remove ezreal.w.target
    execute if entity @s[tag=blue] run tag @e[tag=ezreal.w.target,team=!blue] remove ezreal.w.target
}

function w.mark {
    playsound ezreal.sfx.w.hit master @a ~ ~ ~
    tag @s add ezreal.w.target
    execute if entity @s[tag=has_display_bar] run tag @s add update.mark.ezreal.w

    execute if entity @s[type=!player] on passengers as @s[tag=ezreal.w.mark] on passengers run kill @s
    execute if entity @s[type=!player] on passengers as @s[tag=ezreal.w.mark] run kill @s
    execute if entity @s[type=!player] at @s run summon item_display ~ ~ ~ {interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[700211f]}}},Tags:["ezreal.w.mark","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:80,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[type=!player] run ride @e[type=item_display,tag=temp,tag=ezreal.w.mark,limit=1,sort=nearest] mount @s
    execute if entity @s[type=interaction] on passengers run data merge entity @s[tag=ezreal.w.mark] {transformation:{scale:[3.0,3.0,3.0],translation:[0.0,5.0,0.0]}}
}
