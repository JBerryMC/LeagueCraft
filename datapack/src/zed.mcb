# zed:  (converted from the 1.20.2 LeagueCraft datapack)

function aa {
    playsound zed.sfx.aa master @a ~ ~ ~
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:zed"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:zed/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:zed/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:zed/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:zed/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:zed/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function _champion:hud

    ## W shadow
    execute if entity @s[team=red,tag=!r.animation,tag=!cced] if entity @e[tag=w.shadow,tag=!blinked,tag=red,tag=zed.shadow] run scoreboard players set @s status.w 2
    execute if entity @s[team=red,tag=!r.animation,tag=!cced] if entity @e[tag=w.shadow,tag=!blinked,tag=red,tag=zed.shadow] if score @s cc.root matches 1.. run scoreboard players set @s status.w 9
    execute if entity @s[team=blue,tag=!r.animation,tag=!cced] if entity @e[tag=w.shadow,tag=!blinked,tag=blue,tag=zed.shadow] run scoreboard players set @s status.w 2
    execute if entity @s[team=blue,tag=!r.animation,tag=!cced] if entity @e[tag=w.shadow,tag=!blinked,tag=blue,tag=zed.shadow] if score @s cc.root matches 1.. run scoreboard players set @s status.w 9

    ## R shadow
    execute if entity @s[team=red,tag=!r.animation,tag=!cced] if entity @e[tag=r.shadow,tag=!blinked,tag=red,tag=zed.shadow] run scoreboard players set @s status.r 2
    execute if entity @s[team=red,tag=!r.animation,tag=!cced] if entity @e[tag=r.shadow,tag=!blinked,tag=red,tag=zed.shadow] if score @s cc.root matches 1.. run scoreboard players set @s status.r 9
    execute if entity @s[team=blue,tag=!r.animation,tag=!cced] if entity @e[tag=r.shadow,tag=!blinked,tag=blue,tag=zed.shadow] run scoreboard players set @s status.r 2
    execute if entity @s[team=blue,tag=!r.animation,tag=!cced] if entity @e[tag=r.shadow,tag=!blinked,tag=blue,tag=zed.shadow] if score @s cc.root matches 1.. run scoreboard players set @s status.r 9

    execute if score @s cc.root matches 1.. run scoreboard players set @s status.r 9

    function zed:hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=zed.q,type=minecraft:item_display] at @s run function zed:skills/q.passive
    tag @e[tag=blue.zed.q.target,type=#has_health_bar] remove blue.zed.q.target
    tag @e[tag=red.zed.q.target,type=#has_health_bar] remove red.zed.q.target

    execute as @e[tag=zed.shadow,type=minecraft:area_effect_cloud] at @s run function zed:skills/shadow.passive
    execute as @e[tag=zed.shadow.model,type=minecraft:armor_stand] at @s run function zed:skills/shadow.model

    execute as @e[tag=zed.e.particle,type=minecraft:area_effect_cloud] at @s run function zed:skills/e.particle

    ## R
    execute as @e[tag=zed.r.cd,type=minecraft:area_effect_cloud] at @s run function zed:skills/r.passive
    execute as @e[tag=zed.r.cast,type=minecraft:item_display] at @s run function zed:skills/r.animation
}

function main {
    # Cooldown
    #title @s actionbar [{"text":"\uE010"},{"score":{"name":"@s","objective":"mana"}},{"text":" \uE017"},{"score":{"name":"@s","objective":"cd_q"}},{"text":" \uE018"},{"score":{"name":"@s","objective":"cd_w"}},{"text":" \uE019"},{"score":{"name":"@s","objective":"cd_e"}},{"text":" \uE020"},{"score":{"name":"@s","objective":"cd_r"}}]
    #execute if score @s stack_p matches 1.. run title @s actionbar [{"text":"\uE010"},{"score":{"name":"@s","objective":"mana"}},{"text":" \uE015"},{"score":{"name":"@s","objective":"stack_p"}},{"text":" \uE011"},{"score":{"name":"@s","objective":"cd_q"}},{"text":" \uE012"},{"score":{"name":"@s","objective":"cd_w"}},{"text":" \uE013"},{"score":{"name":"@s","objective":"cd_e"}},{"text":" \uE014"},{"score":{"name":"@s","objective":"cd_r"}}]
    function zed:hud_display

    ## Item Handling
    execute unless predicate _champion:slot/head run function zed:item/headwear
    execute unless predicate _champion:slot/offhand run function zed:item/offhand

    # Passive

    ## Re-use
    execute if predicate _champion:hold_q if score @s use_ability matches 1.. run function _champion:abilities/use_q
    execute if predicate _champion:hold_w if score @s use_ability matches 1.. run function _champion:abilities/use_w
    execute if predicate _champion:hold_e if score @s use_ability matches 1.. run function _champion:abilities/use_e
    execute if predicate _champion:hold_r if score @s use_ability matches 1.. run function _champion:abilities/use_r

    ## First use
    execute if predicate _champion:use_q run function _champion:abilities/use_q

    execute if predicate _champion:use_w run function _champion:abilities/use_w

    execute if predicate _champion:use_e run function _champion:abilities/use_e

    execute if predicate _champion:use_r run function _champion:abilities/use_r
}

function passive {
    execute if entity @s[team=red] run scoreboard players set @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] zed_p_cd 10

    execute if entity @s[team=red] as @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] at @s run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force

    execute if entity @s[team=red] run scoreboard players operation zed.p.dmg temp = @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] hp.max

    execute if entity @s[team=blue] run scoreboard players set @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] zed_p_cd 10

    execute if entity @s[team=blue] as @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] at @s run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force

    execute if entity @s[team=blue] run scoreboard players operation zed.p.dmg temp = @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] hp.max

    scoreboard players operation zed.p.dmg temp *= 10 integer
    scoreboard players operation zed.p.dmg temp /= 100 integer

    scoreboard players operation @s dmg_magic.deal = zed.p.dmg temp

    execute if entity @s[team=red] if entity @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=zed.r.mark.red] run scoreboard players operation @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=zed.r.mark.red] zed.r.dmg += @s dmg_magic.deal
    execute if entity @s[team=blue] if entity @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=zed.r.mark.blue] run scoreboard players operation @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=zed.r.mark.blue] zed.r.dmg += @s dmg_magic.deal
}

function use_e {
    function _champion:abilities/cooldown/e

    function zed:skills/e.animation

    execute if entity @s[team=red] as @e[tag=zed.shadow.model,team=red] at @s run function zed:skills/e.animation
    execute if entity @s[team=red] run tag @e[tag=zed.shadow,tag=moving,tag=red] add e.buffer

    execute if entity @s[team=blue] as @e[tag=zed.shadow.model,team=blue] at @s run function zed:skills/e.animation
    execute if entity @s[team=blue] run tag @e[tag=zed.shadow,tag=moving,tag=blue] add e.buffer
}

function use_q {
    function _champion:abilities/cooldown/q
    scoreboard players set @s channeling 5

    execute anchored eyes positioned ^ ^ ^ run function zed:skills/q.spawn
    execute anchored eyes positioned ^ ^ ^ run function zed:skills/q.raycasting
    execute if entity @s[team=red] unless entity @e[tag=red.zed.q.target] as @e[tag=zed.shadow.model,team=red] at @s rotated as @p[tag=zed,team=red] run tp @s ~ ~ ~ ~ 0
    execute if entity @s[team=red] unless entity @e[tag=red.zed.q.target] anchored eyes positioned as @e[tag=zed.shadow.model,team=red] positioned ^ ^ ^ as @e[tag=zed.shadow.model,team=red] run function zed:skills/q.spawn.shadow

    execute if entity @s[team=red] if entity @e[tag=red.zed.q.target] as @e[tag=zed.shadow.model,team=red] at @s facing entity @e[tag=red.zed.q.target,limit=1] eyes run tp @s ~ ~ ~ ~ 0
    execute if entity @s[team=red] if entity @e[tag=red.zed.q.target] anchored eyes positioned as @e[tag=zed.shadow.model,team=red] positioned ^ ^ ^ facing entity @e[tag=red.zed.q.target,limit=1] eyes rotated ~ ~5 as @e[tag=zed.shadow.model,team=red] run function zed:skills/q.spawn.shadow

    execute if entity @s[team=red] run tag @e[tag=red.zed.q.target] remove red.zed.q.target

    execute if entity @s[team=blue] unless entity @e[tag=blue.zed.q.target] as @e[tag=zed.shadow.model,team=blue] at @s rotated as @p[tag=zed,team=blue] run tp @s ~ ~ ~ ~ 0
    execute if entity @s[team=blue] unless entity @e[tag=blue.zed.q.target] anchored eyes positioned as @e[tag=zed.shadow.model,team=blue] positioned ^ ^ ^ as @e[tag=zed.shadow.model,team=blue] run function zed:skills/q.spawn.shadow

    execute if entity @s[team=blue] if entity @e[tag=blue.zed.q.target] as @e[tag=zed.shadow.model,team=blue] at @s facing entity @e[tag=blue.zed.q.target,limit=1] eyes run tp @s ~ ~ ~ ~ 0
    execute if entity @s[team=blue] if entity @e[tag=blue.zed.q.target] anchored eyes positioned as @e[tag=zed.shadow.model,team=blue] positioned ^ ^ ^ facing entity @e[tag=blue.zed.q.target,limit=1] eyes rotated ~ ~5 as @e[tag=zed.shadow.model,team=blue] run function zed:skills/q.spawn.shadow

    execute if entity @s[team=blue] run tag @e[tag=blue.zed.q.target] remove blue.zed.q.target
}

function use_r {
    function _champion:abilities/cooldown/r

    playsound minecraft:zed.ultimate master @a ~ ~ ~
    playsound minecraft:zed.sfx.r master @a ~ ~ ~

    scoreboard players set @s fx.invis 19
    scoreboard players set @s status.weapon 9999

    tag @s add unvalid
    tag @s add r.animation
    tag @s remove red_tower.target
    tag @s remove blue_tower.target

    execute if entity @s[team=red] run kill @e[tag=zed.shadow,tag=r.shadow,tag=red]
    execute if entity @s[team=red] run summon minecraft:area_effect_cloud ~ ~ ~ {Duration:180,Tags:["zed.shadow","r.shadow","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] run tag @e[tag=temp_target,team=!red,limit=1,sort=nearest,type=!#unvalid,tag=!unvalid] add zed.r.target
    execute if entity @s[team=red] positioned as @e[team=!red,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:item_display ^ ^1.5 ^5 {Tags:["zed.r.cast","red","lol.auto_clear"],teleport_duration:1,Passengers:[{id:"area_effect_cloud",Duration:20,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=red] positioned as @e[team=!red,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:armor_stand ^ ^1.5 ^5 {Marker:1,Invisible:1,Team:"red",ShowArms:1,Pose:{LeftArm:[22.5f,0.0f,0.0f],RightArm:[-22.5f,0.0f,0.0f]},Tags:["zed.r.animation","unvalid"],equipment:{mainhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},offhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[300002f]}}}}}
    execute if entity @s[team=red] positioned as @e[team=!red,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:armor_stand ^5 ^1.5 ^-5 {Marker:1,Invisible:1,Team:"red",ShowArms:1,Pose:{LeftArm:[22.5f,0.0f,0.0f],RightArm:[-22.5f,0.0f,0.0f]},Tags:["zed.r.animation","unvalid"],equipment:{mainhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},offhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[300002f]}}}}}
    execute if entity @s[team=red] positioned as @e[team=!red,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:armor_stand ^-5 ^1.5 ^-5 {Marker:1,Invisible:1,Team:"red",ShowArms:1,Pose:{LeftArm:[22.5f,0.0f,0.0f],RightArm:[-22.5f,0.0f,0.0f]},Tags:["zed.r.animation","unvalid"],equipment:{mainhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},offhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[300002f]}}}}}

    execute if entity @s[team=blue] run kill @e[tag=zed.shadow,tag=r.shadow,tag=blue]
    execute if entity @s[team=blue] run summon minecraft:area_effect_cloud ~ ~ ~ {Duration:180,Tags:["zed.shadow","r.shadow","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run tag @e[tag=temp_target,team=!blue,limit=1,sort=nearest,type=!#unvalid,tag=!unvalid] add zed.r.target
    execute if entity @s[team=blue] positioned as @e[team=!blue,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:item_display ^ ^1.5 ^5 {Tags:["zed.r.cast","blue","lol.auto_clear"],teleport_duration:1,Passengers:[{id:"area_effect_cloud",Duration:20,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] positioned as @e[team=!blue,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:armor_stand ^ ^1.5 ^5 {Marker:1,Invisible:1,Team:"blue",ShowArms:1,Pose:{LeftArm:[22.5f,0.0f,0.0f],RightArm:[-22.5f,0.0f,0.0f]},Tags:["zed.r.animation","unvalid"],equipment:{mainhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},offhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[300002f]}}}}}
    execute if entity @s[team=blue] positioned as @e[team=!blue,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:armor_stand ^5 ^1.5 ^-5 {Marker:1,Invisible:1,Team:"blue",ShowArms:1,Pose:{LeftArm:[22.5f,0.0f,0.0f],RightArm:[-22.5f,0.0f,0.0f]},Tags:["zed.r.animation","unvalid"],equipment:{mainhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},offhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[300002f]}}}}}
    execute if entity @s[team=blue] positioned as @e[team=!blue,tag=zed.r.target,limit=1] facing entity @s eyes rotated ~ 0 run summon minecraft:armor_stand ^-5 ^1.5 ^-5 {Marker:1,Invisible:1,Team:"blue",ShowArms:1,Pose:{LeftArm:[22.5f,0.0f,0.0f],RightArm:[-22.5f,0.0f,0.0f]},Tags:["zed.r.animation","unvalid"],equipment:{mainhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},offhand:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[300131f]}}},head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[300002f]}}}}}

    execute as @e[tag=zed.shadow,tag=r.shadow,tag=!blinked,limit=1,sort=nearest] run function zed:skills/shadow.spawn
}

function use_r.check {
    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target] add temp_target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=champion,dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_target] at @s run function zed:use_r

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] remove temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target] add temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=champion,dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_target] at @s run function zed:use_r

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] remove temp_target

    execute if entity @s[distance=..10] if score @s cd_r matches 0 positioned ^ ^ ^0.1 run function zed:use_r.check
}

function use_r2 {
    execute if entity @s[team=red] run tag @e[tag=zed.shadow,tag=r.shadow,tag=red,type=minecraft:area_effect_cloud,tag=!blinked] add blink
    execute if entity @s[team=blue] run tag @e[tag=zed.shadow,tag=r.shadow,tag=blue,type=minecraft:area_effect_cloud,tag=!blinked] add blink
}

function use_w {
    function _champion:abilities/cooldown/w

    playsound minecraft:zed.sfx.w1 master @a ~ ~ ~

    execute if entity @s[team=red] run kill @e[tag=zed.shadow,tag=w.shadow,tag=red]
    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:105,Tags:["red","zed.shadow","moving","w.shadow"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] run tp @e[tag=zed.shadow,type=minecraft:area_effect_cloud,tag=moving,limit=1,sort=nearest] ~ ~ ~ ~ 0

    execute if entity @s[team=blue] run kill @e[tag=zed.shadow,tag=w.shadow,tag=blue]
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:105,Tags:["blue","zed.shadow","moving","w.shadow"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run tp @e[tag=zed.shadow,type=minecraft:area_effect_cloud,tag=moving,limit=1,sort=nearest] ~ ~ ~ ~ 0

    scoreboard players set @s rclick 0
}

function use_w2 {
    execute if entity @s[team=red] run tag @e[tag=zed.shadow,tag=w.shadow,tag=red,type=minecraft:area_effect_cloud,tag=!blinked] add blink
    execute if entity @s[team=blue] run tag @e[tag=zed.shadow,tag=w.shadow,tag=blue,type=minecraft:area_effect_cloud,tag=!blinked] add blink
}
