# leona:skills/  (converted from the 1.20.2 LeagueCraft datapack)

function e.animation {
    tp @s ^ ^ ^1.75
    particle wax_on ~ ~ ~ 0 0.2 0 1 3 force

    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,dx=0,tag=!leona.e.dmg] add leona.e.hit
    execute if entity @s[tag=red] if entity @e[tag=leona.e.hit,team=!red] run tag @e[tag=leona.e.hit,team=!red,tag=!leona.e.dmg] add leona.e.temp_dmg
    execute if entity @s[tag=red] if entity @e[tag=leona.e.hit,team=!red] as @p[tag=leona,team=red] run function leona:skills/e.damage

    execute if entity @s[tag=red] if entity @e[tag=leona.e.hit,team=!red] run tag @e[tag=leona.e.hit,team=!red] add leona.e.dmg
    execute if entity @s[tag=red] if entity @e[tag=leona.e.hit,team=!red] run tag @e[tag=leona.e.hit,team=!red] remove leona.e.hit

    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=0,tag=!leona.e.dmg] add leona.e.hit
    execute if entity @s[tag=blue] if entity @e[tag=leona.e.hit,team=!blue] run tag @e[tag=leona.e.hit,team=!blue,tag=!leona.e.dmg] add leona.e.temp_dmg
    execute if entity @s[tag=blue] if entity @e[tag=leona.e.hit,team=!blue] as @p[tag=leona,team=blue] run function leona:skills/e.damage

    execute if entity @s[tag=blue] if entity @e[tag=leona.e.hit,team=!blue] run tag @e[tag=leona.e.hit,team=!blue] add leona.e.dmg
    execute if entity @s[tag=blue] if entity @e[tag=leona.e.hit,team=!blue] run tag @e[tag=leona.e.hit,team=!blue] remove leona.e.hit
}

function e.damage {
    execute if entity @s[team=red] run scoreboard players set @e[team=!red,type=!#unvalid,tag=leona.e.hit,tag=leona.e.temp_dmg,limit=1,sort=nearest] leona.passive 3
    execute if entity @s[team=blue] run scoreboard players set @e[team=!blue,type=!#unvalid,tag=leona.e.hit,tag=leona.e.temp_dmg,limit=1,sort=nearest] leona.passive 3

    execute if entity @s[team=red] run damage @e[tag=leona.e.hit,tag=leona.e.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=leona.e.hit,tag=leona.e.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players operation @s dmg_magic.deal = @s ability_power
    scoreboard players operation @s dmg_magic.deal *= 40 integer
    scoreboard players operation @s dmg_magic.deal /= 100 integer
    scoreboard players add @s dmg_magic.deal 210

    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leona.e.hit,tag=has_health_bar,tag=leona.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leona.e.hit,tag=has_health_bar,tag=leona.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=leona.e.hit,type=!#unvalid,tag=leona.e.temp_dmg,limit=1,sort=nearest] remove leona.e.temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=leona.e.hit,tag=leona.e.temp_dmg,type=!#unvalid,team=!red] run function leona:skills/e.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leona.e.hit,tag=has_health_bar,tag=leona.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leona.e.hit,tag=has_health_bar,tag=leona.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=leona.e.hit,type=!#unvalid,tag=leona.e.temp_dmg,limit=1,sort=nearest] remove leona.e.temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=leona.e.hit,tag=leona.e.temp_dmg,type=!#unvalid,team=!blue] run function leona:skills/e.damage
}

function e.dash {
    execute if entity @s[tag=red] on passengers on vehicle facing entity @e[tag=leona.e.target,team=!red,limit=1,sort=nearest] feet rotated ~ ~-20 run tp @s ^ ^ ^1 ~ ~
    execute if entity @s[tag=red] if score @p[team=red,tag=leona] channeling matches -1 run ride @p[team=red,tag=leona] mount @s

    execute if entity @s[tag=red] run scoreboard players set @e[tag=leona.e.target,team=!red] fx.sight 2

    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!red,dx=0] positioned ~0.5 ~0.5 ~0.5 on passengers on vehicle run tp @s ^ ^ ^1.5
    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!red,dx=0] run tag @p[tag=leona,team=red] remove e.dash
    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!red,dx=0] on passengers run kill @s[tag=cd]
    execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!red,dx=0] run tag @e[tag=leona.e.target,team=!red] remove leona.e.target

    execute if entity @s[tag=blue] on passengers on vehicle facing entity @e[tag=leona.e.target,team=!blue,limit=1,sort=nearest] feet rotated ~ ~-20 run tp @s ^ ^ ^1 ~ ~
    execute if entity @s[tag=blue] if score @p[team=blue,tag=leona] channeling matches -1 run ride @p[team=blue,tag=leona] mount @s

    execute if entity @s[tag=blue] run scoreboard players set @e[tag=leona.e.target,team=!blue] fx.sight 2

    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!blue,dx=0] positioned ~0.5 ~0.5 ~0.5 on passengers on vehicle run tp @s ^ ^ ^1.5
    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!blue,dx=0] run tag @p[tag=leona,team=blue] remove e.dash
    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!blue,dx=0] on passengers run kill @s[tag=cd]
    execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leona.e.target,team=!blue,dx=0] run tag @e[tag=leona.e.target,team=!blue] remove leona.e.target
}

function e.dash_cancel {
    execute if entity @s[tag=red] run tag @e[tag=leona.e.target,team=!red] remove leona.e.target
    execute if entity @s[tag=red] as @e[tag=leona.q.mark.model,tag=red] on passengers run kill @s
    execute if entity @s[tag=red] run tag @p[tag=leona,team=red] remove e.dash
    execute if entity @s[tag=red] on passengers run data modify entity @s Age set value 2147483646

    execute if entity @s[tag=blue] run tag @e[tag=leona.e.target,team=!blue] remove leona.e.target
    execute if entity @s[tag=blue] as @e[tag=leona.q.mark.model,tag=blue] on passengers run kill @s
    execute if entity @s[tag=blue] run tag @p[tag=leona,team=blue] remove e.dash
    execute if entity @s[tag=blue] on passengers run data modify entity @s Age set value 2147483646
}

function e.end {
    execute if entity @s[tag=red] run scoreboard players set @p[tag=leona,team=red] status.weapon 1000101
    execute if entity @s[tag=red] if entity @e[tag=leona.e.dmg,team=!red] at @p[tag=leona,team=red] run tag @e[tag=champion,tag=leona.e.dmg,team=!red,limit=1,sort=furthest] add leona.e.target
    execute if entity @s[tag=red] if entity @e[tag=leona.e.dmg,team=!red] run tag @e[tag=leona.e.dmg,team=!red] remove leona.e.dmg

    execute if entity @s[tag=red] if entity @e[tag=leona.e.target,team=!red] run scoreboard players set @e[tag=leona.e.target,team=!red] cc.root 10
    execute if entity @s[tag=red] if entity @e[tag=leona.e.target,team=!red] as @p[tag=leona,team=red] at @s run function leona:use_e2

    execute if entity @s[tag=blue] if entity @e[tag=leona.e.dmg,team=!blue] at @p[tag=leona,team=blue] run tag @e[tag=champion,tag=leona.e.dmg,team=!blue,limit=1,sort=furthest] add leona.e.target
    execute if entity @s[tag=blue] if entity @e[tag=leona.e.dmg,team=!blue] run tag @e[tag=leona.e.dmg,team=!blue] remove leona.e.dmg

    execute if entity @s[tag=blue] if entity @e[tag=leona.e.target,team=!blue] run scoreboard players set @e[tag=leona.e.target,team=!blue] cc.root 10
    execute if entity @s[tag=blue] if entity @e[tag=leona.e.target,team=!blue] as @p[tag=leona,team=blue] at @s run function leona:use_e2
}

function q.damage {
    function leona:skills/q.end
    execute if entity @s[team=red] run scoreboard players set @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] leona.passive 3
    execute if entity @s[team=blue] run scoreboard players set @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] leona.passive 3

    execute if entity @s[team=red] run scoreboard players add @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] cc.stun 20
    execute if entity @s[team=blue] run scoreboard players add @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] cc.stun 20

    scoreboard players operation leona.q.temp_dmg attack_damage = @s ability_power
    scoreboard players operation leona.q.temp_dmg attack_damage *= 30 integer
    scoreboard players operation leona.q.temp_dmg attack_damage /= 100 integer
    scoreboard players add leona.q.temp_dmg attack_damage 110

    scoreboard players operation @s dmg_magic.deal = leona.q.temp_dmg attack_damage
}

function q.end {
    function _champion:abilities/cooldown/q
    stopsound @a master leona.sfx.q
    scoreboard players remove @s aa.range 10
    execute if entity @s[team=red] run kill @e[tag=leona.q.cd,tag=red]
    execute if entity @s[team=blue] run kill @e[tag=leona.q.cd,tag=blue]
    tag @s remove leona.q
}

function r.animation {
    tp @s ~ ~ ~ ~15 0

    execute rotated ~ ~ run particle wax_on ^ ^ ^5 0 0 0 0 1 force
    execute rotated ~-3 ~ run particle wax_on ^ ^ ^5 0 0 0 0 1 force
    execute rotated ~-6 ~ run particle wax_on ^ ^ ^5 0 0 0 0 1 force
    execute rotated ~-9 ~ run particle wax_on ^ ^ ^5 0 0 0 0 1 force
    execute rotated ~-12 ~ run particle wax_on ^ ^ ^5 0 0 0 0 1 force

    execute rotated ~ ~ run particle wax_on ^ ^ ^-5 0 0 0 0 1 force
    execute rotated ~ ~ run particle wax_on ^ ^ ^-5 0 0 0 0 1 force
    execute rotated ~-3 ~ run particle wax_on ^ ^ ^-5 0 0 0 0 1 force
    execute rotated ~-6 ~ run particle wax_on ^ ^ ^-5 0 0 0 0 1 force
    execute rotated ~-9 ~ run particle wax_on ^ ^ ^-5 0 0 0 0 1 force
    execute rotated ~-12 ~ run particle wax_on ^ ^ ^-5 0 0 0 0 1 force
}

function r.cast {
    execute rotated ~ ~ run particle wax_on ^ ^ ^1 0 0 0 0 1 force @a
    execute rotated ~-40 ~ run particle wax_on ^ ^-0.16 ^1 0 0 0 0 1 force @a
    execute rotated ~-30 ~ run particle wax_on ^ ^-0.12 ^1 0 0 0 0 1 force @a
    execute rotated ~-20 ~ run particle wax_on ^ ^-0.08 ^1 0 0 0 0 1 force @a
    execute rotated ~-10 ~ run particle wax_on ^ ^-0.04 ^1 0 0 0 0 1 force @a

    tp @s ~ ~0.2 ~ ~45 ~
}

function r.cast.particle {
    execute if entity @s[tag=leona.r,tag=can_remove] run tag @s remove do_not_clear

    execute if entity @s[tag=leona.r,tag=!can_remove] run data modify entity @s transformation.scale set value [0.0,1000.0,0.0]
    execute if entity @s[tag=leona.r,tag=!can_remove] run data modify entity @s start_interpolation set value -1
    execute if entity @s[tag=leona.r,tag=!can_remove] run summon area_effect_cloud ~ ~ ~ {Duration:10,Tags:["cd","temp"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=leona.r,tag=!can_remove] run ride @e[tag=cd,tag=temp,limit=1,sort=nearest,type=area_effect_cloud] mount @s
    execute if entity @s[tag=leona.r,tag=!can_remove] run tag @s add can_remove
}

function r.damage {
    execute if entity @s[team=red] run scoreboard players set @e[team=!red,type=!#unvalid,tag=leona.r.hit,tag=leona.r.temp_dmg,limit=1,sort=nearest] leona.passive 3
    execute if entity @s[team=blue] run scoreboard players set @e[team=!blue,type=!#unvalid,tag=leona.r.hit,tag=leona.r.temp_dmg,limit=1,sort=nearest] leona.passive 3

    execute if entity @s[team=red] run damage @e[tag=leona.r.hit,tag=leona.r.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=leona.r.hit,tag=leona.r.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 _lol:dmg_physical by @s

    scoreboard players operation @s dmg_magic.deal = @s ability_power
    scoreboard players operation @s dmg_magic.deal *= 80 integer
    scoreboard players operation @s dmg_magic.deal /= 100 integer
    scoreboard players add @s dmg_magic.deal 300

    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leona.r.hit,tag=has_health_bar,tag=leona.r.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leona.r.hit,tag=has_health_bar,tag=leona.r.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=leona.r.hit,type=!#unvalid,tag=leona.r.temp_dmg,limit=1,sort=nearest] remove leona.r.temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=leona.r.hit,tag=leona.r.temp_dmg,type=!#unvalid,team=!red] run function leona:skills/r.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leona.r.hit,tag=has_health_bar,tag=leona.r.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leona.r.hit,tag=has_health_bar,tag=leona.r.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=leona.r.hit,type=!#unvalid,tag=leona.r.temp_dmg,limit=1,sort=nearest] remove leona.r.temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=leona.r.hit,tag=leona.r.temp_dmg,type=!#unvalid,team=!blue] run function leona:skills/r.damage
}

