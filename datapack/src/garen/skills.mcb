    particle minecraft:dust{color:[1,0.918,0],scale:1} ^-2.34375 ^0 ^0.3125 0 0 0 0 1 force @a
    particle minecraft:dust{color:[1,0.918,0],scale:1} ^-2.34375 ^0 ^0.46875 0 0 0 0 1 force @a
}

function r.spawn {
    execute if entity @s[tag=red] at @e[tag=garen.r.target,team=!red] rotated ~ 0 positioned ~ ~0.5 ~ run function garen:skills/r.particle
    execute if entity @s[tag=red] at @e[tag=garen.r.target,team=!red] rotated ~ 0 positioned ~ ~0.5 ~ run function garen:skills/r.particle.end
    execute if entity @s[tag=red] at @e[tag=garen.r.target,team=!red] run particle flash{color:[1.0f,1.0f,1.0f,1.0f]} ~ ~ ~ 0 0 0 1 10 force
    execute if entity @s[tag=red] at @e[tag=garen.r.target,team=!red] run particle explosion ~ ~ ~ 0 0 0 1 10 force
    execute if entity @s[tag=red] as @p[tag=garen,team=red] run function garen:skills/r.damage
    execute if entity @s[tag=red] run tag @p[tag=garen,team=red] remove r.animation

    execute if entity @s[tag=blue] at @e[tag=garen.r.target,team=!blue] rotated ~ 0 positioned ~ ~0.5 ~ run function garen:skills/r.particle
    execute if entity @s[tag=blue] at @e[tag=garen.r.target,team=!blue] rotated ~ 0 positioned ~ ~0.5 ~ run function garen:skills/r.particle.end
    execute if entity @s[tag=blue] at @e[tag=garen.r.target,team=!blue] run particle flash{color:[1.0f,1.0f,1.0f,1.0f]} ~ ~ ~ 0 0 0 1 10 force
    execute if entity @s[tag=blue] at @e[tag=garen.r.target,team=!blue] run particle explosion ~ ~ ~ 0 0 0 1 10 force
    execute if entity @s[tag=blue] as @p[tag=garen,team=blue] run function garen:skills/r.damage
    execute if entity @s[tag=blue] run tag @p[tag=garen,team=blue] remove r.animation
}

function w.end {
    execute if entity @s[tag=red] run scoreboard players remove @p[tag=garen,team=red] dmg_reduction 30
    execute if entity @s[tag=red] run scoreboard players operation @p[tag=garen,team=red] armor -= red.garen.w.armor temp
    execute if entity @s[tag=red] run scoreboard players operation @p[tag=garen,team=red] magic_resist -= red.garen.w.mr temp
    execute if entity @s[tag=red] run tag @p[tag=garen,team=red] remove garen.w

    execute if entity @s[tag=blue] run scoreboard players remove @p[tag=garen,team=blue] dmg_reduction 30
    execute if entity @s[tag=blue] run scoreboard players operation @p[tag=garen,team=blue] armor -= blue.garen.w.armor temp
    execute if entity @s[tag=blue] run scoreboard players operation @p[tag=garen,team=blue] magic_resist -= blue.garen.w.mr temp
    execute if entity @s[tag=blue] run tag @p[tag=garen,team=blue] remove garen.w
}
