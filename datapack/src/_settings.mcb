# _settings:  (converted from the 1.20.2 LeagueCraft datapack)

function load {
    say LeagueCraft Settings reloaded

    scoreboard objectives add champ_id dummy
}

function main {
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:11b}] run function _settings:queue/team.1/slot.1
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:12b}] run function _settings:queue/team.1/slot.2
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:13b}] run function _settings:queue/team.1/slot.3
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:14b}] run function _settings:queue/team.1/slot.4
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:15b}] run function _settings:queue/team.1/slot.5

    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:29b}] run function _settings:queue/team.2/slot.1
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:30b}] run function _settings:queue/team.2/slot.2
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:31b}] run function _settings:queue/team.2/slot.3
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:32b}] run function _settings:queue/team.2/slot.4
    execute if score @s settings.page matches -1 unless data entity @s Inventory[{Slot:33b}] run function _settings:queue/team.2/slot.5

    execute if score @s[tag=champion] settings.page matches 0 run item modify entity @s inventory.0 _settings:update_stats
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:9b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:10b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:11b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:12b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:19b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:20b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:29b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:30b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:31b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:32b}] run function _settings:return
    execute if score @s[tag=champion] settings.page matches 0 unless data entity @s Inventory[{Slot:33b}] run function _settings:return
    execute if score @s[tag=champion,tag=!see_champ] settings.page matches 0 unless data entity @s Inventory[{Slot:13b}] run function _settings:return
    execute if score @s[tag=champion,tag=!see_champ] settings.page matches 0 unless data entity @s Inventory[{Slot:14b}] run function _settings:return
    execute if score @s[tag=champion,tag=see_champ] settings.page matches 0 unless data entity @s Inventory[{Slot:13b}] run function _settings:move/summoner/spell.1
    execute if score @s[tag=champion,tag=see_champ] settings.page matches 0 unless data entity @s Inventory[{Slot:14b}] run function _settings:move/summoner/spell.2
    execute if score @s settings.page matches 0 unless data entity @s Inventory[{Slot:16b}] run function _settings:move/settings
    execute if score @s settings.page matches 0 unless data entity @s Inventory[{Slot:17b}] run function _settings:move/surrender
    execute if score @s[tag=admin] settings.page matches 0 unless data entity @s Inventory[{Slot:26b}] run function _settings:move/practice
    execute if score @s[tag=see_champ] settings.page matches 0 unless data entity @s Inventory[{Slot:35b}] run function _settings:move/summoner/champion

    execute if score @s settings.page matches 1 unless data entity @s Inventory[{Slot:21b}] run function _settings:move/support_me
    execute if score @s settings.page matches 1 unless data entity @s Inventory[{Slot:23b}] run function _settings:move/uninstall

    execute if score @s settings.page matches 10 unless data entity @s Inventory[{Slot:21b}] run function _settings:move/lang/eng
    execute if score @s settings.page matches 10 unless data entity @s Inventory[{Slot:23b}] run function _settings:move/lang/vie

    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:11b}] run function _settings:move/practice/reset_hp
    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:20b}] run function _settings:move/practice/reset_mana
    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:29b}] run function _settings:move/practice/reset_cd

    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:13b}] run function _settings:move/practice/dummy.1
    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:22b}] run function _settings:move/practice/dummy.2
    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:31b}] run function _settings:move/practice/dummy.3

    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:15b}] run function _settings:move/practice/show_stats
    execute if score @s settings.page matches 20 unless data entity @s Inventory[{Slot:24b}] run function _settings:move/practice/show_dmg

    execute if score @s settings.page matches 21 unless data entity @s Inventory[{Slot:11b}] run function _settings:move/structure/tower.1
    execute if score @s settings.page matches 21 unless data entity @s Inventory[{Slot:20b}] run function _settings:move/structure/inhib.1
    execute if score @s settings.page matches 21 unless data entity @s Inventory[{Slot:29b}] run function _settings:move/structure/nexus.1
    execute if score @s settings.page matches 21 unless data entity @s Inventory[{Slot:13b}] run function _settings:move/structure/tower.2
    execute if score @s settings.page matches 21 unless data entity @s Inventory[{Slot:22b}] run function _settings:move/structure/inhib.2
    execute if score @s settings.page matches 21 unless data entity @s Inventory[{Slot:31b}] run function _settings:move/structure/nexus.2

    execute if score @s settings.page matches 21 unless data entity @s Inventory[{Slot:15b}] run function _settings:move/structure/rotate

    execute if score @s settings.page matches 22 unless data entity @s Inventory[{Slot:11b}] run function _settings:move/structure/destroy.1
    execute if score @s settings.page matches 22 unless data entity @s Inventory[{Slot:13b}] run function _settings:move/structure/destroy.2
    execute if score @s settings.page matches 22 unless data entity @s Inventory[{Slot:20b}] run function _settings:move/structure/rebuild.1
    execute if score @s settings.page matches 22 unless data entity @s Inventory[{Slot:22b}] run function _settings:move/structure/rebuild.2
    execute if score @s settings.page matches 22 unless data entity @s Inventory[{Slot:29b}] run function _settings:move/structure/remove.1
    execute if score @s settings.page matches 22 unless data entity @s Inventory[{Slot:31b}] run function _settings:move/structure/remove.2

    execute if score @s settings.page matches 30 unless data entity @s Inventory[{Slot:24b}] run function _settings:move/summoner/team
    execute if score @s settings.page matches 30 unless data entity @s Inventory[{Slot:22b}] run function _settings:move/summoner/spell.1
    execute if score @s settings.page matches 30 unless data entity @s Inventory[{Slot:23b}] run function _settings:move/summoner/spell.2
    execute if score @s settings.page matches 30 unless data entity @s Inventory[{Slot:20b}] run function _settings:move/summoner/champion

    execute if score @s settings.page matches 2..30 unless data entity @s Inventory[{Slot:9b}] run function _settings:return

    execute if score @s settings.page matches 20..30 unless data entity @s Inventory[{Slot:18b}] run function _settings:previous_page
    execute if score @s settings.page matches 20..30 unless data entity @s Inventory[{Slot:26b}] run function _settings:next_page

    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:11b}] run function _settings:champion/_random

    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:12b}] run function _settings:champion/yasuo
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:13b}] run function _settings:champion/leesin
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:14b}] run function _settings:champion/zed
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:15b}] run function _settings:champion/yone

    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:20b}] run function _settings:champion/ashe
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:21b}] run function _settings:champion/ezreal
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:22b}] run function _settings:champion/leona
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:23b}] run function _settings:champion/soraka
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:24b}] run function _settings:champion/aatrox

    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:29b}] run function _settings:champion/garen
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:30b}] run function _settings:champion/malphite
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:31b}] run function _settings:champion/lux
    execute if score @s settings.page matches 100 unless data entity @s Inventory[{Slot:32b}] run function _settings:champion/annie
}

function next_page {
    scoreboard players add @s settings.page 1
    execute if score @s settings.page matches 2 run scoreboard players set @s settings.page 0
    execute if score @s settings.page matches 11 run scoreboard players set @s settings.page 10
    execute if score @s settings.page matches 23 run scoreboard players set @s settings.page 20
    execute if score @s settings.page matches 31 run scoreboard players set @s settings.page 30
    execute if score @s settings.page matches 101 run scoreboard players set @s settings.page 100

    clear @s structure_void
    function _settings:reset
}

function previous_page {
    scoreboard players remove @s settings.page 1
    execute if score @s settings.page matches -1 run scoreboard players set @s settings.page 1
    execute if score @s settings.page matches 9 run scoreboard players set @s settings.page 10
    execute if score @s settings.page matches 19 run scoreboard players set @s settings.page 22
    execute if score @s settings.page matches 29 run scoreboard players set @s settings.page 30
    execute if score @s settings.page matches 99 run scoreboard players set @s settings.page 100

    clear @s structure_void
    function _settings:reset
}

function reset {
    execute if score @s settings.page matches -1 run function _settings:page/_1
    execute if score @s settings.page matches 0 run function _settings:page/00
    execute if score @s settings.page matches 1 run function _settings:page/01

    execute if score @s settings.page matches 10 run function _settings:page/10
    execute if score @s settings.page matches 20 run function _settings:page/20
    execute if score @s settings.page matches 21 run function _settings:page/21
    execute if score @s settings.page matches 22 run function _settings:page/22
    execute if score @s settings.page matches 30 run function _settings:page/30

    execute if score @s settings.page matches 100 run function _settings:page/100

    item replace entity @s[scores={settings.page=20..30}] inventory.0 with structure_void[minecraft:custom_name={text:"Return",italic:false},minecraft:custom_model_data={floats:[100003f]},minecraft:custom_data={kill_item:1}]

    item replace entity @s[scores={settings.page=20..30}] inventory.9 with structure_void[minecraft:custom_name={text:"<",italic:false},minecraft:custom_model_data={floats:[100001f]},minecraft:custom_data={kill_item:1}]
    item replace entity @s[scores={settings.page=20..30}] inventory.17 with structure_void[minecraft:custom_name={text:">",italic:false},minecraft:custom_model_data={floats:[100002f]},minecraft:custom_data={kill_item:1}]
}

function return {
    scoreboard players set @s settings.page 0
    clear @s structure_void
    function _settings:reset
}
