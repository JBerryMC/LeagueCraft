function w.passive {
    particle minecraft:sweep_attack ~ ~1 ~ 0 1 0 0 2 force
    particle minecraft:sweep_attack ^1.5 ^1 ^ 0 1 0 0 2 force
    particle minecraft:sweep_attack ^-1.5 ^1 ^ 0 1 0 0 2 force

    ## RED
    execute if entity @s[tag=red] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[type=#yasuo:block_by_windwall,dx=0,dz=0,dy=2,tag=!red]
    execute if entity @s[tag=red] positioned ^1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[type=#yasuo:block_by_windwall,dx=0,dz=0,dy=2,tag=!red]
    execute if entity @s[tag=red] positioned ^-1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[type=#yasuo:block_by_windwall,dx=0,dz=0,dy=2,tag=!red]

    execute if entity @s[tag=red] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=cd]
    execute if entity @s[tag=red] positioned ^1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=cd]
    execute if entity @s[tag=red] positioned ^-1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=cdd]

    execute if entity @s[tag=red] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=!cd] on passengers run kill @s
    execute if entity @s[tag=red] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=!cd] run kill @s
    execute if entity @s[tag=red] positioned ^1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=!cd] on passengers run kill @s
    execute if entity @s[tag=red] positioned ^1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=!cd] run kill @s
    execute if entity @s[tag=red] positioned ^-1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=!cd] on passengers run kill @s
    execute if entity @s[tag=red] positioned ^-1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!red,tag=!cd] run kill @s

    ## BLUE
    execute if entity @s[tag=blue] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[type=#yasuo:block_by_windwall,dx=0,dz=0,dy=2,tag=!blue]
    execute if entity @s[tag=blue] positioned ^1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[type=#yasuo:block_by_windwall,dx=0,dz=0,dy=2,tag=!blue]
    execute if entity @s[tag=blue] positioned ^-1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[type=#yasuo:block_by_windwall,dx=0,dz=0,dy=2,tag=!blue]

    execute if entity @s[tag=blue] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 run kill @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!blue,tag=cd]
