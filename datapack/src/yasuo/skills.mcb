}

function q.stack {
    execute if entity @s[tag=red] if entity @p[tag=yasuo,team=red,tag=full_q] run tp @s ~ ~ ~ ~20 0
    execute if entity @s[tag=red] if entity @p[tag=yasuo,team=red,tag=full_q] positioned as @p[tag=yasuo,team=red] rotated as @s run particle minecraft:instant_effect ^ ^1.3 ^0.75 0 0 0 0 2 force
    execute if entity @s[tag=red] if entity @p[tag=yasuo,team=red,tag=full_q] positioned as @p[tag=yasuo,team=red] rotated as @s run particle minecraft:instant_effect ^ ^0.7 ^-0.75 0 0 0 0 2 force
    execute if entity @s[tag=red,nbt={Age:120}] run scoreboard players set @p[tag=yasuo,team=red] stack_q 0
    execute if entity @s[tag=red,nbt={Age:120}] run tag @p[tag=yasuo,team=red] remove full_q

    execute if entity @s[tag=blue] if entity @p[tag=yasuo,team=blue,tag=full_q] run tp @s ~ ~ ~ ~20 0
    execute if entity @s[tag=blue] if entity @p[tag=yasuo,team=blue,tag=full_q] positioned as @p[tag=yasuo,team=blue] rotated as @s run particle minecraft:instant_effect ^ ^1.3 ^0.75 0 0 0 0 2 force
    execute if entity @s[tag=blue] if entity @p[tag=yasuo,team=blue,tag=full_q] positioned as @p[tag=yasuo,team=blue] rotated as @s run particle minecraft:instant_effect ^ ^0.7 ^-0.75 0 0 0 0 2 force
    execute if entity @s[tag=blue,nbt={Age:120}] run scoreboard players set @p[tag=yasuo,team=blue] stack_q 0
    execute if entity @s[tag=blue,nbt={Age:120}] run tag @p[tag=yasuo,team=blue] remove full_q
}

function q.stack_cd {
    execute if entity @s[team=red] if entity @e[tag=yasuo.q.stackcd,type=minecraft:area_effect_cloud,tag=red] run data modify entity @e[tag=yasuo.q.stackcd,tag=red,type=minecraft:area_effect_cloud,limit=1] Age set value 0
    execute if entity @s[team=red] unless entity @e[tag=yasuo.q.stackcd,type=minecraft:area_effect_cloud,tag=red] run summon minecraft:area_effect_cloud ~ ~ ~ {Duration:121,Tags:["yasuo.q.stackcd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] if entity @e[tag=yasuo.q.stackcd,type=minecraft:area_effect_cloud,tag=blue] run data modify entity @e[tag=yasuo.q.stackcd,tag=blue,type=minecraft:area_effect_cloud,limit=1] Age set value 0
    execute if entity @s[team=blue] unless entity @e[tag=yasuo.q.stackcd,type=minecraft:area_effect_cloud,tag=blue] run summon minecraft:area_effect_cloud ~ ~ ~ {Duration:121,Tags:["yasuo.q.stackcd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function q.tornado.clear {
    execute if entity @s[tag=red] run tag @e[tag=yasuo.tornado.hit,team=!red,type=!#unvalid] remove yasuo.tornado.hit
    execute if entity @s[tag=blue] run tag @e[tag=yasuo.tornado.hit,team=!blue,type=!#unvalid] remove yasuo.tornado.hit

    kill @s
}

function q.tornado.knockup {
    function _champion:cc/cancel
    scoreboard players set @s cc.airborne 15

    summon item ~ ~ ~ {Invulnerable:1,Age:5985,PickupDelay:32767,Motion:[0.0,0.3,0.0],Tags:["knockup","cc","temp"],Item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[9999f]}}}}
    data modify entity @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] Thrower set from entity @s UUID
    tag @e[type=item,tag=knockup,limit=1,sort=nearest,tag=temp] remove temp
}

function q.tornado.passive {
    #tp @s ~ ~ ~ ~30 ~

    tp @s ^ ^ ^1
    particle minecraft:instant_effect ^ ^ ^ 0.2 0 0.2 0 10 force

    execute as @s[tag=red] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!red,dx=2,dz=2,dy=10,type=!#unvalid,tag=!unvalid] add yasuo.q.hit
    execute as @s[tag=blue] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!blue,dx=2,dz=2,dy=10,type=!#unvalid,tag=!unvalid] add yasuo.q.hit

    #effect give @e[tag=yasuo.q.hit] glowing 1 0 true
    #say @e[tag=yasuo.q.hit]
    execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red,tag=!yasuo.tornado.hit] add temp_dmg
    execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] as @e[tag=yasuo.q.hit,type=!#unvalid,team=!red,tag=!yasuo.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function yasuo:skills/q.tornado.knockup
    execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] on passengers on origin run function yasuo:skills/q.damage

    execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] add yasuo.tornado.hit
    execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] remove yasuo.q.hit

    execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue,tag=!yasuo.tornado.hit] add temp_dmg
    execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] as @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue,tag=!yasuo.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function yasuo:skills/q.tornado.knockup
    execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] on passengers on origin run function yasuo:skills/q.damage

    execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] add yasuo.tornado.hit
    execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] remove yasuo.q.hit

    #execute unless data entity @s Passengers[{Tags:["yasuo.q.cd"]}] run kill @s
}

function q.tornado.spawn {
    playsound yasuo.sfx.q2 master @a ~ ~ ~

    execute if entity @s[team=red] run summon minecraft:item_display ~ ~ ~ {teleport_duration:1,interpolation_duration:10,Tags:["yasuo.q.tornado","temp","spin1","red","lol.auto_clear"],item_display:"head",item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100002f]}}},Passengers:[{id:"area_effect_cloud",Duration:20,Tags:["cd","red","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run summon minecraft:item_display ~ ~ ~ {teleport_duration:1,interpolation_duration:10,Tags:["yasuo.q.tornado","temp","spin1","blue","lol.auto_clear"],item_display:"head",item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100002f]}}},Passengers:[{id:"area_effect_cloud",Duration:20,Tags:["cd","blue","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    tp @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] ~ ~ ~ ~ 0
    execute as @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
    data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    data modify entity @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] transformation.translation set value [0.0,3.0,0.0]
    tag @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] remove temp
    #schedule function _animation:spin1 2t append

    tag @s remove full_q
    execute if entity @s[team=red] run kill @e[tag=yasuo.q.stackcd,type=area_effect_cloud,tag=red]
    execute if entity @s[team=blue] run kill @e[tag=yasuo.q.stackcd,type=area_effect_cloud,tag=blue]
}

function r.animation {
    #particle minecraft:explosion ~ ~ ~ 0 0 0 0 1 force
    particle minecraft:instant_effect ~ ~ ~ 0.5 0.5 0.5 1 5 force

    execute positioned ^ ^1 ^-2 facing entity @s feet on origin run function yasuo:skills/r.blink

    execute if entity @s[tag=red] as @e[tag=yasuo.r.target,team=!red,type=!#unvalid] on vehicle run tp ~ ~ ~
    execute if entity @s[tag=blue] as @e[tag=yasuo.r.target,team=!blue,type=!#unvalid] on vehicle run tp ~ ~ ~

    execute if entity @s[nbt={Age:0}] positioned ~1.5 ~ ~1.5 run summon minecraft:armor_stand ~ ~ ~ {Tags:["yasuo.r.particle","unvalid","up"],Rotation:[135.0f,45.0f],Pose:{Head:[45.0f,0.0f,0.0f]},Invisible:1,Marker:1,Passengers:[{id:"area_effect_cloud",Duration:7,Tags:["yasuo.r.particle.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],equipment:{head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100411f]}}}}}
    execute if entity @s[nbt={Age:8}] positioned ~-1.5 ~ ~-1.5 run summon minecraft:armor_stand ~ ~ ~ {Tags:["yasuo.r.particle","unvalid","side"],Rotation:[0.0f,0.0f],Pose:{Head:[0.0f,0.0f,90.0f]},Invisible:1,Marker:1,Passengers:[{id:"area_effect_cloud",Duration:7,Tags:["yasuo.r.particle.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],equipment:{head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100411f]}}}}}
    execute if entity @s[nbt={Age:15}] positioned ~-1.75 ~ ~ run summon minecraft:armor_stand ~ ~ ~ {Tags:["yasuo.r.particle","unvalid","down"],Rotation:[-90.0f,-45.0f],Pose:{Head:[-45.0f,0.0f,0.0f]},Invisible:1,Marker:1,Passengers:[{id:"area_effect_cloud",Duration:7,Tags:["yasuo.r.particle.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],equipment:{head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100411f]}}}}}

    execute if entity @s[nbt={Age:4}] run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force
    execute if entity @s[nbt={Age:12}] run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force
    execute if entity @s[nbt={Age:19}] run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force

    execute if entity @s[nbt={Age:19}] run function yasuo:skills/r.end
}

function r.blink {
    execute on vehicle run tp @s ~ ~ ~ ~ ~
    execute on vehicle on passengers run kill @s[tag=cd]

    tp @s ~ ~ ~ ~ ~
}

function r.buff.end {
    tag @s remove yasuo.r.buff
    scoreboard players remove @s armor.pen 50
}

function r.damage {
    execute if entity @s[team=red] run damage @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 500
    scoreboard players operation dmg temp = @s attack_damage
    scoreboard players operation dmg temp *= 150 integer
    scoreboard players operation dmg temp /= 100 integer

    scoreboard players operation @s dmg_physical.deal += dmg temp

    function _champion:dmg/calc.debuff
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=yasuo.r.target,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=red] if entity @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!red] run function yasuo:skills/r.damage

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=yasuo.r.target,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=blue] if entity @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!blue] run function yasuo:skills/r.damage
}

function r.end {
    execute if entity @s[tag=red] on origin at @s run function yasuo:skills/r.end.position

    execute if entity @s[tag=red] run tag @e[tag=yasuo.r.target,type=!#unvalid,team=!red] add temp_dmg

    execute if entity @s[tag=blue] on origin at @s run function yasuo:skills/r.end.position

    execute if entity @s[tag=blue] run tag @e[tag=yasuo.r.target,type=!#unvalid,team=!blue] add temp_dmg

    execute on origin run function yasuo:skills/r.damage

    execute if entity @s[tag=red] on origin run scoreboard players add @s[tag=!yasuo.r.buff] armor.pen 50
    execute if entity @s[tag=red] run summon area_effect_cloud ~ ~ ~ {Duration:300,Tags:["yasuo.r.buff","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=red] on origin run tag @s add yasuo.r.buff

    execute if entity @s[tag=red] as @e[tag=airborne,tag=yasuo.r.target,team=!red,type=!#unvalid] on vehicle run data modify entity @s Motion set value [0.0,-1.0,0.0]
    execute if entity @s[tag=red] as @e[tag=airborne,tag=yasuo.r.target,team=!red,type=!#unvalid] on vehicle run data modify entity @s NoGravity set value 0

    execute if entity @s[tag=red] run tag @e[tag=yasuo.r.target,team=!red] remove yasuo.r.target
    execute on origin as @s[team=red] positioned as @e[tag=yasuo.r.end.position,type=area_effect_cloud,tag=red,limit=1,sort=nearest] run tp @s ~ ~1 ~

    execute if entity @s[tag=blue] on origin run scoreboard players add @s[tag=!yasuo.r.buff] armor.pen 50
    execute if entity @s[tag=blue] run summon area_effect_cloud ~ ~ ~ {Duration:300,Tags:["yasuo.r.buff","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=blue] on origin run tag @s add yasuo.r.buff

    execute if entity @s[tag=blue] as @e[tag=airborne,tag=yasuo.r.target,team=!blue,type=!#unvalid] on vehicle run data modify entity @s Motion set value [0.0,-1.0,0.0]
    execute if entity @s[tag=blue] as @e[tag=airborne,tag=yasuo.r.target,team=!blue,type=!#unvalid] on vehicle run data modify entity @s NoGravity set value 0

    execute if entity @s[tag=blue] run tag @e[tag=yasuo.r.target,team=!blue] remove yasuo.r.target
    execute on origin as @s[team=blue] positioned as @e[tag=yasuo.r.end.position,type=area_effect_cloud,tag=blue,limit=1,sort=nearest] run tp @s ~ ~1 ~

    execute on origin at @s run function yasuo:skills/r.end.particle
    execute on origin at @s rotated ~ 0 positioned ~ ~0.2 ~ run function yasuo:skills/r.particle.end
    execute on origin run tag @s remove r.animation
}

function r.end.particle {
    particle end_rod ~ ~ ~ 0 0 0 0.1 100 force
    particle cloud ~ ~0.2 ~ 1.5 0 1.5 0.03 100 force
    #particle minecraft:dust 0.5 0.7 1 2 ~ ~ ~ 1.5 0 1.5 1 500 force
    particle campfire_cosy_smoke ~ ~0.2 ~ 1.5 0 1.5 0.05 20 force
}

function r.end.position {
    execute unless block ~ ~ ~ #like_air if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:1,Tags:["yasuo.r.end.position","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute unless block ~ ~ ~ #like_air if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:1,Tags:["yasuo.r.end.position","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if block ~ ~ ~ #like_air positioned ~ ~-1 ~ run function yasuo:skills/r.end.position
}

function r.particle {
    tp @s[tag=up] ~ ~ ~ ~ ~-10
    tp @s[tag=side] ~ ~ ~ ~-10 ~
    tp @s[tag=down] ~ ~ ~ ~ ~10
    data modify entity @s[tag=!side] Pose.Head[0] set from entity @s[tag=!side] Rotation[1]

    execute unless entity @e[tag=yasuo.r.particle.cd,distance=..0.01,type=minecraft:area_effect_cloud] run kill @s
}

