    execute if entity @s[tag=blue] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!blue,tag=!cd] on passengers run kill @s
    execute if entity @s[tag=blue] positioned ^ ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!blue,tag=!cd] run kill @s
    execute if entity @s[tag=blue] positioned ^1 ^ ^ positioned ~-0.5 ~-1 ~-0.5 as @e[tag=block_by_windwall,type=#unvalid,dx=0,dz=0,dy=2,tag=!blue,tag=!cd] on passengers run kill @s
