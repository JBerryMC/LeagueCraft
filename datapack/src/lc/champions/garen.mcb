# lc:champions/garen/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking garen; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.garen
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.aatrox
    playsound minecraft:garen.select master @s ~ ~ ~
    playsound minecraft:garen.sfx.select master @s ~ ~ ~
}

function aa {
    execute if entity @s[tag=!garen.q] run playsound garen.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=garen.q] run playsound garen.sfx.q.aa master @a ~ ~ ~
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:garen"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:garen/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:garen/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:garen/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:garen/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:garen/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## p
    execute if score @s cd_p matches 0 run scoreboard players set @s status.p 1
    execute if score @s cd_p matches 1.. run scoreboard players set @s status.p 0

    ## Q
    execute if entity @s[tag=garen.q] run scoreboard players set @s status.q 9

    ## E
    execute if entity @s[tag=garen.e] if score @s garen.e.duration matches 41.. run scoreboard players set @s status.e 9
    execute if entity @s[tag=garen.e] if score @s garen.e.duration matches ..40 run scoreboard players set @s status.e 2

    function lc:champions/garen/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=garen.e.particle,type=area_effect_cloud] at @s run function lc:champions/garen/skills/e.particle

    execute as @e[tag=garen.r.fx,type=area_effect_cloud] at @s run function lc:champions/garen/skills/r.animation
}

function main {
    ## HUD
    function lc:champions/garen/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/garen/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/garen/item/offhand

    function lc:champions/garen/passive

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r

    ## Q
    execute if entity @s[team=red,tag=garen.q] unless entity @e[tag=garen.q.cd,tag=red] run function lc:champions/garen/skills/q.end
    execute if entity @s[team=blue,tag=garen.q] unless entity @e[tag=garen.q.cd,tag=blue] run function lc:champions/garen/skills/q.end

    execute if entity @s[tag=garen.q] run particle dust{color:[0.7,1,1],scale:0.5} ^ ^0.5 ^ 0.1 0.5 0.1 1 50 force
}

function passive {
    execute if score @s cd_p matches 0 if score @s hp.left < @s hp.max anchored eyes run particle happy_villager ^ ^-0.5 ^ 0.1 0.2 0.1 1 1 force
}

function use_e {
    function lc:champion/abilities/cooldown/e
    playsound minecraft:garen.sfx.e master @a ~ ~ ~

    scoreboard players set @s status.weapon 1200103
    scoreboard players set @s garen.e.duration 60
    tag @s add garen.e
    tag @s add update.fx.garen.e
    scoreboard players set @s aa.cd 9999

    # x = aa.spd - 10 / 2
    # y = 7 + x
    # z = 60 / y
    # z = Duration

    ## Attack speed scaling
    scoreboard players operation temp aa.spd = @s aa.spd
    scoreboard players remove temp aa.spd 10
    scoreboard players operation temp aa.spd /= 2 integer

    ## Spin how many times
    scoreboard players add temp aa.spd 7
    scoreboard players operation @s garen.e.count = @s garen.e.duration
    scoreboard players operation @s garen.e.count /= temp aa.spd

    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:60,Tags:["garen.e.particle","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:60,Tags:["garen.e.particle","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run summon item_display ~ ~ ~ {Tags:["<%team%>","garen.e.cd","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:60,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=<%team%>] run function lc:champions/garen/skills/e.spin
    }
}

function use_q {
    function lc:champion/abilities/cooldown/q
    playsound minecraft:garen.sfx.q master @a ~ ~ ~

    effect clear @s slowness
    effect give @s speed 4 1 false
    scoreboard players set @s aa.cd 0

    tag @s add garen.q
    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:72,Tags:["garen.q.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:72,Tags:["garen.q.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_r {
    function lc:champion/abilities/cooldown/r

    scoreboard players set @s channeling 10
    playsound minecraft:garen.sfx.r master @a ~ ~ ~ 2
    playsound minecraft:garen.ultimate master @a ~ ~ ~ 2
    tag @s add r.animation

    execute if entity @s[tag=garen.e,team=red] as @e[tag=garen.e.cd,tag=red] run function lc:champions/garen/skills/e.end

    execute if entity @s[team=red] run summon item_display ~ ~ ~ {Tags:["red","garen.r","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=red] run tag @e[tag=garen.r.temp_target,team=!red] add garen.r.target
    execute if entity @s[team=red] run scoreboard players set @e[tag=garen.r.target,team=!red] fx.sight 20
    execute if entity @s[team=red] positioned as @e[tag=garen.r.target,team=!red,limit=1,sort=nearest] run summon item_display ~ ~20 ~ {teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1200401f]}}},Tags:["red","garen.r.fx","temp","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[tag=garen.e,team=blue] as @e[tag=garen.e.cd,tag=blue] run function lc:champions/garen/skills/e.end

    execute if entity @s[team=blue] run summon item_display ~ ~ ~ {Tags:["blue","garen.r","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run tag @e[tag=garen.r.temp_target,team=!blue] add garen.r.target
    execute if entity @s[team=blue] run scoreboard players set @e[tag=garen.r.target,team=!blue] fx.sight 20
    execute if entity @s[team=blue] positioned as @e[tag=garen.r.target,team=!blue,limit=1,sort=nearest] run summon item_display ~ ~20 ~ {teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1200401f]}}},Tags:["blue","garen.r.fx","temp","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
}

function use_r.check {
    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!garen.r.temp_target] add garen.r.temp_target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=champion,dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=garen.r.temp_target] at @s run function lc:champions/garen/use_r

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=garen.r.temp_target,limit=1,sort=nearest] remove garen.r.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!garen.r.temp_target] add garen.r.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=champion,dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=garen.r.temp_target] at @s run function lc:champions/garen/use_r

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[tag=champion,dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=garen.r.temp_target,limit=1,sort=nearest] remove garen.r.temp_target

    execute if entity @s[distance=..5] if score @s cd_r matches 0 positioned ^ ^ ^0.1 run function lc:champions/garen/use_r.check
}

function use_w {
    function lc:champion/abilities/cooldown/w

    playsound minecraft:garen.sfx.w master @a ~ ~ ~

    tag @s add update.shield.garen
    tag @s add garen.w

    scoreboard players add @s dmg_reduction 30
    scoreboard players add @s fx.cc_immune 15

    scoreboard players operation garen.w.armor temp = @s armor
    scoreboard players operation garen.w.armor temp *= 20 integer
    scoreboard players operation garen.w.armor temp /= 100 integer

    scoreboard players operation @s armor += garen.w.armor temp

    scoreboard players operation garen.w.mr temp = @s magic_resist
    scoreboard players operation garen.w.mr temp *= 20 integer
    scoreboard players operation garen.w.mr temp /= 100 integer

    scoreboard players operation @s magic_resist += garen.w.mr temp

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run scoreboard players operation <%team%>.garen.w.armor temp = garen.w.armor temp
        execute if entity @s[team=<%team%>] run scoreboard players operation <%team%>.garen.w.mr temp = garen.w.mr temp
        execute if entity @s[team=<%team%>] run summon item_display ~ ~ ~ {Tags:["<%team%>","garen.w","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:80,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    }

    summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:999999,Tags:["shield.all","new"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Tags:["cd"],Duration:15,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID
    scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all = @s hp.max
    scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all *= 8 integer
    scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all /= 100 integer
    scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all
    tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new
}

# ---- item: lc:champions/garen/item/... -----------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]
        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:"Garen",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:"Garen",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[1200001f]},minecraft:custom_name={text:" ",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/garen/skills/... -------------------------------------------
dir skills {
    function e.damage {
        execute if entity @s[team=red] run damage @e[tag=garen.e.hit,tag=garen.e.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 2 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=garen.e.hit,tag=garen.e.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 2 lc:core/dmg_physical by @s

        scoreboard players operation temp attack_damage = @s attack_damage
        scoreboard players operation temp attack_damage *= 40 integer
        scoreboard players operation temp attack_damage /= 100 integer

        scoreboard players add temp attack_damage 30
        scoreboard players operation @s dmg_physical.deal = temp attack_damage

        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=garen.e.hit,tag=has_health_bar,tag=garen.e.temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=garen.e.hit,tag=has_health_bar,tag=garen.e.temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=garen.e.hit,type=!#unvalid,tag=garen.e.temp_dmg,limit=1,sort=nearest] remove garen.e.temp_dmg

        execute if entity @s[team=red] run execute if entity @e[tag=garen.e.hit,tag=garen.e.temp_dmg,type=!#unvalid,team=!red] run function lc:champions/garen/skills/e.damage

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=garen.e.hit,tag=has_health_bar,tag=garen.e.temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=garen.e.hit,tag=has_health_bar,tag=garen.e.temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=garen.e.hit,type=!#unvalid,tag=garen.e.temp_dmg,limit=1,sort=nearest] remove garen.e.temp_dmg

        execute if entity @s[team=blue] run execute if entity @e[tag=garen.e.hit,tag=garen.e.temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/garen/skills/e.damage
    }

    function e.end {
        stopsound @a master garen.sfx.e

        execute if entity @s[tag=red] as @p[tag=garen,team=red] run tag @s add remove.fx.garen.e
        execute if entity @s[tag=red] as @p[tag=garen,team=red] run scoreboard players set @s status.weapon 1200102

        execute if entity @s[tag=red] as @e[tag=garen.e,tag=red] on passengers run kill @s
        execute if entity @s[tag=red] as @e[tag=garen.e,tag=red] run kill @s
        execute if entity @s[tag=red] as @p[tag=garen,team=red] run scoreboard players operation @s garen.e.duration /= 20 integer
        execute if entity @s[tag=red] as @p[tag=garen,team=red] run scoreboard players operation @s cd_e -= @s garen.e.duration
        execute if entity @s[tag=red] run tag @p[tag=garen,team=red] remove garen.e
        execute if entity @s[tag=red] run scoreboard players set @p[tag=garen,team=red] aa.cd 0
        execute if entity @s[tag=red] on passengers run kill @s
        execute if entity @s[tag=red] run kill @s

        execute if entity @s[tag=blue] as @p[tag=garen,team=blue] run tag @s add remove.fx.garen.e
        execute if entity @s[tag=blue] as @p[tag=garen,team=blue] run scoreboard players set @s status.weapon 1200102
        execute if entity @s[tag=blue] as @e[tag=garen.e,tag=blue] on passengers run kill @s
        execute if entity @s[tag=blue] as @e[tag=garen.e,tag=blue] run kill @s
        execute if entity @s[tag=blue] as @p[tag=garen,team=blue] run scoreboard players operation @s garen.e.duration /= 20 integer
        execute if entity @s[tag=blue] as @p[tag=garen,team=blue] run scoreboard players operation @s cd_e -= @s garen.e.duration
        execute if entity @s[tag=blue] run tag @p[tag=garen,team=blue] remove garen.e
        execute if entity @s[tag=blue] run scoreboard players set @p[tag=garen,team=blue] aa.cd 0
        execute if entity @s[tag=blue] on passengers run kill @s
        execute if entity @s[tag=blue] run kill @s
    }

    function e.particle {
        tp @s ~ ~ ~ ~-36 0

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] positioned as @p[tag=garen.e,team=<%team%>] rotated ~ ~ positioned ^ ^1 ^2 run particle dust{color:[1,0.867,0],scale:1.5} ^ ^ ^ 0 0 0 0 1 force
            execute if entity @s[tag=<%team%>] positioned as @p[tag=garen.e,team=<%team%>] rotated ~6 ~ positioned ^ ^1 ^2 run particle dust{color:[1,0.867,0],scale:1.25} ^ ^ ^ 0 0 0 0 1 force
            execute if entity @s[tag=<%team%>] positioned as @p[tag=garen.e,team=<%team%>] rotated ~12 ~ positioned ^ ^1 ^2 run particle dust{color:[1,0.867,0],scale:1} ^ ^ ^ 0 0 0 0 1 force
            execute if entity @s[tag=<%team%>] positioned as @p[tag=garen.e,team=<%team%>] rotated ~18 ~ positioned ^ ^1 ^2 run particle dust{color:[1,0.867,0],scale:0.75} ^ ^ ^ 0 0 0 0 1 force
            execute if entity @s[tag=<%team%>] positioned as @p[tag=garen.e,team=<%team%>] rotated ~24 ~ positioned ^ ^1 ^2 run particle dust{color:[1,0.867,0],scale:0.5} ^ ^ ^ 0 0 0 0 1 force
            execute if entity @s[tag=<%team%>] positioned as @p[tag=garen.e,team=<%team%>] rotated ~30 ~ positioned ^ ^1 ^2 run particle dust{color:[1,0.867,0],scale:0.25} ^ ^ ^ 0 0 0 0 1 force
        }
    }

    function e.spin {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] positioned ~-2.5 ~ ~-2.5 run tag @e[team=!<%team%>,dx=4,dz=4,dy=1,type=!#unvalid,tag=!unvalid] add garen.e.hit
            execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=garen.e.hit] add garen.e.temp_dmg
            execute if entity @s[team=<%team%>] if entity @e[team=!<%team%>,tag=garen.e.hit] run function lc:champions/garen/skills/e.damage
            execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=garen.e.hit] remove garen.e.hit
            execute if entity @s[team=<%team%>] run summon item_display ~ ~ ~ {Tags:["<%team%>","garen.e","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:9999,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
            execute if entity @s[team=<%team%>] as @e[tag=garen.e,type=item_display,tag=<%team%>] on passengers store result entity @s Duration int 1 run scoreboard players get @p[tag=garen,team=<%team%>] garen.e.count
        }
    }

    function passive.healing {
        scoreboard players operation @s healing = @s hp.max
        scoreboard players operation @s healing *= 2 integer
        scoreboard players operation @s healing /= 100 integer
    }

    function q.damage {
        function lc:champions/garen/skills/q.end
        execute if entity @s[team=red] run scoreboard players add @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] cc.silence 30
        execute if entity @s[team=blue] run scoreboard players add @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] cc.silence 30

        scoreboard players operation garen.q.temp_dmg attack_damage = @s attack_damage
        scoreboard players operation garen.q.temp_dmg attack_damage *= 50 integer
        scoreboard players operation garen.q.temp_dmg attack_damage /= 100 integer
        scoreboard players add garen.q.temp_dmg attack_damage 150

        scoreboard players operation @s dmg_physical.deal += garen.q.temp_dmg attack_damage
    }

    function q.end {
        function lc:champion/abilities/cooldown/q
        stopsound @a master garen.sfx.q

        effect clear @s speed
        execute if entity @s[team=red] run kill @e[tag=garen.q.cd,tag=red]
        execute if entity @s[team=blue] run kill @e[tag=garen.q.cd,tag=blue]
        tag @s remove garen.q
    }

    function r.animation {
        tp @s ~ ~-2 ~ ~20 0
        execute if entity @s[tag=red] run data modify entity @s Pos[0] set from entity @e[tag=garen.r.target,team=!red,limit=1,sort=nearest] Pos[0]
        execute if entity @s[tag=red] run data modify entity @s Pos[2] set from entity @e[tag=garen.r.target,team=!red,limit=1,sort=nearest] Pos[2]

        execute if entity @s[tag=blue] run data modify entity @s Pos[0] set from entity @e[tag=garen.r.target,team=!red,limit=1,sort=nearest] Pos[0]
        execute if entity @s[tag=blue] run data modify entity @s Pos[2] set from entity @e[tag=garen.r.target,team=!blue,limit=1,sort=nearest] Pos[2]
    }

    function r.damage {
        execute if entity @s[team=red] run damage @e[tag=garen.r.target,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 lc:core/dmg_true by @s
        execute if entity @s[team=blue] run damage @e[tag=garen.r.target,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 lc:core/dmg_true by @s

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation temp1 dmg_true.raw = @e[tag=garen.r.target,type=!#unvalid,team=!<%team%>,limit=1,sort=nearest] hp.max
            execute if entity @s[team=<%team%>] run scoreboard players operation temp2 dmg_true.raw = @e[tag=garen.r.target,type=!#unvalid,team=!<%team%>,limit=1,sort=nearest] hp.left
        }

        scoreboard players operation temp1 dmg_true.raw -= temp2 dmg_true.raw
        scoreboard players operation temp1 dmg_true.raw *= 30 integer
        scoreboard players operation temp1 dmg_true.raw /= 100 integer

        scoreboard players add temp1 dmg_true.raw 450

        scoreboard players operation @s dmg_true.deal = temp1 dmg_true.raw

        function lc:champion/dmg/calc.debuff
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=garen.r.target,tag=has_health_bar,limit=1,sort=nearest] dmg_true.raw = @s dmg_true.deal
            execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=garen.r.target,tag=has_health_bar,limit=1,sort=nearest] remove garen.r.target
        }
    }

