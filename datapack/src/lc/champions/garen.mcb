    function r.spawn {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] at @e[tag=garen.r.target,team=!<%team%>] rotated ~ 0 positioned ~ ~0.5 ~ run function lc:champions/garen/skills/r.particle
            execute if entity @s[tag=<%team%>] at @e[tag=garen.r.target,team=!<%team%>] rotated ~ 0 positioned ~ ~0.5 ~ run function lc:champions/garen/skills/r.particle.end
            execute if entity @s[tag=<%team%>] at @e[tag=garen.r.target,team=!<%team%>] run particle flash{color:[1.0f,1.0f,1.0f,1.0f]} ~ ~ ~ 0 0 0 1 10 force
            execute if entity @s[tag=<%team%>] at @e[tag=garen.r.target,team=!<%team%>] run particle explosion ~ ~ ~ 0 0 0 1 10 force
            execute if entity @s[tag=<%team%>] as @p[tag=garen,team=<%team%>] run function lc:champions/garen/skills/r.damage
            execute if entity @s[tag=<%team%>] run tag @p[tag=garen,team=<%team%>] remove r.animation
        }
    }

    function w.end {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] run scoreboard players remove @p[tag=garen,team=<%team%>] dmg_reduction 30
            execute if entity @s[tag=<%team%>] run scoreboard players operation @p[tag=garen,team=<%team%>] armor -= <%team%>.garen.w.armor temp
            execute if entity @s[tag=<%team%>] run scoreboard players operation @p[tag=garen,team=<%team%>] magic_resist -= <%team%>.garen.w.mr temp
            execute if entity @s[tag=<%team%>] run tag @p[tag=garen,team=<%team%>] remove garen.w
        }
    }
}
