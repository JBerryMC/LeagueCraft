    function q.position {
        execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=red] run summon item_display ~ ~ ~ {Tags:["lol.auto_clear","red","soraka.q"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:20,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=blue] run summon item_display ~ ~ ~ {Tags:["lol.auto_clear","blue","soraka.q"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:20,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        execute if block ~ ~ ~ #like_air if block ~ ~-1 ~ #like_air positioned ~ ~-1 ~ run function lc:champions/soraka/skills/q.position

        execute unless block ~ ~ ~ #like_air positioned ~ ~1 ~ run function lc:champions/soraka/skills/q.position
    }

    function q.projectile {
        particle end_rod ~ ~ ~ 0.2 0.2 0.2 0.01 2 force
        particle dust{color:[0.918,0.475,0.404],scale:1.5} ~ ~ ~ 0.2 0.2 0.2 0 2 force

        execute if entity @s[tag=red] as @e[tag=soraka.q,tag=red] at @s run particle end_rod ^ ^ ^3 0 0 0 0 1 force @a
        execute if entity @s[tag=red] as @e[tag=soraka.q,tag=red] at @s run particle end_rod ^ ^ ^-3 0 0 0 0 1 force @a
        execute if entity @s[tag=red] as @e[tag=soraka.q,tag=red] at @s run tp @s ~ ~ ~ ~9 ~

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] facing entity @e[tag=soraka.q,tag=<%team%>,limit=1] feet run tp @s ^ ^ ^0.5
            execute if entity @s[tag=<%team%>] if entity @e[tag=soraka.q,tag=<%team%>,distance=..1] run stopsound @a master soraka.sfx.q
            execute if entity @s[tag=<%team%>] if entity @e[tag=soraka.q,tag=<%team%>,distance=..1] run playsound soraka.sfx.q.hit master @a ~ ~ ~
            execute if entity @s[tag=<%team%>] as @e[tag=soraka.q,tag=<%team%>,distance=..1] at @s run function lc:champions/soraka/skills/q.particle
            execute if entity @s[tag=<%team%>] as @e[tag=soraka.q,tag=<%team%>,distance=..1] at @s positioned ~-3 ~-0.5 ~-3 run tag @e[team=!<%team%>,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add soraka.q.hit
            execute if entity @s[tag=<%team%>] if entity @e[tag=champion,tag=soraka.q.hit,team=!<%team%>] as @e[tag=soraka.q,tag=<%team%>,distance=..1] at @s run function lc:champions/soraka/skills/q.refund
            execute if entity @s[tag=<%team%>] run effect give @e[team=!<%team%>,tag=soraka.q.hit] slowness 2 4 false
            execute if entity @s[tag=<%team%>] run scoreboard players set @e[team=!<%team%>,tag=soraka.q.hit] fx.sight 10
            execute if entity @s[tag=<%team%>] run tag @e[team=!<%team%>,tag=soraka.q.hit] add soraka.q.temp_dmg
            execute if entity @s[tag=<%team%>] if entity @e[tag=soraka.q.hit,team=!<%team%>] as @p[tag=soraka,team=<%team%>] run function lc:champions/soraka/skills/q.damage
            execute if entity @s[tag=<%team%>] run tag @e[team=!<%team%>,tag=soraka.q.hit] remove soraka.q.hit
            execute if entity @s[tag=<%team%>] if entity @e[tag=soraka.q,tag=<%team%>,distance=..1] run kill @s
        }
    }

    function q.refund {
        summon item_display ~ ~1 ~ {teleport_duration:1,Tags:["soraka.q.refund","homing","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] as @p[tag=soraka,team=red] run data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID
        execute if entity @s[tag=blue] as @p[tag=soraka,team=blue] run data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

        execute as @e[tag=soraka.q.refund,tag=temp,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
        execute as @e[tag=soraka.q.refund,tag=temp,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
        tag @e[tag=soraka.q.refund,tag=temp,limit=1,sort=nearest] remove temp
    }

    function r.cast {
        execute if entity @s[tag=soraka.r.fx] run particle wax_on ~ ~10 ~ 0.5 10 0.5 0.5 200 force @a

        execute rotated ~ ~ run particle happy_villager ^ ^ ^1 0 0 0 0 1 force @a
        execute rotated ~-40 ~ run particle happy_villager ^ ^-0.16 ^1 0 0 0 0 1 force @a
        execute rotated ~-30 ~ run particle happy_villager ^ ^-0.12 ^1 0 0 0 0 1 force @a
        execute rotated ~-20 ~ run particle happy_villager ^ ^-0.08 ^1 0 0 0 0 1 force @a
        execute rotated ~-10 ~ run particle happy_villager ^ ^-0.04 ^1 0 0 0 0 1 force @a

        tp @s ~ ~0.2 ~ ~45 ~
    }

    function r.healing {
        scoreboard players operation @s healing = @s ability_power
        scoreboard players operation @s healing *= 50 integer
        scoreboard players operation @s healing /= 100 integer
        scoreboard players add @s healing 500

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] at @e[tag=is_heal_target,team=<%team%>] anchored eyes run particle heart ^ ^-0.5 ^ 0.2 0.2 0.2 1 5 force
            execute if entity @s[team=<%team%>] at @e[tag=is_heal_target,team=<%team%>] anchored eyes run particle happy_villager ^ ^-0.5 ^ 0.5 0.5 0.5 0.1 50 force
        }
    }

    function w.healing {
        scoreboard players operation @s healing = @s ability_power
        scoreboard players operation @s healing *= 50 integer
        scoreboard players operation @s healing /= 100 integer
        scoreboard players add @s healing 170

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] at @e[tag=is_heal_target,team=<%team%>] anchored eyes run particle heart ^ ^-0.5 ^ 0.2 0.2 0.2 1 5 force
            execute if entity @s[team=<%team%>] at @e[tag=is_heal_target,team=<%team%>] anchored eyes run particle happy_villager ^ ^-0.5 ^ 0.5 0.5 0.5 0.1 20 force
        }
    }
}
