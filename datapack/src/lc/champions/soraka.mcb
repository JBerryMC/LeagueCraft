# lc:champions/soraka/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking soraka; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.soraka
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.ashe
    tag @s add useMana
    scoreboard players set @s healnshield_power 40
    scoreboard players operation @s mana = @s mana.max
    playsound minecraft:soraka.select master @a ~ ~ ~
    playsound minecraft:soraka.sfx.select master @a ~ ~ ~
}

function aa {
    playsound soraka.sfx.aa master @a ~ ~ ~

    execute if entity @s[team=red] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.soraka","aa","homing","red","temp","block_by_windwall"],item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.soraka","aa","homing","blue","temp","block_by_windwall"],item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:soraka"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:soraka/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:soraka/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:soraka/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:soraka/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:soraka/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## P
    execute if entity @s[tag=passive.active] run scoreboard players set @s status.p 1

    ## W
    execute if score @s hp.percentage matches ..4 run scoreboard players set @s status.w 8

    function lc:champions/soraka/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=soraka.q.projectile,type=area_effect_cloud] at @s run function lc:champions/soraka/skills/q.projectile

    execute as @e[tag=soraka.e,type=item_display] at @s run function lc:champions/soraka/skills/e.animation

    execute as @e[tag=soraka.fx,type=area_effect_cloud] at @s run function lc:champions/soraka/skills/r.cast
}

function main {
    ## HUD
    function lc:champions/soraka/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/soraka/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/soraka/item/offhand

    function lc:champions/soraka/passive

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r
}

function passive {
    execute if entity @s[team=red] if predicate lc:champions/soraka/look_at_red run tag @s add passive.active
    execute if entity @s[team=red] if predicate lc:champions/soraka/look_at_red run effect give @s speed 1 9 false
    execute if entity @s[team=red] if predicate lc:champions/soraka/look_at_red anchored feet run particle instant_effect ^ ^ ^ 0.2 0.1 0.2 1 2 force

    execute if entity @s[team=red] unless predicate lc:champions/soraka/look_at_red run effect clear @s[tag=passive.active] speed
    execute if entity @s[team=red] unless predicate lc:champions/soraka/look_at_red run tag @s[tag=passive.active] remove passive.active

    execute if entity @s[team=blue] if predicate lc:champions/soraka/look_at_red run tag @s add passive.active
    execute if entity @s[team=blue] if predicate lc:champions/soraka/look_at_red run effect give @s speed 1 9 false
    execute if entity @s[team=blue] if predicate lc:champions/soraka/look_at_red anchored feet run particle instant_effect ^ ^ ^ 0.2 0.1 0.2 1 2 force

    execute if entity @s[team=blue] unless predicate lc:champions/soraka/look_at_red run effect clear @s[tag=passive.active] speed
    execute if entity @s[team=blue] unless predicate lc:champions/soraka/look_at_red run tag @s[tag=passive.active] remove passive.active
}

function use_e {
    function lc:champion/abilities/cooldown/e

    scoreboard players set @s channeling 5

    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:2,Tags:["soraka.e.position"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] run data modify entity @e[tag=soraka.e.position,type=area_effect_cloud,limit=1,sort=nearest] Owner set from entity @s UUID
    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] as @e[tag=soraka.e.position,type=area_effect_cloud,limit=1,sort=nearest] at @s run function lc:champions/soraka/skills/e.position
}

function use_q {
    function lc:champion/abilities/cooldown/q
    playsound soraka.sfx.q master @a ~ ~ ~
    scoreboard players set @s channeling 5

    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:2,Tags:["soraka.q.position"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] run data modify entity @e[tag=soraka.q.position,type=area_effect_cloud,limit=1,sort=nearest] Owner set from entity @s UUID
    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] as @e[tag=soraka.q.position,type=area_effect_cloud,limit=1,sort=nearest] at @s run function lc:champions/soraka/skills/q.position

    execute if entity @s[team=red] anchored eyes run summon area_effect_cloud ^ ^3 ^ {WaitTime:0,Duration:20,Tags:["soraka.q.projectile","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] anchored eyes run summon area_effect_cloud ^ ^3 ^ {WaitTime:0,Duration:20,Tags:["soraka.q.projectile","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_r {
    function lc:champion/abilities/cooldown/r

    playsound minecraft:soraka.sfx.r master @a ~ ~ ~
    playsound minecraft:soraka.ultimate master @a ~ ~ ~

    scoreboard players set @s channeling 5

    execute if entity @s[team=red] as @e[tag=champion,team=red,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] at @s anchored eyes run summon area_effect_cloud ^ ^-0.5 ^ {WaitTime:0,Duration:12,Tags:["soraka.r.fx","soraka.fx"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] as @e[tag=champion,team=blue,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] at @s anchored eyes run summon area_effect_cloud ^ ^-0.5 ^ {WaitTime:0,Duration:12,Tags:["soraka.r.fx","soraka.fx"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[team=red] run tag @e[tag=champion,team=red,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] add is_heal_target
    execute if entity @s[team=blue] run tag @e[tag=champion,team=blue,type=!#unvalid,tag=!unvalid,tag=champion,tag=!dead] add is_heal_target
    function lc:champions/soraka/skills/r.healing
}

function use_w {
    function lc:champion/abilities/cooldown/w
    scoreboard players set @s channeling 5

    playsound minecraft:soraka.sfx.w master @a ~ ~ ~

    scoreboard players operation soraka.w.hp_cost temp = @s hp.max
    execute unless score @s soraka.passive matches 1.. run scoreboard players operation soraka.w.hp_cost temp *= 10 integer
    execute if score @s soraka.passive matches 1.. run scoreboard players operation soraka.w.hp_cost temp *= 2 integer
    scoreboard players operation soraka.w.hp_cost temp /= 100 integer

    execute if score @s hp.left > soraka.w.hp_cost temp run scoreboard players operation @s hp.left -= soraka.w.hp_cost temp
    execute if score @s hp.left <= soraka.w.hp_cost temp run scoreboard players set @s hp.left 1

    execute at @e[tag=soraka.w.temp_target] anchored eyes run summon area_effect_cloud ^ ^-0.5 ^ {WaitTime:0,Duration:5,Tags:["soraka.w.fx","soraka.fx"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>,scores={soraka.passive=1..}] run scoreboard players set @e[tag=soraka.w.temp_target,team=<%team%>,type=!#unvalid] soraka.passive 3
        execute if entity @s[team=<%team%>] run tag @e[tag=soraka.w.temp_target,team=<%team%>,type=!#unvalid] add is_heal_target
    }

    function lc:champions/soraka/skills/w.healing
}

function use_w.check {
    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!soraka.w.temp_target,tag=!soraka] add soraka.w.temp_target

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=champion,dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,tag=!soraka] at @s run function lc:champions/soraka/use_w

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,limit=1,sort=nearest,tag=!soraka] remove soraka.w.temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!soraka.w.temp_target,tag=!soraka] add soraka.w.temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=champion,dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,tag=!soraka] at @s run function lc:champions/soraka/use_w

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=soraka.w.temp_target,limit=1,sort=nearest,tag=!soraka] remove soraka.w.temp_target

    execute if entity @s[distance=..6] if score @s cd_w matches 0 positioned ^ ^ ^0.1 run function lc:champions/soraka/use_w.check
}

predicate look_at_blue {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:type_specific/player": {
            "looking_at": {
                "minecraft:nbt": "{Tags:[\"is_low_hp\"]}",
                "minecraft:team": "blue",
                "minecraft:distance": {
                    "absolute": {
                        "min": 0,
                        "max": 25
                    }
                }
            }
        },
        "minecraft:team": "blue"
    }
}

predicate look_at_red {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:type_specific/player": {
            "looking_at": {
                "minecraft:nbt": "{Tags:[\"is_low_hp\"]}",
                "minecraft:team": "red",
                "minecraft:distance": {
                    "absolute": {
                        "min": 0,
                        "max": 25
                    }
                }
            }
        },
        "minecraft:team": "red"
    }
}

# ---- item: lc:champions/soraka/item/... ----------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]
        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:"Soraka",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:"Soraka",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/soraka/skills/... ------------------------------------------
dir skills {
    function e.animation {
        tp @s ~ ~ ~ ~6 ~
        particle end_rod ^ ^ ^3 0 0 0 0 1 force @a
        particle end_rod ^ ^ ^-3 0 0 0 0 1 force @a

        execute if entity @s[tag=red] positioned ~-3 ~-0.5 ~-3 run scoreboard players set @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] cc.silence 2
        execute if entity @s[tag=blue] positioned ~-3 ~-0.5 ~-3 run scoreboard players set @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] cc.silence 2

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>,tag=!spawned] positioned ~-3 ~-0.5 ~-3 run tag @e[team=!<%team%>,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add soraka.e.hit
            execute if entity @s[tag=<%team%>,tag=!spawned] run tag @e[team=!<%team%>,tag=soraka.e.hit] add soraka.e.temp_dmg
            execute if entity @s[tag=<%team%>,tag=!spawned] if entity @e[tag=soraka.e.hit,team=!<%team%>] as @p[tag=soraka,team=<%team%>] run function lc:champions/soraka/skills/e.damage
            execute if entity @s[tag=<%team%>,tag=!spawned] run tag @e[team=!<%team%>,tag=soraka.e.hit] remove soraka.e.hit
        }

        tag @s add spawned

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] unless data entity @s Passengers positioned ~-3 ~-0.5 ~-3 run tag @e[team=!<%team%>,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add soraka.e.hit
            execute if entity @s[tag=<%team%>] unless data entity @s Passengers run scoreboard players set @e[team=!<%team%>,tag=soraka.e.hit] cc.root 40
            execute if entity @s[tag=<%team%>] unless data entity @s Passengers run tag @e[team=!<%team%>,tag=soraka.e.hit] add soraka.e.temp_dmg
            execute if entity @s[tag=<%team%>] unless data entity @s Passengers if entity @e[tag=soraka.e.hit,team=!<%team%>] as @p[tag=soraka,team=<%team%>] run function lc:champions/soraka/skills/e.damage
            execute if entity @s[tag=<%team%>] unless data entity @s Passengers run tag @e[team=!<%team%>,tag=soraka.e.hit] remove soraka.e.hit
        }
    }

    function e.damage {
        execute if entity @s[team=red] run damage @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s

        scoreboard players operation @s dmg_magic.deal = @s ability_power
        scoreboard players operation @s dmg_magic.deal *= 40 integer
        scoreboard players operation @s dmg_magic.deal /= 100 integer
        scoreboard players add @s dmg_magic.deal 170

        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=soraka.e.hit,type=!#unvalid,tag=soraka.e.temp_dmg,limit=1,sort=nearest] remove soraka.e.temp_dmg

        execute if entity @s[team=red] run execute if entity @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!red] run function lc:champions/soraka/skills/e.damage

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.e.hit,tag=has_health_bar,tag=soraka.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=soraka.e.hit,type=!#unvalid,tag=soraka.e.temp_dmg,limit=1,sort=nearest] remove soraka.e.temp_dmg

        execute if entity @s[team=blue] run execute if entity @e[tag=soraka.e.hit,tag=soraka.e.temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/soraka/skills/e.damage
    }

    function e.end {
        execute if entity @s[tag=red] if entity @e[tag=leona.e.dmg,team=!red] at @p[tag=leona,team=red] run tag @e[tag=leona.e.dmg,team=!red,limit=1,sort=furthest] add leona.e.target
        execute if entity @s[tag=red] if entity @e[tag=leona.e.dmg,team=!red] run tag @e[tag=leona.e.dmg,team=!red] remove leona.e.dmg

        execute if entity @s[tag=red] if entity @e[tag=leona.e.target,team=!red] run scoreboard players set @e[tag=leona.e.target,team=!red] cc.root 10
        execute if entity @s[tag=red] if entity @e[tag=leona.e.target,team=!red] as @p[tag=leona,team=red] at @s run function lc:champions/leona/use_e2

        execute if entity @s[tag=blue] if entity @e[tag=leona.e.dmg,team=!blue] at @p[tag=leona,team=blue] run tag @e[tag=leona.e.dmg,team=!blue,limit=1,sort=furthest] add leona.e.target
        execute if entity @s[tag=blue] if entity @e[tag=leona.e.dmg,team=!blue] run tag @e[tag=leona.e.dmg,team=!blue] remove leona.e.dmg

        execute if entity @s[tag=blue] if entity @e[tag=leona.e.target,team=!blue] run scoreboard players set @e[tag=leona.e.target,team=!blue] cc.root 10
        execute if entity @s[tag=blue] if entity @e[tag=leona.e.target,team=!blue] as @p[tag=leona,team=blue] at @s run function lc:champions/leona/use_e2
    }

    function e.position {
        execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air run playsound soraka.sfx.e master @a ~ ~ ~
        execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=red] run summon item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100301f]}}},Tags:["lol.auto_clear","red","soraka.e"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:30,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=blue] run summon item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[1100301f]}}},Tags:["lol.auto_clear","blue","soraka.e"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:30,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        execute if block ~ ~ ~ #like_air if block ~ ~-1 ~ #like_air positioned ~ ~-1 ~ run function lc:champions/soraka/skills/e.position

        execute unless block ~ ~ ~ #like_air positioned ~ ~1 ~ run function lc:champions/soraka/skills/e.position
    }

    function passive.healing {
        scoreboard players operation @s healing = @s ability_power
        scoreboard players operation @s healing *= 6 integer
        scoreboard players operation @s healing /= 100 integer
        scoreboard players add @s healing 48

        execute if entity @s[team=red] at @e[tag=is_heal_target,team=red] anchored eyes run particle happy_villager ^ ^-0.5 ^ 0.2 0.2 0.2 0.1 20 force

        execute if entity @s[team=blue] at @e[tag=is_heal_target,team=blue] anchored eyes run particle happy_villager ^ ^-0.5 ^ 0.2 0.2 0.2 0.1 20 force
    }

    function q.damage {
        execute if entity @s[team=red] run damage @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s

        scoreboard players operation @s dmg_magic.deal = @s ability_power
        scoreboard players operation @s dmg_magic.deal *= 35 integer
        scoreboard players operation @s dmg_magic.deal /= 100 integer
        scoreboard players add @s dmg_magic.deal 225

        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=soraka.q.hit,type=!#unvalid,tag=soraka.q.temp_dmg,limit=1,sort=nearest] remove soraka.q.temp_dmg

        execute if entity @s[team=red] run execute if entity @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!red] run function lc:champions/soraka/skills/q.damage

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=soraka.q.hit,tag=has_health_bar,tag=soraka.q.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=soraka.q.hit,type=!#unvalid,tag=soraka.q.temp_dmg,limit=1,sort=nearest] remove soraka.q.temp_dmg

        execute if entity @s[team=blue] run execute if entity @e[tag=soraka.q.hit,tag=soraka.q.temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/soraka/skills/q.damage
    }

