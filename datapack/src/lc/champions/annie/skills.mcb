# lc:champions/annie/skills/  (converted from the 1.20.2 LeagueCraft datapack)

function e.damage {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=annie.e.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=annie.e.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 40 integer
    scoreboard players operation temp ability_power /= 100 integer
    scoreboard players add temp ability_power 65

    scoreboard players operation @s dmg_magic.deal = temp ability_power
    function lc:champion/dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] remove annie.e.target

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=annie.e.target,limit=1,sort=nearest] remove annie.e.target
}

function e.shield {
    effect give @s speed 3 2 false
    execute if entity @s[tag=has_display_bar] run tag @s add update.shield.annie
    playsound annie.sfx.e master @a ~ ~ ~

    execute if entity @s[type=!player] on passengers as @s[tag=annie.e.shield] on passengers run kill @s
    execute if entity @s[type=!player] on passengers as @s[tag=annie.e.shield] run kill @s
    execute if entity @s[type=!player] run summon item_display ~ ~ ~ {interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}},Tags:["annie.e.shield","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[-22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[45.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"area_effect_cloud",Duration:50,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[type=!player] run ride @e[type=item_display,tag=temp,tag=annie.e.shield,limit=1,sort=nearest] mount @s
    execute if entity @s[type=!player] on passengers run data merge entity @s[tag=annie.e.shield] {transformation:{translation:[0.0,-0.6,0.0]}}
    execute if entity @s[type=!player] on passengers as @s[tag=annie.e.shield] on passengers run data merge entity @s {transformation:{translation:[0.0,-0.6,0.0]}}

    execute if entity @s[team=red] run scoreboard players operation temp shield.all = @p[tag=annie,team=red] ability_power
    execute if entity @s[team=red] run scoreboard players operation temp shield.all *= 40 integer
    execute if entity @s[team=red] run scoreboard players operation temp shield.all /= 100 integer

    execute if entity @s[team=blue] run scoreboard players operation temp shield.all = @p[tag=annie,team=blue] ability_power
    execute if entity @s[team=blue] run scoreboard players operation temp shield.all *= 40 integer
    execute if entity @s[team=blue] run scoreboard players operation temp shield.all /= 100 integer

    scoreboard players add temp shield.all 200

    summon area_effect_cloud ~ ~ ~ {Duration:999999,Tags:["annie.e","shield.all","new"],Passengers:[{id:"area_effect_cloud",Tags:["cd"],Duration:50,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID
    scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all = temp shield.all
    scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all
    tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new
}

function passive.end {
    tag @s remove malphite.passive
    scoreboard players operation @s armor -= @s malphite.bonus_armor
    scoreboard players set @s cd_p 8
}

function q.damage {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=annie.q.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=annie.q.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 75 integer
    scoreboard players operation temp ability_power /= 100 integer
    scoreboard players add temp ability_power 210

    scoreboard players operation @s dmg_magic.deal = temp ability_power
    function lc:champion/dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] remove annie.q.target

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=annie.q.target,limit=1,sort=nearest] remove annie.q.target
}

function q.hit {
    playsound annie.sfx.q.hit master @a ~ ~ ~

    execute if score @s annie.passive matches ..4 run scoreboard players add @s annie.passive 1
    execute if score @s annie.passive matches 5 run function lc:champions/annie/passive
    execute if entity @s[team=red] if entity @e[tag=annie.q.target,team=!red] run function lc:champions/annie/skills/q.damage
    execute if entity @s[team=blue] if entity @e[tag=annie.q.target,team=!blue] run function lc:champions/annie/skills/q.damage
}

function r.aa {
    execute store success score @s temp if predicate lc:core/roll/50
    playsound annie.sfx.r.aa master @a ~ ~ ~
    execute if score @s[tag=!is_rage] temp matches 1 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/aa/tween_play
    execute if score @s[tag=is_rage] temp matches 1 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/rage.aa/tween_play
    execute if score @s[tag=!is_rage] temp matches 0 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/aa2/tween_play
    execute if score @s[tag=is_rage] temp matches 0 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/rage.aa2/tween_play
}

function r.animation {
    particle flame ~ ~ ~ 0.5 0.2 0.5 0.01 10 force
    particle smoke ~ ~ ~ 0.5 0.2 0.5 0.01 10 force

    execute on passengers as @s[tag=owner] on origin run scoreboard players operation @s cd_r = @s annie.r.duration

    ## Movement
    execute store result score @s[tag=!is_dashing] mot_x run data get entity @s Motion[0] 1000
    execute store result score @s[tag=!is_dashing] mot_z run data get entity @s Motion[2] 1000
    execute if entity @s[scores={mot_x=0,mot_z=0},tag=is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/pause_all
    execute if entity @s[scores={mot_x=0,mot_z=0},tag=is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/idle/tween_play
    execute if entity @s[scores={mot_x=0,mot_z=0},tag=is_moving] run tag @s remove is_moving

    execute unless entity @s[scores={mot_x=0,mot_z=0}] if entity @s[tag=!is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/pause_all
    execute unless entity @s[scores={mot_x=0,mot_z=0}] if entity @s[tag=!is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/walk/tween_play
    execute unless entity @s[scores={mot_x=0,mot_z=0}] if entity @s[tag=!is_moving] run tag @s add is_moving

    ## Revenge
    execute if entity @s[tag=decay] run scoreboard players remove @s hp.left 25

    ## TARGET
    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run kill @e[tag=red.annie.r.move,dx=1,dz=1,dy=20]
    execute if entity @s[team=red] if entity @e[tag=annie.r.target,team=!red] run data modify entity @s angry_at set from entity @e[tag=annie.r.target,team=!red,limit=1,sort=nearest] UUID
    execute if entity @s[team=red] if entity @e[tag=annie.r.target,team=!red,distance=10..,tag=!red.annie.r.move,tag=champion] if score @s annie.r.skill matches 0 run function lc:champions/annie/skills/r.skill

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run kill @e[tag=blue.annie.r.move,dx=1,dz=1,dy=20]
    execute if entity @s[team=blue] if entity @e[tag=annie.r.target,team=!blue] run data modify entity @s angry_at set from entity @e[tag=annie.r.target,team=!blue,limit=1,sort=nearest] UUID
    execute if entity @s[team=blue] if entity @e[tag=annie.r.target,team=!blue,distance=10..,tag=!blue.annie.r.move,tag=champion] if score @s annie.r.skill matches 0 run function lc:champions/annie/skills/r.skill

    ## Return to owner
    execute if entity @s[team=red] if entity @p[tag=annie,team=red,distance=30..,tag=!dead] run function lc:champions/annie/skills/r.blink
    execute if entity @s[team=blue] if entity @p[tag=annie,team=blue,distance=30..,tag=!dead] run function lc:champions/annie/skills/r.blink

    ## DoT
    execute if entity @s[team=red] unless entity @e[tag=annie.r.dot,tag=red] run function lc:champions/annie/skills/r.dot
    execute if entity @s[team=blue] unless entity @e[tag=annie.r.dot,tag=blue] run function lc:champions/annie/skills/r.dot

    ## Rage
    execute if score @s[tag=!is_rage] annie.r.duration matches 1.. run function lc:champions/annie/skills/r.rage
    effect give @s[tag=is_rage] speed 1 6 false
    execute if score @s[tag=is_rage] annie.r.duration matches 0 run function lc:champions/annie/skills/r.rage.end
}

function r.blink {
    data remove entity @s angry_at

    execute if entity @s[team=red] run tag @e[tag=annie.r.target,team=!red] remove annie.r.target
    execute if entity @s[team=red] run tp @s @p[tag=annie,team=red,tag=!dead]

    execute if entity @s[team=blue] run tag @e[tag=annie.r.target,team=!blue] remove annie.r.target
    execute if entity @s[team=blue] run tp @s @p[tag=annie,team=blue,tag=!dead]
}

function r.damage.1 {
    execute if entity @s[team=red] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s
    execute if entity @s[team=blue] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 75 integer
    scoreboard players operation temp ability_power /= 100 integer

    scoreboard players add temp ability_power 400
    scoreboard players operation @s dmg_magic.deal = temp ability_power

    function lc:champion/dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

    execute if entity @s[team=red] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red] run function lc:champions/annie/skills/r.damage.1

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue] run function lc:champions/annie/skills/r.damage.1
}

function r.damage.2 {
    execute if entity @s[team=red] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s
    execute if entity @s[team=blue] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s

    scoreboard players operation temp ability_power = @s ability_power
    scoreboard players operation temp ability_power *= 3 integer
    scoreboard players operation temp ability_power /= 100 integer

    scoreboard players add temp ability_power 10
    scoreboard players operation @s dmg_magic.deal = temp ability_power

    function lc:champion/dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

    execute if entity @s[team=red] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red] run function lc:champions/annie/skills/r.damage.2

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue] run function lc:champions/annie/skills/r.damage.2
}

function r.dash {
    execute if entity @s[tag=red] on passengers on vehicle facing entity @e[tag=malphite.r,tag=red,limit=1,sort=nearest] feet run tp @s ^ ^ ^1.5 ~ ~
    execute if entity @s[tag=red] if score @p[team=red,tag=malphite] channeling matches -1 run ride @p[team=red,tag=malphite] mount @s

    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=red] remove r.dash
    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] on passengers run kill @s[tag=cd]
    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=red] remove r.animation
    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] as @e[tag=malphite.r,tag=red,type=item_display] at @s run function lc:champions/malphite/skills/r.spawn

    execute if entity @s[tag=blue] on passengers on vehicle facing entity @e[tag=malphite.r,tag=blue,limit=1,sort=nearest] feet run tp @s ^ ^ ^1.5 ~ ~
    execute if entity @s[tag=blue] if score @p[team=blue,tag=malphite] channeling matches -1 run ride @p[team=blue,tag=malphite] mount @s

    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=blue] remove r.dash
    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] on passengers run kill @s[tag=cd]
    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=blue] remove r.animation
    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] as @e[tag=malphite.r,tag=blue,type=item_display] at @s run function lc:champions/malphite/skills/r.spawn
}

function r.dot {
    particle small_flame ~ ~ ~ 1 0 1 0.01 50 force

    execute if entity @s[team=red] at @s run summon area_effect_cloud ~ ~ ~ {Tags:["annie.r.dot","red"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] positioned ~-2 ~-0.5 ~-2 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,dx=3,dz=3,dy=0] add annie.r.hit
    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit] add annie.r.dmg
    execute if entity @s[team=red] if entity @e[tag=annie.r.hit,team=!red] run function lc:champions/annie/skills/r.damage.2
    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit] remove annie.r.hit

    execute if entity @s[team=blue] at @s run summon area_effect_cloud ~ ~ ~ {Tags:["annie.r.dot","blue"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] positioned ~-2 ~-0.5 ~-2 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=3,dz=3,dy=0] add annie.r.hit
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit] add annie.r.dmg
    execute if entity @s[team=blue] if entity @e[tag=annie.r.hit,team=!blue] run function lc:champions/annie/skills/r.damage.2
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit] remove annie.r.hit
}

function r.end {
    tag @s add is_dead
    scoreboard players set @s hp.left 0

    playsound annie.sfx.r.end master @a ~ ~ ~
    execute if entity @s[team=red] run tag @e[tag=annie,team=red] add offhand_temp
    execute if entity @s[team=red] run item replace entity @e[tag=annie,team=red] weapon.offhand with air
    execute if entity @s[team=blue] run tag @e[tag=annie,team=blue] add offhand_temp
    execute if entity @s[team=blue] run item replace entity @e[tag=annie,team=blue] weapon.offhand with air

    execute if entity @s[team=red] run tag @e[tag=annie.r.target,team=!red] remove annie.r.target
    execute if entity @s[team=red] run kill @e[tag=red.annie.r.move,type=silverfish]

    execute if entity @s[team=blue] run tag @e[tag=annie.r.target,team=!blue] remove annie.r.target
    execute if entity @s[team=blue] run kill @e[tag=blue.annie.r.move,type=silverfish]

    execute on passengers as @s[tag=owner] on origin run function lc:champion/abilities/cooldown/r
    execute on passengers as @s[tag=aj.annie.root] at @s run function animated_java:annie/animations/death/play

    function lc:champion/hp/percentage
}

function r.knockup {
    function lc:champion/cc/cancel
    scoreboard players set @s cc.airborne 15
    function lc:core/motion/push {x:0,y:424,z:0,ticks:0}
}

function r.position {
    execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin run function lc:champions/annie/skills/r.spawn

    execute if block ~ ~ ~ #like_air if block ~ ~-1 ~ #like_air positioned ~ ~-1 ~ run function lc:champions/annie/skills/r.position

    execute unless block ~ ~ ~ #like_air positioned ~ ~1 ~ run function lc:champions/annie/skills/r.position
}

function r.rage {
    tag @s add is_rage
    scoreboard players add @s aa.spd 20
}

function r.rage.end {
    tag @s remove is_rage
    scoreboard players set @s aa.spd 10
    effect clear @s speed
}

function r.revenge {
    tag @s add decay
    scoreboard players add @s annie.r.duration 10

    scoreboard players operation temp hp.left = @s hp.left
    scoreboard players operation temp hp.max = @s hp.max

    scoreboard players operation temp hp.max -= temp hp.left
    scoreboard players operation temp hp.max /= 2 integer

    scoreboard players operation @s hp.left += temp hp.max
    execute if score @s hp.left > @s hp.max run scoreboard players operation @s hp.left = @s hp.max

    execute if entity @s[team=red] run kill @e[tag=annie.r.target,tag=red.annie.r.move,team=!red]
    execute if entity @s[team=red] run tag @e[tag=annie.r.target,team=!red] remove annie.r.target
    execute if entity @s[team=red] run tag @e[type=!#unvalid,tag=!unvalid,team=!red,limit=1,sort=nearest] add annie.r.target

    execute if entity @s[team=blue] run kill @e[tag=annie.r.target,tag=blue.annie.r.move,team=!blue]
    execute if entity @s[team=blue] run tag @e[tag=annie.r.target,team=!blue] remove annie.r.target
    execute if entity @s[team=blue] run tag @e[type=!#unvalid,tag=!unvalid,team=!blue,limit=1,sort=nearest] add annie.r.target
}

function r.skill {
    playsound annie.sfx.r master @a ~ ~ ~ 2 1
    tag @s add is_dashing
    scoreboard players set @s annie.r.skill 12
    execute on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/skill/play

    execute if entity @s[team=red] as @e[tag=annie.r.target,tag=!red.annie.r.move,team=!red,sort=furthest,limit=1] at @s anchored feet run summon area_effect_cloud ^ ^0.5 ^ {Duration:40,Tags:["red","annie.r.skill.stop"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["annie.r.skill","temp","red","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:40,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[team=blue] as @e[tag=annie.r.target,tag=!blue.annie.r.move,team=!blue,sort=furthest,limit=1] at @s anchored feet run summon area_effect_cloud ^ ^0.5 ^ {Duration:40,Tags:["blue","annie.r.skill.stop"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["annie.r.skill","temp","blue","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:40,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    tp @e[tag=annie.r.skill,tag=temp,limit=1,sort=nearest] ~ ~0.5 ~ ~ ~-2
    execute at @e[tag=annie.r.skill,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=annie.r.skill,tag=temp,limit=1,sort=nearest] remove temp
}

function r.skill.dash {
    execute if entity @s[tag=red] facing entity @e[tag=annie.r.skill.stop,tag=red,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @s ^ ^ ^1 ~ ~
    execute if entity @s[tag=red] facing entity @e[tag=annie.r.skill.stop,tag=red,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @e[type=#can_aggro,limit=1,team=red,tag=annie.r] ~ ~ ~ ~ ~
    execute if entity @s[tag=red] run ride @e[type=#can_aggro,limit=1,team=red,tag=annie.r] mount @s

    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] positioned ~1 ~1 ~1 run particle block{block_state:"magma_block"} ~ ~ ~ 0.5 0 0.5 1 100 force
    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] as @e[team=!red,type=!#unvalid,tag=!unvalid,dx=1,dz=1,dy=1,tag=!dead] at @s run function lc:champions/annie/skills/r.knockup
    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] on passengers run tag @s[tag=annie.r] remove is_dashing
    execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] run kill @s

    execute if entity @s[tag=blue] facing entity @e[tag=annie.r.skill.stop,tag=blue,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @s ^ ^ ^1 ~ ~
    execute if entity @s[tag=blue] facing entity @e[tag=annie.r.skill.stop,tag=blue,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @e[type=#can_aggro,limit=1,team=blue,tag=annie.r] ~ ~ ~ ~ ~
    execute if entity @s[tag=blue] run ride @e[type=#can_aggro,limit=1,team=blue,tag=annie.r] mount @s

    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] positioned ~1 ~1 ~1 run particle block{block_state:"magma_block"} ~ ~ ~ 0.5 0 0.5 1 100 force
    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] as @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=1,dz=1,dy=1,tag=!dead] at @s run function lc:champions/annie/skills/r.knockup
    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] on passengers run tag @s[tag=annie.r] remove is_dashing
    execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] run kill @s
}

function r.spawn {
    playsound minecraft:annie.sfx.r master @a ~ ~ ~ 4 1

    particle large_smoke ~ ~ ~ 1 0 1 0.01 100 force
    particle flame ~ ~ ~ 1 0.5 1 0.01 200 force

    execute if entity @s[team=red] positioned ~-2 ~-0.5 ~-2 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,dx=3,dz=3,dy=0] add annie.r.hit
    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit] add annie.r.dmg
    execute if entity @s[team=blue] positioned ~-2 ~-0.5 ~-2 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=3,dz=3,dy=0] add annie.r.hit
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit] add annie.r.dmg

    execute if score @s annie.passive matches 5 run function lc:champions/annie/passive

    execute if entity @s[team=red] if entity @e[tag=annie.r.hit,team=!red] run function lc:champions/annie/skills/r.damage.1
    execute if entity @s[team=red] run tag @e[tag=annie.r.hit,team=!red,limit=1,sort=nearest] add annie.r.target
    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit] remove annie.r.hit

    execute if entity @s[team=blue] if entity @e[tag=annie.r.hit,team=!blue] run function lc:champions/annie/skills/r.damage.1
    execute if entity @s[team=blue] run tag @e[tag=annie.r.hit,team=!blue,limit=1,sort=nearest] add annie.r.target
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit] remove annie.r.hit

    function lc:champions/annie/skills/r.summon
}

function r.summon {
    execute if entity @s[team=red] run summon zombified_piglin ~ ~ ~ {CustomName:"Tibbers",PersistenceRequired:1,Team:"red",Tags:["use_custom_model","magic.aa","is_pet","red","has_health_bar","lol.minion","melee","temp","annie.r"],Silent:1,active_effects:[{id:"invisibility",duration:-1,amplifier:0,show_particles:0b}],attributes:[{id:"minecraft:follow_range",base:1048.0d},{id:"minecraft:attack_damage",base:0.0d},{id:"minecraft:max_health",base:1000.0d},{id:"minecraft:knockback_resistance",base:1.0d}],Health:1000.0f,Passengers:[{id:"area_effect_cloud",Duration:9999,Tags:["owner"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"text_display",Tags:["hp","stats_bar"],background:0,billboard:"vertical"},{id:"text_display",Tags:["shield_all","stats_bar"],background:0,billboard:"vertical"}]}
    execute if entity @s[team=blue] run summon zombified_piglin ~ ~ ~ {CustomName:"Tibbers",PersistenceRequiblue:1,Team:"blue",Tags:["use_custom_model","magic.aa","is_pet","blue","has_health_bar","lol.minion","melee","temp","annie.r"],Silent:1,active_effects:[{id:"invisibility",duration:-1,amplifier:0,show_particles:0b}],attributes:[{id:"minecraft:follow_range",base:1048.0d},{id:"minecraft:attack_damage",base:0.0d},{id:"minecraft:max_health",base:1000.0d},{id:"minecraft:knockback_resistance",base:1.0d}],Health:1000.0f,Passengers:[{id:"area_effect_cloud",Duration:9999,Tags:["owner"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"text_display",Tags:["hp","stats_bar"],background:0,billboard:"vertical"},{id:"text_display",Tags:["shield_all","stats_bar"],background:0,billboard:"vertical"}]}

    execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=hp] {transformation:{scale:[0.325,0.375,0.325],translation:[0.0,-0.55,0.0]}}
    execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=shield_all] {transformation:{scale:[0.325,0.375,0.325],translation:[0.0,-0.55,0.0001]}}

    execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] if entity @s[team=red] on passengers run data modify entity @s[tag=owner] Owner set from entity @p[tag=annie,team=red] UUID
    execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] if entity @s[team=blue] on passengers run data modify entity @s[tag=owner] Owner set from entity @p[tag=annie,team=blue] UUID

    execute rotated ~ 0 run function animated_java:annie/summon

    execute if entity @s[team=red] run ride @e[type=#animated_java:root,tag=aj.annie.root,limit=1,sort=nearest] mount @e[tag=annie.r,team=red,limit=1,sort=nearest]
    execute if entity @s[team=red] as @e[tag=annie.r,team=red,limit=1,sort=nearest] on passengers run team join red @s[type=#animated_java:root,tag=aj.annie.root]
    execute if entity @s[team=red] as @e[tag=annie.r,team=red,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] on passengers run team join red @s
    execute if entity @s[team=red] as @e[tag=annie.r,team=red,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] run function animated_java:annie/animations/spawn/play
    execute if entity @s[team=red] as @e[tag=annie.r,team=red,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] on passengers run data modify entity @s teleport_duration set value 1
    execute if entity @s[team=red] as @e[tag=annie.r,team=red,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] run data modify entity @s teleport_duration set value 1

    execute if entity @s[team=blue] run ride @e[type=#animated_java:root,tag=aj.annie.root,limit=1,sort=nearest] mount @e[tag=annie.r,team=blue,limit=1,sort=nearest]
    execute if entity @s[team=blue] as @e[tag=annie.r,team=blue,limit=1,sort=nearest] on passengers run team join blue @s[type=#animated_java:root,tag=aj.annie.root]
    execute if entity @s[team=blue] as @e[tag=annie.r,team=blue,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] on passengers run team join blue @s
    execute if entity @s[team=blue] as @e[tag=annie.r,team=blue,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] run function animated_java:annie/animations/spawn/play
    execute if entity @s[team=blue] as @e[tag=annie.r,team=blue,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] on passengers run data modify entity @s teleport_duration set value 1
    execute if entity @s[team=blue] as @e[tag=annie.r,team=blue,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] run data modify entity @s teleport_duration set value 1

    scoreboard players operation annie.r.stats hp.max = @s ability_power
    scoreboard players operation annie.r.stats hp.max *= 50 integer
    scoreboard players operation annie.r.stats hp.max /= 100 integer
    scoreboard players add annie.r.stats hp.max 3500

    scoreboard players operation annie.r.stats ability_power = @s ability_power
    scoreboard players operation annie.r.stats ability_power *= 15 integer
    scoreboard players operation annie.r.stats ability_power /= 100 integer
    scoreboard players add annie.r.stats ability_power 100

    attribute @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] minecraft:movement_speed base set 0.2

    scoreboard players set @e[tag=lol.minion,tag=temp] channeling -1
    scoreboard players operation @e[tag=lol.minion,tag=temp] ability_power = annie.r.stats ability_power

    scoreboard players set @e[tag=lol.minion,tag=temp] armor 90
    scoreboard players set @e[tag=lol.minion,tag=temp] magic_resist 90

    scoreboard players set @e[tag=lol.minion,tag=temp] aa.cd 0
    scoreboard players set @e[tag=lol.minion,tag=temp] aa.spd 8
    scoreboard players set @e[tag=lol.minion,tag=temp] aa.range 30

    scoreboard players set @e[tag=lol.minion,tag=temp] annie.r.skill 0
    scoreboard players set @e[tag=lol.minion,tag=temp] annie.r.duration 3

    scoreboard players set @e[tag=lol.minion,tag=temp] hp.regen 5
    scoreboard players operation @e[tag=lol.minion,tag=temp] hp.max = annie.r.stats hp.max
    scoreboard players operation @e[tag=lol.minion,tag=temp] hp.left = @e[tag=lol.minion,tag=temp] hp.max

    tag @e[tag=lol.minion,tag=temp] remove temp
}

function w.damage {
    execute if entity @s[team=red] run damage @e[tag=annie.w.hit,type=!#unvalid,team=!red,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s
    execute if entity @s[team=blue] run damage @e[tag=annie.w.hit,type=!#unvalid,team=!blue,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s

    scoreboard players operation annie.w.temp_dmg attack_damage = @s ability_power
    scoreboard players operation annie.w.temp_dmg attack_damage *= 85 integer
    scoreboard players operation annie.w.temp_dmg attack_damage /= 100 integer

    scoreboard players add annie.w.temp_dmg attack_damage 250

    scoreboard players operation @s dmg_magic.deal = annie.w.temp_dmg attack_damage
    function lc:champion/dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.w.hit,type=!#unvalid,limit=1,sort=nearest] remove annie.w.hit

    execute if entity @s[team=red] run execute if entity @e[tag=annie.w.hit,type=!#unvalid,team=!red] run function lc:champions/annie/skills/w.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.w.hit,type=!#unvalid,limit=1,sort=nearest] remove annie.w.hit

    execute if entity @s[team=blue] run execute if entity @e[tag=annie.w.hit,type=!#unvalid,team=!blue] run function lc:champions/annie/skills/w.damage
}

