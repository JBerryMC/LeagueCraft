# lc:champions/vayne/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking vayne; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.vayne
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.vayne
    tag @s add useMana
    scoreboard players operation @s mana = @s mana.max
    playsound minecraft:vayne.select master @a ~ ~ ~
    scoreboard players set @s vayne.w.stack 0
}

function aa {
    playsound vayne.sfx.aa master @a ~ ~ ~

    execute if entity @s[team=red] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.vayne","aa","homing","red","temp"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.vayne","aa","homing","blue","temp"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:vayne"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:vayne/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:vayne/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:vayne/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:vayne/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:vayne/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud
    function lc:champions/vayne/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=vayne.aa,tag=!motion_checked,type=arrow] at @s run function lc:champions/vayne/skills/aa
    execute as @e[tag=vayne.aa,type=armor_stand] at @s run function lc:champions/vayne/skills/aa.animation

    execute as @e[tag=vayne.q.dash,type=area_effect_cloud] at @s run function lc:champions/vayne/skills/q.dash

    execute as @e[tag=vayne.e.knockback,type=area_effect_cloud] at @s run function lc:champions/vayne/skills/e.animation
    execute as @e[tag=vayne.e.stun.cd,type=area_effect_cloud] at @s run function lc:champions/vayne/skills/e.stun

    execute as @e[tag=vayne.w.passive,team=red] at @s positioned as @e[tag=vayne.aa.target,team=!red,limit=1,sort=nearest] run tp @s ~ ~0.1 ~
    execute as @e[tag=vayne.w.passive,team=blue] at @s positioned as @e[tag=vayne.aa.target,team=!blue,limit=1,sort=nearest] run tp @s ~ ~0.1 ~

    execute as @e[tag=vayne.r.animation,type=area_effect_cloud] at @s run function lc:champions/vayne/skills/r.animation
    execute as @e[tag=vayne.r.silverfish,type=silverfish] at @s run function lc:champions/vayne/skills/r.silverfish
}

function main {
    # Cooldown
    function lc:champions/vayne/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/vayne/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/vayne/item/offhand

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r
}

function passive {
    attribute @s[tag=!p.active] minecraft:movement_speed base set 0.1
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] unless entity @e[tag=<%team%>,tag=vayne.r.cd] run attribute @s[tag=p.active] minecraft:movement_speed base set 0.13
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run attribute @s[tag=p.active] minecraft:movement_speed base set 0.19
    }

    tag @s remove p.active
}

function use_e {
    scoreboard players set @s cd_e 12
    scoreboard players remove @s mana 90

    playsound minecraft:vayne.sfx.e master @a ~ ~ ~

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] if entity @e[tag=vayne.r.cd,tag=<%team%>] run effect clear @s invisibility
        execute if entity @s[team=<%team%>] if entity @e[tag=vayne.r.cd,tag=<%team%>] run kill @e[tag=vayne.q.fx.invis.cd,tag=<%team%>]
        execute if entity @s[team=<%team%>] if entity @e[tag=vayne.r.cd,tag=<%team%>] run item replace entity @s weapon.offhand with minecraft:air
        execute if entity @s[team=<%team%>] run summon arrow ^ ^1.2 ^1 {SoundEvent:"minecraft:entity.player.attack.weak",Tags:["vayne.aa","e_active"],NoGravity:1,LeftOwner:0,damage:0.2,crit:0,Passengers:[{Tags:["vayne.aa","unvalid","e_active"],id:"armor_stand",Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:20,Tags:["aa.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],Team:"<%team%>",Marker:1,Invisible:1}]}
        execute if entity @s[team=<%team%>] run data modify entity @e[tag=vayne.aa,type=armor_stand,limit=1,sort=nearest,team=<%team%>] Rotation[0] set from entity @p[tag=vayne,team=<%team%>] Rotation[0]
    }
}

function use_q {
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] unless entity @e[tag=<%team%>,tag=vayne.r.cd] run scoreboard players set @s cd_q 2
        execute if entity @s[team=<%team%>] unless entity @e[tag=<%team%>,tag=vayne.r.cd] run playsound vayne.sfx.q master @a ~ ~ ~
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run scoreboard players set @s cd_q 1
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run playsound vayne.sfx.q.fx.invis master @a ~ ~ ~
    }

    scoreboard players remove @s mana 30

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run effect give @s invisibility 1 0 true
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run effect give @e[tag=vayne.r.silverfish,tag=<%team%>] invisibility 1 0 true
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run item replace entity @s armor.head with minecraft:air
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run item replace entity @s weapon.offhand with minecraft:air
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:21,Tags:["<%team%>","vayne.q.fx.invis.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[team=<%team%>] run kill @e[tag=<%team%>,tag=vayne.q.cd]
        execute if entity @s[team=<%team%>] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:140,Tags:["<%team%>","vayne.q.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[team=<%team%>] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:5,Tags:["<%team%>","vayne.q.dash"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[team=<%team%>] run tp @e[tag=<%team%>,tag=vayne.q.dash,type=minecraft:area_effect_cloud] ~ ~0.1 ~ ~ 0
    }
}

function use_r {
    scoreboard players set @s cd_r 70
    scoreboard players remove @s mana 80
    scoreboard players set @s vayne.r.duration 240
    playsound minecraft:vayne.ultimate master @a ~ ~ ~
    playsound minecraft:vayne.sfx.r master @a ~ ~ ~

    execute if entity @s[team=red] if score .world lang matches 0 run bossbar add red.vayne.r {text:"Final Hour"}
    execute if entity @s[team=red] if score .world lang matches 1 run bossbar add red.vayne.r {text:"Thời Khắc Cuối Cùng"}
    execute if entity @s[team=red] run bossbar set red.vayne.r max 240
    execute if entity @s[team=red] run bossbar set red.vayne.r value 240
    execute if entity @s[team=red] run bossbar set red.vayne.r players @s
    execute if entity @s[team=red] run bossbar set red.vayne.r visible true

    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:240,Tags:["red","vayne.r.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:10,Tags:["red","vayne.r.animation"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] rotated ~ 0 run summon silverfish ^1 ^ ^ {Silent:1,NoAI:1,Team:"nocollision",Tags:["vayne.r.silverfish","unvalid","red","vayne.r.bat1"]}
    execute if entity @s[team=red] rotated ~ 0 run summon silverfish ^-1 ^ ^ {Silent:1,NoAI:1,Team:"nocollision",Tags:["vayne.r.silverfish","unvalid","red","vayne.r.bat2"]}

    execute if entity @s[team=blue] if score .world lang matches 0 run bossbar add blue.vayne.r {text:"Final Hour"}
    execute if entity @s[team=blue] if score .world lang matches 1 run bossbar add blue.vayne.r {text:"Thời Khắc Cuối Cùng"}
    execute if entity @s[team=blue] run bossbar set blue.vayne.r max 240
    execute if entity @s[team=blue] run bossbar set blue.vayne.r value 240
    execute if entity @s[team=blue] run bossbar set blue.vayne.r players @s
    execute if entity @s[team=blue] run bossbar set blue.vayne.r visible true

    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:240,Tags:["blue","vayne.r.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:10,Tags:["blue","vayne.r.animation"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] rotated ~ 0 run summon silverfish ^1 ^ ^ {Silent:1,NoAI:1,Team:"nocollision",Tags:["vayne.r.silverfish","unvalid","blue","vayne.r.bat1"]}
    execute if entity @s[team=blue] rotated ~ 0 run summon silverfish ^-1 ^ ^ {Silent:1,NoAI:1,Team:"nocollision",Tags:["vayne.r.silverfish","unvalid","blue","vayne.r.bat2"]}
}

function use_w {
}

# ---- item: lc:champions/vayne/item/... -----------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]
        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[600001f]},minecraft:custom_name={text:"Jhin",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[600001f]},minecraft:custom_name={text:"Jhin",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/vayne/skills/... -------------------------------------------
dir skills {
    function e.animation {
        execute if block ^ ^0.1 ^1.5 #like_air run tp @s ^ ^ ^1.5
        execute if entity @s[tag=red] run tp @e[tag=vayne.e.target,limit=1,team=!red] ~ ~0.1 ~

        execute unless block ^ ^0.1 ^1.5 #like_air run playsound vayne.sfx.e.stun master @a ~ ~ ~

        execute if entity @s[tag=red] unless block ^ ^0.1 ^1.5 #like_air run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:31,Tags:["vayne.e.stun.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] unless block ^ ^0.1 ^1.5 #like_air run tag @e[tag=vayne.e.target,limit=1,team=!red] add stun
        execute if entity @s[tag=red] unless block ^ ^0.1 ^1.5 #like_air run kill @s

        execute if entity @s[tag=red,nbt={Age:4}] run tag @e[tag=vayne.e.target,limit=1,team=!red] remove vayne.e.target

        execute if entity @s[tag=blue] run tp @e[tag=vayne.e.target,limit=1,team=!blue] ~ ~0.1 ~

        execute if entity @s[tag=blue] unless block ^ ^0.1 ^1.5 #like_air run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:31,Tags:["vayne.e.stun.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=blue] unless block ^ ^0.1 ^1.5 #like_air run tag @e[tag=vayne.e.target,limit=1,team=!blue] add stun
        execute if entity @s[tag=blue] unless block ^ ^0.1 ^1.5 #like_air run kill @s

        execute if entity @s[tag=blue,nbt={Age:4}] run tag @e[tag=vayne.e.target,limit=1,team=!blue] remove vayne.e.target
    }

    function e.knockback {
        particle witch ~ ~1.2 ~ 0 0 0 0.5 50 force
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run tag @e[tag=vayne.aa.target,team=!<%team%>,limit=1] add vayne.e.target
            execute if entity @s[team=<%team%>] run tag @e[tag=vayne.e.target,team=!<%team%>,limit=1] add airborne
            execute if entity @s[team=<%team%>] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:5,Tags:["vayne.e.knockback","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
            execute if entity @s[team=<%team%>] rotated as @s run tp @e[tag=vayne.e.knockback,tag=<%team%>] ~ ~ ~ ~ ~
        }
    }

    function e.stun {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>,nbt={Age:30}] run tag @e[tag=vayne.e.target,limit=1,team=!<%team%>] remove stun
            execute if entity @s[tag=<%team%>,nbt={Age:30}] run tag @e[tag=vayne.e.target,limit=1,team=!<%team%>] remove vayne.e.target
        }
    }

    function p.raycasting {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>,distance=..20] unless entity @e[tag=!unvalid,type=!#unvalid,distance=..1.5,team=!<%team%>] positioned ^ ^ ^1 run function lc:champions/vayne/skills/p.raycasting
            execute if entity @s[team=<%team%>,distance=..20] if entity @e[tag=!unvalid,type=!#unvalid,distance=..1.5,team=!<%team%>] run tag @s add p.active
        }
    }

    function q.dash {
        execute if block ^ ^ ^1 #like_air run tp @s ^ ^ ^1
        execute if entity @s[tag=red] run tp @p[team=red,tag=vayne] ~ ~ ~ ~ ~
        execute if entity @s[tag=blue] run tp @p[team=blue,tag=vayne] ~ ~ ~ ~ ~
    }

    function r.animation {
        tp @s ~ ~0.2 ~ ~30 0
        particle witch ^1 ^ ^ 0 0 0 1 2 force
        particle witch ^-1 ^ ^ 0 0 0 1 2 force

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] run tp @e[tag=<%team%>,tag=vayne.r.bat1,type=silverfish] ^1 ^ ^
            execute if entity @s[tag=<%team%>] run tp @e[tag=<%team%>,tag=vayne.r.bat2,type=silverfish] ^-1 ^ ^
        }
    }

    function r.bat {
        execute if entity @s[tag=red,tag=vayne.r.bat1] unless entity @e[tag=vayne.r.animation,tag=red] at @p[tag=vayne,team=red] rotated ~ 0 run tp @s ^1 ^1.5 ^ ~ ~
        execute if entity @s[tag=red,tag=vayne.r.bat2] unless entity @e[tag=vayne.r.animation,tag=red] at @p[tag=vayne,team=red] rotated ~ 0 run tp @s ^-1 ^1.5 ^ ~ ~
        execute if entity @s[tag=red] unless entity @e[tag=vayne.r.cd,tag=red] run function lc:champions/vayne/skills/r.end
        execute if entity @s[tag=red] unless entity @e[tag=vayne.q.fx.invis.cd,tag=red] positioned as @p[tag=vayne,team=red] run particle witch ~ ~ ~ 0.2 0 0.2 0 2 force

        execute if entity @s[tag=red,tag=vayne.r.bat1] run scoreboard players remove @p[scores={vayne.r.duration=1..}] vayne.r.duration 1
        execute if entity @s[tag=red,tag=vayne.r.bat2] store result bossbar red.vayne.r value run scoreboard players get @p[tag=vayne,team=red] vayne.r.duration

        execute if entity @s[tag=blue,tag=vayne.r.bat1] unless entity @e[tag=vayne.r.animation,tag=blue] at @p[tag=vayne,team=blue] rotated ~ 0 run tp @s ^1 ^1.5 ^ ~ ~
        execute if entity @s[tag=blue,tag=vayne.r.bat2] unless entity @e[tag=vayne.r.animation,tag=blue] at @p[tag=vayne,team=blue] rotated ~ 0 run tp @s ^-1 ^1.5 ^ ~ ~
        execute if entity @s[tag=blue] unless entity @e[tag=vayne.r.cd,tag=blue] run function lc:champions/vayne/skills/r.end
        execute if entity @s[tag=blue] unless entity @e[tag=vayne.q.fx.invis.cd,tag=blue] positioned as @p[tag=vayne,team=blue] run particle witch ~ ~ ~ 0.2 0 0.2 0 2 force

        execute if entity @s[tag=blue,tag=vayne.r.bat1] run scoreboard players remove @p[scores={vayne.r.duration=1..}] vayne.r.duration 1
        execute if entity @s[tag=blue,tag=vayne.r.bat2] store result bossbar blue.vayne.r value run scoreboard players get @p[tag=vayne,team=blue] vayne.r.duration
    }

    function r.end {
        execute if entity @s[tag=red] run bossbar remove red.vayne.r
        execute if entity @s[tag=blue] run bossbar remove blue.vayne.r

        tp @s ~ -100 ~
        kill @s
    }

    function r.extend {
        scoreboard players add @s vayne.r.duration 20

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] as @e[tag=<%team%>,tag=vayne.r.cd,limit=1] store result score @s temp run data get entity @s Age
            execute if entity @s[team=<%team%>] as @e[tag=<%team%>,tag=vayne.r.cd,limit=1] run scoreboard players remove @s temp 20
            execute if entity @s[team=<%team%>] as @e[tag=<%team%>,tag=vayne.r.cd,limit=1] store result entity @s Age int 1 run scoreboard players get @s temp
        }
    }

    function w.stack.full {
        playsound vayne.sfx.w master @a ~ ~ ~

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=vayne.r.cd] as @p[tag=vayne,team=<%team%>] run function lc:champions/vayne/skills/r.extend
            execute if entity @s[team=<%team%>] run kill @e[tag=vayne.w.passive,team=<%team%>]
            execute if entity @s[team=<%team%>] positioned as @e[tag=vayne.aa.target,team=!<%team%>] run particle crit ~ ~1.2 ~ 0 0 0 0.5 50 force
            execute if entity @s[team=<%team%>] run effect give @e[tag=vayne.aa.target,type=!#undead,team=!<%team%>] instant_damage 1 0 true
            execute if entity @s[team=<%team%>] run effect give @e[tag=vayne.aa.target,type=#undead,team=!<%team%>] instant_health 1 0 true
            execute if entity @s[team=<%team%>] run scoreboard players set @p[team=<%team%>,tag=vayne] vayne.w.stack 0
            execute if entity @s[team=<%team%>] run kill @e[tag=vayne.w.stack.cd,tag=<%team%>]
            execute if entity @s[team=<%team%>] run tag @e[tag=vayne.aa.target,team=!<%team%>] remove vayne.aa.target
        }
    }

    function w.stack.gain {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run kill @e[tag=vayne.w.stack.cd,tag=<%team%>]
            execute if entity @s[team=<%team%>] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:70,Tags:["vayne.w.stack.cd","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
            execute if entity @s[team=<%team%>] if entity @e[type=!#unvalid,tag=vayne.aa.target,distance=..2,team=!<%team%>,limit=1,sort=nearest] run scoreboard players add @p[tag=vayne,team=<%team%>,scores={vayne.w.stack=..2}] vayne.w.stack 1
            execute if entity @s[team=<%team%>] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!<%team%>,limit=1,sort=nearest] run scoreboard players set @p[tag=vayne,team=<%team%>] vayne.w.stack 1
            execute if entity @s[team=<%team%>] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!<%team%>,limit=1,sort=nearest] run tag @e[type=!#unvalid,tag=vayne.aa.target,team=!<%team%>] remove vayne.aa.target
            execute if entity @s[team=<%team%>] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!<%team%>,limit=1,sort=nearest] run tag @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!<%team%>,limit=1,sort=nearest] add vayne.aa.target
            execute if entity @s[team=<%team%>,tag=e_active] positioned as @e[tag=vayne.aa.target,limit=1,team=!<%team%>] run function lc:champions/vayne/skills/e.knockback
            execute if entity @s[team=<%team%>] if entity @p[tag=vayne,team=<%team%>,scores={vayne.w.stack=1}] unless entity @e[tag=vayne.w.passive,team=<%team%>] run summon armor_stand ~ ~ ~ {Tags:["unvalid","vayne.w.passive"],Marker:1,Invisible:1,Team:'<%team%>',equipment:{head:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[600001f]}}}}}
            execute if entity @s[team=<%team%>] if entity @p[tag=vayne,team=<%team%>,scores={vayne.w.stack=2}] run data modify entity @e[tag=vayne.w.passive,team=<%team%>,limit=1] equipment.head.components."minecraft:custom_model_data" set value {floats:[600002f]}
            execute if entity @s[team=<%team%>] if entity @p[tag=vayne,team=<%team%>,scores={vayne.w.stack=3}] run function lc:champions/vayne/skills/w.stack.full
        }
    }

    function w.stack.lost {
        scoreboard players set @s vayne.w.stack 0
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run kill @e[tag=vayne.w.passive,team=<%team%>]
            execute if entity @s[team=<%team%>] run tag @e[tag=vayne.aa.target,team=!<%team%>] remove vayne.aa.target
        }
    }
}
