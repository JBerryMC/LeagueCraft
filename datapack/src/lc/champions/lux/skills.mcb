# lc:champions/lux/skills/  (converted from the 1.20.2 LeagueCraft datapack)

function e.animation {
    function lc:champions/lux/skills/e.particle

    execute if entity @s[tag=red] positioned ~-3 ~-0.5 ~-3 run effect give @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] slowness 2 2 false
    execute if entity @s[tag=red] positioned ~-3 ~-0.5 ~-3 run scoreboard players set @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] fx.sight 2

    execute if entity @s[tag=blue] positioned ~-3 ~-0.5 ~-3 run effect give @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] slowness 2 2 false
    execute if entity @s[tag=blue] positioned ~-3 ~-0.5 ~-3 run scoreboard players set @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] fx.sight 2
}

function e.damage {
    execute if entity @s[team=red] run effect give @e[team=!red,type=!#unvalid,tag=lux.e.hit,tag=lux.e.temp_dmg,limit=1,sort=nearest] slowness 1 2 false
    execute if entity @s[team=red] run scoreboard players set @e[team=!red,type=!#unvalid,tag=lux.e.hit,tag=lux.e.temp_dmg,limit=1,sort=nearest] lux.passive 6
    execute if entity @s[team=blue] run scoreboard players set @e[team=!blue,type=!#unvalid,tag=lux.e.hit,tag=lux.e.temp_dmg,limit=1,sort=nearest] lux.passive 6
    execute if entity @s[team=blue] run effect give @e[team=!blue,type=!#unvalid,tag=lux.e.hit,tag=lux.e.temp_dmg,limit=1,sort=nearest] slowness 1 2 false

    execute if entity @s[team=red] run damage @e[tag=lux.e.hit,tag=lux.e.temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=lux.e.hit,tag=lux.e.temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s

    scoreboard players operation @s dmg_magic.deal = @s ability_power
    scoreboard players operation @s dmg_magic.deal *= 80 integer
    scoreboard players operation @s dmg_magic.deal /= 100 integer
    scoreboard players add @s dmg_magic.deal 265

    function lc:champion/dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=lux.e.hit,tag=has_health_bar,tag=lux.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=lux.e.hit,tag=has_health_bar,tag=lux.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=lux.e.hit,type=!#unvalid,tag=lux.e.temp_dmg,limit=1,sort=nearest] remove lux.e.temp_dmg

    execute if entity @s[team=red] run execute if entity @e[tag=lux.e.hit,tag=lux.e.temp_dmg,type=!#unvalid,team=!red] run function lc:champions/lux/skills/e.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=lux.e.hit,tag=has_health_bar,tag=lux.e.temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=lux.e.hit,tag=has_health_bar,tag=lux.e.temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=lux.e.hit,type=!#unvalid,tag=lux.e.temp_dmg,limit=1,sort=nearest] remove lux.e.temp_dmg

    execute if entity @s[team=blue] run execute if entity @e[tag=lux.e.hit,tag=lux.e.temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/lux/skills/e.damage
}

function e.end {
    particle flash{color:[1.0f,1.0f,1.0f,1.0f]} ~ ~ ~ 0 0 0 1 1 force
    particle end_rod ~ ~ ~ 0 0 0 0.2 20 force
    stopsound @a master lux.sfx.e.lingering
    playsound lux.sfx.e.end master @a ~ ~ ~

    execute if entity @s[tag=red] positioned ~-3 ~-0.5 ~-3 run tag @e[team=!red,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add lux.e.hit
    execute if entity @s[tag=red] run tag @e[team=!red,tag=lux.e.hit] add lux.e.temp_dmg
    execute if entity @s[tag=red] if entity @e[tag=lux.e.hit,team=!red] as @p[tag=lux,team=red] run function lc:champions/lux/skills/e.damage
    execute if entity @s[tag=red] run tag @e[team=!red,tag=lux.e.hit] remove lux.e.hit

    execute if entity @s[tag=blue] positioned ~-3 ~-0.5 ~-3 run tag @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=5,dz=5,dy=0] add lux.e.hit
    execute if entity @s[tag=blue] run tag @e[team=!blue,tag=lux.e.hit] add lux.e.temp_dmg
    execute if entity @s[tag=blue] if entity @e[tag=lux.e.hit,team=!blue] as @p[tag=lux,team=blue] run function lc:champions/lux/skills/e.damage
    execute if entity @s[tag=blue] run tag @e[team=!blue,tag=lux.e.hit] remove lux.e.hit

    execute on passengers run kill @s
    kill @s
}

