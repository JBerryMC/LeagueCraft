    function w.animation {
        tp @s ^ ^ ^0.75

        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!red,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] run function lc:champions/ashe/skills/w.hit

        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!blue,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] run function lc:champions/ashe/skills/w.hit

        particle dust{color:[0.5,0.9,1],scale:1} ~ ~ ~ 0 0 0 0 1 force
    }

    function w.damage {
        execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 2 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 2 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 0
        scoreboard players set @s dmg_magic.deal 0

        scoreboard players set temp attack_damage 80
        scoreboard players operation temp attack_damage += @s attack_damage

        scoreboard players operation @s dmg_physical.deal = temp attack_damage
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
    }

    function w.hit {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] run tag @e[team=!<%team%>,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add temp_dmg
            execute if entity @s[tag=<%team%>] as @p[tag=ashe,team=<%team%>] run function lc:champions/ashe/skills/w.damage
        }

        kill @s
    }

    dir structure_damage {
        function q.damage.1 {
            execute if entity @s[team=red] run damage @e[tag=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s
            execute if entity @s[team=blue] run damage @e[tag=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s

            scoreboard players set @s dmg_physical.deal 0
            scoreboard players set @s dmg_magic.deal 0

            scoreboard players operation temp attack_damage = @s attack_damage
            scoreboard players operation temp attack_damage *= 25 integer
            scoreboard players operation temp attack_damage /= 100 integer

            scoreboard players operation @s dmg_physical.deal = temp attack_damage
            function lc:champion/dmg/calc.debuff

            ## RED
            execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

            execute if entity @s[team=red] as @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
            execute if entity @s[team=red] as @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical

            ## BLUE
            execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

            execute if entity @s[team=blue] as @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
            execute if entity @s[team=blue] as @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical
        }

        function q.damage.2 {
            execute if entity @s[team=red] run damage @e[tag=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s
            execute if entity @s[team=blue] run damage @e[tag=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s

            scoreboard players set @s dmg_physical.deal 0
            scoreboard players set @s dmg_magic.deal 0

            scoreboard players operation temp attack_damage = @s attack_damage
            scoreboard players operation temp attack_damage *= 25 integer
            scoreboard players operation temp attack_damage /= 100 integer

            scoreboard players operation @s dmg_physical.deal = temp attack_damage
            function lc:champion/dmg/calc.debuff

            ## RED
            execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

            execute if entity @s[team=red] as @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
            execute if entity @s[team=red] as @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical

            ## BLUE
            execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

            execute if entity @s[team=blue] as @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
            execute if entity @s[team=blue] as @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical
        }

        function q.damage.3 {
            execute if entity @s[team=red] run damage @e[tag=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s
            execute if entity @s[team=blue] run damage @e[tag=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s

            scoreboard players set @s dmg_physical.deal 0
            scoreboard players set @s dmg_magic.deal 0

            scoreboard players operation temp attack_damage = @s attack_damage
            scoreboard players operation temp attack_damage *= 25 integer
            scoreboard players operation temp attack_damage /= 100 integer

            scoreboard players operation @s dmg_physical.deal = temp attack_damage
            function lc:champion/dmg/calc.debuff

            ## RED
            execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

            execute if entity @s[team=red] run tag @e[tag=!red,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

            ## BLUE
            execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

            execute if entity @s[team=blue] run tag @e[tag=!blue,tag=lol.structure,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
        }
    }
}
