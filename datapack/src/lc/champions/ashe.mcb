# lc:champions/ashe/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking ashe; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.ashe
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.ashe
    tag @s add useMana
    scoreboard players operation @s mana = @s mana.max
    playsound minecraft:ashe.select master @a ~ ~ ~
    playsound minecraft:ashe.sfx.select master @a ~ ~ ~
    scoreboard players set @s ashe.q.stack 0
    scoreboard players set @s ashe.e.stack 0
}

function aa {
    execute unless score @s ashe.q.stack matches 3 if score @s cd_q matches 0 run playsound ashe.sfx.aa master @a ~ ~ ~
    execute if score @s cd_q matches 1.. run playsound ashe.sfx.q.active master @a ~ ~ ~

    execute if score @s[tag=!q.active] ashe.q.stack matches 3 unless entity @e[tag=temp_dmg,tag=lol.structure] run playsound ashe.sfx.q.trigger master @s ~ ~ ~
    execute if score @s[tag=!q.active] ashe.q.stack matches 3 if entity @e[tag=temp_dmg,tag=lol.structure] run playsound ashe.sfx.aa master @s ~ ~ ~

    execute if entity @s[team=red] if score @s cd_q matches 0 at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.ashe","aa","homing","red","temp","block_by_windwall"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] if score @s cd_q matches 0 at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.ashe","aa","homing","blue","temp","block_by_windwall"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[team=red] if score @s cd_q matches 1.. at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["ashe.q","aa.ashe","aa","homing","red","temp","block_by_windwall"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=red] if score @s cd_q matches 1.. run function lc:champions/ashe/skills/q.aa

    execute if entity @s[team=blue] if score @s cd_q matches 1.. at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["ashe.q","aa.ashe","aa","homing","blue","temp","block_by_windwall"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] if score @s cd_q matches 1.. run function lc:champions/ashe/skills/q.aa
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:ashe"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:ashe/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:ashe/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:ashe/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:ashe/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:ashe/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"ashe.q.stack"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## Q
    execute if entity @s[tag=!cced] unless score @s ashe.q.stack matches 4 run scoreboard players set @s status.q 0
    execute if entity @s[tag=!cced] if score @s ashe.q.stack matches 4 run scoreboard players set @s status.q 1
    execute if entity @s[tag=!cced] if score @s cd_q matches 1.. run scoreboard players set @s status.q 7

    function lc:champions/ashe/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @p[tag=ashe,team=red,tag=!q.active] if score @s ashe.q.stack matches 1.. unless entity @e[tag=ashe.q.stack.cd,tag=red,type=area_effect_cloud] run function lc:champions/ashe/skills/q.stack.lost
    execute as @p[tag=ashe,tag=q.active,team=red] unless entity @e[tag=ashe.q.cd,tag=red,type=area_effect_cloud] run function lc:champions/ashe/skills/q.end

    execute as @p[tag=ashe,team=blue,tag=!q.active] if score @s ashe.q.stack matches 1.. unless entity @e[tag=ashe.q.stack.cd,tag=blue,type=area_effect_cloud] run function lc:champions/ashe/skills/q.stack.lost
    execute as @p[tag=ashe,tag=q.active,team=blue] unless entity @e[tag=ashe.q.cd,tag=blue,type=area_effect_cloud] run function lc:champions/ashe/skills/q.end

    execute as @e[tag=ashe.w,type=item_display] at @s run function lc:champions/ashe/skills/w.animation

    execute as @e[tag=ashe.e,type=item_display] at @s run function lc:champions/ashe/skills/e.animation

    execute as @e[tag=ashe.r,type=item_display] at @s run function lc:champions/ashe/skills/r.animation
}

function main {
    # Cooldown
    function lc:champions/ashe/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/ashe/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/ashe/item/offhand

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r

    ##Q
    execute if entity @s[tag=q.active] run scoreboard players operation @s ashe.q.stack = @s cd_q
}

function passive {
}

function use_e {
    function lc:champion/abilities/cooldown/e
    scoreboard players remove @s ashe.e.stack 1
    scoreboard players set @s channeling 5

    playsound minecraft:ashe.sfx.e master @a ~ ~ ~

    execute if entity @s[team=red] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500301f]}}},Tags:["red","ashe.e","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:101,Tags:["cd","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:20,Tags:["moving.up"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=red] anchored eyes run tp @e[tag=ashe.e,tag=red,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~ -40

    execute if entity @s[team=blue] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500301f]}}},Tags:["blue","ashe.e","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:101,Tags:["cd","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:20,Tags:["moving.up"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] anchored eyes run tp @e[tag=ashe.e,tag=blue,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~ -40
}

function use_q {
    tag @s add q.active
    scoreboard players set @s cd_q 6
    scoreboard players set @s ashe.q.stack 6
    scoreboard players set @s aa.cd 0
    scoreboard players set @s status.weapon 500102

    execute if entity @s[team=red] run scoreboard players operation red.ashe.q.buff temp = @s aa.spd
    execute if entity @s[team=red] run scoreboard players operation red.ashe.q.buff temp *= 55 integer
    execute if entity @s[team=red] run scoreboard players operation red.ashe.q.buff temp /= 100 integer
    execute if entity @s[team=red] run scoreboard players operation @s aa.spd += red.ashe.q.buff temp

    execute if entity @s[team=blue] run scoreboard players operation blue.ashe.q.buff temp = @s aa.spd
    execute if entity @s[team=blue] run scoreboard players operation blue.ashe.q.buff temp *= 55 integer
    execute if entity @s[team=blue] run scoreboard players operation blue.ashe.q.buff temp /= 100 integer
    execute if entity @s[team=blue] run scoreboard players operation @s aa.spd += blue.ashe.q.buff temp

    playsound ashe.sfx.q master @a ~ ~ ~
    execute if entity @s[team=red] run kill @e[tag=ashe.q.stack.cd,tag=red]
    execute if entity @s[team=blue] run kill @e[tag=ashe.q.stack.cd,tag=blue]

    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:120,Tags:["ashe.q.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:120,Tags:["ashe.q.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_r {
    function lc:champion/abilities/cooldown/r
    scoreboard players set @s channeling 5

    playsound minecraft:ashe.ultimate master @a ~ ~ ~
    playsound minecraft:ashe.sfx.r master @a ~ ~ ~

    execute if entity @s[team=red] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500401f]}}},Tags:["red","ashe.r","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:101,Tags:["cd","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=red] anchored eyes run tp @e[tag=ashe.r,tag=red,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~ ~

    execute if entity @s[team=blue] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,item_display:"head",item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500401f]}}},Tags:["blue","ashe.r","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:101,Tags:["cd","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] anchored eyes run tp @e[tag=ashe.r,tag=blue,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~ ~
}

