    execute if entity @s[team=blue] anchored eyes run tp @e[tag=ashe.w,tag=ashe.w.8,tag=blue,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~-12 ~
    execute if entity @s[team=blue] anchored eyes run tp @e[tag=ashe.w,tag=ashe.w.9,tag=blue,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~-18 ~
    execute if entity @s[team=blue] anchored eyes run tp @e[tag=ashe.w,tag=ashe.w.10,tag=blue,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~-24 ~
    execute if entity @s[team=blue] anchored eyes run tp @e[tag=ashe.w,tag=ashe.w.11,tag=blue,type=item_display,limit=1,sort=nearest] ^ ^ ^ ~-30 ~
    #execute if entity @s[team=blue] as @e[tag=ashe.w,tag=blue,type=item_display] at @s anchored eyes run tp @s ^ ^ ^1
}

# ---- item: lc:champions/ashe/item/... ------------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]
        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[500001f]},minecraft:custom_name={text:"Ashe",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[500001f]},minecraft:custom_name={text:"Ashe",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/ashe/skills/... --------------------------------------------
dir skills {
    function e.animation {
        tp @s ^ ^ ^1.5

        execute if entity @s[tag=red] on passengers if entity @s[tag=moving.up] on vehicle run tp @s ^ ^ ^1.5 ~ ~2

        execute if entity @s[tag=red] positioned ~-2.5 ~-10 ~-2.5 run scoreboard players add @e[team=!red,tag=!unvalid,type=!#unvalid,dx=5,dy=20] fx.sight 20

        execute if entity @s[tag=blue] on passengers if entity @s[tag=moving.up] on vehicle run tp @s ^ ^ ^1.5 ~ ~2

        execute if entity @s[tag=blue] positioned ~-2.5 ~-10 ~-2.5 run scoreboard players add @e[team=!blue,tag=!unvalid,type=!#unvalid,dx=5,dy=20] fx.sight 20

        particle firework ~ ~ ~ 0 0 0 0 1 force
    }

    function e.end {
        playsound ashe.sfx.e.end master @a ~ ~ ~
        particle end_rod ~ ~ ~ 0 0 0 1 200 force
        execute if entity @s[tag=red] positioned ~-10 ~-10 ~-10 run scoreboard players add @e[team=!blue,tag=!unvalid,type=!#unvalid,dx=20,dy=20] fx.sight 100
        execute if entity @s[tag=blue] positioned ~-10 ~-10 ~-10 run scoreboard players add @e[team=!blue,tag=!unvalid,type=!#unvalid,dx=20,dy=20] fx.sight 100
    }

    function e.stack.gain {
        scoreboard players add @s ashe.e.stack 1
        execute if score @s ashe.e.stack matches ..1 run scoreboard players set @s cd_e 50
    }

    function q.aa {
        execute if entity @s[team=red] at @s anchored eyes run summon item_display ^0.5 ^ ^-.25 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","red","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^0.5 ^ ^-.25 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","blue","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @e[tag=temp_dmg,tag=!lol.structure] run function lc:champion/aa/ranged.initial
        execute if entity @e[tag=temp_dmg,tag=lol.structure] run function lc:champion/aa/ranged.initial_structure
        #say 1

        execute if entity @s[team=red] at @s anchored eyes run summon item_display ^1 ^ ^-.5 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","red","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^1 ^ ^-.5 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","blue","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @e[tag=temp_dmg,tag=!lol.structure] run function lc:champion/aa/ranged.initial
        execute if entity @e[tag=temp_dmg,tag=lol.structure] run function lc:champion/aa/ranged.initial_structure

        #say 2
        execute if entity @s[team=red] at @s anchored eyes run summon item_display ^-0.5 ^ ^-.25 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","red","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^-0.5 ^ ^-.25 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","blue","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @e[tag=temp_dmg,tag=!lol.structure] run function lc:champion/aa/ranged.initial
        execute if entity @e[tag=temp_dmg,tag=lol.structure] run function lc:champion/aa/ranged.initial_structure

        #say 3
        execute if entity @s[team=red] at @s anchored eyes run summon item_display ^-1 ^ ^-.5 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","red","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^-1 ^ ^-.5 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","blue","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @e[tag=temp_dmg,tag=!lol.structure] run function lc:champion/aa/ranged.initial
        execute if entity @e[tag=temp_dmg,tag=lol.structure] run function lc:champion/aa/ranged.initial_structure
        #say 4
    }

    function q.damage.1 {
        execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 0
        scoreboard players set @s dmg_magic.deal 0

        scoreboard players operation temp attack_damage = @s attack_damage
        scoreboard players operation temp attack_damage *= 25 integer
        scoreboard players operation temp attack_damage /= 100 integer

        scoreboard players operation @s dmg_physical.deal = temp attack_damage
        function lc:champion/aa/on_hit
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
        execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
        execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical
    }

    function q.damage.2 {
        execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 0
        scoreboard players set @s dmg_magic.deal 0

        scoreboard players operation temp attack_damage = @s attack_damage
        scoreboard players operation temp attack_damage *= 25 integer
        scoreboard players operation temp attack_damage /= 100 integer

        scoreboard players operation @s dmg_physical.deal = temp attack_damage
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
        execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
        execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical
    }

    function q.damage.3 {
        execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 0
        scoreboard players set @s dmg_magic.deal 0

        scoreboard players operation temp attack_damage = @s attack_damage
        scoreboard players operation temp attack_damage *= 25 integer
        scoreboard players operation temp attack_damage /= 100 integer

        scoreboard players operation @s dmg_physical.deal = temp attack_damage
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
    }

    function q.end {
        execute if entity @s[team=red] run scoreboard players operation @s aa.spd -= red.ashe.q.buff temp
        execute if entity @s[team=blue] run scoreboard players operation @s aa.spd -= blue.ashe.q.buff temp
        scoreboard players set @s status.weapon 500101
        scoreboard players set @s ashe.q.stack 0
        tag @s remove q.active
    }

    function q.hit {
        function lc:champions/ashe/skills/q.damage.1

        function lc:champions/ashe/skills/q.damage.2

        function lc:champions/ashe/skills/q.damage.2

        function lc:champions/ashe/skills/q.damage.2

        function lc:champions/ashe/skills/q.damage.3
    }

    function q.hit_structure {
        function lc:champions/ashe/skills/structure_damage/q.damage.1

        function lc:champions/ashe/skills/structure_damage/q.damage.2

        function lc:champions/ashe/skills/structure_damage/q.damage.2

        function lc:champions/ashe/skills/structure_damage/q.damage.2

        function lc:champions/ashe/skills/structure_damage/q.damage.3
    }

    function q.stack.gain {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run kill @e[tag=ashe.q.stack.cd,tag=<%team%>]
            execute if entity @s[team=<%team%>] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:80,Tags:["ashe.q.stack.cd","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        }

        scoreboard players add @s[scores={ashe.q.stack=..3}] ashe.q.stack 1
    }

    function q.stack.lost {
        scoreboard players remove @s ashe.q.stack 1
        execute if score @s[team=red] ashe.q.stack matches 1.. run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:20,Tags:["ashe.q.stack.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if score @s[team=blue] ashe.q.stack matches 1.. run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:20,Tags:["ashe.q.stack.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    }

    function r.animation {
        tp @s ^ ^ ^1.5 ~ ~

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] positioned ~-1.5 ~-1.5 ~-1.5 if entity @e[tag=champion,team=!<%team%>,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2,limit=1,sort=nearest] positioned ~1.5 ~1.5 ~1.5 run tag @e[tag=champion,team=!<%team%>,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest] add ashe.r.target
            execute if entity @s[tag=<%team%>] if entity @e[team=!<%team%>,tag=ashe.r.target,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest] positioned as @e[team=!<%team%>,tag=ashe.r.target,tag=!unvalid,type=!#unvalid,limit=1,sort=nearest] run function lc:champions/ashe/skills/r.hit
        }

        particle firework ~ ~ ~ 0.2 0.2 0.2 0 1 force
        particle dust{color:[0.5,0.9,1],scale:2} ~ ~ ~ 0.2 0.2 0.2 0 5 force
        particle cloud ~ ~ ~ 0.2 0.2 0.2 0.01 2 force
    }

    function r.damage {
        execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=ashe.r.target,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=ashe.r.target,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 0
        scoreboard players set @s dmg_magic.deal 0

        scoreboard players operation temp ability_power = @s ability_power
        scoreboard players operation temp ability_power *= 120 integer
        scoreboard players operation temp ability_power /= 100 integer
        scoreboard players add temp ability_power 600

        scoreboard players operation @s dmg_magic.deal = temp ability_power
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] remove ashe.r.target

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=ashe.r.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=ashe.r.target,limit=1,sort=nearest] remove ashe.r.target
    }

    function r.damage.side {
        execute if entity @s[team=red] run damage @e[tag=ashe.r.hit,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=ashe.r.hit,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 0
        scoreboard players set @s dmg_magic.deal 0

        scoreboard players operation temp ability_power = @s ability_power
        scoreboard players operation temp ability_power *= 120 integer
        scoreboard players operation temp ability_power /= 100 integer
        scoreboard players add temp ability_power 600
        scoreboard players operation temp ability_power /= 2 integer

        scoreboard players operation @s dmg_magic.deal = temp ability_power
        function lc:champion/dmg/calc.debuff
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=ashe.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=ashe.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=ashe.r.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=red] if entity @e[tag=ashe.r.hit,tag=temp_dmg,type=!#unvalid,team=!red] run function lc:champions/ashe/skills/r.damage.side

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=ashe.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=ashe.r.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=ashe.r.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=blue] if entity @e[tag=ashe.r.hit,tag=temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/ashe/skills/r.damage.side
    }

    function r.hit {
        particle flash{color:[1.0f,1.0f,1.0f,1.0f]} ~ ~1 ~ 0 0 0 1 10 force
        particle cloud ~ ~1 ~ 0 0 0 0.1 100 force
        particle item_snowball ~ ~1 ~ 1.5 0 1.5 0.2 100 force
        execute rotated ~ 0 positioned ~ ~0.5 ~ run function lc:champions/ashe/skills/r.particle
        execute store result score @s cc.stun on passengers run data get entity @s[tag=cd] Age

        execute if entity @s[tag=red] run scoreboard players operation @e[tag=ashe.r.target,team=!red] cc.stun = @s cc.stun
        execute if entity @s[tag=blue] run scoreboard players operation @e[tag=ashe.r.target,team=!blue] cc.stun = @s cc.stun

        execute if entity @s[tag=red] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!red,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2,tag=!ashe.r.target] add ashe.r.hit
        execute if entity @s[tag=red] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!red,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2,tag=!ashe.r.target] add temp_dmg
        execute if entity @s[tag=red] as @p[tag=ashe,team=red] run function lc:champions/ashe/skills/r.damage.side
        execute if entity @s[tag=red] run tag @e[tag=ashe.r.hit,team=!red] remove ashe.r.hit

        execute if entity @s[tag=red] as @p[tag=ashe,team=red] run function lc:champions/ashe/skills/r.damage

        execute if entity @s[tag=red] positioned ~-1.5 ~-1.5 ~-1.5 run effect give @e[team=!red,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2] slowness 1 1 false
        execute if entity @s[tag=red] positioned ~-1.5 ~-1.5 ~-1.5 run scoreboard players add @e[team=!red,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2] fx.sight 20

        execute if entity @s[tag=blue] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!blue,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2,tag=!ashe.r.target] add ashe.r.hit
        execute if entity @s[tag=blue] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!blue,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2,tag=!ashe.r.target] add temp_dmg
        execute if entity @s[tag=blue] as @p[tag=ashe,team=blue] run function lc:champions/ashe/skills/r.damage.side
        execute if entity @s[tag=blue] run tag @e[tag=ashe.r.hit,team=!blue] remove ashe.r.hit

        execute if entity @s[tag=blue] as @p[tag=ashe,team=blue] run function lc:champions/ashe/skills/r.damage

        execute if entity @s[tag=blue] positioned ~-1.5 ~-1.5 ~-1.5 run effect give @e[team=!blue,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2] slowness 1 1 false
        execute if entity @s[tag=blue] positioned ~-1.5 ~-1.5 ~-1.5 run scoreboard players add @e[team=!blue,tag=!unvalid,type=!#unvalid,dx=2,dy=2,dz=2] fx.sight 20

        execute on passengers run kill @s[tag=cd]
    }

