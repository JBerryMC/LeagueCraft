# lc:champions/vayne/skills/  (converted from the 1.20.2 LeagueCraft datapack)

function e.animation {
    execute if block ^ ^0.1 ^1.5 #like_air run tp @s ^ ^ ^1.5
    execute if entity @s[tag=red] run tp @e[tag=vayne.e.target,limit=1,team=!red] ~ ~0.1 ~

    execute unless block ^ ^0.1 ^1.5 #like_air run playsound vayne.sfx.e.stun master @a ~ ~ ~

    execute if entity @s[tag=red] unless block ^ ^0.1 ^1.5 #like_air run summon area_effect_cloud ~ ~ ~ {Duration:31,Tags:["vayne.e.stun.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=red] unless block ^ ^0.1 ^1.5 #like_air run tag @e[tag=vayne.e.target,limit=1,team=!red] add stun
    execute if entity @s[tag=red] unless block ^ ^0.1 ^1.5 #like_air run kill @s

    execute if entity @s[tag=red,nbt={Age:4}] run tag @e[tag=vayne.e.target,limit=1,team=!red] remove vayne.e.target

    execute if entity @s[tag=blue] run tp @e[tag=vayne.e.target,limit=1,team=!blue] ~ ~0.1 ~

    execute if entity @s[tag=blue] unless block ^ ^0.1 ^1.5 #like_air run summon area_effect_cloud ~ ~ ~ {Duration:31,Tags:["vayne.e.stun.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=blue] unless block ^ ^0.1 ^1.5 #like_air run tag @e[tag=vayne.e.target,limit=1,team=!blue] add stun
    execute if entity @s[tag=blue] unless block ^ ^0.1 ^1.5 #like_air run kill @s

    execute if entity @s[tag=blue,nbt={Age:4}] run tag @e[tag=vayne.e.target,limit=1,team=!blue] remove vayne.e.target
}

function e.knockback {
    particle witch ~ ~1.2 ~ 0 0 0 0.5 50 force
    execute if entity @s[team=red] run tag @e[tag=vayne.aa.target,team=!red,limit=1] add vayne.e.target
    execute if entity @s[team=red] run tag @e[tag=vayne.e.target,team=!red,limit=1] add airborne
    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:5,Tags:["vayne.e.knockback","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] rotated as @s run tp @e[tag=vayne.e.knockback,tag=red] ~ ~ ~ ~ ~
    execute if entity @s[team=blue] run tag @e[tag=vayne.aa.target,team=!blue,limit=1] add vayne.e.target
    execute if entity @s[team=blue] run tag @e[tag=vayne.e.target,team=!blue,limit=1] add airborne
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:5,Tags:["vayne.e.knockback","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] rotated as @s run tp @e[tag=vayne.e.knockback,tag=blue] ~ ~ ~ ~ ~
}

function e.stun {
    execute if entity @s[tag=red,nbt={Age:30}] run tag @e[tag=vayne.e.target,limit=1,team=!red] remove stun
    execute if entity @s[tag=red,nbt={Age:30}] run tag @e[tag=vayne.e.target,limit=1,team=!red] remove vayne.e.target
    execute if entity @s[tag=blue,nbt={Age:30}] run tag @e[tag=vayne.e.target,limit=1,team=!blue] remove stun
    execute if entity @s[tag=blue,nbt={Age:30}] run tag @e[tag=vayne.e.target,limit=1,team=!blue] remove vayne.e.target
}

function p.raycasting {
    execute if entity @s[team=red,distance=..20] unless entity @e[tag=!unvalid,type=!#unvalid,distance=..1.5,team=!red] positioned ^ ^ ^1 run function lc:champions/vayne/skills/p.raycasting
    execute if entity @s[team=red,distance=..20] if entity @e[tag=!unvalid,type=!#unvalid,distance=..1.5,team=!red] run tag @s add p.active
    execute if entity @s[team=blue,distance=..20] unless entity @e[tag=!unvalid,type=!#unvalid,distance=..1.5,team=!blue] positioned ^ ^ ^1 run function lc:champions/vayne/skills/p.raycasting
    execute if entity @s[team=blue,distance=..20] if entity @e[tag=!unvalid,type=!#unvalid,distance=..1.5,team=!blue] run tag @s add p.active
}

function q.dash {
    execute if block ^ ^ ^1 #like_air run tp @s ^ ^ ^1
    execute if entity @s[tag=red] run tp @p[team=red,tag=vayne] ~ ~ ~ ~ ~
    execute if entity @s[tag=blue] run tp @p[team=blue,tag=vayne] ~ ~ ~ ~ ~
}

function r.animation {
    tp @s ~ ~0.2 ~ ~30 0
    particle witch ^1 ^ ^ 0 0 0 1 2 force
    particle witch ^-1 ^ ^ 0 0 0 1 2 force

    execute if entity @s[tag=red] run tp @e[tag=red,tag=vayne.r.bat1,type=silverfish] ^1 ^ ^
    execute if entity @s[tag=red] run tp @e[tag=red,tag=vayne.r.bat2,type=silverfish] ^-1 ^ ^

    execute if entity @s[tag=blue] run tp @e[tag=blue,tag=vayne.r.bat1,type=silverfish] ^1 ^ ^
    execute if entity @s[tag=blue] run tp @e[tag=blue,tag=vayne.r.bat2,type=silverfish] ^-1 ^ ^
}

function r.bat {
    execute if entity @s[tag=red,tag=vayne.r.bat1] unless entity @e[tag=vayne.r.animation,tag=red] at @p[tag=vayne,team=red] rotated ~ 0 run tp @s ^1 ^1.5 ^ ~ ~
    execute if entity @s[tag=red,tag=vayne.r.bat2] unless entity @e[tag=vayne.r.animation,tag=red] at @p[tag=vayne,team=red] rotated ~ 0 run tp @s ^-1 ^1.5 ^ ~ ~
    execute if entity @s[tag=red] unless entity @e[tag=vayne.r.cd,tag=red] run function lc:champions/vayne/skills/r.end
    execute if entity @s[tag=red] unless entity @e[tag=vayne.q.fx.invis.cd,tag=red] positioned as @p[tag=vayne,team=red] run particle witch ~ ~ ~ 0.2 0 0.2 0 2 force

    execute if entity @s[tag=red,tag=vayne.r.bat1] run scoreboard players remove @p[scores={vayne.r.duration=1..}] vayne.r.duration 1
    execute if entity @s[tag=red,tag=vayne.r.bat2] store result bossbar red.vayne.r value run scoreboard players get @p[tag=vayne,team=red] vayne.r.duration

    execute if entity @s[tag=blue,tag=vayne.r.bat1] unless entity @e[tag=vayne.r.animation,tag=blue] at @p[tag=vayne,team=blue] rotated ~ 0 run tp @s ^1 ^1.5 ^ ~ ~
    execute if entity @s[tag=blue,tag=vayne.r.bat2] unless entity @e[tag=vayne.r.animation,tag=blue] at @p[tag=vayne,team=blue] rotated ~ 0 run tp @s ^-1 ^1.5 ^ ~ ~
    execute if entity @s[tag=blue] unless entity @e[tag=vayne.r.cd,tag=blue] run function lc:champions/vayne/skills/r.end
    execute if entity @s[tag=blue] unless entity @e[tag=vayne.q.fx.invis.cd,tag=blue] positioned as @p[tag=vayne,team=blue] run particle witch ~ ~ ~ 0.2 0 0.2 0 2 force

    execute if entity @s[tag=blue,tag=vayne.r.bat1] run scoreboard players remove @p[scores={vayne.r.duration=1..}] vayne.r.duration 1
    execute if entity @s[tag=blue,tag=vayne.r.bat2] store result bossbar blue.vayne.r value run scoreboard players get @p[tag=vayne,team=blue] vayne.r.duration
}

function r.end {
    execute if entity @s[tag=red] run bossbar remove red.vayne.r
    execute if entity @s[tag=blue] run bossbar remove blue.vayne.r

    tp @s ~ -100 ~
    kill @s
}

function r.extend {
    scoreboard players add @s vayne.r.duration 20

    execute if entity @s[team=red] as @e[tag=red,tag=vayne.r.cd,limit=1] store result score @s temp run data get entity @s Age
    execute if entity @s[team=red] as @e[tag=red,tag=vayne.r.cd,limit=1] run scoreboard players remove @s temp 20
    execute if entity @s[team=red] as @e[tag=red,tag=vayne.r.cd,limit=1] store result entity @s Age int 1 run scoreboard players get @s temp

    execute if entity @s[team=blue] as @e[tag=blue,tag=vayne.r.cd,limit=1] store result score @s temp run data get entity @s Age
    execute if entity @s[team=blue] as @e[tag=blue,tag=vayne.r.cd,limit=1] run scoreboard players remove @s temp 20
    execute if entity @s[team=blue] as @e[tag=blue,tag=vayne.r.cd,limit=1] store result entity @s Age int 1 run scoreboard players get @s temp
}

function w.stack.full {
    playsound vayne.sfx.w master @a ~ ~ ~

    execute if entity @s[team=red] if entity @e[tag=red,tag=vayne.r.cd] as @p[tag=vayne,team=red] run function lc:champions/vayne/skills/r.extend
    execute if entity @s[team=red] run kill @e[tag=vayne.w.passive,team=red]
    execute if entity @s[team=red] positioned as @e[tag=vayne.aa.target,team=!red] run particle crit ~ ~1.2 ~ 0 0 0 0.5 50 force
    execute if entity @s[team=red] run effect give @e[tag=vayne.aa.target,type=!#undead,team=!red] instant_damage 1 0 true
    execute if entity @s[team=red] run effect give @e[tag=vayne.aa.target,type=#undead,team=!red] instant_health 1 0 true
    execute if entity @s[team=red] run scoreboard players set @p[team=red,tag=vayne] vayne.w.stack 0
    execute if entity @s[team=red] run kill @e[tag=vayne.w.stack.cd,tag=red]
    execute if entity @s[team=red] run tag @e[tag=vayne.aa.target,team=!red] remove vayne.aa.target

    execute if entity @s[team=blue] if entity @e[tag=blue,tag=vayne.r.cd] as @p[tag=vayne,team=blue] run function lc:champions/vayne/skills/r.extend
    execute if entity @s[team=blue] run kill @e[tag=vayne.w.passive,team=blue]
    execute if entity @s[team=blue] positioned as @e[tag=vayne.aa.target,team=!blue] run particle crit ~ ~1.2 ~ 0 0 0 0.5 50 force
    execute if entity @s[team=blue] run effect give @e[tag=vayne.aa.target,type=!#undead,team=!blue] instant_damage 1 0 true
    execute if entity @s[team=blue] run effect give @e[tag=vayne.aa.target,type=#undead,team=!blue] instant_health 1 0 true
    execute if entity @s[team=blue] run scoreboard players set @p[team=blue,tag=vayne] vayne.w.stack 0
    execute if entity @s[team=blue] run kill @e[tag=vayne.w.stack.cd,tag=blue]
    execute if entity @s[team=blue] run tag @e[tag=vayne.aa.target,team=!blue] remove vayne.aa.target
}

function w.stack.gain {
    execute if entity @s[team=red] run kill @e[tag=vayne.w.stack.cd,tag=red]
    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:70,Tags:["vayne.w.stack.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=red] if entity @e[type=!#unvalid,tag=vayne.aa.target,distance=..2,team=!red,limit=1,sort=nearest] run scoreboard players add @p[tag=vayne,team=red,scores={vayne.w.stack=..2}] vayne.w.stack 1
    execute if entity @s[team=red] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!red,limit=1,sort=nearest] run scoreboard players set @p[tag=vayne,team=red] vayne.w.stack 1
    execute if entity @s[team=red] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!red,limit=1,sort=nearest] run tag @e[type=!#unvalid,tag=vayne.aa.target,team=!red] remove vayne.aa.target
    execute if entity @s[team=red] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!red,limit=1,sort=nearest] run tag @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!red,limit=1,sort=nearest] add vayne.aa.target
    execute if entity @s[team=red,tag=e_active] positioned as @e[tag=vayne.aa.target,limit=1,team=!red] run function lc:champions/vayne/skills/e.knockback
    execute if entity @s[team=red] if entity @p[tag=vayne,team=red,scores={vayne.w.stack=1}] unless entity @e[tag=vayne.w.passive,team=red] run summon armor_stand ~ ~ ~ {Tags:["unvalid","vayne.w.passive"],Marker:1,Invisible:1,Team:'red',equipment:{head:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[600001f]}}}}}
    execute if entity @s[team=red] if entity @p[tag=vayne,team=red,scores={vayne.w.stack=2}] run data modify entity @e[tag=vayne.w.passive,team=red,limit=1] equipment.head.components."minecraft:custom_model_data" set value {floats:[600002f]}
    execute if entity @s[team=red] if entity @p[tag=vayne,team=red,scores={vayne.w.stack=3}] run function lc:champions/vayne/skills/w.stack.full

    execute if entity @s[team=blue] run kill @e[tag=vayne.w.stack.cd,tag=blue]
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:70,Tags:["vayne.w.stack.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] if entity @e[type=!#unvalid,tag=vayne.aa.target,distance=..2,team=!blue,limit=1,sort=nearest] run scoreboard players add @p[tag=vayne,team=blue,scores={vayne.w.stack=..2}] vayne.w.stack 1
    execute if entity @s[team=blue] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!blue,limit=1,sort=nearest] run scoreboard players set @p[tag=vayne,team=blue] vayne.w.stack 1
    execute if entity @s[team=blue] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!blue,limit=1,sort=nearest] run tag @e[type=!#unvalid,tag=vayne.aa.target,team=!blue] remove vayne.aa.target
    execute if entity @s[team=blue] if entity @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!blue,limit=1,sort=nearest] run tag @e[type=!#unvalid,tag=!vayne.aa.target,distance=..2,team=!blue,limit=1,sort=nearest] add vayne.aa.target
    execute if entity @s[team=blue,tag=e_active] positioned as @e[tag=vayne.aa.target,limit=1,team=!blue] run function lc:champions/vayne/skills/e.knockback
    execute if entity @s[team=blue] if entity @p[tag=vayne,team=blue,scores={vayne.w.stack=1}] unless entity @e[tag=vayne.w.passive,team=blue] run summon armor_stand ~ ~ ~ {Tags:["unvalid","vayne.w.passive"],Marker:1,Invisible:1,Team:'blue',equipment:{head:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[600001f]}}}}}
    execute if entity @s[team=blue] if entity @p[tag=vayne,team=blue,scores={vayne.w.stack=2}] run data modify entity @e[tag=vayne.w.passive,team=blue,limit=1] equipment.head.components."minecraft:custom_model_data" set value {floats:[600002f]}
    execute if entity @s[team=blue] if entity @p[tag=vayne,team=blue,scores={vayne.w.stack=3}] run function lc:champions/vayne/skills/w.stack.full
}

function w.stack.lost {
    scoreboard players set @s vayne.w.stack 0
    execute if entity @s[team=red] run kill @e[tag=vayne.w.passive,team=red]
    execute if entity @s[team=red] run tag @e[tag=vayne.aa.target,team=!red] remove vayne.aa.target

    execute if entity @s[team=blue] run kill @e[tag=vayne.w.passive,team=blue]
    execute if entity @s[team=blue] run tag @e[tag=vayne.aa.target,team=!blue] remove vayne.aa.target
}
