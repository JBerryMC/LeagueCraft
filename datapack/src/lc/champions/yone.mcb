# lc:champions/yone/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking yone; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.yone
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.yone
    playsound minecraft:yone.select master @a ~ ~ ~
    playsound minecraft:yone.sfx.select master @a ~ ~ ~
    scoreboard players set @s yone.passive 0
}

function aa {
    execute if score @s yone.passive matches 0 run playsound yone.sfx.aa1 master @a ~ ~ ~
    execute if score @s yone.passive matches 1 run playsound yone.sfx.aa2 master @a ~ ~ ~
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:yone"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:yone/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:yone/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:yone/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:yone/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:yone/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## PASSIVE
    execute if score @s yone.passive matches 0 run scoreboard players set @s status.p 0
    execute if score @s yone.passive matches 1 run scoreboard players set @s status.p 1

    ## Q
    execute if score @s[tag=!full_q,tag=!cced,tag=!r.animation,tag=!e.animation] cd_q matches 0 run scoreboard players set @s status.q 1
    execute if score @s[tag=full_q,tag=!cced,tag=!r.animation,tag=!e.animation] cd_q matches 0 run scoreboard players set @s status.q 2
    execute if score @s[tag=!full_q,tag=!cced,tag=!r.animation,tag=!e.animation] cd_q matches 1.. run scoreboard players set @s status.q 0
    execute if score @s[tag=full_q,tag=!cced,tag=!r.animation,tag=!e.animation] cd_q matches 1.. run scoreboard players set @s status.q 7

    execute if entity @s[tag=full_q,tag=!cced,tag=!r.animation,tag=!e.animation] if score @s cc.root matches 1.. run scoreboard players set @s status.q 9

    ## E

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>,tag=e.soul] if entity @e[tag=yone.e.dash,tag=<%team%>] run scoreboard players set @s status.e 9
        execute if entity @s[team=<%team%>,tag=e.soul,tag=!cced,tag=!r.animation] unless entity @e[tag=yone.e.dash,tag=<%team%>] run scoreboard players set @s status.e 2
    }

    execute if entity @s[team=red] if entity @e[tag=yone.e.body,tag=red,tag=unbound.buffer] run tag @s add e.animation
    execute if entity @s[team=blue] if entity @e[tag=yone.e.body,tag=blue,tag=unbound.buffer] run tag @s add e.animation

    execute if score @s cc.root matches 1.. run scoreboard players set @s status.e 9

    ## R
    execute if score @s cc.root matches 1.. run scoreboard players set @s status.r 9

    function lc:champions/yone/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=yone.q.stackcd,type=minecraft:area_effect_cloud] at @s run function lc:champions/yone/skills/q.stack
    execute as @e[tag=yone.q.tornado,type=minecraft:item_display] at @s run function lc:champions/yone/skills/q.tornado.passive
    execute as @e[tag=yone.q,type=minecraft:item_display] at @s run function lc:champions/yone/skills/q.dash

    execute as @e[tag=yone.w.animation,type=minecraft:area_effect_cloud] at @s run function lc:champions/yone/skills/w.animation

    execute as @e[tag=yone.e.dash,type=minecraft:item_display] at @s run function lc:champions/yone/skills/e.dash
    execute as @e[tag=yone.unbound,type=minecraft:item_display] at @s run function lc:champions/yone/skills/e.unbound.dash
    execute as @e[tag=yone.e.body,type=minecraft:item_display] at @s run function lc:champions/yone/skills/e.body

    execute as @e[tag=yone.e.cd.particle,type=minecraft:area_effect_cloud] at @s run particle dust{color:[1,0,0],scale:1} ~ ~ ~ 0 0 0 1 1 force

    execute as @e[tag=yone.e.cd.particle,type=minecraft:area_effect_cloud,tag=red] at @s run data modify entity @s Pos[1] set from entity @e[tag=yone.e.body,tag=red,limit=1] Pos[1]
    execute as @e[tag=yone.e.cd.particle,type=minecraft:area_effect_cloud,tag=blue] at @s run data modify entity @s Pos[1] set from entity @e[tag=yone.e.body,tag=blue,limit=1] Pos[1]
    execute as @e[tag=yone.e.mark,type=#has_health_bar] at @s anchored eyes run particle note ^ ^0.5 ^ 0 0 0 1 1 force

    execute as @e[tag=yone.r.cast,type=minecraft:area_effect_cloud] at @s run function lc:champions/yone/skills/r.cast
    execute as @e[tag=yone.r.particle,type=minecraft:area_effect_cloud] at @s run particle dust{color:[1,0,0],scale:1} ~ ~ ~ 0.1 0 0.1 1 2 force
}

function main {
    # Cooldown
    function lc:champions/yone/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/yone/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/yone/item/offhand

    ## Passive

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r
}

function passive {
    item replace entity @s weapon.offhand with air
    tag @s add offhand_temp

    execute if score @s yone.passive matches 0 run scoreboard players set @s dmg_magic.deal 0
    execute if score @s yone.passive matches 0 run scoreboard players set @s status.weapon 400102

    execute if score @s yone.passive matches 1 run scoreboard players set @s status.weapon 400101
    execute if score @s yone.passive matches 1 run scoreboard players operation @s dmg_physical.deal /= 2 integer
    execute if score @s yone.passive matches 1 run scoreboard players operation @s dmg_magic.deal = @s dmg_physical.deal

    scoreboard players add @s yone.passive 1
    execute if score @s yone.passive matches 2 run scoreboard players set @s yone.passive 0
}

function use_e {
    function lc:champion/abilities/cooldown/e
    playsound minecraft:yone.sfx.e master @a ~ ~ ~
    scoreboard players set @s mana 100
    scoreboard players set @s yone.passive 0
    tag @s add e.soul

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["yone.e.dash","temp","<%team%>","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:5,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=<%team%>] run summon minecraft:item_display ~ ~ ~ {item_display:"head",Tags:["yone.e.body","<%team%>","lol.auto_clear"],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[400002f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:105,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    }

    tp @e[tag=yone.e.dash,tag=temp,limit=1,sort=nearest] ~ ~0.5 ~ ~ ~
    execute as @e[tag=yone.e.dash,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
    execute at @e[tag=yone.e.dash,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=yone.e.dash,tag=temp,limit=1,sort=nearest] remove temp

    execute if entity @s[team=red] run tp @e[tag=red,tag=yone.e.body,type=minecraft:item_display] ~ ~0.5 ~ ~ 0
    execute if entity @s[team=blue] run tp @e[tag=blue,tag=yone.e.body,type=minecraft:item_display] ~ ~0.5 ~ ~ 0
}

function use_e2 {
    scoreboard players set @s yone.passive 0

    execute if entity @s[team=red] as @e[tag=yone.e.body,tag=red] on passengers run kill @s
    execute if entity @s[team=blue] as @e[tag=yone.e.body,tag=blue] on passengers run kill @s
}

function use_q {
    function lc:champion/abilities/cooldown/q_aa.spd
    scoreboard players set @s channeling 5

    execute if score @s[tag=full_q] stack_q matches 2 run function lc:core/motion/tag_dash {tag:"full_q"}

    execute if score @s[tag=full_q] stack_q matches 2 run function lc:champions/yone/skills/q.tornado.spawn

    execute if score @s stack_q matches 0..1 anchored eyes positioned ^ ^ ^0.5 run function lc:champions/yone/skills/q.particle
    execute if score @s stack_q matches 0..1 anchored eyes positioned ^ ^ ^1.5 run function lc:champions/yone/skills/q.check

    execute if score @s stack_q matches 0..1 run playsound yone.sfx.q0 master @a ~ ~ ~
    execute if score @s[tag=full_q] stack_q matches 2 run playsound yone.sfx.q1 master @a ~ ~ ~

    execute if score @s[tag=!full_q] stack_q matches 2 run scoreboard players set @s stack_q 0
}

function use_r {
    function lc:champion/abilities/cooldown/r

    playsound minecraft:yone.sfx.r master @a ~ ~ ~
    scoreboard players set @s channeling 20
    tag @s add r.animation

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:20,Tags:["yone.r.cast","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[team=<%team%>] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:20,Tags:["yone.r.animation","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    }
    tp @e[tag=yone.r.cast,limit=1,sort=nearest] ~ ~ ~ ~ 0
}

function use_w {
    function lc:champion/abilities/cooldown/w_aa.spd
    scoreboard players set @s channeling 5

    playsound minecraft:yone.sfx.w master @a ~ ~ ~

    execute if entity @s[team=red] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:5,Tags:["yone.w.animation","red","temp"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:5,Tags:["yone.w.animation","blue","temp"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    tp @e[tag=yone.w.animation,limit=1,sort=nearest,tag=temp] ~ ~0.75 ~ ~60 ~
    data modify entity @e[tag=yone.w.animation,limit=1,sort=nearest,tag=temp] Owner set from entity @s UUID
    tag @e[tag=yone.w.animation,tag=temp,limit=1,sort=nearest] remove temp
}

# ---- item: lc:champions/yone/item/... ------------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]

        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[400001f]},minecraft:custom_name={text:"Yone Hair",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[400001f]},minecraft:custom_name={text:"Tóc Yone",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        execute if score @s yone.passive matches 1 run item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[400101f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
        execute if score @s yone.passive matches 0 run item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[400102f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/yone/skills/... --------------------------------------------
dir skills {
    function e.body {
        execute if entity @s[tag=red] unless entity @e[tag=yone.e.dash,type=minecraft:item_display,tag=red] on passengers rotated as @s run summon minecraft:area_effect_cloud ^ ^ ^1 {WaitTime:0,Duration:105,Tags:["yone.e.cd.particle","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] if entity @e[tag=yone.e.dash,tag=red] rotated as @e[tag=yone.e.dash,tag=red] if block ^ ^ ^-.75 #like_air run tp @s ^ ^ ^-.75

        execute if entity @s[tag=red] unless entity @e[tag=yone.e.dash,tag=red] if block ~ ~-0.5 ~ #like_air run tp @s ~ ~-0.5 ~
        execute if entity @s[tag=red] unless entity @e[tag=yone.e.dash,tag=red] run scoreboard players remove @p[tag=yone,team=red,scores={mana=1..}] mana 1

        execute if entity @s[tag=red,tag=!yone.e.end] run effect give @p[tag=yone,team=red] speed infinite 1 true
        execute if entity @s[tag=red] facing entity @p[tag=yone,team=red] feet positioned ^ ^ ^0.1 run function lc:champions/yone/skills/e.particle

        execute if entity @s[tag=red] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=red] run tag @p[tag=yone,team=red] remove e.animation
        execute if entity @s[tag=red] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=red] run tag @p[tag=yone,team=red] remove unstoppable
        execute if entity @s[tag=red] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=red] as @e[tag=yone.unbound,tag=red,limit=1,sort=nearest] on passengers run kill @s[tag=cd]
        execute if entity @s[tag=red] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=red] at @s run tp @p[tag=yone,team=red] ~ ~ ~
        execute if entity @s[tag=red] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=red] run gamemode spectator @p[tag=yone,team=red,tag=dead]
        execute if entity @s[tag=red] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=red] run kill @s

        execute if entity @s[tag=unbound.buffer,tag=red,tag=!yone.e.end] as @p[team=red,tag=yone,tag=!cced,tag=!r.animation] if score @s channeling matches -1 unless function lc:core/motion/in_dash as @e[tag=unbound.buffer,tag=red] run function lc:champions/yone/skills/e.unbound

        execute if entity @s[tag=blue] unless entity @e[tag=yone.e.dash,type=minecraft:item_display,tag=blue] on passengers rotated as @s run summon minecraft:area_effect_cloud ^ ^ ^1 {WaitTime:0,Duration:105,Tags:["yone.e.cd.particle","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=blue] if entity @e[tag=yone.e.dash,tag=blue] rotated as @e[tag=yone.e.dash,tag=blue] if block ^ ^ ^-.75 #like_air run tp @s ^ ^ ^-.75

        execute if entity @s[tag=blue] unless entity @e[tag=yone.e.dash,tag=blue] if block ~ ~-0.5 ~ #like_air run tp @s ~ ~-0.5 ~
        execute if entity @s[tag=blue] unless entity @e[tag=yone.e.dash,tag=blue] run scoreboard players remove @p[tag=yone,team=blue,scores={mana=1..}] mana 1

        execute if entity @s[tag=blue,tag=!yone.e.end] run effect give @p[tag=yone,team=blue] speed infinite 1 true
        execute if entity @s[tag=blue] facing entity @p[tag=yone,team=blue] feet positioned ^ ^ ^0.1 run function lc:champions/yone/skills/e.particle

        execute if entity @s[tag=blue] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=blue] run tag @p[tag=yone,team=blue] remove e.animation
        execute if entity @s[tag=blue] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=blue] run tag @p[tag=yone,team=blue] remove unstoppable
        execute if entity @s[tag=blue] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=blue] as @e[tag=yone.unbound,tag=blue,limit=1,sort=nearest] on passengers run kill @s[tag=cd]
        execute if entity @s[tag=blue] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=blue] at @s run tp @p[tag=yone,team=blue] ~ ~ ~
        execute if entity @s[tag=blue] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=blue] run gamemode spectator @p[tag=yone,team=blue,tag=dead]
        execute if entity @s[tag=blue] positioned ~ ~0.5 ~ if entity @e[tag=yone.unbound,distance=..1,tag=blue] run kill @s

        execute if entity @s[tag=unbound.buffer,tag=blue,tag=!yone.e.end] as @p[team=blue,tag=yone,tag=!cced,tag=!r.animation] if score @s channeling matches -1 unless function lc:core/motion/in_dash as @e[tag=unbound.buffer,tag=blue] run function lc:champions/yone/skills/e.unbound

        execute on passengers at @s run tp @s ~ ~ ~ ~3.7 0
    }

    function e.damage {
        execute if entity @s[team=red] run damage @e[tag=yone.e.mark,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        execute if entity @s[team=red] as @e[team=!red,tag=yone.e.mark,tag=has_health_bar,limit=1,sort=nearest] run scoreboard players operation @s yone.e.dmg *= 35 integer
        execute if entity @s[team=red] as @e[team=!red,tag=yone.e.mark,tag=has_health_bar,limit=1,sort=nearest] run scoreboard players operation @s yone.e.dmg /= 100 integer

        execute if entity @s[team=red] as @e[team=!red,tag=yone.e.mark,tag=has_health_bar,limit=1,sort=nearest] run scoreboard players operation @s dmg_true.raw = @s yone.e.dmg

        execute if entity @s[team=red] run scoreboard players set @e[team=!red,tag=yone.e.mark,type=!#unvalid,limit=1,sort=nearest] yone.e.dmg 0
        execute if entity @s[team=red] run tag @e[team=!red,tag=yone.e.mark,type=!#unvalid,limit=1,sort=nearest] remove yone.e.mark

        execute if entity @s[team=red] if entity @e[tag=yone.e.mark,type=!#unvalid,team=!red] run function lc:champions/yone/skills/e.damage

        execute if entity @s[team=blue] run damage @e[tag=yone.e.mark,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        execute if entity @s[team=blue] as @e[team=!blue,tag=yone.e.mark,tag=has_health_bar,limit=1,sort=nearest] run scoreboard players operation @s yone.e.dmg *= 35 integer
        execute if entity @s[team=blue] as @e[team=!blue,tag=yone.e.mark,tag=has_health_bar,limit=1,sort=nearest] run scoreboard players operation @s yone.e.dmg /= 100 integer

        execute if entity @s[team=blue] as @e[team=!blue,tag=yone.e.mark,tag=has_health_bar,limit=1,sort=nearest] run scoreboard players operation @s dmg_true.raw = @s yone.e.dmg

        execute if entity @s[team=blue] run scoreboard players set @e[team=!blue,tag=yone.e.mark,type=!#unvalid,limit=1,sort=nearest] yone.e.dmg 0
        execute if entity @s[team=blue] run tag @e[team=!blue,tag=yone.e.mark,type=!#unvalid,limit=1,sort=nearest] remove yone.e.mark

        execute if entity @s[team=blue] if entity @e[tag=yone.e.mark,type=!#unvalid,team=!blue] run function lc:champions/yone/skills/e.damage
    }

    function e.dash {
        tp @s ^ ^ ^.75
        execute if entity @s[tag=red] at @s positioned ~ ~-0.5 ~ as @p[team=red,tag=yone] run function lc:core/motion/follow
        execute if entity @s[tag=blue] at @s positioned ~ ~-0.5 ~ as @p[team=blue,tag=yone] run function lc:core/motion/follow
    }

    function e.mark {
        execute as @e[type=!#unvalid,type=!player] store result score @s hurt run data get entity @s HurtTime
        execute if entity @s[team=red] positioned ^ ^ ^1 run tag @e[tag=!unvalid,type=!#unvalid,team=!red,limit=1,sort=nearest,scores={hurt=1..}] add yone.e.mark
        execute if entity @s[team=blue] positioned ^ ^ ^1 run tag @e[tag=!unvalid,type=!#unvalid,team=!blue,limit=1,sort=nearest,scores={hurt=1..}] add yone.e.mark

        scoreboard players reset @e[type=!#unvalid,type=!player] hurt
    }

    function e.particle {
        particle dust{color:[1,0,0],scale:0.5} ~ ~1 ~ 0 0 0 1 1 force
        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 unless entity @p[tag=yone,team=red,dx=0] positioned ~0.5 ~0.5 ~0.5 positioned ^ ^ ^0.1 run function lc:champions/yone/skills/e.particle
        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 unless entity @p[tag=yone,team=blue,dx=0] positioned ~0.5 ~0.5 ~0.5 positioned ^ ^ ^0.1 run function lc:champions/yone/skills/e.particle
    }

    function e.unbound {
        ## RED
        execute if entity @s[tag=red] run scoreboard players set @p[tag=yone,team=red] channeling 5
        execute if entity @s[tag=red] if entity @e[tag=yone.e.mark,team=!red] as @p[tag=yone,team=red] run function lc:champions/yone/skills/e.damage
        execute if entity @s[tag=red] run scoreboard players set @p[tag=yone,team=red] mana 0

        execute if entity @s[tag=red] positioned as @p[tag=yone,team=red] run playsound minecraft:yone.sfx.e2 master @a ~ ~ ~

        execute if entity @s[tag=red] run effect clear @p[tag=yone,team=red] speed

        execute if entity @s[tag=red] run kill @e[tag=yone.e.cd.particle,type=minecraft:area_effect_cloud,tag=red]
        execute if entity @s[tag=red] as @p[tag=yone,team=red] run function lc:core/effect/cleanse
        execute if entity @s[tag=red] run tag @p[tag=yone,team=red] remove e.soul
        execute if entity @s[tag=red] run tag @p[tag=yone,team=red] add unstoppable

        execute if entity @s[tag=red] as @p[tag=yone,team=red] at @s run function lc:champions/yone/skills/e.unbound.spawn

        ## BLUE
        execute if entity @s[tag=blue] run scoreboard players set @p[tag=yone,team=blue] channeling 5
        execute if entity @s[tag=blue] if entity @e[tag=yone.e.mark,team=!blue] as @p[tag=yone,team=blue] run function lc:champions/yone/skills/e.damage
        execute if entity @s[tag=blue] run scoreboard players set @p[tag=yone,team=blue] mana 0

        execute if entity @s[tag=blue] positioned as @p[tag=yone,team=blue] run playsound minecraft:yone.sfx.e2 master @a ~ ~ ~

        execute if entity @s[tag=blue] run effect clear @p[tag=yone,team=blue] speed

        execute if entity @s[tag=blue] run kill @e[tag=yone.e.cd.particle,type=minecraft:area_effect_cloud,tag=blue]
        execute if entity @s[tag=blue] as @p[tag=yone,team=blue] run function lc:core/effect/cleanse
        execute if entity @s[tag=blue] run tag @p[tag=yone,team=blue] remove e.soul
        execute if entity @s[tag=blue] run tag @p[tag=yone,team=blue] add unstoppable

        execute if entity @s[tag=blue] as @p[tag=yone,team=blue] at @s run function lc:champions/yone/skills/e.unbound.spawn

        tag @s add yone.e.end
    }

    function e.unbound.dash {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] if score @p[team=<%team%>,tag=yone] channeling matches -1 facing entity @e[tag=<%team%>,tag=yone.e.body,type=item_display] feet rotated ~ ~-5 run tp @s ^ ^ ^1.5
            execute if entity @s[tag=<%team%>] if score @p[team=<%team%>,tag=yone] channeling matches -1 at @s positioned ~ ~-0.5 ~ as @p[team=<%team%>,tag=yone] run function lc:core/motion/follow
        }
    }

    function e.unbound.spawn {
        execute if entity @s[team=red] run summon item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["dash","red","yone.unbound","temp","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] run summon item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["dash","blue","yone.unbound","temp","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        execute at @e[tag=yone.unbound,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        tag @e[tag=yone.unbound,tag=temp,limit=1,sort=nearest] remove temp
    }

    function q.check {
        execute if entity @s[team=red] positioned ^ ^ ^ positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!red,type=!#unvalid,tag=!unvalid,tag=!yone.q.hit] add yone.q.hit
        execute if entity @s[team=red] positioned ^ ^ ^1 positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!red,type=!#unvalid,tag=!unvalid,tag=!yone.q.hit] add yone.q.hit
        execute if entity @s[team=red] positioned ^ ^ ^2 positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!red,type=!#unvalid,tag=!unvalid,tag=!yone.q.hit] add yone.q.hit

        execute if entity @s[team=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run scoreboard players add @s stack_q 1
        execute if entity @s[team=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run function lc:champions/yone/skills/q.stack_cd
        execute if entity @s[team=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!red] add temp_dmg
        execute if entity @s[team=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run function lc:champions/yone/skills/q.damage
        execute if entity @s[team=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!red] remove yone.q.hit

        execute if entity @s[team=blue] positioned ^ ^ ^ positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!blue,type=!#unvalid,tag=!unvalid,tag=!yone.q.hit] add yone.q.hit
        execute if entity @s[team=blue] positioned ^ ^ ^1 positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!blue,type=!#unvalid,tag=!unvalid,tag=!yone.q.hit] add yone.q.hit
        execute if entity @s[team=blue] positioned ^ ^ ^2 positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!blue,type=!#unvalid,tag=!unvalid,tag=!yone.q.hit] add yone.q.hit

        execute if entity @s[team=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run scoreboard players add @s stack_q 1
        execute if entity @s[team=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run function lc:champions/yone/skills/q.stack_cd
        execute if entity @s[team=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!blue] add temp_dmg
        execute if entity @s[team=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run function lc:champions/yone/skills/q.damage
        execute if entity @s[team=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!blue] remove yone.q.hit

        execute if score @s stack_q matches 2 run tag @s add full_q
    }

    function q.damage {
        execute if entity @s[team=red] run damage @e[tag=yone.q.hit,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=yone.q.hit,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 100
        scoreboard players operation @s dmg_physical.deal += @s attack_damage
        function lc:champion/aa/on_hit
        function lc:champion/dmg/calc.debuff

        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yone.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=yone.q.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=red] if entity @e[tag=yone.q.hit,tag=temp_dmg,type=!#unvalid,team=!red] run function lc:champions/yone/skills/q.damage

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yone.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=yone.q.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=blue] if entity @e[tag=yone.q.hit,tag=temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/yone/skills/q.damage
    }

    function q.dash {
        execute if block ^ ^ ^1 #like_air run tp @s ^ ^ ^1
        execute if entity @s[tag=red] at @s positioned ~ ~-0.5 ~ as @p[team=red,tag=yone] run function lc:core/motion/follow
        execute if entity @s[tag=blue] at @s positioned ~ ~-0.5 ~ as @p[team=blue,tag=yone] run function lc:core/motion/follow

        particle minecraft:instant_effect ^ ^ ^ 0.2 0 0.2 0 10 force
    }

    function q.particle {
        particle minecraft:end_rod ^ ^ ^0.5 0 0 0 0 1 force
        particle minecraft:end_rod ^ ^ ^0.75 0 0 0 0 1 force
        particle minecraft:end_rod ^ ^ ^1 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^1.25 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^1.5 0.1 0.1 0.1 0 3 force
        particle minecraft:end_rod ^ ^ ^1.75 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^2 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^2.25 0 0 0 0 1 force
        particle minecraft:end_rod ^ ^ ^2.5 0 0 0 0 1 force

        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^0.5 0 0 0 0 1 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^0.75 0 0 0 0 1 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^1 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^1.25 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^1.5 0.1 0.1 0.1 0 3 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^1.75 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^2 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^2.25 0 0 0 0 1 force
        particle minecraft:dust{color:[1,0.5,0.5],scale:1} ^ ^ ^2.5 0 0 0 0 1 force
    }

    function q.stack {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] if entity @p[tag=yone,team=<%team%>,tag=full_q] run tp @s ~ ~ ~ ~20 0
            execute if entity @s[tag=<%team%>] if entity @p[tag=yone,team=<%team%>,tag=full_q] positioned as @p[tag=yone,team=<%team%>] rotated as @s run particle minecraft:instant_effect ^ ^1.3 ^0.75 0 0 0 0 2 force
            execute if entity @s[tag=<%team%>] if entity @p[tag=yone,team=<%team%>,tag=full_q] positioned as @p[tag=yone,team=<%team%>] rotated as @s run particle minecraft:instant_effect ^ ^0.7 ^-0.75 0 0 0 0 2 force
            execute if entity @s[tag=<%team%>,nbt={Age:120}] run scoreboard players set @p[tag=yone,team=<%team%>] stack_q 0
            execute if entity @s[tag=<%team%>,nbt={Age:120}] run tag @p[tag=yone,team=<%team%>] remove full_q
        }
    }

    function q.stack_cd {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] if entity @e[tag=yone.q.stackcd,type=minecraft:area_effect_cloud,tag=<%team%>] run data modify entity @e[tag=yone.q.stackcd,tag=<%team%>,type=minecraft:area_effect_cloud,limit=1] Age set value 0
            execute if entity @s[team=<%team%>] unless entity @e[tag=yone.q.stackcd,type=minecraft:area_effect_cloud,tag=<%team%>] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:121,Tags:["yone.q.stackcd","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        }
    }

    function q.tornado.clear {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] run tag @p[tag=yone,team=<%team%>,tag=q.dash] remove q.dash
            execute if entity @s[tag=<%team%>] run tag @e[tag=yone.tornado.hit,team=!<%team%>,type=!#unvalid] remove yone.tornado.hit
        }

        kill @s
    }

    function q.tornado.knockup {
        function lc:champion/cc/cancel
        scoreboard players set @s cc.airborne 15

        function lc:core/motion/push {x:0,y:424,z:0,ticks:0}
    }

    function q.tornado.passive {
        tp @s ^ ^ ^1
        particle minecraft:sweep_attack ~ ~1 ~ 0.8 0 0.8 1 5 force

        execute as @s[tag=red] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!red,dx=2,dz=2,dy=5,type=!#unvalid,tag=!unvalid] add yone.q.hit

        execute if entity @s[tag=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!red,tag=!yone.tornado.hit] add temp_dmg
        execute if entity @s[tag=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] as @e[tag=yone.q.hit,type=!#unvalid,team=!red,tag=!yone.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function lc:champions/yone/skills/q.tornado.knockup
        execute if entity @s[tag=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] on passengers on origin run function lc:champions/yone/skills/q.damage

        execute if entity @s[tag=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!red] add yone.tornado.hit
        execute if entity @s[tag=red] if entity @e[tag=yone.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!red] remove yone.q.hit

        execute as @s[tag=blue] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!blue,dx=2,dz=2,dy=5,type=!#unvalid,tag=!unvalid] add yone.q.hit

        execute if entity @s[tag=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!blue,tag=!yone.tornado.hit] add temp_dmg
        execute if entity @s[tag=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] as @e[tag=yone.q.hit,type=!#unvalid,team=!blue,tag=!yone.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function lc:champions/yone/skills/q.tornado.knockup
        execute if entity @s[tag=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] on passengers on origin run function lc:champions/yone/skills/q.damage

        execute if entity @s[tag=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!blue] add yone.tornado.hit
        execute if entity @s[tag=blue] if entity @e[tag=yone.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yone.q.hit,type=!#unvalid,team=!blue] remove yone.q.hit
    }

    function q.tornado.spawn {
        playsound yone.sfx.q2 master @a ~ ~ ~

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run summon minecraft:item_display ~ ~ ~ {teleport_duration:1,interpolation_duration:10,Tags:["yone.q.tornado","temp","<%team%>","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:15,Tags:["cd","<%team%>","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
            execute if entity @s[team=<%team%>] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["yone.q","temp","<%team%>","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:8,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        }

        tp @e[tag=yone.q,tag=temp,limit=1,sort=nearest] ~ ~0.5 ~ ~ 0
        execute as @e[tag=yone.q,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
        execute at @e[tag=yone.q,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        tag @e[tag=yone.q,tag=temp,limit=1,sort=nearest] remove temp

        tp @e[tag=yone.q.tornado,tag=temp,limit=1,sort=nearest] ~ ~ ~ ~ 0
        execute at @e[tag=yone.q.tornado,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        tag @e[tag=yone.q.tornado,tag=temp,limit=1,sort=nearest] remove temp

        tag @s remove full_q
        execute if entity @s[team=red] run kill @e[tag=yone.q.stackcd,type=area_effect_cloud,tag=red]
        execute if entity @s[team=blue] run kill @e[tag=yone.q.stackcd,type=area_effect_cloud,tag=blue]
    }

    function r.animation {
        ## RED
        execute if entity @s[tag=red] positioned as @p[tag=yone,team=red] run playsound minecraft:yone.ultimate master @a ~ ~ ~
        execute if entity @s[tag=red] as @e[tag=yone.r.mark,type=minecraft:area_effect_cloud,tag=red] at @s positioned ~-1.5 ~ ~-1.5 run tag @e[type=!#unvalid,tag=!unvalid,dx=2,dz=2,dy=10,team=!red,tag=!yone.r.hit] add yone.r.hit
        execute if entity @s[tag=red] unless entity @e[tag=yone.r.hit,team=!red] positioned as @e[tag=yone.r.mark,limit=1,type=area_effect_cloud,tag=red,sort=furthest] rotated as @p[tag=yone,team=red] run tp @p[tag=yone,team=red] ~ ~0.2 ~
        execute if entity @s[tag=red] if entity @e[tag=yone.r.hit,team=!red] positioned as @e[tag=yone.r.hit,team=!red,sort=furthest,limit=1] positioned as @e[tag=yone.r.mark,limit=1,sort=nearest] rotated as @p[tag=yone,team=red] run tp @p[tag=yone,team=red] ^ ^0.2 ^4
        execute if entity @s[tag=red] if entity @e[tag=yone.r.hit,team=!red] positioned as @e[tag=yone.r.hit,team=!red,sort=furthest,limit=1] positioned as @e[tag=yone.r.mark,limit=1,sort=nearest] rotated as @p[tag=yone,team=red] run tp @e[tag=yone.r.hit,team=!red] ^ ^0.2 ^3
