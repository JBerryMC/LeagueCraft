# lc:champions/annie/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking annie; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.annie
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.annie
    tag @s add useMana
    scoreboard players operation @s mana = @s mana.max
    playsound minecraft:annie.select master @a ~ ~ ~
    playsound minecraft:annie.sfx.select master @a ~ ~ ~
    scoreboard players set @s annie.passive 4
}

function aa {
    playsound annie.sfx.aa master @a ~ ~ ~

    execute if entity @s[team=red] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.annie","aa","homing","red","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.annie","aa","homing","blue","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:annie"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:annie/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:annie/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:annie/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:annie/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:annie/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"annie.passive"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## p
    execute if score @s annie.passive matches 4 run scoreboard players set @s status.p 1
    execute unless score @s annie.passive matches 4 run scoreboard players set @s status.p 0

    ## R
    execute if entity @s[team=red] if entity @e[tag=annie.r,team=red] run scoreboard players set @s status.r 2
    execute if entity @s[team=blue] if entity @e[tag=annie.r,team=blue] run scoreboard players set @s status.r 2

    function lc:champions/annie/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=annie.r,type=#can_aggro] at @s run function lc:champions/annie/skills/r.animation

    execute as @e[tag=annie.r.skill,type=item_display] at @s run function lc:champions/annie/skills/r.skill.dash
}

function main {
    ## HUD
    function lc:champions/annie/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/annie/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/annie/item/offhand

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r

    execute if score @s annie.passive matches 4 run particle small_flame ~ ~0.5 ~ 0.2 0 0.2 0.01 10 force @a

    execute if score @s[team=red] annie.r.duration matches 0 as @e[tag=annie.r,team=red] at @s run function lc:champions/annie/skills/r.end
    execute if score @s[team=blue] annie.r.duration matches 0 as @e[tag=annie.r,team=blue] at @s run function lc:champions/annie/skills/r.end
}

function passive {
    scoreboard players set @s annie.passive 0
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=annie.q.target] add annie.p.target
        execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=annie.w.hit] add annie.p.target
        execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=annie.r.dmg] add annie.p.target
        execute if entity @s[team=<%team%>] run scoreboard players add @e[tag=annie.r,team=<%team%>,type=#can_aggro] annie.r.duration 3
        execute if entity @s[team=<%team%>] if entity @e[tag=annie.p.target,team=!<%team%>] run tag @e[tag=annie.r.target,team=!<%team%>,tag=!<%team%>.annie.r.move] remove annie.r.target
        execute if entity @s[team=<%team%>] if entity @e[tag=annie.p.target,team=!<%team%>] run tag @e[tag=annie.p.target,team=!<%team%>,limit=1,sort=nearest] add annie.r.target
        execute if entity @s[team=<%team%>] run scoreboard players set @e[tag=annie.p.target,team=!<%team%>] cc.stun 35
        execute if entity @s[team=<%team%>] run tag @e[tag=annie.p.target,team=!<%team%>] remove annie.p.target
    }
}

function use_e {
    function lc:champion/abilities/cooldown/e

    execute if score @s annie.passive matches ..3 run scoreboard players add @s annie.passive 1

    function lc:champions/annie/skills/e.shield

    ## RED
    execute if entity @s[team=red] run tag @e[tag=temp_target,team=red,type=!#unvalid] add annie.e.target
    execute if entity @s[team=red] as @e[tag=annie.r,team=red,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield
    execute if entity @s[team=red] as @e[tag=annie.e.target,team=red,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield

    ## BLUE
    execute if entity @s[team=blue] run tag @e[tag=temp_target,team=blue,type=!#unvalid] add annie.e.target
    execute if entity @s[team=blue] as @e[tag=annie.r,team=blue,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield
    execute if entity @s[team=blue] as @e[tag=annie.e.target,team=blue,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield
}

function use_e.check {
    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target,tag=!annie] add temp_target

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=temp_target,tag=!annie] at @s run function lc:champions/annie/use_e

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest,tag=!annie] remove temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target,tag=!annie] add temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=temp_target,tag=!annie] at @s run function lc:champions/annie/use_e

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest,tag=!annie] remove temp_target

    execute if entity @s[distance=..8] if score @s cd_e matches 0 positioned ^ ^ ^0.1 run function lc:champions/annie/use_e.check
    execute if entity @s[team=red] if score @s cd_e matches 0 unless entity @e[team=red,tag=annie.e.target] at @s run function lc:champions/annie/use_e
    execute if entity @s[team=blue] if score @s cd_e matches 0 unless entity @e[team=blue,tag=annie.e.target] at @s run function lc:champions/annie/use_e
}

function use_q {
    function lc:champion/abilities/cooldown/q
    playsound minecraft:annie.sfx.q master @a ~ ~ ~
    scoreboard players set @s channeling 5

    execute if entity @s[team=red] run tag @e[tag=annie.q.temp_target,team=!red] add annie.q.target
    execute if entity @s[team=blue] run tag @e[tag=annie.q.temp_target,team=!blue] add annie.q.target

    execute if entity @s[team=red] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["annie.q","homing","red","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["annie.q","homing","blue","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute at @s run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

    execute if entity @s[team=red] as @e[tag=annie.q,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
    execute if entity @s[team=blue] as @e[tag=annie.q,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] as @e[tag=annie.q,tag=temp,tag=<%team%>,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[team=!<%team%>,tag=annie.q.target,limit=1,sort=nearest] UUID
        execute if entity @s[team=<%team%>] run tag @e[tag=annie.q,tag=temp,tag=<%team%>,limit=1,sort=nearest] remove temp
    }
}

function use_q.check {
    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.q.temp_target] add annie.q.temp_target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target] at @s run function lc:champions/annie/use_q

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target,limit=1,sort=nearest] remove annie.q.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.q.temp_target] add annie.q.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target] at @s run function lc:champions/annie/use_q

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target,limit=1,sort=nearest] remove annie.q.temp_target

    execute if entity @s[distance=..6] if score @s cd_q matches 0 positioned ^ ^ ^0.1 run function lc:champions/annie/use_q.check
}

function use_r {
    playsound minecraft:annie.ultimate master @s ~ ~ ~

    scoreboard players set @s cd_r 45
    scoreboard players set @s annie.r.duration 45
    execute if score @s annie.passive matches ..4 run scoreboard players add @s annie.passive 1

    item modify entity @s weapon.offhand lc:champion/set_model_invis

    scoreboard players add @s channeling 5

    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:2,Tags:["annie.r.position"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] run data modify entity @e[tag=annie.r.position,type=area_effect_cloud,limit=1,sort=nearest] Owner set from entity @s UUID
    execute positioned as @e[type=marker,tag=lc.ground_target,limit=1] as @e[tag=annie.r.position,type=area_effect_cloud,limit=1,sort=nearest] at @s run function lc:champions/annie/skills/r.position

    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Tags:["annie.r.dot","red"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Tags:["annie.r.dot","blue"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_r.check {
    execute if entity @s[team=red] run tag @e[tag=annie.r.target,team=!red] remove annie.r.target
    execute if entity @s[team=blue] run tag @e[tag=annie.r.target,team=!blue] remove annie.r.target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.r.temp_target] add annie.r.temp_target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target] at @s run function lc:champions/annie/use_r2

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target,limit=1,sort=nearest] remove annie.r.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.r.temp_target] add annie.r.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target] at @s run function lc:champions/annie/use_r2

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target,limit=1,sort=nearest] remove annie.r.temp_target

    execute if entity @s[distance=10..,team=red] unless entity @e[team=!red,tag=annie.r.target] positioned ~ ~ ~ run function lc:champions/annie/use_r2
    execute if entity @s[distance=10..,team=blue] unless entity @e[team=!blue,tag=annie.r.target] positioned ~ ~ ~ run function lc:champions/annie/use_r2

    execute if entity @s[distance=..10,team=red] unless entity @e[team=!red,tag=annie.r.target] positioned ^ ^ ^0.1 run function lc:champions/annie/use_r.check
    execute if entity @s[distance=..10,team=blue] unless entity @e[team=!blue,tag=annie.r.target] positioned ^ ^ ^0.1 run function lc:champions/annie/use_r.check
}

function use_r2 {
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run tag @e[tag=annie.r.target,team=!<%team%>] remove annie.r.target
        execute if entity @s[team=<%team%>] run kill @e[tag=<%team%>.annie.r.move,type=silverfish]
        execute if entity @s[team=<%team%>] unless entity @e[tag=annie.r.temp_target,team=!<%team%>] run summon silverfish ~ ~ ~ {active_effects:[{id:"invisibility",duration:-1,amplifier:127,show_particles:0b},{id:"resistance",duration:-1,amplifier:127,show_particles:0b}],Silent:1,Tags:["unvalid","annie.r.target","<%team%>.annie.r.move","no_convert"],NoAI:1}
        execute if entity @s[team=<%team%>] run data remove entity @e[tag=annie.r,team=<%team%>,type=#can_aggro,limit=1] angry_at
        execute if entity @s[team=<%team%>] run tag @e[tag=annie.r.temp_target,team=!<%team%>,limit=1,sort=nearest] add annie.r.target
    }
}

function use_w {
    function lc:champion/abilities/cooldown/w

    playsound minecraft:annie.sfx.w master @a ~ ~ ~
    scoreboard players set @s channeling 5
    execute if score @s annie.passive matches ..4 run scoreboard players add @s annie.passive 1

    execute anchored eyes positioned ^ ^-0.75 ^ rotated ~90 0 run function lc:champions/annie/skills/w.particle

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] positioned ^ ^ ^0.5 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!<%team%>,type=!#unvalid,tag=!unvalid] add annie.w.hit
        execute if entity @s[team=<%team%>] positioned ^1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!<%team%>,type=!#unvalid,tag=!unvalid] add annie.w.hit
        execute if entity @s[team=<%team%>] positioned ^-1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!<%team%>,type=!#unvalid,tag=!unvalid] add annie.w.hit
    }

    execute if score @s annie.passive matches 5 run function lc:champions/annie/passive
    execute if entity @s[team=red] if entity @e[tag=annie.w.hit,team=!red] as @p[tag=annie,team=red] run function lc:champions/annie/skills/w.damage
    execute if entity @s[team=blue] if entity @e[tag=annie.w.hit,team=!blue] as @p[tag=annie,team=blue] run function lc:champions/annie/skills/w.damage
}

# ---- item: lc:champions/annie/item/... -----------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]
        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[1500001f]},minecraft:custom_name={text:"Annie",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[900001f]},minecraft:custom_name={text:"Sừng Aatrox",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] unless entity @e[tag=annie.r,type=#can_aggro,team=<%team%>] run item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[1500401f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
            execute if entity @s[team=<%team%>] if entity @e[tag=annie.r,type=#can_aggro,team=<%team%>] run item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
        }
    }
}

# ---- skills: lc:champions/annie/skills/... -------------------------------------------
dir skills {
    function e.damage {
        execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=annie.e.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s
        execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=annie.e.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s

        scoreboard players operation temp ability_power = @s ability_power
        scoreboard players operation temp ability_power *= 40 integer
        scoreboard players operation temp ability_power /= 100 integer
        scoreboard players add temp ability_power 65

        scoreboard players operation @s dmg_magic.deal = temp ability_power
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] remove annie.e.target

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.e.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=annie.e.target,limit=1,sort=nearest] remove annie.e.target
    }

    function e.shield {
        effect give @s speed 3 2 false
        execute if entity @s[tag=has_display_bar] run tag @s add update.shield.annie
        playsound annie.sfx.e master @a ~ ~ ~

        execute if entity @s[type=!player] on passengers as @s[tag=annie.e.shield] on passengers run kill @s
        execute if entity @s[type=!player] on passengers as @s[tag=annie.e.shield] run kill @s
        execute if entity @s[type=!player] run summon item_display ~ ~ ~ {interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}},Tags:["annie.e.shield","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[-22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[45.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[1500301f]}}}},{id:"area_effect_cloud",WaitTime:0,Duration:50,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[type=!player] run ride @e[type=item_display,tag=temp,tag=annie.e.shield,limit=1,sort=nearest] mount @s
        execute if entity @s[type=!player] on passengers run data merge entity @s[tag=annie.e.shield] {transformation:{translation:[0.0,-0.6,0.0]}}
        execute if entity @s[type=!player] on passengers as @s[tag=annie.e.shield] on passengers run data merge entity @s {transformation:{translation:[0.0,-0.6,0.0]}}

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation temp shield.all = @p[tag=annie,team=<%team%>] ability_power
            execute if entity @s[team=<%team%>] run scoreboard players operation temp shield.all *= 40 integer
            execute if entity @s[team=<%team%>] run scoreboard players operation temp shield.all /= 100 integer
        }

        scoreboard players add temp shield.all 200

        summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:999999,Tags:["annie.e","shield.all","new"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Tags:["cd"],Duration:50,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID
        scoreboard players operation @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all = temp shield.all
        scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all
        tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new
    }

    function passive.end {
        tag @s remove malphite.passive
        scoreboard players operation @s armor -= @s malphite.bonus_armor
        scoreboard players set @s cd_p 8
    }

    function q.damage {
        execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=annie.q.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s
        execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=annie.q.target,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s

        scoreboard players operation temp ability_power = @s ability_power
        scoreboard players operation temp ability_power *= 75 integer
        scoreboard players operation temp ability_power /= 100 integer
        scoreboard players add temp ability_power 210

        scoreboard players operation @s dmg_magic.deal = temp ability_power
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] remove annie.q.target

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=annie.q.target,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=annie.q.target,limit=1,sort=nearest] remove annie.q.target
    }

    function q.hit {
        playsound annie.sfx.q.hit master @a ~ ~ ~

        execute if score @s annie.passive matches ..4 run scoreboard players add @s annie.passive 1
        execute if score @s annie.passive matches 5 run function lc:champions/annie/passive
        execute if entity @s[team=red] if entity @e[tag=annie.q.target,team=!red] run function lc:champions/annie/skills/q.damage
        execute if entity @s[team=blue] if entity @e[tag=annie.q.target,team=!blue] run function lc:champions/annie/skills/q.damage
    }

    function r.aa {
        execute store success score @s temp if predicate lc:core/roll/50
        playsound annie.sfx.r.aa master @a ~ ~ ~
        execute if score @s[tag=!is_rage] temp matches 1 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/aa/tween_play
        execute if score @s[tag=is_rage] temp matches 1 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/rage.aa/tween_play
        execute if score @s[tag=!is_rage] temp matches 0 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/aa2/tween_play
        execute if score @s[tag=is_rage] temp matches 0 on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/rage.aa2/tween_play
    }

    function r.animation {
        particle flame ~ ~ ~ 0.5 0.2 0.5 0.01 10 force
        particle smoke ~ ~ ~ 0.5 0.2 0.5 0.01 10 force

        execute on passengers as @s[tag=owner] on origin run scoreboard players operation @s cd_r = @s annie.r.duration

        ## Movement
        execute store result score @s[tag=!is_dashing] mot_x run data get entity @s Motion[0] 1000
        execute store result score @s[tag=!is_dashing] mot_z run data get entity @s Motion[2] 1000
        execute if entity @s[scores={mot_x=0,mot_z=0},tag=is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/pause_all
        execute if entity @s[scores={mot_x=0,mot_z=0},tag=is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/idle/tween_play
        execute if entity @s[scores={mot_x=0,mot_z=0},tag=is_moving] run tag @s remove is_moving

        execute unless entity @s[scores={mot_x=0,mot_z=0}] if entity @s[tag=!is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/pause_all
        execute unless entity @s[scores={mot_x=0,mot_z=0}] if entity @s[tag=!is_moving] on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/walk/tween_play
        execute unless entity @s[scores={mot_x=0,mot_z=0}] if entity @s[tag=!is_moving] run tag @s add is_moving

        ## Revenge
        execute if entity @s[tag=decay] run scoreboard players remove @s hp.left 25

        ## TARGET
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] positioned ~-1 ~-1 ~-1 run kill @e[tag=<%team%>.annie.r.move,dx=1,dz=1,dy=20]
            execute if entity @s[team=<%team%>] if entity @e[tag=annie.r.target,team=!<%team%>] run data modify entity @s angry_at set from entity @e[tag=annie.r.target,team=!<%team%>,limit=1,sort=nearest] UUID
            execute if entity @s[team=<%team%>] if entity @e[tag=annie.r.target,team=!<%team%>,distance=10..,tag=!<%team%>.annie.r.move,tag=champion] if score @s annie.r.skill matches 0 run function lc:champions/annie/skills/r.skill
        }

        ## Return to owner
        execute if entity @s[team=red] if entity @p[tag=annie,team=red,distance=30..,tag=!dead] run function lc:champions/annie/skills/r.blink
        execute if entity @s[team=blue] if entity @p[tag=annie,team=blue,distance=30..,tag=!dead] run function lc:champions/annie/skills/r.blink

        ## DoT
        execute if entity @s[team=red] unless entity @e[tag=annie.r.dot,tag=red] run function lc:champions/annie/skills/r.dot
        execute if entity @s[team=blue] unless entity @e[tag=annie.r.dot,tag=blue] run function lc:champions/annie/skills/r.dot

        ## Rage
        execute if score @s[tag=!is_rage] annie.r.duration matches 1.. run function lc:champions/annie/skills/r.rage
        effect give @s[tag=is_rage] speed 1 6 false
        execute if score @s[tag=is_rage] annie.r.duration matches 0 run function lc:champions/annie/skills/r.rage.end
    }

    function r.blink {
        data remove entity @s angry_at

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run tag @e[tag=annie.r.target,team=!<%team%>] remove annie.r.target
            execute if entity @s[team=<%team%>] run tp @s @p[tag=annie,team=<%team%>,tag=!dead]
        }
    }

    function r.damage.1 {
        execute if entity @s[team=red] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s
        execute if entity @s[team=blue] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s

        scoreboard players operation temp ability_power = @s ability_power
        scoreboard players operation temp ability_power *= 75 integer
        scoreboard players operation temp ability_power /= 100 integer

        scoreboard players add temp ability_power 400
        scoreboard players operation @s dmg_magic.deal = temp ability_power

        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

        execute if entity @s[team=red] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red] run function lc:champions/annie/skills/r.damage.1

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

        execute if entity @s[team=blue] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue] run function lc:champions/annie/skills/r.damage.1
    }

    function r.damage.2 {
        execute if entity @s[team=red] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s
        execute if entity @s[team=blue] run damage @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 1 lc:core/dmg_magic by @s

        scoreboard players operation temp ability_power = @s ability_power
        scoreboard players operation temp ability_power *= 3 integer
        scoreboard players operation temp ability_power /= 100 integer

        scoreboard players add temp ability_power 10
        scoreboard players operation @s dmg_magic.deal = temp ability_power

        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

        execute if entity @s[team=red] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!red] run function lc:champions/annie/skills/r.damage.2

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.r.hit,tag=has_health_bar,tag=annie.r.dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.hit,type=!#unvalid,tag=annie.r.dmg,limit=1,sort=nearest] remove annie.r.dmg

        execute if entity @s[team=blue] run execute if entity @e[tag=annie.r.hit,tag=annie.r.dmg,type=!#unvalid,team=!blue] run function lc:champions/annie/skills/r.damage.2
    }

    function r.dash {
        execute if entity @s[tag=red] on passengers on vehicle facing entity @e[tag=malphite.r,tag=red,limit=1,sort=nearest] feet run tp @s ^ ^ ^1.5 ~ ~
        execute if entity @s[tag=red] if score @p[team=red,tag=malphite] channeling matches -1 run ride @p[team=red,tag=malphite] mount @s

        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=red] remove r.dash
        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] on passengers run kill @s[tag=cd]
        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=red] remove r.animation
        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=red,dx=1,dz=1,dy=1] as @e[tag=malphite.r,tag=red,type=item_display] at @s run function lc:champions/malphite/skills/r.spawn

        execute if entity @s[tag=blue] on passengers on vehicle facing entity @e[tag=malphite.r,tag=blue,limit=1,sort=nearest] feet run tp @s ^ ^ ^1.5 ~ ~
        execute if entity @s[tag=blue] if score @p[team=blue,tag=malphite] channeling matches -1 run ride @p[team=blue,tag=malphite] mount @s

        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=blue] remove r.dash
        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] on passengers run kill @s[tag=cd]
        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] run tag @p[tag=malphite,team=blue] remove r.animation
        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=malphite.r,tag=blue,dx=1,dz=1,dy=1] as @e[tag=malphite.r,tag=blue,type=item_display] at @s run function lc:champions/malphite/skills/r.spawn
    }

    function r.dot {
        particle small_flame ~ ~ ~ 1 0 1 0.01 50 force

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] at @s run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Tags:["annie.r.dot","<%team%>"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
            execute if entity @s[team=<%team%>] positioned ~-2 ~-0.5 ~-2 run tag @e[team=!<%team%>,type=!#unvalid,tag=!unvalid,dx=3,dz=3,dy=0] add annie.r.hit
            execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=annie.r.hit] add annie.r.dmg
            execute if entity @s[team=<%team%>] if entity @e[tag=annie.r.hit,team=!<%team%>] run function lc:champions/annie/skills/r.damage.2
            execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=annie.r.hit] remove annie.r.hit
        }
    }

    function r.end {
        tag @s add is_dead
        scoreboard players set @s hp.left 0

        playsound annie.sfx.r.end master @a ~ ~ ~
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run tag @e[tag=annie,team=<%team%>] add offhand_temp
            execute if entity @s[team=<%team%>] run item replace entity @e[tag=annie,team=<%team%>] weapon.offhand with air
        }

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run tag @e[tag=annie.r.target,team=!<%team%>] remove annie.r.target
            execute if entity @s[team=<%team%>] run kill @e[tag=<%team%>.annie.r.move,type=silverfish]
        }

        execute on passengers as @s[tag=owner] on origin run function lc:champion/abilities/cooldown/r
        execute on passengers as @s[tag=aj.annie.root] at @s run function animated_java:annie/animations/death/play

        function lc:champion/hp/percentage
    }

    function r.knockup {
        function lc:champion/cc/cancel
        scoreboard players set @s cc.airborne 15
        function lc:core/motion/push {x:0,y:424,z:0,ticks:0}
    }

    function r.position {
        execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin run function lc:champions/annie/skills/r.spawn

        execute if block ~ ~ ~ #like_air if block ~ ~-1 ~ #like_air positioned ~ ~-1 ~ run function lc:champions/annie/skills/r.position

        execute unless block ~ ~ ~ #like_air positioned ~ ~1 ~ run function lc:champions/annie/skills/r.position
    }

    function r.rage {
        tag @s add is_rage
        scoreboard players add @s aa.spd 20
    }

    function r.rage.end {
        tag @s remove is_rage
        scoreboard players set @s aa.spd 10
        effect clear @s speed
    }

    function r.revenge {
        tag @s add decay
        scoreboard players add @s annie.r.duration 10

        scoreboard players operation temp hp.left = @s hp.left
        scoreboard players operation temp hp.max = @s hp.max

        scoreboard players operation temp hp.max -= temp hp.left
        scoreboard players operation temp hp.max /= 2 integer

        scoreboard players operation @s hp.left += temp hp.max
        execute if score @s hp.left > @s hp.max run scoreboard players operation @s hp.left = @s hp.max

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run kill @e[tag=annie.r.target,tag=<%team%>.annie.r.move,team=!<%team%>]
            execute if entity @s[team=<%team%>] run tag @e[tag=annie.r.target,team=!<%team%>] remove annie.r.target
            execute if entity @s[team=<%team%>] run tag @e[type=!#unvalid,tag=!unvalid,team=!<%team%>,limit=1,sort=nearest] add annie.r.target
        }
    }

    function r.skill {
        playsound annie.sfx.r master @a ~ ~ ~ 2 1
        tag @s add is_dashing
        scoreboard players set @s annie.r.skill 12
        execute on passengers as @s[tag=aj.annie.root] run function animated_java:annie/animations/skill/play

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] as @e[tag=annie.r.target,tag=!<%team%>.annie.r.move,team=!<%team%>,sort=furthest,limit=1] at @s anchored feet run summon area_effect_cloud ^ ^0.5 ^ {WaitTime:0,Duration:40,Tags:["<%team%>","annie.r.skill.stop"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
            execute if entity @s[team=<%team%>] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["annie.r.skill","temp","<%team%>","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:40,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        }

        tp @e[tag=annie.r.skill,tag=temp,limit=1,sort=nearest] ~ ~0.5 ~ ~ ~-2
        execute at @e[tag=annie.r.skill,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        tag @e[tag=annie.r.skill,tag=temp,limit=1,sort=nearest] remove temp
    }

    function r.skill.dash {
        execute if entity @s[tag=red] facing entity @e[tag=annie.r.skill.stop,tag=red,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @s ^ ^ ^1 ~ ~
        execute if entity @s[tag=red] facing entity @e[tag=annie.r.skill.stop,tag=red,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @e[type=#can_aggro,limit=1,team=red,tag=annie.r] ~ ~ ~ ~ ~
        execute if entity @s[tag=red] run ride @e[type=#can_aggro,limit=1,team=red,tag=annie.r] mount @s

        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] positioned ~1 ~1 ~1 run particle block{block_state:"magma_block"} ~ ~ ~ 0.5 0 0.5 1 100 force
        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] as @e[team=!red,type=!#unvalid,tag=!unvalid,dx=1,dz=1,dy=1,tag=!dead] at @s run function lc:champions/annie/skills/r.knockup
        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] on passengers run tag @s[tag=annie.r] remove is_dashing
        execute if entity @s[tag=red] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=red,dx=1,dz=1,dy=1] run kill @s

        execute if entity @s[tag=blue] facing entity @e[tag=annie.r.skill.stop,tag=blue,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @s ^ ^ ^1 ~ ~
        execute if entity @s[tag=blue] facing entity @e[tag=annie.r.skill.stop,tag=blue,limit=1,sort=furthest] feet rotated ~ ~-40 run tp @e[type=#can_aggro,limit=1,team=blue,tag=annie.r] ~ ~ ~ ~ ~
        execute if entity @s[tag=blue] run ride @e[type=#can_aggro,limit=1,team=blue,tag=annie.r] mount @s

        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] positioned ~1 ~1 ~1 run particle block{block_state:"magma_block"} ~ ~ ~ 0.5 0 0.5 1 100 force
        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] as @e[team=!blue,type=!#unvalid,tag=!unvalid,dx=1,dz=1,dy=1,tag=!dead] at @s run function lc:champions/annie/skills/r.knockup
        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] on passengers run tag @s[tag=annie.r] remove is_dashing
        execute if entity @s[tag=blue] positioned ~-1 ~-1 ~-1 if entity @e[tag=annie.r.skill.stop,tag=blue,dx=1,dz=1,dy=1] run kill @s
    }

    function r.spawn {
        playsound minecraft:annie.sfx.r master @a ~ ~ ~ 4 1

        particle large_smoke ~ ~ ~ 1 0 1 0.01 100 force
        particle flame ~ ~ ~ 1 0.5 1 0.01 200 force

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] positioned ~-2 ~-0.5 ~-2 run tag @e[team=!<%team%>,type=!#unvalid,tag=!unvalid,dx=3,dz=3,dy=0] add annie.r.hit
            execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=annie.r.hit] add annie.r.dmg
        }

        execute if score @s annie.passive matches 5 run function lc:champions/annie/passive

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] if entity @e[tag=annie.r.hit,team=!<%team%>] run function lc:champions/annie/skills/r.damage.1
            execute if entity @s[team=<%team%>] run tag @e[tag=annie.r.hit,team=!<%team%>,limit=1,sort=nearest] add annie.r.target
            execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=annie.r.hit] remove annie.r.hit
        }

        function lc:champions/annie/skills/r.summon
    }

    function r.summon {
        execute if entity @s[team=red] run summon zombified_piglin ~ ~ ~ {CustomName:"Tibbers",PersistenceRequired:1,Team:"red",Tags:["use_custom_model","magic.aa","is_pet","red","has_health_bar","lol.minion","melee","temp","annie.r"],Silent:1,active_effects:[{id:"invisibility",duration:-1,amplifier:0,show_particles:0b}],attributes:[{id:"minecraft:follow_range",base:1048.0d},{id:"minecraft:attack_damage",base:0.0d},{id:"minecraft:max_health",base:1000.0d},{id:"minecraft:knockback_resistance",base:1.0d}],Health:1000.0f,Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:9999,Tags:["owner"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"text_display",Tags:["hp","stats_bar"],background:0,billboard:"vertical"},{id:"text_display",Tags:["shield_all","stats_bar"],background:0,billboard:"vertical"}]}
        execute if entity @s[team=blue] run summon zombified_piglin ~ ~ ~ {CustomName:"Tibbers",PersistenceRequiblue:1,Team:"blue",Tags:["use_custom_model","magic.aa","is_pet","blue","has_health_bar","lol.minion","melee","temp","annie.r"],Silent:1,active_effects:[{id:"invisibility",duration:-1,amplifier:0,show_particles:0b}],attributes:[{id:"minecraft:follow_range",base:1048.0d},{id:"minecraft:attack_damage",base:0.0d},{id:"minecraft:max_health",base:1000.0d},{id:"minecraft:knockback_resistance",base:1.0d}],Health:1000.0f,Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:9999,Tags:["owner"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"text_display",Tags:["hp","stats_bar"],background:0,billboard:"vertical"},{id:"text_display",Tags:["shield_all","stats_bar"],background:0,billboard:"vertical"}]}

        execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=hp] {transformation:{scale:[0.325,0.375,0.325],translation:[0.0,-0.55,0.0]}}
        execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] on passengers run data merge entity @s[tag=shield_all] {transformation:{scale:[0.325,0.375,0.325],translation:[0.0,-0.55,0.0001]}}

        execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] if entity @s[team=red] on passengers run data modify entity @s[tag=owner] Owner set from entity @p[tag=annie,team=red] UUID
        execute as @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] if entity @s[team=blue] on passengers run data modify entity @s[tag=owner] Owner set from entity @p[tag=annie,team=blue] UUID

        execute rotated ~ 0 run function animated_java:annie/summon

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run ride @e[type=#animated_java:root,tag=aj.annie.root,limit=1,sort=nearest] mount @e[tag=annie.r,team=<%team%>,limit=1,sort=nearest]
            execute if entity @s[team=<%team%>] as @e[tag=annie.r,team=<%team%>,limit=1,sort=nearest] on passengers run team join <%team%> @s[type=#animated_java:root,tag=aj.annie.root]
            execute if entity @s[team=<%team%>] as @e[tag=annie.r,team=<%team%>,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] on passengers run team join <%team%> @s
            execute if entity @s[team=<%team%>] as @e[tag=annie.r,team=<%team%>,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] run function animated_java:annie/animations/spawn/play
            execute if entity @s[team=<%team%>] as @e[tag=annie.r,team=<%team%>,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] on passengers run data modify entity @s teleport_duration set value 1
            execute if entity @s[team=<%team%>] as @e[tag=annie.r,team=<%team%>,limit=1,sort=nearest] on passengers as @s[type=#animated_java:root,tag=aj.annie.root] run data modify entity @s teleport_duration set value 1
        }

        scoreboard players operation annie.r.stats hp.max = @s ability_power
        scoreboard players operation annie.r.stats hp.max *= 50 integer
        scoreboard players operation annie.r.stats hp.max /= 100 integer
        scoreboard players add annie.r.stats hp.max 3500

        scoreboard players operation annie.r.stats ability_power = @s ability_power
        scoreboard players operation annie.r.stats ability_power *= 15 integer
        scoreboard players operation annie.r.stats ability_power /= 100 integer
        scoreboard players add annie.r.stats ability_power 100

        attribute @e[tag=lol.minion,tag=temp,limit=1,sort=nearest] minecraft:movement_speed base set 0.2

        scoreboard players set @e[tag=lol.minion,tag=temp] channeling -1
        scoreboard players operation @e[tag=lol.minion,tag=temp] ability_power = annie.r.stats ability_power

        scoreboard players set @e[tag=lol.minion,tag=temp] armor 90
        scoreboard players set @e[tag=lol.minion,tag=temp] magic_resist 90

        scoreboard players set @e[tag=lol.minion,tag=temp] aa.cd 0
        scoreboard players set @e[tag=lol.minion,tag=temp] aa.spd 8
        scoreboard players set @e[tag=lol.minion,tag=temp] aa.range 30

        scoreboard players set @e[tag=lol.minion,tag=temp] annie.r.skill 0
        scoreboard players set @e[tag=lol.minion,tag=temp] annie.r.duration 3

        scoreboard players set @e[tag=lol.minion,tag=temp] hp.regen 5
        scoreboard players operation @e[tag=lol.minion,tag=temp] hp.max = annie.r.stats hp.max
        scoreboard players operation @e[tag=lol.minion,tag=temp] hp.left = @e[tag=lol.minion,tag=temp] hp.max

        tag @e[tag=lol.minion,tag=temp] remove temp
    }

    function w.damage {
        execute if entity @s[team=red] run damage @e[tag=annie.w.hit,type=!#unvalid,team=!red,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s
        execute if entity @s[team=blue] run damage @e[tag=annie.w.hit,type=!#unvalid,team=!blue,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s

        scoreboard players operation annie.w.temp_dmg attack_damage = @s ability_power
        scoreboard players operation annie.w.temp_dmg attack_damage *= 85 integer
        scoreboard players operation annie.w.temp_dmg attack_damage /= 100 integer

        scoreboard players add annie.w.temp_dmg attack_damage 250

        scoreboard players operation @s dmg_magic.deal = annie.w.temp_dmg attack_damage
        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=annie.w.hit,type=!#unvalid,limit=1,sort=nearest] remove annie.w.hit

        execute if entity @s[team=red] run execute if entity @e[tag=annie.w.hit,type=!#unvalid,team=!red] run function lc:champions/annie/skills/w.damage

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=annie.w.hit,tag=has_health_bar,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.w.hit,type=!#unvalid,limit=1,sort=nearest] remove annie.w.hit

        execute if entity @s[team=blue] run execute if entity @e[tag=annie.w.hit,type=!#unvalid,team=!blue] run function lc:champions/annie/skills/w.damage
    }

