# lc:champions/annie/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking annie; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.annie
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.annie
    tag @s add useMana
    scoreboard players operation @s mana = @s mana.max
    playsound minecraft:annie.select master @a ~ ~ ~
    playsound minecraft:annie.sfx.select master @a ~ ~ ~
    scoreboard players set @s annie.passive 4
}

function aa {
    playsound annie.sfx.aa master @a ~ ~ ~

    execute if entity @s[team=red] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.annie","aa","homing","red","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["aa.annie","aa","homing","blue","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:annie"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:annie/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:annie/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:annie/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:annie/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:annie/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"annie.passive"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## p
    execute if score @s annie.passive matches 4 run scoreboard players set @s status.p 1
    execute unless score @s annie.passive matches 4 run scoreboard players set @s status.p 0

    ## R
    execute if entity @s[team=red] if entity @e[tag=annie.r,team=red] run scoreboard players set @s status.r 2
    execute if entity @s[team=blue] if entity @e[tag=annie.r,team=blue] run scoreboard players set @s status.r 2

    function lc:champions/annie/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=annie.r,type=#can_aggro] at @s run function lc:champions/annie/skills/r.animation

    execute as @e[tag=annie.r.skill,type=item_display] at @s run function lc:champions/annie/skills/r.skill.dash
}

function main {
    ## HUD
    function lc:champions/annie/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/annie/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/annie/item/offhand

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r

    execute if score @s annie.passive matches 4 run particle small_flame ~ ~0.5 ~ 0.2 0 0.2 0.01 10 force @a

    execute if score @s[team=red] annie.r.duration matches 0 as @e[tag=annie.r,team=red] at @s run function lc:champions/annie/skills/r.end
    execute if score @s[team=blue] annie.r.duration matches 0 as @e[tag=annie.r,team=blue] at @s run function lc:champions/annie/skills/r.end
}

function passive {
    scoreboard players set @s annie.passive 0
    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.q.target] add annie.p.target
    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.w.hit] add annie.p.target
    execute if entity @s[team=red] run tag @e[team=!red,tag=annie.r.dmg] add annie.p.target
    execute if entity @s[team=red] run scoreboard players add @e[tag=annie.r,team=red,type=#can_aggro] annie.r.duration 3
    execute if entity @s[team=red] if entity @e[tag=annie.p.target,team=!red] run tag @e[tag=annie.r.target,team=!red,tag=!red.annie.r.move] remove annie.r.target
    execute if entity @s[team=red] if entity @e[tag=annie.p.target,team=!red] run tag @e[tag=annie.p.target,team=!red,limit=1,sort=nearest] add annie.r.target
    execute if entity @s[team=red] run scoreboard players set @e[tag=annie.p.target,team=!red] cc.stun 35
    execute if entity @s[team=red] run tag @e[tag=annie.p.target,team=!red] remove annie.p.target

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.q.target] add annie.p.target
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.w.hit] add annie.p.target
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=annie.r.dmg] add annie.p.target
    execute if entity @s[team=blue] run scoreboard players add @e[tag=annie.r,team=blue,type=#can_aggro] annie.r.duration 3
    execute if entity @s[team=blue] if entity @e[tag=annie.p.target,team=!blue] run tag @e[tag=annie.r.target,team=!blue,tag=!blue.annie.r.move] remove annie.r.target
    execute if entity @s[team=blue] if entity @e[tag=annie.p.target,team=!blue] run tag @e[tag=annie.p.target,team=!blue,limit=1,sort=nearest] add annie.r.target
    execute if entity @s[team=blue] run scoreboard players set @e[tag=annie.p.target,team=!blue] cc.stun 35
    execute if entity @s[team=blue] run tag @e[tag=annie.p.target,team=!blue] remove annie.p.target
}

function use_e {
    function lc:champion/abilities/cooldown/e

    execute if score @s annie.passive matches ..3 run scoreboard players add @s annie.passive 1

    function lc:champions/annie/skills/e.shield

    ## RED
    execute if entity @s[team=red] run tag @e[tag=temp_target,team=red,type=!#unvalid] add annie.e.target
    execute if entity @s[team=red] as @e[tag=annie.r,team=red,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield
    execute if entity @s[team=red] as @e[tag=annie.e.target,team=red,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield

    ## BLUE
    execute if entity @s[team=blue] run tag @e[tag=temp_target,team=blue,type=!#unvalid] add annie.e.target
    execute if entity @s[team=blue] as @e[tag=annie.r,team=blue,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield
    execute if entity @s[team=blue] as @e[tag=annie.e.target,team=blue,type=!#unvalid] at @s run function lc:champions/annie/skills/e.shield
}

function use_e.check {
    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target,tag=!annie] add temp_target

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=temp_target,tag=!annie] at @s run function lc:champions/annie/use_e

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest,tag=!annie] remove temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target,tag=!annie] add temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=temp_target,tag=!annie] at @s run function lc:champions/annie/use_e

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest,tag=!annie] remove temp_target

    execute if entity @s[distance=..8] if score @s cd_e matches 0 positioned ^ ^ ^0.1 run function lc:champions/annie/use_e.check
    execute if entity @s[team=red] if score @s cd_e matches 0 unless entity @e[team=red,tag=annie.e.target] at @s run function lc:champions/annie/use_e
    execute if entity @s[team=blue] if score @s cd_e matches 0 unless entity @e[team=blue,tag=annie.e.target] at @s run function lc:champions/annie/use_e
}

function use_q {
    function lc:champion/abilities/cooldown/q
    playsound minecraft:annie.sfx.q master @a ~ ~ ~
    scoreboard players set @s channeling 5

    execute if entity @s[team=red] run tag @e[tag=annie.q.temp_target,team=!red] add annie.q.target
    execute if entity @s[team=blue] run tag @e[tag=annie.q.temp_target,team=!blue] add annie.q.target

    execute if entity @s[team=red] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["annie.q","homing","red","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] anchored eyes run summon item_display ^ ^ ^ {teleport_duration:1,Tags:["annie.q","homing","blue","temp","block_by_windwall"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute at @s run summon area_effect_cloud ~ ~ ~ {Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

    execute if entity @s[team=red] as @e[tag=annie.q,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
    execute if entity @s[team=blue] as @e[tag=annie.q,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner

    execute if entity @s[team=red] as @e[tag=annie.q,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[team=!red,tag=annie.q.target,limit=1,sort=nearest] UUID
    execute if entity @s[team=red] run tag @e[tag=annie.q,tag=temp,tag=red,limit=1,sort=nearest] remove temp

    execute if entity @s[team=blue] as @e[tag=annie.q,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[team=!blue,tag=annie.q.target,limit=1,sort=nearest] UUID
    execute if entity @s[team=blue] run tag @e[tag=annie.q,tag=temp,tag=blue,limit=1,sort=nearest] remove temp
}

function use_q.check {
    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.q.temp_target] add annie.q.temp_target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target] at @s run function lc:champions/annie/use_q

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target,limit=1,sort=nearest] remove annie.q.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.q.temp_target] add annie.q.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target] at @s run function lc:champions/annie/use_q

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.q.temp_target,limit=1,sort=nearest] remove annie.q.temp_target

    execute if entity @s[distance=..6] if score @s cd_q matches 0 positioned ^ ^ ^0.1 run function lc:champions/annie/use_q.check
}

function use_r {
    playsound minecraft:annie.ultimate master @s ~ ~ ~

    scoreboard players set @s cd_r 45
    scoreboard players set @s annie.r.duration 45
    execute if score @s annie.passive matches ..4 run scoreboard players add @s annie.passive 1

    item modify entity @s weapon.offhand lc:champion/set_model_invis

    scoreboard players add @s channeling 5

    execute anchored eyes positioned ^ ^ ^6 run summon area_effect_cloud ~ ~ ~ {Duration:2,Tags:["annie.r.position"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute anchored eyes positioned ^ ^ ^6 run data modify entity @e[tag=annie.r.position,type=area_effect_cloud,limit=1,sort=nearest] Owner set from entity @s UUID
    execute anchored eyes positioned ^ ^ ^6 as @e[tag=annie.r.position,type=area_effect_cloud,limit=1,sort=nearest] at @s run function lc:champions/annie/skills/r.position

    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Tags:["annie.r.dot","red"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Tags:["annie.r.dot","blue"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_r.check {
    execute if entity @s[team=red] run tag @e[tag=annie.r.target,team=!red] remove annie.r.target
    execute if entity @s[team=blue] run tag @e[tag=annie.r.target,team=!blue] remove annie.r.target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.r.temp_target] add annie.r.temp_target

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target] at @s run function lc:champions/annie/use_r2

    execute if entity @s[team=red] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target,limit=1,sort=nearest] remove annie.r.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!annie.r.temp_target] add annie.r.temp_target

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 if entity @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target] at @s run function lc:champions/annie/use_r2

    execute if entity @s[team=blue] positioned ~-1 ~-1 ~-1 run tag @e[dx=1,dz=1,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=annie.r.temp_target,limit=1,sort=nearest] remove annie.r.temp_target

    execute if entity @s[distance=10..,team=red] unless entity @e[team=!red,tag=annie.r.target] positioned ~ ~ ~ run function lc:champions/annie/use_r2
    execute if entity @s[distance=10..,team=blue] unless entity @e[team=!blue,tag=annie.r.target] positioned ~ ~ ~ run function lc:champions/annie/use_r2

    execute if entity @s[distance=..10,team=red] unless entity @e[team=!red,tag=annie.r.target] positioned ^ ^ ^0.1 run function lc:champions/annie/use_r.check
    execute if entity @s[distance=..10,team=blue] unless entity @e[team=!blue,tag=annie.r.target] positioned ^ ^ ^0.1 run function lc:champions/annie/use_r.check
}

function use_r2 {
    execute if entity @s[team=red] run tag @e[tag=annie.r.target,team=!red] remove annie.r.target
    execute if entity @s[team=red] run kill @e[tag=red.annie.r.move,type=silverfish]
    execute if entity @s[team=red] unless entity @e[tag=annie.r.temp_target,team=!red] run summon silverfish ~ ~ ~ {active_effects:[{id:"invisibility",duration:-1,amplifier:127,show_particles:0b},{id:"resistance",duration:-1,amplifier:127,show_particles:0b}],Silent:1,Tags:["unvalid","annie.r.target","red.annie.r.move","no_convert"],NoAI:1}
    execute if entity @s[team=red] run data remove entity @e[tag=annie.r,team=red,type=#can_aggro,limit=1] angry_at
    execute if entity @s[team=red] run tag @e[tag=annie.r.temp_target,team=!red,limit=1,sort=nearest] add annie.r.target

    execute if entity @s[team=blue] run tag @e[tag=annie.r.target,team=!blue] remove annie.r.target
    execute if entity @s[team=blue] run kill @e[tag=blue.annie.r.move,type=silverfish]
    execute if entity @s[team=blue] unless entity @e[tag=annie.r.temp_target,team=!blue] run summon silverfish ~ ~ ~ {active_effects:[{id:"invisibility",duration:-1,amplifier:127,show_particles:0b},{id:"resistance",duration:-1,amplifier:127,show_particles:0b}],Silent:1,Tags:["unvalid","annie.r.target","blue.annie.r.move","no_convert"],NoAI:1}
    execute if entity @s[team=blue] run data remove entity @e[tag=annie.r,team=blue,type=#can_aggro,limit=1] angry_at
    execute if entity @s[team=blue] run tag @e[tag=annie.r.temp_target,team=!blue,limit=1,sort=nearest] add annie.r.target
}

function use_w {
    function lc:champion/abilities/cooldown/w

    playsound minecraft:annie.sfx.w master @a ~ ~ ~
    scoreboard players set @s channeling 5
    execute if score @s annie.passive matches ..4 run scoreboard players add @s annie.passive 1

    execute anchored eyes positioned ^ ^-0.75 ^ rotated ~90 0 run function lc:champions/annie/skills/w.particle

    execute if entity @s[team=red] positioned ^ ^ ^0.5 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add annie.w.hit
    execute if entity @s[team=red] positioned ^1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add annie.w.hit
    execute if entity @s[team=red] positioned ^-1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add annie.w.hit

    execute if entity @s[team=blue] positioned ^ ^ ^0.5 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add annie.w.hit
    execute if entity @s[team=blue] positioned ^1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add annie.w.hit
    execute if entity @s[team=blue] positioned ^-1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add annie.w.hit

    execute if score @s annie.passive matches 5 run function lc:champions/annie/passive
    execute if entity @s[team=red] if entity @e[tag=annie.w.hit,team=!red] as @p[tag=annie,team=red] run function lc:champions/annie/skills/w.damage
    execute if entity @s[team=blue] if entity @e[tag=annie.w.hit,team=!blue] as @p[tag=annie,team=blue] run function lc:champions/annie/skills/w.damage
}
