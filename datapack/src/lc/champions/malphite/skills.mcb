function r.position {
    execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=red] run summon item_display ~ ~ ~ {Tags:["lol.auto_clear","red","malphite.r"],Passengers:[{id:"area_effect_cloud",Duration:20,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if block ~ ~ ~ #like_air unless block ~ ~-1 ~ #like_air on origin if entity @s[team=blue] run summon item_display ~ ~ ~ {Tags:["lol.auto_clear","blue","malphite.r"],Passengers:[{id:"area_effect_cloud",Duration:20,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if block ~ ~ ~ #like_air if block ~ ~-1 ~ #like_air positioned ~ ~-1 ~ run function lc:champions/malphite/skills/r.position

    execute unless block ~ ~ ~ #like_air positioned ~ ~1 ~ run function lc:champions/malphite/skills/r.position
}

function r.spawn {
    stopsound @a master malphite.sfx.r
    playsound malphite.sfx.r.hit master @a ~ ~ ~

    particle block{block_state:"dirt"} ~ ~ ~ 1 0 1 0.2 200 force
    particle item{item:"dirt"} ~ ~ ~ 0 0 0 0.2 200 force
    execute rotated 0 0 run function lc:champions/malphite/skills/r.particle

    execute as @s[tag=red] run scoreboard players set @p[tag=malphite,team=red] fx.cc_immune 0
    execute as @s[tag=blue] run scoreboard players set @p[tag=malphite,team=blue] fx.cc_immune 0

    execute as @s[tag=red] as @p[tag=malphite,team=red] run tp @s ~ ~ ~
    execute as @s[tag=red] as @p[tag=malphite,team=red] run function lc:core/motion/halt
    execute as @s[tag=blue] as @p[tag=malphite,team=blue] run tp @s ~ ~ ~
    execute as @s[tag=blue] as @p[tag=malphite,team=blue] run function lc:core/motion/halt

    execute as @s[tag=red] at @s positioned ~-2.5 ~-1 ~-2.5 run tag @e[team=!red,dx=4,dz=4,dy=2,type=!#unvalid,tag=!unvalid] add malphite.r.hit
    execute as @s[tag=blue] at @s positioned ~-2.5 ~-1 ~-2.5 run tag @e[team=!blue,dx=4,dz=4,dy=2,type=!#unvalid,tag=!unvalid] add malphite.r.hit

    execute if entity @s[tag=red] if entity @e[tag=malphite.r.hit,team=!red,type=!#unvalid] run tag @e[tag=malphite.r.hit,type=!#unvalid,team=!red,tag=!malphite.r.dmg] add temp_dmg
    execute if entity @s[tag=red] if entity @e[tag=malphite.r.hit,team=!red,type=!#unvalid] run tag @e[tag=malphite.r.hit,type=!#unvalid,team=!red] add malphite.r.dmg
    execute if entity @s[tag=red] if entity @e[tag=malphite.r.hit,team=!red,type=!#unvalid] as @e[tag=malphite.r.hit,type=!#unvalid,team=!red,tag=!unstoppable] at @s run function lc:champions/malphite/skills/r.knockup
    execute if entity @s[tag=red] if entity @e[tag=malphite.r.hit,team=!red,type=!#unvalid] as @p[tag=malphite,team=red] run function lc:champions/malphite/skills/r.damage

    execute if entity @s[tag=red] if entity @e[tag=malphite.r.hit,team=!red,type=!#unvalid] run tag @e[tag=malphite.r.hit,type=!#unvalid,team=!red] remove malphite.r.hit

    execute if entity @s[tag=blue] if entity @e[tag=malphite.r.hit,team=!blue,type=!#unvalid] run tag @e[tag=malphite.r.hit,type=!#unvalid,team=!blue,tag=!malphite.r.dmg] add temp_dmg
    execute if entity @s[tag=blue] if entity @e[tag=malphite.r.hit,team=!blue,type=!#unvalid] run tag @e[tag=malphite.r.hit,type=!#unvalid,team=!blue] add malphite.r.dmg
    execute if entity @s[tag=blue] if entity @e[tag=malphite.r.hit,team=!blue,type=!#unvalid] as @e[tag=malphite.r.hit,type=!#unvalid,team=!blue,tag=!unstoppable] at @s run function lc:champions/malphite/skills/r.knockup
    execute if entity @s[tag=blue] if entity @e[tag=malphite.r.hit,team=!blue,type=!#unvalid] as @p[tag=malphite,team=blue] run function lc:champions/malphite/skills/r.damage

    execute if entity @s[tag=blue] if entity @e[tag=malphite.r.hit,team=!blue,type=!#unvalid] run tag @e[tag=malphite.r.hit,type=!#unvalid,team=!blue] remove malphite.r.hit
}

function w.area {
    execute anchored eyes positioned ^ ^-0.5 ^ rotated ~90 0 run function lc:champions/malphite/skills/w.particle

    execute if entity @s[team=red] positioned ^ ^ ^0.5 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add malphite.w.hit
    execute if entity @s[team=red] positioned ^1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add malphite.w.hit
    execute if entity @s[team=red] positioned ^-1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add malphite.w.hit

    execute if entity @s[team=red] as @p[tag=malphite,team=red] run function lc:champions/malphite/skills/w.area.damage

    execute if entity @s[team=blue] positioned ^ ^ ^0.5 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add malphite.w.hit
    execute if entity @s[team=blue] positioned ^1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add malphite.w.hit
    execute if entity @s[team=blue] positioned ^-1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add malphite.w.hit

    execute if entity @s[team=blue] as @p[tag=malphite,team=blue] run function lc:champions/malphite/skills/w.area.damage
}

function w.area.damage {
    execute if entity @s[team=red] run damage @e[tag=malphite.w.hit,type=!#unvalid,team=!red,limit=1,sort=nearest] 2 lc:core/dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[tag=malphite.w.hit,type=!#unvalid,team=!blue,limit=1,sort=nearest] 2 lc:core/dmg_physical by @s

    scoreboard players operation malphite.w.temp_dmg attack_damage = @s ability_power
    scoreboard players operation malphite.w.temp_dmg attack_damage *= 20 integer
    scoreboard players operation malphite.w.temp_dmg attack_damage /= 100 integer

    scoreboard players operation temp armor = @s armor
    scoreboard players operation temp armor *= 15 integer
    scoreboard players operation temp armor /= 100 integer

    scoreboard players operation malphite.w.temp_dmg attack_damage += temp armor
    scoreboard players add malphite.w.temp_dmg attack_damage 55

    scoreboard players operation @s dmg_physical.deal = malphite.w.temp_dmg attack_damage
    function lc:champion/dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=malphite.w.hit,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=malphite.w.hit,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=malphite.w.hit,type=!#unvalid,limit=1,sort=nearest] remove malphite.w.hit

    execute if entity @s[team=red] run execute if entity @e[tag=malphite.w.hit,type=!#unvalid,team=!red] run function lc:champions/malphite/skills/w.area.damage

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=malphite.w.hit,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=malphite.w.hit,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=malphite.w.hit,type=!#unvalid,limit=1,sort=nearest] remove malphite.w.hit

    execute if entity @s[team=blue] run execute if entity @e[tag=malphite.w.hit,type=!#unvalid,team=!blue] run function lc:champions/malphite/skills/w.area.damage
}

function w.damage {
    scoreboard players operation malphite.w.temp_dmg attack_damage = @s ability_power
    scoreboard players operation malphite.w.temp_dmg attack_damage *= 20 integer
    scoreboard players operation malphite.w.temp_dmg attack_damage /= 100 integer

    scoreboard players operation temp armor = @s armor
    scoreboard players operation temp armor *= 15 integer
    scoreboard players operation temp armor /= 100 integer

    scoreboard players operation malphite.w.temp_dmg attack_damage += temp armor
    scoreboard players add malphite.w.temp_dmg attack_damage 70

    scoreboard players operation @s dmg_physical.deal += malphite.w.temp_dmg attack_damage
    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
    execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/calc.physical
    execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function lc:champion/dmg/taken/physical

    execute at @s rotated ~ 0 run function lc:champions/malphite/skills/w.area
}

function w.end {
    scoreboard players remove @s aa.range 10

    execute if entity @s[team=red] run kill @e[tag=malphite.w.cd,tag=red]
    execute if entity @s[team=blue] run kill @e[tag=malphite.w.cd,tag=blue]
    tag @s remove malphite.w
    tag @s add offhand_temp

    item replace entity @s weapon.offhand with air
    scoreboard players set @s status.weapon 1300101
}

