# lc:champions/leona/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking leona; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.leona
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.leona
    tag @s add useMana
    scoreboard players operation @s armor.base = @s armor
    scoreboard players operation @s magic_resist.base = @s magic_resist
    scoreboard players operation @s mana = @s mana.max
    playsound minecraft:leona.select master @s ~ ~ ~
    playsound minecraft:leona.sfx.select master @s ~ ~ ~
}

function aa {
    execute if entity @s[tag=!leona.q] run playsound leona.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=leona.q] run playsound leona.sfx.q.aa master @a ~ ~ ~
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:leona"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:leona/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:leona/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:leona/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:leona/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:leona/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## Q
    execute if entity @s[tag=leona.q] run scoreboard players set @s status.q 9

    ## W
    execute if entity @s[tag=leona.w] run scoreboard players set @s status.w 9

    function lc:champions/leona/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[type=!#unvalid,tag=!unvalid,scores={leona.passive=1..2}] at @s anchored eyes run particle wax_on ^ ^-0.5 ^ 0.2 0.2 0.2 1 2 force

    execute as @e[tag=leona.e,type=item_display] at @s run function lc:champions/leona/skills/e.animation
    execute as @e[tag=leona.e2,type=item_display] at @s run function lc:champions/leona/skills/e.dash

    execute as @e[tag=leona.r,type=item_display] at @s run function lc:champions/leona/skills/r.animation
    execute as @e[tag=leona.r.cast,type=area_effect_cloud] at @s run function lc:champions/leona/skills/r.cast
}

function main {
    ## HUD
    function lc:champions/leona/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/leona/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/leona/item/offhand

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r

    execute if entity @s[team=red,tag=leona.q] unless entity @e[tag=leona.q.cd,tag=red] run function lc:champions/leona/skills/q.end
    execute if entity @s[team=blue,tag=leona.q] unless entity @e[tag=leona.q.cd,tag=blue] run function lc:champions/leona/skills/q.end
}

function passive {
    ## EXECUTE AS TARGET
    scoreboard players set @s leona.passive 0
    scoreboard players add @s dmg_magic.raw 168
    execute at @s anchored eyes run particle end_rod ^ ^-0.5 ^ 0.2 0.2 0.2 0.1 10 force
}

function use_e {
    function lc:champion/abilities/cooldown/e
    playsound leona.sfx.e master @a ~ ~ ~

    scoreboard players set @s channeling 5
    scoreboard players set @s status.weapon 9999

    execute if entity @s[team=red] run summon minecraft:item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[1000101f]}}},Tags:["leona.e","red","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:7,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run summon minecraft:item_display ~ ~ ~ {teleport_duration:1,item_display:"head",item:{id:"phantom_membrane",count:1,components:{"minecraft:custom_model_data":{floats:[1000101f]}}},Tags:["leona.e","blue","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:7,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute anchored eyes run tp @e[tag=leona.e,limit=1,sort=nearest] ^ ^ ^ ~ ~
}

function use_e2 {
    playsound leona.sfx.e.hit master @a ~ ~ ~
    tag @s add e.dash

    function lc:core/motion/interrupt

    execute if entity @s[team=red] run summon item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["dash","red","leona.e2","temp","interrupt_by_blink","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run summon item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["dash","blue","leona.e2","temp","interrupt_by_blink","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute at @e[tag=leona.e2,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=leona.e2,tag=temp,limit=1,sort=nearest] remove temp
}

function use_q {
    playsound leona.sfx.q master @a ~ ~ ~
    scoreboard players set @s aa.cd 0
    scoreboard players add @s aa.range 10

    tag @s add leona.q
    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:120,Tags:["leona.q.cd","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:120,Tags:["leona.q.cd","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_r {
    function lc:champion/abilities/cooldown/r

    playsound minecraft:leona.ultimate master @a ~ ~ ~ 2
    playsound minecraft:leona.sfx.r master @a ~ ~ ~ 2

    scoreboard players set @s channeling 5

    execute anchored eyes run summon area_effect_cloud ^ ^-0.5 ^ {Duration:12,Tags:["leona.r.cast"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute anchored eyes positioned ^ ^ ^12 run summon area_effect_cloud ~ ~ ~ {Duration:2,Tags:["leona.r.position"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute anchored eyes positioned ^ ^ ^12 run data modify entity @e[tag=leona.r.position,type=area_effect_cloud,limit=1,sort=nearest] Owner set from entity @s UUID
    execute anchored eyes positioned ^ ^ ^12 as @e[tag=leona.r.position,type=area_effect_cloud,limit=1,sort=nearest] at @s run function lc:champions/leona/skills/r.position
}

function use_w {
    function lc:champion/abilities/cooldown/w

    playsound minecraft:leona.sfx.w master @a ~ ~ ~
    tag @s add update.shield.leona
    tag @s add leona.w

    scoreboard players operation leona.w.armor temp = @s armor
    scoreboard players operation leona.w.armor temp *= 20 integer
    scoreboard players operation leona.w.armor temp /= 100 integer
    scoreboard players add leona.w.armor temp 50

    scoreboard players operation @s armor += leona.w.armor temp

    scoreboard players operation leona.w.mr temp = @s magic_resist
    scoreboard players operation leona.w.mr temp *= 20 integer
    scoreboard players operation leona.w.mr temp /= 100 integer
    scoreboard players add leona.w.mr temp 50

    scoreboard players operation @s magic_resist += leona.w.mr temp

    execute if entity @s[team=red] run scoreboard players operation red.leona.w.armor temp = leona.w.armor temp
    execute if entity @s[team=red] run scoreboard players operation red.leona.w.mr temp = leona.w.mr temp
    execute if entity @s[team=red] run summon item_display ~ ~ ~ {Tags:["red","leona.w","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:60,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[team=blue] run scoreboard players operation blue.leona.w.armor temp = leona.w.armor temp
    execute if entity @s[team=blue] run scoreboard players operation blue.leona.w.mr temp = leona.w.mr temp
    execute if entity @s[team=blue] run summon item_display ~ ~ ~ {Tags:["blue","leona.w","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:60,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
}
