    function q.sonic {
        tp @s ^ ^ ^1.5
        particle minecraft:dust{color:[0.6,0.9,1],scale:3} ^ ^ ^0.5 0.2 0.2 0.2 0 5 force
        particle minecraft:dust{color:[0.6,0.9,1],scale:1} ^ ^ ^ 0.2 0.2 0.2 0 10 force
        particle minecraft:dust{color:[0.6,0.9,1],scale:0.5} ^ ^ ^-0.5 0.2 0.2 0.2 0 5 force

        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!red,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] run function lc:champions/leesin/skills/q.sonic.hit

        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[team=!blue,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] run function lc:champions/leesin/skills/q.sonic.hit
    }

    function q.sonic.hit {
        playsound leesin.sfx.q.hit master @a ~ ~ ~
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] run tag @e[team=!<%team%>,dx=0,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add leesin.q.target.<%team%>
            execute if entity @s[tag=<%team%>] as @p[tag=leesin,team=<%team%>] run function lc:champions/leesin/skills/q1.damage
            execute if entity @s[tag=<%team%>] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:60,Tags:["<%team%>","leesin.q.mark.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
            execute if entity @s[tag=<%team%>] as @e[tag=leesin.q.target.<%team%>,limit=1,sort=nearest] anchored eyes run summon item_display ^ ^ ^ {brightness:{sky:15,block:15},Glowing:1,Tags:["<%team%>","leesin.q.mark","lol.auto_clear"],teleport_duration:1,billboard:"vertical",item_display:"head",item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200111f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Tags:["cd"],Duration:200,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
            execute if entity @s[tag=<%team%>] run scoreboard players set @e[tag=leesin.q.target.<%team%>,limit=1,sort=nearest] fx.sight 60
        }

        kill @s
    }

    function q1.damage {
        execute if entity @s[team=red] run damage @e[tag=leesin.q.target.red,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=leesin.q.target.blue,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 155
        scoreboard players operation @s dmg_physical.deal += @s attack_damage

        function lc:champion/dmg/calc.debuff
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=leesin.q.target.<%team%>,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=leesin.q.target.<%team%>,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
        }
    }

    function q2.damage {
        execute if entity @s[team=red] run damage @e[tag=leesin.q.target.red,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=leesin.q.target.blue,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 155
        scoreboard players operation @s dmg_physical.deal += @s attack_damage
        scoreboard players operation dmg temp = @s dmg_physical.deal

        execute if entity @s[team=red] run scoreboard players operation dmg temp *= @e[tag=leesin.q.target.red,type=!#unvalid,team=!red,limit=1,sort=nearest] hp.percentage_lost
        execute if entity @s[team=blue] run scoreboard players operation dmg temp *= @e[tag=leesin.q.target.blue,type=!#unvalid,team=!blue,limit=1,sort=nearest] hp.percentage_lost
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_physical.deal += dmg temp

        function lc:champion/dmg/calc.debuff
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=leesin.q.target.<%team%>,tag=has_health_bar,limit=1,sort=nearest] armor.reduced = @s armor.pen
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=leesin.q.target.<%team%>,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
        }
    }

    function q2.dash {
        execute if entity @s[tag=red] on passengers on vehicle facing entity @e[tag=leesin.q.target.red,limit=1,sort=nearest] feet rotated ~ ~-20 run tp @s ^ ^ ^1.5
        execute if entity @s[tag=red] if score @p[team=red,tag=leesin] channeling matches -1 at @s positioned ~ ~-0.5 ~ as @p[team=red,tag=leesin] run function lc:core/motion/follow

        execute if entity @s[tag=red] run scoreboard players set @e[tag=leesin.q.target.red] fx.sight 2

        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] as @p[tag=leesin,team=red] run function lc:champions/leesin/skills/q2.damage
        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] as @e[tag=leesin.q.mark,tag=red] on passengers run kill @s
        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] run tag @p[tag=leesin,team=red] remove q2.dash
        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] on passengers run kill @s[tag=cd]
        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.red,dx=0] run tag @e[tag=leesin.q.target.red] remove leesin.q.target.red

        execute if entity @s[tag=blue] on passengers on vehicle facing entity @e[tag=leesin.q.target.blue,limit=1,sort=nearest] feet rotated ~ ~-20 run tp @s ^ ^ ^1.5
        execute if entity @s[tag=blue] if score @p[team=blue,tag=leesin] channeling matches -1 at @s positioned ~ ~-0.5 ~ as @p[team=blue,tag=leesin] run function lc:core/motion/follow

        execute if entity @s[tag=blue] run scoreboard players set @e[tag=leesin.q.target.blue] fx.sight 2

        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] as @p[tag=leesin,team=blue] run function lc:champions/leesin/skills/q2.damage
        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] as @e[tag=leesin.q.mark,tag=blue] on passengers run kill @s
        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] run tag @p[tag=leesin,team=blue] remove q2.dash
        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] on passengers run kill @s[tag=cd]
        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=leesin.q.target.blue,dx=0] run tag @e[tag=leesin.q.target.blue] remove leesin.q.target.blue
    }

    function q2.dash.cancel {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] run tag @e[tag=leesin.q.target.<%team%>] remove leesin.q.target.<%team%>
            execute if entity @s[tag=<%team%>] as @e[tag=leesin.q.mark.model,tag=<%team%>] on passengers run kill @s
            execute if entity @s[tag=<%team%>] run tag @p[tag=leesin,team=<%team%>] remove q2.dash
            execute if entity @s[tag=<%team%>] on passengers run data modify entity @s Age set value 2147483646
        }
    }

    function r.animation {
        execute anchored feet run particle dust{color:[1,0.5,0],scale:1} ^ ^0.5 ^ 0.2 0.2 0.2 1 10 force

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] positioned ~-1 ~-1 ~-1 if entity @e[tag=!leesin.r.target,team=!<%enemy%>,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unvalid,type=!#unvalid] as @p[team=<%enemy%>,tag=leesin] run function lc:champions/leesin/skills/r.damage.collide
            execute if entity @s[team=<%team%>] positioned ~-1 ~-1 ~-1 if entity @e[tag=!leesin.r.target,team=!<%enemy%>,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unvalid,type=!#unvalid] as @e[tag=!leesin.r.target,team=!<%enemy%>,dx=1,dz=1,dy=1,tag=!leesin.r.collide,tag=!unstoppable] positioned ~1 ~1 ~1 at @s run function lc:champions/leesin/skills/r.knockup.collide
        }

        execute unless entity @s[team=red,type=player,tag=leesin.r.kicked,tag=airborne] run tag @e[tag=leesin.r.collide,team=red] remove leesin.r.collide
        execute unless entity @s[team=blue,type=player,tag=leesin.r.kicked,tag=airborne] run tag @e[tag=leesin.r.collide,team=blue] remove leesin.r.collide
        execute unless entity @s[type=player,tag=leesin.r.kicked,tag=airborne] run tag @s remove leesin.r.target
        tag @s[tag=!airborne] remove leesin.r.kicked

        execute if entity @s[team=red,type=!player] if entity @s[tag=!airborne] run tag @e[team=!blue,tag=leesin.r.collide] remove leesin.r.collide
        execute if entity @s[team=blue,type=!player] if entity @s[tag=!airborne] run tag @e[team=!red,tag=leesin.r.collide] remove leesin.r.collide
        execute if entity @s[type=!player] run tag @s[tag=!airborne] remove leesin.r.target
    }

    function r.cast {
        #execute on origin run tp @s ~ ~ ~ ~ ~

        execute if entity @s[nbt={Age:3}] on origin if entity @s[team=red] at @e[tag=leesin.r.target.temp,team=!red] anchored feet run particle crit ^ ^0.5 ^ 0 0 0 1 50 force
        execute if entity @s[nbt={Age:3}] on origin if entity @s[team=blue] at @e[tag=leesin.r.target.temp,team=!blue] anchored feet run particle crit ^ ^0.5 ^ 0 0 0 1 50 force

        execute if entity @s[nbt={Age:5}] on origin run tag @s remove r.animation

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[nbt={Age:5}] on origin if entity @s[team=<%team%>] run tag @e[tag=leesin.r.target.temp,team=!<%team%>] add leesin.r.target
            execute if entity @s[nbt={Age:5}] on origin if entity @s[team=<%team%>] run tag @e[tag=leesin.r.target.temp,team=!<%team%>] remove leesin.r.target.temp
        }

        execute if entity @s[nbt={Age:5}] on origin run function lc:champions/leesin/skills/r.damage

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[nbt={Age:5}] on origin if entity @s[team=<%team%>] as @e[tag=leesin.r.target,team=!<%team%>,tag=!unstoppable,tag=champion,limit=1] at @s unless predicate lc:core/is_flying facing entity @p[tag=leesin,team=<%team%>] feet rotated ~ ~-5 run function lc:champions/leesin/skills/r.knockup
            execute if entity @s[nbt={Age:5}] on origin if entity @s[team=<%team%>] as @e[tag=leesin.r.target,team=!<%team%>,tag=!unstoppable,tag=champion,limit=1] at @s if predicate lc:core/is_flying on vehicle at @s[tag=lol.is_flying] facing entity @p[tag=leesin,team=<%team%>] feet rotated ~ ~-5 on passengers as @s[tag=champion] run function lc:champions/leesin/skills/r.knockup
        }
    }

    function r.damage {
        execute if entity @s[team=red] run damage @e[tag=leesin.r.target,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=leesin.r.target,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 625
        scoreboard players operation dmg temp = @s attack_damage
        scoreboard players operation dmg temp *= 200 integer
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_physical.deal += dmg temp

        function lc:champion/dmg/calc.debuff
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] armoruced = @s armor.pen
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
        }
    }

    function r.damage.collide {
        execute if entity @s[team=red] run damage @e[tag=!leesin.r.collide,tag=!leesin.r.target,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=!leesin.r.collide,tag=!leesin.r.target,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 625
        scoreboard players operation dmg temp = @s attack_damage
        scoreboard players operation dmg temp *= 200 integer
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_physical.deal += dmg temp

        execute if entity @s[team=red] run scoreboard players operation dmg temp = @e[team=!red,tag=leesin.r.target] hp.max
        execute if entity @s[team=blue] run scoreboard players operation dmg temp = @e[team=!blue,tag=leesin.r.target] hp.max

        scoreboard players operation dmg temp *= 20 integer
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_physical.deal += dmg temp

        function lc:champion/dmg/calc.debuff
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=!leesin.r.collide,tag=!leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] armoruced = @s armor.pen
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=!leesin.r.collide,tag=!leesin.r.target,tag=has_health_bar,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal
        }
    }

    function r.knockup {
        function lc:champion/cc/cancel
        scoreboard players set @s cc.airborne 20
        tag @s add leesin.r.kicked
        # Kicked away from Lee Sin (this runs facing him), 0.75 blocks per tick, straight for 20 ticks.
        execute rotated ~180 0 run function lc:core/motion/throw {speed:750,ticks:20}
    }

    function r.knockup.collide {
        tag @s add leesin.r.collide

        function lc:champion/cc/cancel
        scoreboard players set @s cc.airborne 20

        function lc:core/motion/push {x:0,y:530,z:0,ticks:0}
    }

    function r.particle {
        #execute if entity @s[tag=red] run tp @p[tag=leesin,team=red] ~ ~ ~
        #execute if entity @s[tag=blue] run tp @p[tag=leesin,team=blue] ~ ~ ~

        tp @s ~ ~ ~ ~-30 ~-10

        particle dust{color:[1,0.5,0],scale:2} ^1 ^0.5 ^1.75 0 0 0 1 1 force
        particle dust{color:[1,0.5,0],scale:2} ^0.5 ^0.5 ^1.75 0 0 0 1 1 force
        particle dust{color:[1,0.5,0],scale:3} ^ ^0.5 ^1.75 0 0 0 1 1 force
        particle dust{color:[1,0.5,0],scale:1} ^-0.25 ^0.5 ^1.75 0 0 0 0 1 force
        particle dust{color:[1,0.5,0],scale:1} ^-0.5 ^0.5 ^1.75 0 0 0 0 1 force
        particle dust{color:[1,0.5,0],scale:1} ^-0.75 ^0.5 ^1.75 0 0 0 0 1 force
        particle dust{color:[1,0.5,0],scale:1} ^-1 ^0.5 ^1.75 0 0 0 0 1 force

        #particle dust 1 0.5 0 2 ^ ^ ^1.5 0.1 0.1 0.1 1 2 force
    }

    function w.dash {
        tp @s ^ ^ ^1
        execute if entity @s[tag=red] at @s positioned ~ ~-0.5 ~ as @p[team=red,tag=leesin] run function lc:core/motion/follow
        execute if entity @s[tag=blue] at @s positioned ~ ~-0.5 ~ as @p[team=blue,tag=leesin] run function lc:core/motion/follow

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] if entity @e[tag=leesin.w.stop,distance=..1] positioned ~-1 ~-1 ~-1 as @e[tag=champion,tag=leesin.w.target,team=<%team%>,dx=1,dz=1,dy=1] at @s run function lc:champions/leesin/skills/w.shield.ally
            execute if entity @s[tag=<%team%>] if entity @e[tag=leesin.w.stop,distance=..1] run tag @e[tag=leesin.w.target,team=<%team%>] remove leesin.w.target
            execute if entity @s[tag=<%team%>] if entity @e[tag=leesin.w.stop,distance=..1] on passengers run kill @s[tag=cd]
        }
    }

    function w.dash.cancel {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] run tag @e[tag=leesin.w.target,team=<%team%>] remove leesin.w.target
            execute if entity @s[tag=<%team%>] run kill @e[tag=leesin.w.stop,tag=<%team%>]
            execute if entity @s[tag=<%team%>] on passengers run kill @s[tag=cd]
        }
    }

    function w.shield.ally {
        tag @s add leesin.w.ally

        execute if entity @s[tag=has_display_bar] run tag @s add update.shield.leesin

        execute if entity @s[type=!player] on passengers as @s[tag=leesin.w.shield] on passengers run kill @s
        execute if entity @s[type=!player] on passengers as @s[tag=leesin.w.shield] run kill @s
        execute if entity @s[type=!player] run summon item_display ~ ~ ~ {interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}},Tags:["leesin.w.shield","temp","lol.auto_clear","spin1"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[0.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[200201f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[120.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[200201f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[-120.0f,0.0f],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[200201f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[-22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[22.5f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}}},{id:"item_display",interpolation_duration:10,teleport_duration:1,item_display:"head",Rotation:[45.0f,0.0f],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[200211f]}}}},{id:"area_effect_cloud",WaitTime:0,Duration:40,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[type=!player] run ride @e[type=item_display,tag=temp,tag=leesin.w.shield,limit=1,sort=nearest] mount @s
        execute if entity @s[type=!player] on passengers run data merge entity @s[tag=leesin.w.shield] {transformation:{translation:[0.0,-0.6,0.0]}}
        execute if entity @s[type=!player] on passengers as @s[tag=leesin.w.shield] on passengers run data merge entity @s {transformation:{translation:[0.0,-0.6,0.0]}}

        summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:999999,Tags:["leesin.w","shield.all","new"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Tags:["cd"],Duration:40,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID
        scoreboard players set @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all 250
        scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all
        tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new
    }
}
