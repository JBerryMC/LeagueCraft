# lc:champions/leesin/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking leesin; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.leesin
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.leesin
    tag @s add useEnergy
    scoreboard players operation @s mana = @s mana.max
    playsound minecraft:leesin.select master @a ~ ~ ~
    playsound minecraft:leesin.sfx.select master @a ~ ~ ~
}

function aa {
    playsound leesin.sfx.aa master @a ~ ~ ~
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:leesin"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:leesin/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:leesin/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:leesin/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:leesin/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:leesin/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"stack_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## Passive
    execute if score @s stack_p matches 1.. run scoreboard players set @s status.p 1
    execute if score @s stack_p matches 0 run scoreboard players set @s status.p 0

    ## Q
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=leesin.q.mark.cd] run scoreboard players set @s mana_q 25
        execute if entity @s[team=<%team%>] unless entity @e[tag=<%team%>,tag=leesin.q.mark.cd] run scoreboard players set @s mana_q 50
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=leesin.q.mark.cd] if entity @e[tag=!unvalid,type=!#unvalid,tag=leesin.q.target.<%team%>,team=!<%team%>,distance=..20] if score @s mana >= @s mana_q run scoreboard players set @s status.q 2
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=leesin.q.mark.cd] unless entity @e[tag=!unvalid,type=!#unvalid,tag=leesin.q.target.<%team%>,team=!<%team%>,distance=..20] if score @s mana >= @s mana_q run scoreboard players set @s status.q 7
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=leesin.q.mark.cd] if score @s cc.root matches 1.. run scoreboard players set @s status.q 9
    }

    ## W
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=leesin.w2.cd] run scoreboard players set @s mana_w 25
        execute if entity @s[team=<%team%>] unless entity @e[tag=<%team%>,tag=leesin.w2.cd] run scoreboard players set @s mana_w 50
        execute if entity @s[team=<%team%>] if entity @e[tag=<%team%>,tag=leesin.w2.cd] if score @s mana >= @s mana_w run scoreboard players set @s status.w 2
        execute if entity @s[team=<%team%>] unless entity @e[tag=<%team%>,tag=leesin.w2.cd] if score @s cc.root matches 1.. run scoreboard players set @s status.w 9
    }

    ## E
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] if entity @e[tag=leesin.e.mark,team=!<%team%>] run scoreboard players set @s mana_e 25
        execute if entity @s[team=<%team%>] unless entity @e[tag=leesin.e.mark,team=!<%team%>] run scoreboard players set @s mana_e 50
        execute if entity @s[team=<%team%>] if entity @e[tag=leesin.e.mark,team=!<%team%>] if score @s mana >= @s mana_e run scoreboard players set @s status.e 2
    }

    ## R + Flash
    execute if entity @s[tag=r.animation] if score @s cd_spell.1 matches 0 if score @s spell.1 matches 1 run scoreboard players set @s status.spell.1 1
    execute if entity @s[tag=r.animation] if score @s cd_spell.1 matches 0 if score @s spell.1 matches 2 run scoreboard players set @s status.spell.1 2
    execute if entity @s[tag=r.animation] if score @s cd_spell.1 matches 0 if score @s spell.1 matches 3 run scoreboard players set @s status.spell.1 3
    execute if entity @s[tag=r.animation] if score @s cd_spell.1 matches 0 if score @s spell.1 matches 4 run scoreboard players set @s status.spell.1 4
    execute if entity @s[tag=r.animation] if score @s cd_spell.1 matches 0 if score @s spell.1 matches 5 run scoreboard players set @s status.spell.1 5

    function lc:champions/leesin/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    ## Q
    execute as @e[tag=leesin.q.sonic,type=minecraft:area_effect_cloud] at @s run function lc:champions/leesin/skills/q.sonic
    execute as @e[tag=leesin.q.mark.cd,type=minecraft:area_effect_cloud] at @s run function lc:champions/leesin/skills/q.mark
    execute as @e[tag=leesin.q.mark,type=minecraft:item_display] at @s run function lc:champions/leesin/skills/q.mark.model
    execute as @a[tag=q2.dash,tag=leesin] at @s run function lc:champions/leesin/skills/q.mark
    execute as @e[tag=leesin.q2,type=item_display] at @s run function lc:champions/leesin/skills/q2.dash

    ## W
    execute as @e[tag=leesin.w,type=minecraft:item_display] at @s run function lc:champions/leesin/skills/w.dash
    execute as @e[tag=leesin.w2,type=minecraft:area_effect_cloud,nbt={Age:80},tag=red] run scoreboard players remove @e[tag=leesin,team=red] omnivamp 26
    execute as @e[tag=leesin.w2,type=minecraft:area_effect_cloud,nbt={Age:80},tag=blue] run scoreboard players remove @e[tag=leesin,team=blue] omnivamp 26

    ## E
    execute as @e[tag=leesin.e.particle,type=minecraft:area_effect_cloud] at @s run function lc:champions/leesin/skills/e.particle
    execute as @e[tag=leesin.e.mark.cd,type=minecraft:area_effect_cloud,nbt={Age:60},tag=red] run tag @e[tag=leesin.e.mark,team=!red] remove leesin.e.mark
    execute as @e[tag=leesin.e.mark.cd,type=minecraft:area_effect_cloud,nbt={Age:60},tag=blue] run tag @e[tag=leesin.e.mark,team=!blue] remove leesin.e.mark

    ## R
    execute as @e[tag=leesin.r.cast,type=minecraft:area_effect_cloud] at @s run function lc:champions/leesin/skills/r.cast
    execute as @e[tag=leesin.r.particle,type=minecraft:area_effect_cloud] at @s run function lc:champions/leesin/skills/r.particle
    execute as @e[tag=leesin.r.target,type=#has_health_bar] at @s run function lc:champions/leesin/skills/r.animation
}

function main {
    # Cooldown
    #execute unless score @s stack_p matches 1.. run title @s actionbar [{"text":"\uE010"},{"score":{"name":"@s","objective":"mana"}},{"text":" \uE016"},{"text":" \uE011"},{"score":{"name":"@s","objective":"cd_q"}},{"text":" \uE012"},{"score":{"name":"@s","objective":"cd_w"}},{"text":" \uE013"},{"score":{"name":"@s","objective":"cd_e"}},{"text":" \uE014"},{"score":{"name":"@s","objective":"cd_r"}}]
    #execute if score @s stack_p matches 1.. run title @s actionbar [{"text":"\uE010"},{"score":{"name":"@s","objective":"mana"}},{"text":" \uE015"},{"score":{"name":"@s","objective":"stack_p"}},{"text":" \uE011"},{"score":{"name":"@s","objective":"cd_q"}},{"text":" \uE012"},{"score":{"name":"@s","objective":"cd_w"}},{"text":" \uE013"},{"score":{"name":"@s","objective":"cd_e"}},{"text":" \uE014"},{"score":{"name":"@s","objective":"cd_r"}}]
    function lc:champions/leesin/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/leesin/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/leesin/item/offhand

    # Passive
    function lc:champions/leesin/passive

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r

    # Q

    # W

    # E

    # R
    #execute if entity @s[tag=!r.animation,tag=!cced,scores={rclick=1..,shift=1..,cd_r=0},team=red] rotated ~ 0 positioned ^ ^1 ^1.5 if entity @e[team=!red,distance=..1.5,type=!#unvalid,tag=!unvalid] positioned ^ ^-1 ^-1.5 run function lc:champions/leesin/use_r
    #execute if entity @s[tag=!r.animation,tag=!cced,scores={rclick=1..,shift=1..,cd_r=0},team=blue] rotated ~ 0 positioned ^ ^1 ^1.5 if entity @e[team=!blue,distance=..1.5,type=!#unvalid,tag=!unvalid] positioned ^ ^-1 ^-1.5 run function lc:champions/leesin/use_r
}

function passive {
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] if score @s stack_p matches 0 if entity @e[tag=leesin.passive.cd,tag=<%team%>] run function lc:champions/leesin/skills/passive.end
        execute if entity @s[team=<%team%>] if score @s stack_p matches 1.. unless entity @e[tag=leesin.passive.cd,tag=<%team%>] run function lc:champions/leesin/skills/passive.end
    }
}

function use_e {
    function lc:champion/abilities/cooldown/e
    function lc:champions/leesin/skills/passive.start

    scoreboard players set @s channeling 5

    playsound minecraft:leesin.sfx.e1 master @a ~ ~ ~

    summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:4,Tags:["leesin.e.particle"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[team=red] run tag @e[team=!red,distance=..3,type=!#unvalid,tag=!unvalid] add leesin.e.mark
    execute if entity @s[team=red] run tag @e[team=!red,tag=leesin.e.mark] add temp_dmg
    execute if entity @s[team=red] if entity @e[team=!red,tag=leesin.e.mark] run function lc:champions/leesin/skills/e.damage

    execute if entity @s[team=red] run scoreboard players add @e[tag=leesin.e.mark,team=!red,distance=..3] fx.sight 40
    execute if entity @s[team=red] if entity @e[tag=leesin.e.mark,team=!red] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:61,Tags:["red","leesin.e.mark.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[team=blue] run tag @e[team=!blue,distance=..3,type=!#unvalid,tag=!unvalid] add leesin.e.mark
    execute if entity @s[team=blue] run tag @e[team=!blue,tag=leesin.e.mark] add temp_dmg
    execute if entity @s[team=blue] if entity @e[team=!blue,tag=leesin.e.mark] run function lc:champions/leesin/skills/e.damage

    execute if entity @s[team=blue] run scoreboard players add @e[tag=leesin.e.mark,team=!blue,distance=..3] fx.sight 40
    execute if entity @s[team=blue] if entity @e[tag=leesin.e.mark,team=!blue] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:61,Tags:["blue","leesin.e.mark.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
}

function use_e2 {
    function lc:champions/leesin/skills/passive.start

    playsound minecraft:leesin.sfx.e2 master @a ~ ~ ~

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run effect give @e[tag=leesin.e.mark,team=!<%team%>] minecraft:slowness 4 4 false
        execute if entity @s[team=<%team%>] at @e[tag=leesin.e.mark] run particle minecraft:instant_effect ~ ~1 ~ 0.2 0.2 0.2 1 50 force
        execute if entity @s[team=<%team%>] run tag @e[tag=leesin.e.mark,team=!<%team%>] remove leesin.e.mark
        execute if entity @s[team=<%team%>] run kill @e[tag=leesin.e.mark.cd,tag=<%team%>,type=minecraft:area_effect_cloud]
    }
}

function use_q {
    function lc:champion/abilities/cooldown/q
    function lc:champions/leesin/skills/passive.start
    scoreboard players set @s channeling 5

    playsound minecraft:leesin.sfx.q1 master @a ~ ~ ~

    execute anchored eyes positioned ^ ^ ^1 run function lc:champions/leesin/skills/q.particle

    execute if entity @s[team=red] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:13,Tags:["leesin.q.sonic","red","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:13,Tags:["leesin.q.sonic","blue","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute anchored eyes run tp @e[tag=leesin.q.sonic,limit=1,sort=nearest] ^ ^ ^ ~ ~
}

function use_q2 {
    function lc:champions/leesin/skills/passive.start

    playsound minecraft:leesin.sfx.q2 master @a ~ ~ ~

    tag @s add q2.dash

    function lc:core/motion/interrupt

    execute if entity @s[team=red] run summon item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["dash","red","leesin.q2","temp","interrupt_by_blink","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run summon item_display ~ ~0.5 ~ {teleport_duration:1,Tags:["dash","blue","leesin.q2","temp","interrupt_by_blink","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:2147483647,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute at @e[tag=leesin.q2,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=leesin.q2,tag=temp,limit=1,sort=nearest] remove temp

    execute if entity @s[team=red] run kill @e[tag=leesin.q.mark.cd,tag=red]
    execute if entity @s[team=blue] run kill @e[tag=leesin.q.mark.cd,tag=blue]
}

function use_r {
    function lc:champion/abilities/cooldown/r
    function lc:champions/leesin/skills/passive.start

    scoreboard players set @s channeling 5

    playsound minecraft:leesin.ultimate master @a ~ ~ ~
    playsound minecraft:leesin.sfx.r master @a ~ ~ ~
    tag @s add r.animation

    summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:5,Tags:["leesin.r.particle","temp"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    tp @e[tag=leesin.r.particle,tag=temp,type=area_effect_cloud,limit=1] ~ ~ ~ ~60 0
    tag @e[tag=leesin.r.particle,tag=temp,type=area_effect_cloud,limit=1] remove temp

    summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:6,Tags:["leesin.r.cast","temp"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    tp @e[tag=leesin.r.cast,tag=temp,type=area_effect_cloud,limit=1] ~ ~ ~ ~ ~
    data modify entity @e[tag=leesin.r.cast,tag=temp,type=area_effect_cloud,limit=1] Owner set from entity @s UUID
    tag @e[tag=leesin.r.cast,tag=temp,type=area_effect_cloud,limit=1] remove temp

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=temp_target,limit=1,sort=nearest,type=!#unvalid,tag=!unvalid] add leesin.r.target.temp
        execute if entity @s[team=<%team%>] run tag @e[team=!<%team%>,tag=temp_target,limit=1,sort=nearest,type=!#unvalid,tag=!unvalid] remove temp_target
        execute if entity @s[team=<%team%>] run scoreboard players set @e[team=!<%team%>,tag=leesin.r.target.temp,limit=1,sort=nearest,type=!#unvalid,tag=!unvalid,tag=!unstoppable] cc.root 5
    }
}

function use_r.check {
    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,tag=!leesin.r.target.temp,tag=!leesin.r.target,tag=champion,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target] add temp_target

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=champion,dx=0,tag=!leesin.r.target.temp,tag=!leesin.r.target,tag=champion,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] at @s run function lc:champions/leesin/use_r

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,tag=!leesin.r.target.temp,tag=!leesin.r.target,tag=champion,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] remove temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,tag=!leesin.r.target.temp,tag=!leesin.r.target,tag=champion,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target] add temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=champion,dx=0,tag=!leesin.r.target.temp,tag=!leesin.r.target,tag=champion,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] at @s run function lc:champions/leesin/use_r

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[tag=champion,dx=0,tag=!leesin.r.target.temp,tag=!leesin.r.target,tag=champion,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] remove temp_target

    execute if entity @s[distance=..3] if score @s cd_r matches 0 positioned ^ ^ ^0.1 run function lc:champions/leesin/use_r.check
}

function use_w {
    function lc:champion/abilities/cooldown/w
    function lc:champions/leesin/skills/passive.start

    playsound minecraft:leesin.sfx.w1 master @a ~ ~ ~

    function lc:core/motion/interrupt

    ## Recast
    execute if entity @s[team=red] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:60,Tags:["red","leesin.w2.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:60,Tags:["blue","leesin.w2.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    ## Self Shield
    summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:999999,Tags:["shield.all","new"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Tags:["cd"],Duration:40,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID
    scoreboard players set @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all 250
    scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all
    tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new

    ## RED
    execute if entity @s[team=red] run tag @e[tag=temp_target,team=red,type=!#unvalid] add leesin.w.target

    execute if entity @s[team=red] unless entity @e[tag=leesin.w.target,team=red] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["interrupt_by_blink","leesin.w","temp","red","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:5,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=red] if entity @e[tag=leesin.w.target,team=red] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["interrupt_by_blink","leesin.w","temp","red","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[team=red] as @e[tag=leesin.w.target,limit=1,sort=nearest,team=red,type=!#unvalid] at @s anchored feet run summon area_effect_cloud ^ ^0.5 ^ {WaitTime:0,Duration:20,Tags:["red","leesin.w.stop"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    ## BLUE
    execute if entity @s[team=blue] run tag @e[tag=temp_target,team=blue,type=!#unvalid] add leesin.w.target

    execute if entity @s[team=blue] unless entity @e[tag=leesin.w.target,team=blue] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["interrupt_by_blink","leesin.w","temp","blue","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:5,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] if entity @e[tag=leesin.w.target,team=blue] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["interrupt_by_blink","leesin.w","temp","blue","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[team=blue] as @e[tag=leesin.w.target,limit=1,sort=nearest,team=blue,type=!#unvalid] at @s anchored feet run summon area_effect_cloud ^ ^0.5 ^ {WaitTime:0,Duration:20,Tags:["blue","leesin.w.stop"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    tp @e[tag=leesin.w,tag=temp,limit=1,sort=nearest] ~ ~0.5 ~ ~ ~-2
    execute as @e[tag=leesin.w,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
    execute at @e[tag=leesin.w,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=leesin.w,tag=temp,limit=1,sort=nearest] remove temp

    tag @s add update.shield.leesin
}

function use_w.check {
    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target,tag=!leesin] add temp_target

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=temp_target,tag=!leesin] at @s run function lc:champions/leesin/use_w

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=red,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest,tag=!leesin] remove temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target,tag=!leesin] add temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=temp_target,tag=!leesin] at @s run function lc:champions/leesin/use_w

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=blue,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest,tag=!leesin] remove temp_target

    execute if entity @s[distance=..6] if score @s cd_w matches 0 positioned ^ ^ ^0.1 run function lc:champions/leesin/use_w.check
    execute if entity @s[team=red] if score @s cd_w matches 0 unless entity @e[team=red,tag=leesin.w.target] at @s run function lc:champions/leesin/use_w
    execute if entity @s[team=blue] if score @s cd_w matches 0 unless entity @e[team=blue,tag=leesin.w.target] at @s run function lc:champions/leesin/use_w
}

function use_w2 {
    function lc:champions/leesin/skills/passive.start

    playsound minecraft:leesin.sfx.w2 master @a ~ ~ ~

    scoreboard players add @s omnivamp 26

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run kill @e[tag=leesin.w2.cd,tag=<%team%>]
        execute if entity @s[team=<%team%>] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:81,Tags:["leesin.w2","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    }

    particle minecraft:witch ~ ~1 ~ 0.3 0.3 0.3 1 50 force
}

# ---- item: lc:champions/leesin/item/... ----------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]

        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[200001f]},minecraft:custom_name={text:"LeeSin Hair",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[200001f]},minecraft:custom_name={text:"Tóc LeeSin",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[200101f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/leesin/skills/... ------------------------------------------
dir skills {
    function e.damage {
        execute if entity @s[team=red] run damage @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 3 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_magic.deal 135
        scoreboard players operation @s dmg_magic.deal += @s attack_damage

        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=leesin.e.mark,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=red] run execute if entity @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!red] run function lc:champions/leesin/skills/e.damage

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=leesin.e.mark,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=leesin.e.mark,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=blue] run execute if entity @e[tag=leesin.e.mark,tag=temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/leesin/skills/e.damage
    }

