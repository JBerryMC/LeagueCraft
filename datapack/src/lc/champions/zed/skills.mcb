    execute if entity @s[team=blue] run scoreboard players operation @e[tag=zed.r.mark.blue,team=!blue,tag=has_health_bar,limit=1,sort=nearest] zed.r.dmg += @s dmg_physical.deal

    function lc:champion/dmg/calc.debuff

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=zed.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=zed.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run tag @e[team=!red,tag=zed.q.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=red] if entity @e[tag=zed.q.hit,tag=temp_dmg,type=!#unvalid,team=!red] run function lc:champions/zed/skills/q.damage

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=zed.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=zed.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run tag @e[team=!blue,tag=zed.q.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    execute if entity @s[team=blue] if entity @e[tag=zed.q.hit,tag=temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/zed/skills/q.damage
}

