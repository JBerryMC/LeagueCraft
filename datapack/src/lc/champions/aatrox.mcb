    function w.passive {
        tp @s ^ ^ ^1
        particle lava ~ ~ ~ 0 0 0 0 1 force
        particle landing_lava ~ ~ ~ 0.2 0 0.2 1 5 force
        particle dust{color:[0.525,0,0.078],scale:2} ~ ~ ~ 0.2 0 0.2 1 5 force

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!<%team%>,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest] add aatrox.w.target.<%team%>
            execute if entity @s[tag=<%team%>] if entity @e[tag=aatrox.w.target.<%team%>,type=!#unvalid,tag=champion] run function lc:champions/aatrox/skills/w.trigger
            execute if entity @s[tag=<%team%>] if entity @e[tag=aatrox.w.target.<%team%>,type=!#unvalid,tag=!champion] as @p[tag=aatrox,team=<%team%>] run function lc:champions/aatrox/skills/w.damage
            execute if entity @s[tag=<%team%>] if entity @e[tag=aatrox.w.target.<%team%>,type=!#unvalid,tag=!champion] run tag @e[tag=aatrox.w.target.<%team%>,type=!#unvalid,tag=!champion] remove aatrox.w.target.<%team%>
        }
    }

    function w.pull {
        function lc:champion/cc/cancel
        tag @s add airborne
        scoreboard players set @s cc.airborne 5
        # Thrown at the chain's centre, 0.75 blocks per tick.
        execute if entity @s[tag=aatrox.w.target.red] positioned ~ ~0.2 ~ facing entity @e[tag=aatrox.w.chain,tag=red,limit=1] feet run function lc:core/motion/throw {speed:750,ticks:0}
        execute if entity @s[tag=aatrox.w.target.blue] positioned ~ ~0.2 ~ facing entity @e[tag=aatrox.w.chain,tag=blue,limit=1] feet run function lc:core/motion/throw {speed:750,ticks:0}
    }

    function w.trigger {
        playsound aatrox.sfx.w.hit master @a ~ ~ ~

        execute if entity @s[tag=red] as @p[tag=aatrox,team=red] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 2

        execute if entity @s[tag=red] as @p[tag=aatrox,team=red] run function lc:champions/aatrox/skills/w.damage
        execute if entity @s[tag=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:31,Tags:["aatrox.w.chain","red"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:31,Tags:["aatrox.w.rotation"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] as @e[tag=aatrox.w.chain,tag=red] on passengers run data modify entity @s Rotation[0] set from entity @e[tag=aatrox.w,tag=red,limit=1,sort=nearest] Rotation[0]
        execute if entity @s[tag=red] at @e[tag=aatrox.w.chain,tag=red] run summon area_effect_cloud ^ ^ ^2 {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","red","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] at @e[tag=aatrox.w.chain,tag=red] run summon area_effect_cloud ^ ^ ^-2 {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","red","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] at @e[tag=aatrox.w.chain,tag=red] run summon area_effect_cloud ^2 ^ ^ {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","red","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] at @e[tag=aatrox.w.chain,tag=red] run summon area_effect_cloud ^-2 ^ ^ {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","red","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

        execute if entity @s[tag=blue] as @p[tag=aatrox,team=blue] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 2

        execute if entity @s[tag=blue] as @p[tag=aatrox,team=blue] run function lc:champions/aatrox/skills/w.damage
        execute if entity @s[tag=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:31,Tags:["aatrox.w.chain","blue"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:31,Tags:["aatrox.w.rotation"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=blue] as @e[tag=aatrox.w.chain,tag=blue] on passengers run data modify entity @s Rotation[0] set from entity @e[tag=aatrox.w,tag=blue,limit=1,sort=nearest] Rotation[0]
        execute if entity @s[tag=blue] at @e[tag=aatrox.w.chain,tag=blue] run summon area_effect_cloud ^ ^ ^2 {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","blue","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=blue] at @e[tag=aatrox.w.chain,tag=blue] run summon area_effect_cloud ^ ^ ^-2 {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","blue","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=blue] at @e[tag=aatrox.w.chain,tag=blue] run summon area_effect_cloud ^2 ^ ^ {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","blue","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=blue] at @e[tag=aatrox.w.chain,tag=blue] run summon area_effect_cloud ^-2 ^ ^ {WaitTime:0,Duration:31,Tags:["aatrox.w.chain.particle","blue","spin"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

        kill @s
    }
}
