# lc:champions/aatrox/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking aatrox; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.aatrox
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.aatrox
    playsound minecraft:aatrox.select master @s ~ ~ ~
    playsound minecraft:aatrox.sfx.select master @s ~ ~ ~
}

function aa {
    execute if score @s cd_p matches 1.. run playsound aatrox.sfx.aa master @a ~ ~ ~
    execute if score @s cd_p matches 1.. on passengers on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/aa/play

    execute unless entity @e[tag=temp_dmg,tag=lol.structure] if score @s cd_p matches 0 run playsound aatrox.sfx.p.aa master @a ~ ~ ~
    execute unless entity @e[tag=temp_dmg,tag=lol.structure] if score @s cd_p matches 0 on passengers on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/passive/play

    execute if entity @e[tag=temp_dmg,tag=lol.structure] if score @s cd_p matches 0 run playsound aatrox.sfx.aa master @a ~ ~ ~
    execute if entity @e[tag=temp_dmg,tag=lol.structure] if score @s cd_p matches 0 on passengers on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/aa/play
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:aatrox"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:aatrox/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:aatrox/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:aatrox/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:aatrox/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:aatrox/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## p
    execute if score @s cd_p matches 0 run scoreboard players set @s status.p 1
    execute if score @s cd_p matches 1.. run scoreboard players set @s status.p 0

    ## Q
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>,tag=!r.animation,tag=!cced] if score @s cd_q matches 0 if entity @e[tag=aatrox.q.cd,tag=<%team%>] if score @s stack_q matches 0 run scoreboard players set @s status.q 1
        execute if entity @s[team=<%team%>,tag=!r.animation,tag=!cced] if entity @e[tag=aatrox.q.cd,tag=<%team%>] if score @s stack_q matches 1 run scoreboard players set @s status.q 2
        execute if entity @s[team=<%team%>,tag=!r.animation,tag=!cced] if entity @e[tag=aatrox.q.cd,tag=<%team%>] if score @s stack_q matches 2 run scoreboard players set @s status.q 3
    }
    execute if score @s channeling matches 1.. run scoreboard players set @s status.q 9

    ## W
    execute if score @s channeling matches 1.. run scoreboard players set @s status.w 9

    ## E
    execute if score @s cc.root matches 1.. run scoreboard players set @s status.e 9

    ## R
    execute if score @s[tag=!r.animation,tag=!cced] mana matches 1.. run scoreboard players set @s status.r 6
    execute if score @s channeling matches 1.. run scoreboard players set @s status.r 9

    function lc:champions/aatrox/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @p[tag=aatrox,team=red] at @s if score @s stack_p matches 0 if score @s cd_p matches 0 run function lc:champions/aatrox/skills/passive.trigger
    execute as @p[tag=aatrox,team=blue] at @s if score @s stack_p matches 0 if score @s cd_p matches 0 run function lc:champions/aatrox/skills/passive.trigger

    ## Q
    execute as @p[tag=aatrox,team=red] if score @s stack_q matches 1..3 unless entity @e[tag=red,tag=aatrox.q.cd] run function lc:champions/aatrox/skills/q.reset
    execute as @p[tag=aatrox,team=blue] if score @s stack_q matches 1..3 unless entity @e[tag=blue,tag=aatrox.q.cd] run function lc:champions/aatrox/skills/q.reset
    execute as @e[tag=aatrox.q,type=item_display] at @s run function lc:champions/aatrox/skills/q.passive

    ## W
    execute as @e[tag=aatrox.w,type=area_effect_cloud] at @s run function lc:champions/aatrox/skills/w.passive
    execute as @e[tag=aatrox.w.chain,type=area_effect_cloud] at @s run function lc:champions/aatrox/skills/w.chain.passive
    execute as @e[tag=aatrox.w.chain.particle,type=area_effect_cloud] at @s run particle dust_color_transition{from_color:[0.525,0,0.078],scale:1,to_color:[0,0,0]} ~ ~ ~ 0 0 0 0 1 force

    ## E
    execute as @e[tag=aatrox.e,type=item_display] at @s run function lc:champions/aatrox/skills/e.dash

    ## R
    execute as @a[tag=aatrox,tag=aatrox.r] at @s run function lc:champions/aatrox/skills/r.passive
}

function main {
    ## HUD
    function lc:champions/aatrox/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/aatrox/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/aatrox/item/offhand

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r
}

function passive {
    scoreboard players set @s cd_p 24
    scoreboard players remove @s aa.range 10
    scoreboard players set @s stack_p 0

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] as @e[team=!<%team%>,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] at @s run particle item{item:"blaze_powder"} ~ ~1 ~ 0 0 0 0.1 100 force
        execute if entity @s[team=<%team%>] run scoreboard players operation aatrox.p.dmg temp = @e[team=!<%team%>,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] hp.max
    }

    scoreboard players operation aatrox.p.dmg temp *= 12 integer
    scoreboard players operation aatrox.p.dmg temp /= 100 integer

    scoreboard players operation @s dmg_magic.deal = aatrox.p.dmg temp

    execute if entity @s[team=red] run tag @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] add aatrox.p.red
    execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] add aatrox.p.blue
}

function use_e {
    function lc:champion/abilities/cooldown/e
    playsound aatrox.sfx.e master @a ~ ~ ~
    scoreboard players set @s aa.cd 0

    execute if entity @s[team=red] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["interrupt_by_blink","aatrox.e","temp","red","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:6,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["interrupt_by_blink","aatrox.e","temp","blue","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:6,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    function lc:core/motion/face_moving
    execute as @e[tag=aatrox.e,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
    execute at @e[tag=aatrox.e,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=aatrox.e,tag=temp,limit=1,sort=nearest] remove temp
}

function use_q {
    function lc:champion/abilities/cooldown/q
    scoreboard players set @s channeling 12
    scoreboard players add @s stack_q 1
    execute if score @s stack_q matches 4 run scoreboard players set @s stack_q 1

    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:20,Tags:["aatrox.q.delay","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:20,Tags:["aatrox.q.delay","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if score @s stack_q matches 1 run playsound aatrox.sfx.q1 master @a ~ ~ ~
    execute if score @s stack_q matches 2 run playsound aatrox.sfx.q2 master @a ~ ~ ~
    execute if score @s stack_q matches 3 run playsound aatrox.sfx.q3 master @a ~ ~ ~

    execute if score @s stack_q matches 1 run function lc:champions/aatrox/skills/q.spawn.1
    execute if score @s stack_q matches 2 run function lc:champions/aatrox/skills/q.spawn.2
    execute if score @s stack_q matches 3 run function lc:champions/aatrox/skills/q.spawn.3


    execute if score @s stack_q matches 3 run scoreboard players set @s stack_q 0
}

function use_r {
    scoreboard players set @s cd_r 45
    playsound minecraft:aatrox.ultimate master @a ~ ~ ~ 2
    playsound minecraft:aatrox.sfx.r master @a ~ ~ ~ 2

    scoreboard players set @s mana 200
    scoreboard players set @s channeling 5
    scoreboard players add @s aa.range 10
    scoreboard players add @s omnivamp 45

    scoreboard players set @s status.r 6

    scoreboard players set @s fx.invis 200
    scoreboard players set @s status.weapon 9999

    execute if entity @s[team=red] run scoreboard players operation red.aatrox.r.buff temp = @s attack_damage
    execute if entity @s[team=red] run scoreboard players operation red.aatrox.r.buff temp *= 45 integer
    execute if entity @s[team=red] run scoreboard players operation red.aatrox.r.buff temp /= 100 integer

    execute if entity @s[team=red] run scoreboard players operation @s attack_damage += red.aatrox.r.buff temp

    execute if entity @s[team=blue] run scoreboard players operation blue.aatrox.r.buff temp = @s attack_damage
    execute if entity @s[team=blue] run scoreboard players operation blue.aatrox.r.buff temp *= 45 integer
    execute if entity @s[team=blue] run scoreboard players operation blue.aatrox.r.buff temp /= 100 integer

    execute if entity @s[team=blue] run scoreboard players operation @s attack_damage += blue.aatrox.r.buff temp

    particle lava ~ ~1 ~ 0.5 0.5 0.5 1 100 force
    particle campfire_cosy_smoke ~ ~1 ~ 0.5 0.5 0.5 0.2 100 force
    particle crimson_spore ~ ~1 ~ 0 0 0 1 1000 force
    particle block{block_state:"nether_wart_block"} ~ ~1 ~ 1 1 1 1 100 force

    # Aatrox grows: bigger, faster, steps up blocks and jumps higher (it used to be a horse).
    tag @s add aatrox.r
    attribute @s minecraft:scale modifier add lol:aatrox.r 0.5 add_multiplied_base
    attribute @s minecraft:movement_speed modifier add lol:aatrox.r 0.5 add_multiplied_total
    attribute @s minecraft:step_height modifier add lol:aatrox.r 0.5 add_value
    attribute @s minecraft:jump_strength modifier add lol:aatrox.r 0.2 add_value

    # The R model; the plugin mounts it on Aatrox (lc:core/model/wear).
    execute rotated ~ 0 run function animated_java:aatrox/summon
    execute as @e[type=#animated_java:root,tag=aj.aatrox.root,limit=1,sort=nearest] run tag @s add aatrox.r.model
    execute if entity @s[team=red] as @e[type=#animated_java:root,tag=aj.aatrox.root,limit=1,sort=nearest] run tag @s add aatrox.r.model.red
    execute if entity @s[team=blue] as @e[type=#animated_java:root,tag=aj.aatrox.root,limit=1,sort=nearest] run tag @s add aatrox.r.model.blue
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] as @e[type=#animated_java:root,tag=aatrox.r.model.<%team%>,limit=1,sort=nearest] run team join <%team%> @s
        execute if entity @s[team=<%team%>] as @e[type=#animated_java:root,tag=aatrox.r.model.<%team%>,limit=1,sort=nearest] on passengers run team join <%team%> @s
    }
    execute as @e[type=#animated_java:root,tag=aatrox.r.model,limit=1,sort=nearest] run function animated_java:aatrox/animations/r.cast/play
    execute as @e[type=#animated_java:root,tag=aatrox.r.model,limit=1,sort=nearest] on passengers run data modify entity @s teleport_duration set value 1
    function lc:core/model/wear {tag:"aatrox.r.model"}
}

function use_w {
    function lc:champion/abilities/cooldown/w
    scoreboard players set @s channeling 5

    playsound minecraft:aatrox.sfx.w master @a ~ ~ ~
    execute on passengers on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/w/tween_play

    execute if entity @s[team=red] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:10,Tags:["aatrox.w","red","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:10,Tags:["aatrox.w","blue","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    tp @e[tag=aatrox.w,limit=1,sort=nearest] ~ ~ ~ ~ 0
}

# ---- item: lc:champions/aatrox/item/... ----------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]
        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[900001f]},minecraft:custom_name={text:"Aatrox Helmet",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[900001f]},minecraft:custom_name={text:"Sừng Aatrox",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[9999f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/aatrox/skills/... ------------------------------------------
dir skills {
    function e.dash {
        tp @s ^ ^ ^0.75
        particle dust{color:[1,0.6,0],scale:0.5} ^ ^ ^-0.4 0.1 0.2 0.1 1 50 force

        execute if entity @s[tag=red] at @s positioned ~ ~-0.5 ~ as @p[team=red,tag=aatrox] run function lc:core/motion/follow

        execute if entity @s[tag=blue] at @s positioned ~ ~-0.5 ~ as @p[team=blue,tag=aatrox] run function lc:core/motion/follow
    }

    function passive.heal {
        particle heart ~ ~1 ~ 0.2 0.2 0.2 1 5 force
        particle happy_villager ~ ~1 ~ 0.5 0.5 0.5 0.1 20 force

        execute if score @s hp.left < @s hp.max run scoreboard players operation @s hp.left += temp omnivamp

        execute if entity @s[team=red] run tag @e[tag=aatrox.p.red] remove aatrox.p.red
        execute if entity @s[team=blue] run tag @e[tag=aatrox.p.blue] remove aatrox.p.blue
    }

    function passive.trigger {
        playsound aatrox.sfx.p master @a ~ ~ ~
        scoreboard players add @s aa.range 10
        scoreboard players set @s stack_p 1
    }

    function q.damage {
        execute if entity @s[team=red] run damage @e[tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 70
        scoreboard players operation dmg temp = @s attack_damage
        scoreboard players operation dmg temp *= 90 integer
        scoreboard players operation dmg temp /= 100 integer
        scoreboard players operation @s dmg_physical.deal += dmg temp

        execute if score @s stack_q matches 2 run scoreboard players operation @s dmg_physical.deal *= 125 integer
        execute if score @s stack_q matches 2 run scoreboard players operation @s dmg_physical.deal /= 100 integer

        execute if score @s stack_q matches 0 run scoreboard players operation @s dmg_physical.deal *= 15625 integer
        execute if score @s stack_q matches 0 run scoreboard players operation @s dmg_physical.deal /= 10000 integer

        scoreboard players operation dmg temp = @s dmg_physical.deal
        scoreboard players operation dmg temp *= 60 integer
        scoreboard players operation dmg temp /= 100 integer

        execute if entity @s[team=red] as @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] if entity @s[tag=sweetspot] on attacker run scoreboard players operation @s dmg_physical.deal += dmg temp
        execute if entity @s[team=blue] as @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] if entity @s[tag=sweetspot] on attacker run scoreboard players operation @s dmg_physical.deal += dmg temp

        function lc:champion/dmg/calc.debuff

        ## RED
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] as @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] if entity @s[tag=sweetspot] run tag @s remove sweetspot
        execute if entity @s[team=red] run tag @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=red] run execute if entity @e[tag=temp_dmg,type=!#unvalid,team=!red] run function lc:champions/aatrox/skills/q.damage

        ## BLUE
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] as @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] if entity @s[tag=sweetspot] run tag @s remove sweetspot
        execute if entity @s[team=blue] run tag @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=blue] run execute if entity @e[tag=temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/aatrox/skills/q.damage
    }

    function q.end {
        execute if entity @s[tag=q1] run particle lava ^ ^0.2 ^7 0.75 0.2 0.75 0.1 30 force
        execute if entity @s[tag=q1] run particle campfire_cosy_smoke ^ ^0.2 ^3.5 0.75 0.2 0.75 0.1 7 force
        execute if entity @s[tag=q1] positioned ^ ^0.2 ^3.5 rotated ~90 ~ run function lc:champions/aatrox/skills/q.particle.1

        execute if entity @s[tag=q2] run particle lava ^ ^0.2 ^3 1 0 1 0.1 40 force
        execute if entity @s[tag=q2] run particle campfire_cosy_smoke ^ ^0.2 ^2 1 0 1 0.1 10 force
        execute if entity @s[tag=q2] positioned ^ ^0.2 ^1.5 rotated ~90 ~ run function lc:champions/aatrox/skills/q.particle.2

        execute if entity @s[tag=q3] run particle lava ^ ^0.2 ^1.5 0.75 0 0.75 0.1 50 force
        execute if entity @s[tag=q3] run particle campfire_cosy_smoke ^ ^0.2 ^1.5 0.75 0 0.75 0.1 10 force
        execute if entity @s[tag=q3] positioned ^ ^0.2 ^1.5 rotated ~90 ~ run function lc:champions/aatrox/skills/q.particle.3

        ## ----------------------------------------------------------------------------------------------------------------- ##

        ## Q1 area
        execute if entity @s[tag=q1,tag=red] positioned ^ ^ ^6.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=red] positioned ^ ^ ^4.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=red] positioned ^ ^ ^2.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=red] positioned ^ ^ ^0.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=red] positioned ^ ^ ^-0.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg

        ## Q1 sweetspot
        execute if entity @s[tag=q1,tag=red] positioned ^0.5 ^ ^7 positioned ~-0.5 ~ ~-0.5 run tag @e[dx=0,dz=0,dy=3,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot
        execute if entity @s[tag=q1,tag=red] positioned ^-0.5 ^ ^7 positioned ~-0.5 ~ ~-0.5 run tag @e[dx=0,dz=0,dy=3,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot

        ## -------------------- ##

        ## Q2 area
        execute if entity @s[tag=q2,tag=red] positioned ^ ^ ^0.5 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q2,tag=red] positioned ^1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q2,tag=red] positioned ^-1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg

        ## Q2 sweetspot
        execute if entity @s[tag=q2,tag=red] positioned ^ ^ ^3 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot
        execute if entity @s[tag=q2,tag=red] positioned ^1.5 ^ ^3 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot
        execute if entity @s[tag=q2,tag=red] positioned ^-1.5 ^ ^3 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot

        ## -------------------- ##

        ## Q3 area
        execute if entity @s[tag=q3,tag=red] positioned ^ ^ ^1.5 positioned ~-2.5 ~ ~-2.5 run tag @e[dx=4,dz=4,dy=3,team=!red,type=!#unvalid,tag=!unvalid] add temp_dmg

        ## Q3 sweetspot
        execute if entity @s[tag=q3,tag=red] positioned ^ ^ ^1.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot

        execute if entity @s[tag=red] if entity @e[team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] unless entity @e[team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg,tag=sweetspot] as @p[tag=aatrox,team=red] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 2
        execute if entity @s[tag=red] if entity @e[team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg] if entity @e[team=!red,type=!#unvalid,tag=!unvalid,tag=temp_dmg,tag=sweetspot] as @p[tag=aatrox,team=red] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 4
        execute if entity @s[tag=red] as @e[tag=sweetspot,team=!red,type=!#unvalid,tag=temp_dmg,tag=!unvalid] at @s run function lc:champions/aatrox/skills/q.knockup
        execute if entity @s[tag=red] as @p[tag=aatrox,team=red] run function lc:champions/aatrox/skills/q.damage

        ## ----------------------------------------------------------------------------------------------------------------- ##

        ## Q1 area
        execute if entity @s[tag=q1,tag=blue] positioned ^ ^ ^6.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=blue] positioned ^ ^ ^4.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=blue] positioned ^ ^ ^2.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=blue] positioned ^ ^ ^0.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q1,tag=blue] positioned ^ ^ ^-0.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg

        ## Q1 sweetspot
        execute if entity @s[tag=q1,tag=blue] positioned ^0.5 ^ ^7 positioned ~-0.5 ~ ~-0.5 run tag @e[dx=0,dz=0,dy=3,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot
        execute if entity @s[tag=q1,tag=blue] positioned ^-0.5 ^ ^7 positioned ~-0.5 ~ ~-0.5 run tag @e[dx=0,dz=0,dy=3,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot

        ## -------------------- ##

        ## Q2 area
        execute if entity @s[tag=q2,tag=blue] positioned ^ ^ ^0.5 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q2,tag=blue] positioned ^1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg
        execute if entity @s[tag=q2,tag=blue] positioned ^-1 ^ ^2 positioned ~-1.5 ~ ~-1.5 run tag @e[dx=2,dz=2,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg

        ## Q2 sweetspot
        execute if entity @s[tag=q2,tag=blue] positioned ^ ^ ^3 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot
        execute if entity @s[tag=q2,tag=blue] positioned ^1.5 ^ ^3 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot
        execute if entity @s[tag=q2,tag=blue] positioned ^-1.5 ^ ^3 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot

        ## -------------------- ##

        ## Q3 area
        execute if entity @s[tag=q3,tag=blue] positioned ^ ^ ^1.5 positioned ~-2.5 ~ ~-2.5 run tag @e[dx=4,dz=4,dy=3,team=!blue,type=!#unvalid,tag=!unvalid] add temp_dmg

        ## Q3 sweetspot
        execute if entity @s[tag=q3,tag=blue] positioned ^ ^ ^1.5 positioned ~-1 ~ ~-1 run tag @e[dx=1,dz=1,dy=3,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] add sweetspot

        execute if entity @s[tag=blue] if entity @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] unless entity @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg,tag=sweetspot] as @p[tag=aatrox,team=blue] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 2
        execute if entity @s[tag=blue] if entity @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg] if entity @e[team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_dmg,tag=sweetspot] as @p[tag=aatrox,team=blue] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 4
        execute if entity @s[tag=blue] as @e[tag=sweetspot,team=!blue,type=!#unvalid,tag=temp_dmg,tag=!unvalid] at @s run function lc:champions/aatrox/skills/q.knockup
        execute if entity @s[tag=blue] as @p[tag=aatrox,team=blue] run function lc:champions/aatrox/skills/q.damage
    }

    function q.knockup {
        function lc:champion/cc/cancel
        tag @s add airborne
        scoreboard players set @s cc.airborne 5
        function lc:core/motion/push {x:0,y:283,z:0,ticks:0}
    }

