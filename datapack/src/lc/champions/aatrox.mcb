    function q.passive {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] if score @p[tag=aatrox,team=<%team%>] mana matches 0 positioned as @p[tag=aatrox,team=<%team%>] run tp @s ~ ~ ~
            execute if entity @s[tag=<%team%>] if score @p[tag=aatrox,team=<%team%>] mana matches 1.. positioned as @e[tag=aatrox.r,team=<%team%>] run tp @s ~ ~ ~
        }

        execute unless data entity @s Passengers[{Tags:["cd"]}] run function lc:champions/aatrox/skills/q.end
    }

    function q.reset {
        scoreboard players set @s stack_q 0
    }

    function q.spawn.1 {
        playsound aatrox.sfx.q1 master @a ~ ~ ~

        execute on passengers on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/q1/play

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run kill @e[tag=aatrox.q.cd,tag=<%team%>]
            execute if entity @s[team=<%team%>] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:80,Tags:["<%team%>","aatrox.q.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        }

        execute if entity @s[team=red] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900101f]}}},item_display:"head",Tags:["temp","q1","red","aatrox.q","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900101f]}}},item_display:"head",Tags:["temp","q1","blue","aatrox.q","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        tp @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] ~ ~ ~ ~ 0
        execute as @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
        execute at @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        tag @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] remove temp
    }

    function q.spawn.2 {
        playsound aatrox.sfx.q2 master @a ~ ~ ~
        execute on passengers on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/q2/play

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run kill @e[tag=aatrox.q.cd,tag=<%team%>]
            execute if entity @s[team=<%team%>] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:80,Tags:["<%team%>","aatrox.q.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        }

        execute if entity @s[team=red] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900102f]}}},item_display:"head",Tags:["temp","aatrox.q","q2","red","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900102f]}}},item_display:"head",Tags:["temp","aatrox.q","q2","blue","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        tp @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] ~ ~ ~ ~ 0
        execute as @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
        execute at @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        tag @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] remove temp
    }

    function q.spawn.3 {
        playsound aatrox.sfx.q3 master @a ~ ~ ~
        execute on passengers on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/q3/play

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run kill @e[tag=aatrox.q.cd,tag=<%team%>]
            execute if entity @s[team=<%team%>] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:80,Tags:["<%team%>","aatrox.q.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        }

        execute if entity @s[team=red] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900103f]}}},item_display:"head",Tags:["temp","aatrox.q","q3","red","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900103f]}}},item_display:"head",Tags:["temp","aatrox.q","q3","blue","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        tp @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] ~ ~ ~ ~ 0
        execute as @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
        execute at @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        tag @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] remove temp
    }

    function r.end {
        tag @s remove aatrox.r
        execute if entity @s[team=red] as @e[type=#animated_java:root,tag=aatrox.r.model.red] at @s run function animated_java:aatrox/remove/this
        execute if entity @s[team=blue] as @e[type=#animated_java:root,tag=aatrox.r.model.blue] at @s run function animated_java:aatrox/remove/this

        attribute @s minecraft:scale modifier remove lol:aatrox.r
        attribute @s minecraft:movement_speed modifier remove lol:aatrox.r
        attribute @s minecraft:step_height modifier remove lol:aatrox.r
        attribute @s minecraft:jump_strength modifier remove lol:aatrox.r

        scoreboard players set @s status.weapon 900101
        scoreboard players operation @s[team=red] attack_damage -= red.aatrox.r.buff temp
        scoreboard players operation @s[team=blue] attack_damage -= blue.aatrox.r.buff temp
        scoreboard players remove @s aa.range 10
        scoreboard players remove @s omnivamp 45
        gamemode spectator @s[tag=dead]
    }

    function r.extend {
        stopsound @a master aatrox.sfx.r
        playsound minecraft:aatrox.sfx.r master @a ~ ~ ~ 2

        scoreboard players add @s mana 100
        scoreboard players add @s fx.invis 100
        execute if score @s fx.invis matches 200.. run scoreboard players set @s fx.invis 200

        particle lava ~ ~1 ~ 0.5 0.5 0.5 1 100 force
        particle campfire_cosy_smoke ~ ~1 ~ 0.5 0.5 0.5 0.2 100 force
        particle crimson_spore ~ ~1 ~ 0 0 0 1 1000 force
        particle block{block_state:"nether_wart_block"} ~ ~1 ~ 1 1 1 1 100 force

        effect give @s speed 10 4 true
    }

    function r.passive {
        particle smoke ~ ~1 ~ 0.5 1 0.5 0.01 10 force
        particle falling_lava ~ ~ ~ 0.5 0.2 0.5 0 5 force
        particle lava ~ ~ ~ 0.2 0.2 0.2 0 1 force

        execute if score @s mana matches 1.. run scoreboard players remove @s mana 1
        execute if score @s mana matches 0 run function lc:champions/aatrox/skills/r.end
    }

    function w.chain.link {
        particle dust{color:[1,0.6,0],scale:1} ~ ~ ~ 0 0 0 1 1 force
        execute if entity @s[tag=red] positioned ~-0.5 ~-0.5 ~-0.5 unless entity @e[tag=aatrox.w.target.red,dx=0] positioned ~0.5 ~0.5 ~0.5 positioned ^ ^ ^0.1 run function lc:champions/aatrox/skills/w.chain.link
        execute if entity @s[tag=blue] positioned ~-0.5 ~-0.5 ~-0.5 unless entity @e[tag=aatrox.w.target.blue,dx=0] positioned ~0.5 ~0.5 ~0.5 positioned ^ ^ ^0.1 run function lc:champions/aatrox/skills/w.chain.link
    }

    function w.chain.passive {
        tp @s ~ ~ ~ ~-12 0
        particle lava ~ ~ ~ 0 0 0 1 2 force
        particle dust_color_transition{from_color:[0.525,0,0.078],scale:2,to_color:[0,0,0]} ^ ^ ^2 0 0 0 1 1 force
        particle dust_color_transition{from_color:[0.525,0,0.078],scale:2,to_color:[0,0,0]} ^ ^ ^-2 0 0 0 1 1 force
        particle dust_color_transition{from_color:[0.525,0,0.078],scale:2,to_color:[0,0,0]} ^2 ^ ^ 0 0 0 1 1 force
        particle dust_color_transition{from_color:[0.525,0,0.078],scale:2,to_color:[0,0,0]} ^-2 ^ ^ 0 0 0 1 1 force

        execute as @e[tag=aatrox.w.chain.particle] at @s run particle dust_color_transition{from_color:[0.525,0,0.078],scale:2,to_color:[1,0.6,0]} ~ ~ ~ 0 0 0 0 1 force
        execute as @e[tag=aatrox.w.chain.particle] at @s run particle landing_lava ~ ~ ~ 0.2 0 0.2 0 3 force

        execute on passengers rotated as @s positioned ^ ^ ^2 rotated ~90 ~ run function lc:champions/aatrox/skills/w.particle

        execute if entity @s[tag=red] on passengers rotated as @s on vehicle positioned ^ ^ ^-2 positioned ~-2.5 ~-20 ~-2.5 unless entity @e[tag=aatrox.w.target.red,dx=4,dz=4,dy=40] positioned ~2.5 ~20 ~2.5 positioned ^ ^ ^2 positioned ^ ^ ^5 positioned ~-2.5 ~-20 ~-2.5 unless entity @e[tag=aatrox.w.target.red,dx=4,dz=4,dy=40] positioned ~2.5 ~20 ~2.5 positioned ^ ^ ^-5 positioned ^ ^ ^1 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.red,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^ ^ ^-1 positioned ^2 ^ ^ positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.red,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^-2 ^ ^ positioned ^3 ^ ^3 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.red,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^-3 ^ ^-3 positioned ^4 ^ ^6 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.red,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^-4 ^ ^-6 positioned ^-2 ^ ^ positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.red,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^2 ^ ^ positioned ^-3 ^ ^3 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.red,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^3 ^ ^-3 positioned ^-4 ^ ^6 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.red,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^4 ^ ^-6 run tag @e[tag=aatrox.w.target.red] remove aatrox.w.target.red

        execute if entity @s[tag=red] as @e[tag=aatrox.w.chain.particle,tag=red,tag=spin] at @s facing entity @e[tag=aatrox.w.chain,tag=red,limit=1,sort=nearest] feet run tp @s ^0.2 ^ ^0.09

        execute if entity @s[tag=red] run effect give @e[tag=aatrox.w.target.red,limit=1] slowness 1 1 false
        execute if entity @s[tag=red] facing entity @e[tag=aatrox.w.target.red,limit=1] eyes run function lc:champions/aatrox/skills/w.chain.link

        execute if entity @s[tag=red] unless entity @e[tag=aatrox.w.target.red] run function lc:champions/aatrox/skills/w.end

        execute if entity @s[tag=red,nbt={Age:30}] run function lc:champions/aatrox/skills/w.end

        execute if entity @s[tag=blue] on passengers rotated as @s on vehicle positioned ^ ^ ^-2 positioned ~-2.5 ~-20 ~-2.5 unless entity @e[tag=aatrox.w.target.blue,dx=4,dz=4,dy=40] positioned ~2.5 ~20 ~2.5 positioned ^ ^ ^2 positioned ^ ^ ^5 positioned ~-2.5 ~-20 ~-2.5 unless entity @e[tag=aatrox.w.target.blue,dx=4,dz=4,dy=40] positioned ~2.5 ~20 ~2.5 positioned ^ ^ ^-5 positioned ^ ^ ^1 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.blue,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^ ^ ^-1 positioned ^2 ^ ^ positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.blue,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^-2 ^ ^ positioned ^3 ^ ^3 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.blue,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^-3 ^ ^-3 positioned ^4 ^ ^6 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.blue,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^-4 ^ ^-6 positioned ^-2 ^ ^ positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.blue,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^2 ^ ^ positioned ^-3 ^ ^3 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.blue,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^3 ^ ^-3 positioned ^-4 ^ ^6 positioned ~-1.5 ~-20 ~-1.5 unless entity @e[tag=aatrox.w.target.blue,dx=2,dz=2,dy=40] positioned ~1.5 ~20 ~1.5 positioned ^4 ^ ^-6 run tag @e[tag=aatrox.w.target.blue] remove aatrox.w.target.blue

        execute if entity @s[tag=blue] as @e[tag=aatrox.w.chain.particle,tag=blue,tag=spin] at @s facing entity @e[tag=aatrox.w.chain,tag=blue,limit=1,sort=nearest] feet run tp @s ^0.2 ^ ^0.09

        execute if entity @s[tag=blue] run effect give @e[tag=aatrox.w.target.blue,limit=1] slowness 1 1 false
        execute if entity @s[tag=blue] facing entity @e[tag=aatrox.w.target.blue,limit=1] eyes run function lc:champions/aatrox/skills/w.chain.link

        execute if entity @s[tag=blue] unless entity @e[tag=aatrox.w.target.blue] run function lc:champions/aatrox/skills/w.end

        execute if entity @s[tag=blue,nbt={Age:30}] run function lc:champions/aatrox/skills/w.end
    }

    function w.damage {
        execute if entity @s[team=red] run damage @e[tag=aatrox.w.target.red,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_magic by @s
        execute if entity @s[team=blue] run damage @e[tag=aatrox.w.target.blue,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_magic by @s

        scoreboard players set @s dmg_magic.deal 70

        scoreboard players operation dmg temp = @s attack_damage
        scoreboard players operation dmg temp *= 40 integer
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_magic.deal += dmg temp

        function lc:champion/dmg/calc.debuff
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=aatrox.w.target.<%team%>,tag=has_health_bar,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=aatrox.w.target.<%team%>,tag=has_health_bar,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
        }
    }

    function w.end {
        execute if entity @s[tag=red] on passengers run kill @s
        execute if entity @s[tag=red] run kill @e[tag=aatrox.w.particle,tag=red]
        execute if entity @s[tag=red] unless entity @e[tag=aatrox.w.target.red] run stopsound @a master aatrox.sfx.w.hit

        execute if entity @s[tag=red] as @e[tag=aatrox.w.target.red,type=!#unvalid,tag=champion] at @s run function lc:champions/aatrox/skills/w.pull
        execute if entity @s[tag=red] as @p[tag=aatrox,team=red] run function lc:champions/aatrox/skills/w.damage
        execute if entity @s[tag=red] run effect clear @e[tag=aatrox.w.target.red] slowness
        execute if entity @s[tag=red] run tag @e[tag=aatrox.w.target.red] remove aatrox.w.target.red

        execute if entity @s[tag=blue] on passengers run kill @s
        execute if entity @s[tag=blue] run kill @e[tag=aatrox.w.particle,tag=blue]
        execute if entity @s[tag=blue] unless entity @e[tag=aatrox.w.target.blue] run stopsound @a master aatrox.sfx.w.hit

        execute if entity @s[tag=blue] as @e[tag=aatrox.w.target.blue,type=!#unvalid,tag=champion] at @s run function lc:champions/aatrox/skills/w.pull
        execute if entity @s[tag=blue] as @p[tag=aatrox,team=blue] run function lc:champions/aatrox/skills/w.damage
        execute if entity @s[tag=blue] run effect clear @e[tag=aatrox.w.target.blue] slowness
        execute if entity @s[tag=blue] run tag @e[tag=aatrox.w.target.blue] remove aatrox.w.target.blue

        kill @s
    }

