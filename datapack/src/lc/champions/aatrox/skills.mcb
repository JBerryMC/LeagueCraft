function q.passive {
    execute if entity @s[tag=red] if score @p[tag=aatrox,team=red] mana matches 0 positioned as @p[tag=aatrox,team=red] run tp @s ~ ~ ~
    execute if entity @s[tag=red] if score @p[tag=aatrox,team=red] mana matches 1.. positioned as @e[tag=aatrox.r,team=red] run tp @s ~ ~ ~

    execute if entity @s[tag=blue] if score @p[tag=aatrox,team=blue] mana matches 0 positioned as @p[tag=aatrox,team=blue] run tp @s ~ ~ ~
    execute if entity @s[tag=blue] if score @p[tag=aatrox,team=blue] mana matches 1.. positioned as @e[tag=aatrox.r,team=blue] run tp @s ~ ~ ~

    execute unless data entity @s Passengers[{Tags:["cd"]}] run function lc:champions/aatrox/skills/q.end
}

function q.reset {
    scoreboard players set @s stack_q 0
}

function q.spawn.1 {
    playsound aatrox.sfx.q1 master @a ~ ~ ~

    execute on vehicle as @s[tag=aatrox.r] on passengers as @s[tag=aj.aatrox.root,type=#animated_java:root] run function animated_java:aatrox/animations/q1/play

    execute if entity @s[team=red] run kill @e[tag=aatrox.q.cd,tag=red]
    execute if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {Duration:80,Tags:["red","aatrox.q.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[team=blue] run kill @e[tag=aatrox.q.cd,tag=blue]
    execute if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {Duration:80,Tags:["blue","aatrox.q.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    execute if entity @s[team=red] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900101f]}}},item_display:"head",Tags:["temp","q1","red","aatrox.q","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] run summon item_display ~ ~ ~ {teleport_duration:1,item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[900101f]}}},item_display:"head",Tags:["temp","q1","blue","aatrox.q","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Duration:12,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    tp @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] ~ ~ ~ ~ 0
    execute as @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
    execute at @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=aatrox.q,tag=temp,limit=1,sort=nearest] remove temp
}

