# lc:champions/yasuo/  (converted from the 1.20.2 LeagueCraft datapack)

# What's special about picking yasuo; the stats are in settings.mcb.
function pick {
    execute if score .world lang matches 0 as @s run function lc:core/lang/champion/eng.yasuo
    execute if score .world lang matches 1 as @s run function lc:core/lang/champion/vie.yasuo
    playsound minecraft:yasuo.select master @a ~ ~ ~
    playsound minecraft:yasuo.sfx.select master @a ~ ~ ~
}

function aa {
    playsound yasuo.sfx.aa master @a ~ ~ ~
}

function hud {
    $title @s actionbar ["",{translate:"space.-60"},{text:"i",font:"minecraft:yasuo"},{translate:"space.16"},{score:{name:"@s",objective:"status.p"},font:"lol:yasuo/p"},{translate:"space.5"},{score:{name:"@s",objective:"status.q"},font:"lol:yasuo/q"},{translate:"space.6"},{score:{name:"@s",objective:"status.w"},font:"lol:yasuo/w"},{translate:"space.6"},{score:{name:"@s",objective:"status.e"},font:"lol:yasuo/e"},{translate:"space.6"},{score:{name:"@s",objective:"status.r"},font:"lol:yasuo/r"},{translate:"space.9"},{score:{name:"@s",objective:"status.spell.1"},font:"minecraft:lol"},{translate:"space.5"},{score:{name:"@s",objective:"status.spell.2"},font:"minecraft:lol"},{translate:"space.-253"},{text:"M",font:"minecraft:lol"},{translate:"space.-274"},{score:{name:"@s",objective:"status.hotbar"},font:"minecraft:hotbar"},{translate:"space.-207"},{storage:"lol:main",nbt:"hp.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:hp_display"},{translate:"space.-252"},{storage:"lol:main",nbt:"mana.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:mana_display"},{translate:"space.-183"},{score:{name:"@s",objective:"cd_p"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.passive"},font:"space:default"},{score:{name:"@s",objective:"cd_q"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.q"},font:"space:default"},{score:{name:"@s",objective:"cd_w"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.w"},font:"space:default"},{score:{name:"@s",objective:"cd_e"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.e"},font:"space:default"},{score:{name:"@s",objective:"cd_r"},font:"minecraft:custom/cd"},{score:{name:"@s",objective:"space.r"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.1"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.1"},font:"space:default"},{score:{name:"@s",objective:"cd_spell.2"},font:"minecraft:custom/passive"},{score:{name:"@s",objective:"space.spell.2"},font:"space:default"},{translate:"space.-138"},{score:{name:"@s",objective:"space.hp1"},font:"space:default"},{score:{name:"@s",objective:"hp.left"},font:"minecraft:custom/hp"},{text:"/",font:"minecraft:custom/hp"},{score:{name:"@s",objective:"hp.max"},font:"minecraft:custom/hp"},{score:{name:"@s",objective:"space.hp2"},font:"space:default"},{translate:"space.-78"},{score:{name:"@s",objective:"space.mana1"},font:"space:default"},{score:{name:"@s",objective:"mana"},font:"minecraft:custom/mana"},{text:"/",font:"minecraft:custom/mana"},{score:{name:"@s",objective:"mana.max"},font:"minecraft:custom/mana"},{score:{name:"@s",objective:"space.mana2"},font:"space:default"},{translate:"space.-112"},{storage:"lol:main",nbt:"keybind.q.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.24"},{storage:"lol:main",nbt:"keybind.w.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.e.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.22"},{storage:"lol:main",nbt:"keybind.r.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true,font:"minecraft:custom/keybind",bold:true,color:"#ffd821"},{translate:"space.25"},{nbt:"keybind.d.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",storage:"lol:main",interpret:true},{translate:"space.18"},{keybind:"key.swapOffhand",font:"minecraft:custom/keybind_small",bold:true,color:"#ffd821"},{storage:"lol:main",nbt:"crosshair.$(uuid1).$(uuid2).$(uuid3).$(uuid4)",interpret:true}]
}

function hud_display {
    function lc:champion/hud

    ## Q
    execute if entity @s[tag=!full_p] run scoreboard players set @s status.p 0
    execute if entity @s[tag=full_p] run scoreboard players set @s status.p 1
    execute if score @s[tag=!full_q,tag=!cced,tag=!r.animation] cd_q matches 0 run scoreboard players set @s status.q 1
    execute if score @s[tag=full_q,tag=!cced,tag=!r.animation] cd_q matches 0 run scoreboard players set @s status.q 2
    execute if score @s[tag=!full_q,tag=!cced,tag=!r.animation] cd_q matches 1.. run scoreboard players set @s status.q 0
    execute if score @s[tag=full_q,tag=!cced,tag=!r.animation] cd_q matches 1.. run scoreboard players set @s status.q 7

    ## E
    execute if score @s cc.root matches 1.. run scoreboard players set @s status.e 9

    ## R
    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if score @s[tag=!cced,team=<%team%>,tag=!r.animation] cd_r matches 0 if entity @e[tag=champion,distance=..20,tag=champion,tag=airborne,team=!<%team%>,tag=!unvalid,type=!#unvalid] run scoreboard players set @s status.r 1
        execute if score @s[tag=!cced,team=<%team%>,tag=!r.animation] cd_r matches 0 unless entity @e[tag=champion,distance=..20,tag=champion,tag=airborne,team=!<%team%>,tag=!unvalid,type=!#unvalid] run scoreboard players set @s status.r 0
    }

    execute if score @s cc.root matches 1.. run scoreboard players set @s status.r 9

    function lc:champions/yasuo/hud with entity @s Inventory[{Slot:4b}].components."minecraft:custom_data"
}

function loop {
    execute as @e[tag=yasuo.q.stackcd,type=minecraft:area_effect_cloud] at @s run function lc:champions/yasuo/skills/q.stack
    execute as @e[tag=yasuo.q.tornado,type=minecraft:item_display] at @s run function lc:champions/yasuo/skills/q.tornado.passive

    execute as @e[tag=yasuo.w.passive,type=minecraft:area_effect_cloud] at @s run function lc:champions/yasuo/skills/w.passive

    execute as @e[tag=yasuo.e,type=minecraft:item_display] at @s run function lc:champions/yasuo/skills/e.dash
    execute as @e[tag=yasuo.e.particle,type=minecraft:area_effect_cloud] at @s run function lc:champions/yasuo/skills/e.dash_q.particle
    #execute as @e[tag=yasuo.e.tornado,type=minecraft:item_display] at @s run function lc:champions/yasuo/skills/e.dash_q.tornado

    execute as @e[tag=yasuo.r.lock,type=minecraft:area_effect_cloud] at @s run function lc:champions/yasuo/skills/r.animation
    execute as @e[tag=yasuo.r.particle,type=minecraft:armor_stand] at @s run function lc:champions/yasuo/skills/r.particle
}

function main {
    ## Cooldown
    function lc:champions/yasuo/hud_display

    ## Item Handling
    execute unless predicate lc:champion/slot/head run function lc:champions/yasuo/item/headwear
    execute unless predicate lc:champion/slot/offhand run function lc:champions/yasuo/item/offhand

    ## Passive
    function lc:champions/yasuo/passive

    ## Re-use
    execute if predicate lc:champion/hold_q if score @s use_ability matches 1.. run function lc:champion/abilities/use_q
    execute if predicate lc:champion/hold_w if score @s use_ability matches 1.. run function lc:champion/abilities/use_w
    execute if predicate lc:champion/hold_e if score @s use_ability matches 1.. run function lc:champion/abilities/use_e
    execute if predicate lc:champion/hold_r if score @s use_ability matches 1.. run function lc:champion/abilities/use_r

    ## First use
    execute if predicate lc:champion/use_q run function lc:champion/abilities/use_q

    execute if predicate lc:champion/use_w run function lc:champion/abilities/use_w

    execute if predicate lc:champion/use_e run function lc:champion/abilities/use_e

    execute if predicate lc:champion/use_r run function lc:champion/abilities/use_r
    execute if entity @s[tag=yasuo.r.buff,team=red] unless entity @e[tag=yasuo.r.buff,tag=red] run function lc:champions/yasuo/skills/r.buff.end
    execute if entity @s[tag=yasuo.r.buff,team=blue] unless entity @e[tag=yasuo.r.buff,tag=blue] run function lc:champions/yasuo/skills/r.buff.end
    execute as @s unless entity @s[nbt={SelectedItem:{id:"minecraft:phantom_membrane"}}] run function lc:champions/yasuo/set_item
}

function passive {
    execute store result score .x pos_x1 run data get entity @s Pos[0] 100.0
    execute store result score .z pos_z1 run data get entity @s Pos[2] 100.0

    scoreboard players operation .vx pos_y1 = .x pos_x1
    scoreboard players operation .vx pos_y1 -= @s pos_x1
    scoreboard players operation .vz pos_y1 = .z pos_z1
    scoreboard players operation .vz pos_y1 -= @s pos_z1
    scoreboard players set .v pos_y1 0
    execute unless score .vx pos_y1 matches 0 run scoreboard players set .v pos_y1 1
    execute unless score .vz pos_y1 matches 0 run scoreboard players set .v pos_y1 1

    execute if score .v pos_y1 matches 0 run scoreboard players set @s pos_y1 1
    execute unless score .v pos_y1 matches 0 run scoreboard players set @s pos_y1 2

    execute if score @s pos_y1 matches 2 run scoreboard players add @s mana 1
    execute if score @s mana matches 500.. run scoreboard players set @s mana 500
    execute if score @s mana matches 500.. run tag @s[tag=!full_p] add full_p

    scoreboard players operation @s pos_x1 = .x pos_x1
    scoreboard players operation @s pos_z1 = .z pos_z1
}

function use_e {
    function lc:champion/abilities/cooldown/e
    playsound minecraft:yasuo.sfx.e master @a ~ ~ ~

    execute if entity @s[team=red] run tag @e[tag=temp_target,team=!red,type=!#unvalid] add yasuo.e.target
    execute if entity @s[team=red] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["yasuo.e","temp","red","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[team=red] rotated ~ -2 run tp @e[tag=yasuo.e,tag=temp,limit=1,sort=nearest] ~ ~0.5 ~ ~ ~

    execute if entity @s[team=blue] run tag @e[tag=temp_target,team=!blue,type=!#unvalid] add yasuo.e.target
    execute if entity @s[team=blue] run summon minecraft:item_display ~ ~0.5 ~ {teleport_duration:1,interpolation_duration:10,Tags:["yasuo.e","temp","blue","dash","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute if entity @s[team=blue] rotated ~ -2 run tp @e[tag=yasuo.e,tag=temp,limit=1,sort=nearest] ~ ~0.5 ~ ~ ~

    execute as @e[tag=yasuo.e,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
    execute at @e[tag=yasuo.e,tag=temp,limit=1,sort=nearest] run data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
    tag @e[tag=yasuo.e,tag=temp,limit=1,sort=nearest] remove temp
}

function use_e.check {
    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!red,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target] add temp_target

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_target] at @s run function lc:champions/yasuo/use_e

    execute if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!red,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] remove temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!blue,type=!#unvalid,tag=!unvalid,limit=1,sort=nearest,tag=!temp_target] add temp_target

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[dx=0,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_target] at @s run function lc:champions/yasuo/use_e

    execute if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!blue,type=!#unvalid,tag=!unvalid,tag=temp_target,limit=1,sort=nearest] remove temp_target

    execute if entity @s[distance=..6] if score @s cd_e matches 0 positioned ^ ^ ^0.1 run function lc:champions/yasuo/use_e.check
    #particle flame ~ ~ ~ 0 0 0 0 1 force
}

function use_q {
    function lc:champion/abilities/cooldown/q_aa.spd
    scoreboard players set @s channeling 5

    tag @s remove yasuo.in_e
    execute if function lc:core/motion/in_dash run tag @s add yasuo.in_e
    execute if entity @s[tag=yasuo.in_e] run function lc:core/motion/tag_dash {tag:"q_buffer"}
    execute if entity @s[tag=yasuo.in_e] if score @s[tag=full_q] stack_q matches 2 run function lc:core/motion/tag_dash {tag:"full_q"}

    execute unless entity @s[tag=yasuo.in_e] if score @s[tag=full_q] stack_q matches 2 run function lc:champions/yasuo/skills/q.tornado.spawn

    execute unless entity @s[tag=yasuo.in_e] if score @s stack_q matches 0..1 anchored eyes positioned ^ ^ ^0.5 run function lc:champions/yasuo/skills/q.particle
    execute unless entity @s[tag=yasuo.in_e] if score @s stack_q matches 0..1 anchored eyes positioned ^ ^ ^1.5 run function lc:champions/yasuo/skills/q.check

    execute unless entity @s[tag=yasuo.in_e] if score @s stack_q matches 0..1 run playsound yasuo.sfx.q0 master @a ~ ~ ~
    execute unless entity @s[tag=yasuo.in_e] if score @s[tag=full_q] stack_q matches 2 run playsound yasuo.sfx.q1 master @a ~ ~ ~

    execute unless entity @s[tag=yasuo.in_e] if score @s[tag=!full_q] stack_q matches 2 run scoreboard players set @s stack_q 0
}

function use_r {
    function lc:champion/abilities/cooldown/r

    playsound minecraft:yasuo.ultimate master @a ~ ~ ~
    playsound minecraft:yasuo.sfx.r master @a ~ ~ ~
    scoreboard players set @s mana 500
    scoreboard players set @s stack_q 0
    tag @s add r.animation
    effect give @s minecraft:levitation 1 0 true
    effect give @s speed 1 1 true

    REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
        execute if entity @s[team=<%team%>] run tag @e[tag=champion,tag=airborne,distance=..20,team=!<%team%>,type=!#unvalid] add yasuo.r.target
        execute if entity @s[team=<%team%>] run scoreboard players set @e[tag=airborne,tag=yasuo.r.target,team=!<%team%>,type=!#unvalid] cc.airborne 20
        execute if entity @s[team=<%team%>] as @e[tag=airborne,tag=yasuo.r.target,team=!<%team%>,type=!#unvalid] run function lc:core/motion/push {x:0,y:0,z:0,ticks:20}
        execute if entity @s[team=<%team%>] as @e[tag=airborne,limit=1,sort=nearest,team=!<%team%>] at @s run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:20,Tags:["yasuo.r.lock","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[team=<%team%>] run data modify entity @e[tag=yasuo.r.lock,type=minecraft:area_effect_cloud,tag=<%team%>,limit=1,sort=nearest] Owner set from entity @s UUID
        execute as @e[tag=yasuo.r.lock,type=minecraft:area_effect_cloud,tag=<%team%>] at @s facing entity @p[tag=r.animation,team=<%team%>,tag=yasuo] eyes rotated ~ 0 run tp @s ~ ~ ~ ~ ~
    }
}

function use_w {
    function lc:champion/abilities/cooldown/w

    playsound minecraft:yasuo.sfx.w master @a ~ ~ ~
    execute if entity @s[team=red] rotated ~ 0 run summon minecraft:area_effect_cloud ^ ^ ^2 {WaitTime:0,Duration:80,Tags:["yasuo.w.passive","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[team=blue] rotated ~ 0 run summon minecraft:area_effect_cloud ^ ^ ^2 {WaitTime:0,Duration:80,Tags:["yasuo.w.passive","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}

    tp @e[tag=yasuo.w.passive,limit=1,sort=nearest] ^ ^ ^2 ~ 0
}

tag entity_types block_by_windwall {
    minecraft:arrow
    minecraft:spectral_arrow
    minecraft:snowball
    minecraft:small_fireball
    minecraft:fireball
    minecraft:wither_skull
    minecraft:shulker_bullet
}

# ---- item: lc:champions/yasuo/item/... -----------------------------------------------
dir item {
    function headwear {
        clear @s iron_sword[minecraft:custom_data~{lol_item:1}]
        execute if score .world lang matches 0 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[100001f]},minecraft:custom_name={text:"Yasuo Hair",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
        execute if score .world lang matches 1 run item replace entity @s armor.head with minecraft:iron_sword[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[100001f]},minecraft:custom_name={text:"Tóc Yasuo",italic:false},minecraft:custom_data={lol_item:1,kill_item:1}]
    }

    function offhand {
        clear @s carrot_on_a_stick[minecraft:custom_data~{lol_item:1}]
        tag @s remove offhand_temp

        item replace entity @s weapon.offhand with minecraft:carrot_on_a_stick[minecraft:tooltip_display={hidden_components:["minecraft:enchantments","minecraft:attribute_modifiers","minecraft:unbreakable","minecraft:can_break","minecraft:can_place_on","minecraft:stored_enchantments"]},minecraft:unbreakable={},minecraft:custom_model_data={floats:[100001f]},minecraft:custom_name={text:".",color:"#1b0c1b"},minecraft:custom_data={lol_item:1,kill_item:1,offhand:1}]
    }
}

# ---- skills: lc:champions/yasuo/skills/... -------------------------------------------
dir skills {
    function e.damage {
        execute if entity @s[team=red] run damage @e[tag=yasuo.e.target,type=!#unvalid,team=!red,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s
        execute if entity @s[team=blue] run damage @e[tag=yasuo.e.target,type=!#unvalid,team=!blue,limit=1,sort=nearest] 2 lc:core/dmg_magic by @s

        scoreboard players set @s dmg_magic.deal 100
        scoreboard players operation dmg temp = @s attack_damage
        scoreboard players operation dmg temp *= 20 integer
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_magic.deal += dmg temp

        scoreboard players operation dmg temp = @s ability_power
        scoreboard players operation dmg temp *= 60 integer
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_magic.deal += dmg temp

        function lc:champion/dmg/calc.debuff
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=yasuo.e.target,tag=has_health_bar,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
            execute if entity @s[team=<%team%>] run scoreboard players operation @e[team=!<%team%>,tag=yasuo.e.target,tag=has_health_bar,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
            execute if entity @s[team=<%team%>] run scoreboard players set @s dmg_magic.deal 0
        }

        execute if entity @s[team=red] run tag @e[team=!red,tag=yasuo.e.target,type=!#unvalid,limit=1,sort=nearest] remove yasuo.e.target
        execute if entity @s[team=blue] run tag @e[team=!blue,tag=yasuo.e.target,type=!#unvalid,limit=1,sort=nearest] remove yasuo.e.target
    }

    function e.dash {
        tp @s ^ ^ ^0.75
        execute if entity @s[tag=red] at @s positioned ~ ~-0.5 ~ as @p[team=red,tag=yasuo] run function lc:core/motion/follow
        execute if entity @s[tag=blue] at @s positioned ~ ~-0.5 ~ as @p[team=blue,tag=yasuo] run function lc:core/motion/follow
        #execute if entity @s[tag=blue] run tp @p[team=blue,tag=yasuo] ~ ~ ~ ~ ~

        execute on passengers as @p if entity @s[team=red] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=yasuo.e.target,dx=0,team=!red,type=!#unvalid] run function lc:champions/yasuo/skills/e.damage
        execute on passengers as @p if entity @s[team=blue] positioned ~-0.5 ~-0.5 ~-0.5 if entity @e[tag=yasuo.e.target,dx=0,team=!blue,type=!#unvalid] run function lc:champions/yasuo/skills/e.damage

        particle dust{color:[0.7,1,1],scale:0.5} ^ ^ ^-0.4 0.1 0.2 0.1 1 50 force
    }

    function e.dash.clear {
        execute if entity @s[tag=red] run tag @e[tag=yasuo.e.target,team=!red,type=!#unvalid] remove yasuo.e.target
        execute if entity @s[tag=blue] run tag @e[tag=yasuo.e.target,team=!blue,type=!#unvalid] remove yasuo.e.target
    }

    function e.dash_q {
        execute if entity @s run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:6,Tags:["yasuo.e.particle"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=full_q] on passengers as @p run function lc:champions/yasuo/skills/e.dash_q.tornado

        execute on passengers as @p if score @s stack_q matches 0..1 run function lc:champions/yasuo/skills/e.dash_q.check

        execute on passengers as @p if score @s stack_q matches 0..1 run playsound yasuo.sfx.eq0 master @a ~ ~ ~
        execute on passengers as @p if score @s[tag=full_q] stack_q matches 2 run playsound yasuo.sfx.eq1 master @a ~ ~ ~
        execute on passengers as @p if score @s[tag=!full_q] stack_q matches 2 run scoreboard players set @s stack_q 0
    }

    function e.dash_q.check {
        execute if entity @s[team=red] positioned ~-2 ~-1.5 ~-2 run tag @e[dx=3,dz=3,dy=1,team=!red,type=!#unvalid,tag=!unvalid,tag=!yasuo.q.hit] add yasuo.q.hit

        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run scoreboard players add @s stack_q 1
        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run function lc:champions/yasuo/skills/q.stack_cd
        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] add temp_dmg
        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run function lc:champions/yasuo/skills/q.damage
        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] remove yasuo.q.hit

        execute if entity @s[team=blue] positioned ~-2 ~-1.5 ~-2 run tag @e[dx=3,dz=3,dy=1,team=!blue,type=!#unvalid,tag=!unvalid,tag=!yasuo.q.hit] add yasuo.q.hit

        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run scoreboard players add @s stack_q 1
        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run function lc:champions/yasuo/skills/q.stack_cd
        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] add temp_dmg
        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run function lc:champions/yasuo/skills/q.damage
        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] remove yasuo.q.hit

        execute if score @s stack_q matches 2 run tag @s add full_q
    }

    function e.dash_q.particle {
        tp @s ~ ~ ~ ~30 ~
        particle minecraft:end_rod ^ ^1 ^2 0.1 0.1 0.1 0 2 force
        particle minecraft:end_rod ^ ^1 ^-2 0.1 0.1 0.1 0 2 force
        execute rotated ~-15 0 run particle minecraft:end_rod ^ ^1 ^2 0.1 0.1 0.1 0 2 force
        execute rotated ~-15 0 run particle minecraft:end_rod ^ ^1 ^-2 0.1 0.1 0.1 0 2 force

        particle dust{color:[0.5,0.7,1],scale:2} ^ ^0.75 ^1.75 0.1 0.1 0.1 1 2 force
        particle dust{color:[0.5,0.7,1],scale:2} ^ ^0.75 ^-1.75 0.1 0.1 0.1 1 2 force
        execute rotated ~-15 0 run particle dust{color:[0.5,0.7,1],scale:2} ^ ^0.5 ^1.75 0.1 0.1 0.1 1 2 force
        execute rotated ~-15 0 run particle dust{color:[0.5,0.7,1],scale:2} ^ ^0.5 ^-1.75 0.1 0.1 0.1 1 2 force

        particle minecraft:instant_effect ^ ^0.25 ^1.5 0.1 0.1 0.1 0 1 force
        particle minecraft:instant_effect ^ ^0.25 ^-1.5 0.1 0.1 0.1 0 1 force
        execute rotated ~-15 0 run particle minecraft:instant_effect ^ ^0.25 ^1.5 0.1 0.1 0.1 0 1 force
        execute rotated ~-15 0 run particle minecraft:instant_effect ^ ^0.25 ^-1.5 0.1 0.1 0.1 0 1 force
    }

    function e.dash_q.tornado {
        playsound yasuo.sfx.eq2 master @a ~ ~ ~
        execute if entity @s[team=red] run summon minecraft:item_display ~ ~-1 ~ {teleport_duration:10,interpolation_duration:10,Tags:["yasuo.e.tornado","spin1","red","temp","lol.auto_clear"],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100311f]}}},item_display:"head",Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] run summon minecraft:item_display ~ ~-1 ~ {teleport_duration:10,interpolation_duration:10,Tags:["yasuo.e.tornado","spin1","blue","temp","lol.auto_clear"],item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100311f]}}},item_display:"head",Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:10,Tags:["cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        tp @e[tag=yasuo.e.tornado,tag=temp,limit=1,sort=nearest] ~ ~1 ~
        execute as @e[tag=yasuo.e.tornado,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
        data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        data modify entity @e[tag=yasuo.e.tornado,tag=temp,limit=1,sort=nearest] transformation.translation set value [0.0,3.0,0.0]
        tag @e[tag=yasuo.e.tornado,tag=temp,limit=1,sort=nearest] remove temp

        tag @s remove full_q
        execute if entity @s[team=red] run kill @e[tag=yasuo.q.stackcd,type=area_effect_cloud,tag=red]
        execute if entity @s[team=blue] run kill @e[tag=yasuo.q.stackcd,type=area_effect_cloud,tag=blue]

        execute as @s[team=red] at @s positioned ~-2.5 ~-1.5 ~-2.5 run tag @e[team=!red,dx=4,dz=4,dy=2,type=!#unvalid,tag=!unvalid] add yasuo.q.hit
        execute as @s[team=blue] at @s positioned ~-2.5 ~-1.5 ~-2.5 run tag @e[team=!blue,dx=4,dz=4,dy=2,type=!#unvalid,tag=!unvalid] add yasuo.q.hit

        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red,tag=!yasuo.tornado.hit] add temp_dmg
        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] as @e[tag=yasuo.q.hit,type=!#unvalid,team=!red,tag=!yasuo.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function lc:champions/yasuo/skills/e.dash_q.tornado.knockup
        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run function lc:champions/yasuo/skills/q.damage

        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] add yasuo.tornado.hit
        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] remove yasuo.q.hit

        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue,tag=!yasuo.tornado.hit] add temp_dmg
        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] as @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue,tag=!yasuo.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function lc:champions/yasuo/skills/e.dash_q.tornado.knockup
        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run function lc:champions/yasuo/skills/q.damage

        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] add yasuo.tornado.hit
        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] remove yasuo.q.hit
    }

    function e.dash_q.tornado.knockup {
        function lc:champion/cc/cancel
        scoreboard players set @s cc.airborne 18
        function lc:core/motion/push {x:0,y:495,z:0,ticks:0}
    }

    function passive.trigger {
        scoreboard players set @s mana 0
        playsound minecraft:yasuo.sfx.p master @a ~ ~ ~
        tag @s remove full_p

        tag @s add update.shield.yasuo

        summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:999999,Tags:["shield.all","new"],Passengers:[{id:"area_effect_cloud",WaitTime:0,Tags:["cd"],Duration:40,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        data modify entity @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] Owner set from entity @s UUID
        scoreboard players set @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all 600
        scoreboard players operation @s shield.all += @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] shield.all
        tag @e[type=area_effect_cloud,tag=shield.all,tag=new,limit=1,sort=nearest] remove new
    }

    function q.check {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] positioned ^ ^ ^ positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!<%team%>,type=!#unvalid,tag=!unvalid,tag=!yasuo.q.hit] add yasuo.q.hit
            execute if entity @s[team=<%team%>] positioned ^ ^ ^1 positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!<%team%>,type=!#unvalid,tag=!unvalid,tag=!yasuo.q.hit] add yasuo.q.hit
            execute if entity @s[team=<%team%>] positioned ^ ^ ^2 positioned ~-0.5 ~-0.5 ~-0.5 run tag @e[dx=0,team=!<%team%>,type=!#unvalid,tag=!unvalid,tag=!yasuo.q.hit] add yasuo.q.hit
        }

        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] if entity @e[tag=yasuo.q.hit,team=!<%team%>,type=!#unvalid] run scoreboard players add @s stack_q 1
            execute if entity @s[team=<%team%>] if entity @e[tag=yasuo.q.hit,team=!<%team%>,type=!#unvalid] run function lc:champions/yasuo/skills/q.stack_cd
            execute if entity @s[team=<%team%>] if entity @e[tag=yasuo.q.hit,team=!<%team%>,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!<%team%>] add temp_dmg
            execute if entity @s[team=<%team%>] if entity @e[tag=yasuo.q.hit,team=!<%team%>,type=!#unvalid] run function lc:champions/yasuo/skills/q.damage
            execute if entity @s[team=<%team%>] if entity @e[tag=yasuo.q.hit,team=!<%team%>,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!<%team%>] remove yasuo.q.hit
        }

        execute if score @s stack_q matches 2 run tag @s add full_q
    }

    function q.damage {
        execute if entity @s[team=red] run damage @e[tag=yasuo.q.hit,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=yasuo.q.hit,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 5 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 120
        scoreboard players operation @s dmg_physical.deal += @s attack_damage
        function lc:champion/aa/on_hit
        function lc:champion/dmg/calc.debuff
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yasuo.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yasuo.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=yasuo.q.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=red] if entity @e[tag=yasuo.q.hit,tag=temp_dmg,type=!#unvalid,team=!red] run function lc:champions/yasuo/skills/q.damage

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yasuo.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yasuo.q.hit,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=yasuo.q.hit,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=blue] if entity @e[tag=yasuo.q.hit,tag=temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/yasuo/skills/q.damage
    }

    function q.particle {
        particle minecraft:end_rod ^ ^ ^0.5 0 0 0 0 1 force
        particle minecraft:end_rod ^ ^ ^0.75 0 0 0 0 1 force
        particle minecraft:end_rod ^ ^ ^1 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^1.25 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^1.5 0.1 0.1 0.1 0 3 force
        particle minecraft:end_rod ^ ^ ^1.75 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^2 0.05 0.05 0.05 0 2 force
        particle minecraft:end_rod ^ ^ ^2.25 0 0 0 0 1 force
        particle minecraft:end_rod ^ ^ ^2.5 0 0 0 0 1 force

        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^0.5 0 0 0 0 1 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^0.75 0 0 0 0 1 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1.25 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1.5 0.1 0.1 0.1 0 3 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^1.75 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^2 0.05 0.05 0.05 0 2 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^2.25 0 0 0 0 1 force
        particle minecraft:dust{color:[0.5,0.7,1],scale:1} ^ ^ ^2.5 0 0 0 0 1 force
    }

    function q.stack {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[tag=<%team%>] if entity @p[tag=yasuo,team=<%team%>,tag=full_q] run tp @s ~ ~ ~ ~20 0
            execute if entity @s[tag=<%team%>] if entity @p[tag=yasuo,team=<%team%>,tag=full_q] positioned as @p[tag=yasuo,team=<%team%>] rotated as @s run particle minecraft:instant_effect ^ ^1.3 ^0.75 0 0 0 0 2 force
            execute if entity @s[tag=<%team%>] if entity @p[tag=yasuo,team=<%team%>,tag=full_q] positioned as @p[tag=yasuo,team=<%team%>] rotated as @s run particle minecraft:instant_effect ^ ^0.7 ^-0.75 0 0 0 0 2 force
            execute if entity @s[tag=<%team%>,nbt={Age:120}] run scoreboard players set @p[tag=yasuo,team=<%team%>] stack_q 0
            execute if entity @s[tag=<%team%>,nbt={Age:120}] run tag @p[tag=yasuo,team=<%team%>] remove full_q
        }
    }

    function q.stack_cd {
        REPEAT([["red","blue"],["blue","red"]]) as team, enemy {
            execute if entity @s[team=<%team%>] if entity @e[tag=yasuo.q.stackcd,type=minecraft:area_effect_cloud,tag=<%team%>] run data modify entity @e[tag=yasuo.q.stackcd,tag=<%team%>,type=minecraft:area_effect_cloud,limit=1] Age set value 0
            execute if entity @s[team=<%team%>] unless entity @e[tag=yasuo.q.stackcd,type=minecraft:area_effect_cloud,tag=<%team%>] run summon minecraft:area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:121,Tags:["yasuo.q.stackcd","<%team%>"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        }
    }

    function q.tornado.clear {
        execute if entity @s[tag=red] run tag @e[tag=yasuo.tornado.hit,team=!red,type=!#unvalid] remove yasuo.tornado.hit
        execute if entity @s[tag=blue] run tag @e[tag=yasuo.tornado.hit,team=!blue,type=!#unvalid] remove yasuo.tornado.hit

        kill @s
    }

    function q.tornado.knockup {
        function lc:champion/cc/cancel
        scoreboard players set @s cc.airborne 15

        function lc:core/motion/push {x:0,y:424,z:0,ticks:0}
    }

    function q.tornado.passive {
        #tp @s ~ ~ ~ ~30 ~

        tp @s ^ ^ ^1
        particle minecraft:instant_effect ^ ^ ^ 0.2 0 0.2 0 10 force

        execute as @s[tag=red] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!red,dx=2,dz=2,dy=10,type=!#unvalid,tag=!unvalid] add yasuo.q.hit
        execute as @s[tag=blue] positioned ~-1.5 ~-1.5 ~-1.5 run tag @e[team=!blue,dx=2,dz=2,dy=10,type=!#unvalid,tag=!unvalid] add yasuo.q.hit

        #effect give @e[tag=yasuo.q.hit] glowing 1 0 true
        #say @e[tag=yasuo.q.hit]
        execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red,tag=!yasuo.tornado.hit] add temp_dmg
        execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] as @e[tag=yasuo.q.hit,type=!#unvalid,team=!red,tag=!yasuo.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function lc:champions/yasuo/skills/q.tornado.knockup
        execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] on passengers on origin run function lc:champions/yasuo/skills/q.damage

        execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] add yasuo.tornado.hit
        execute if entity @s[tag=red] if entity @e[tag=yasuo.q.hit,team=!red,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!red] remove yasuo.q.hit

        execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue,tag=!yasuo.tornado.hit] add temp_dmg
        execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] as @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue,tag=!yasuo.tornado.hit,tag=temp_dmg,tag=!unstoppable] at @s run function lc:champions/yasuo/skills/q.tornado.knockup
        execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] on passengers on origin run function lc:champions/yasuo/skills/q.damage

        execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] add yasuo.tornado.hit
        execute if entity @s[tag=blue] if entity @e[tag=yasuo.q.hit,team=!blue,type=!#unvalid] run tag @e[tag=yasuo.q.hit,type=!#unvalid,team=!blue] remove yasuo.q.hit

        #execute unless data entity @s Passengers[{Tags:["yasuo.q.cd"]}] run kill @s
    }

    function q.tornado.spawn {
        playsound yasuo.sfx.q2 master @a ~ ~ ~

        execute if entity @s[team=red] run summon minecraft:item_display ~ ~ ~ {teleport_duration:1,interpolation_duration:10,Tags:["yasuo.q.tornado","temp","spin1","red","lol.auto_clear"],item_display:"head",item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100002f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:20,Tags:["cd","red","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
        execute if entity @s[team=blue] run summon minecraft:item_display ~ ~ ~ {teleport_duration:1,interpolation_duration:10,Tags:["yasuo.q.tornado","temp","spin1","blue","lol.auto_clear"],item_display:"head",item:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100002f]}}},Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:20,Tags:["cd","blue","block_by_windwall"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",WaitTime:0,Duration:3,Tags:["spin1"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

        tp @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] ~ ~ ~ ~ 0
        execute as @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] on passengers store result entity @s Rotation[0] float 1 on vehicle run data get entity @s Rotation[0] 1
        data modify entity @e[tag=cd,limit=1,sort=nearest] Owner set from entity @s UUID
        data modify entity @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] transformation.translation set value [0.0,3.0,0.0]
        tag @e[tag=yasuo.q.tornado,tag=temp,limit=1,sort=nearest] remove temp
        #schedule function lc:animation/spin1 2t append

        tag @s remove full_q
        execute if entity @s[team=red] run kill @e[tag=yasuo.q.stackcd,type=area_effect_cloud,tag=red]
        execute if entity @s[team=blue] run kill @e[tag=yasuo.q.stackcd,type=area_effect_cloud,tag=blue]
    }

    function r.animation {
        #particle minecraft:explosion ~ ~ ~ 0 0 0 0 1 force
        particle minecraft:instant_effect ~ ~ ~ 0.5 0.5 0.5 1 5 force

        execute positioned ^ ^1 ^-2 facing entity @s feet on origin run function lc:champions/yasuo/skills/r.blink

        execute if entity @s[tag=red] as @e[tag=yasuo.r.target,team=!red,type=!#unvalid] run tp @s ~ ~ ~
        execute if entity @s[tag=blue] as @e[tag=yasuo.r.target,team=!blue,type=!#unvalid] run tp @s ~ ~ ~

        execute if entity @s[nbt={Age:0}] positioned ~1.5 ~ ~1.5 run summon minecraft:armor_stand ~ ~ ~ {Tags:["yasuo.r.particle","unvalid","up"],Rotation:[135.0f,45.0f],Pose:{Head:[45.0f,0.0f,0.0f]},Invisible:1,Marker:1,Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:7,Tags:["yasuo.r.particle.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],equipment:{head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100411f]}}}}}
        execute if entity @s[nbt={Age:8}] positioned ~-1.5 ~ ~-1.5 run summon minecraft:armor_stand ~ ~ ~ {Tags:["yasuo.r.particle","unvalid","side"],Rotation:[0.0f,0.0f],Pose:{Head:[0.0f,0.0f,90.0f]},Invisible:1,Marker:1,Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:7,Tags:["yasuo.r.particle.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],equipment:{head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100411f]}}}}}
        execute if entity @s[nbt={Age:15}] positioned ~-1.75 ~ ~ run summon minecraft:armor_stand ~ ~ ~ {Tags:["yasuo.r.particle","unvalid","down"],Rotation:[-90.0f,-45.0f],Pose:{Head:[-45.0f,0.0f,0.0f]},Invisible:1,Marker:1,Passengers:[{id:"area_effect_cloud",WaitTime:0,Duration:7,Tags:["yasuo.r.particle.cd"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}],equipment:{head:{id:"iron_sword",count:1,components:{"minecraft:custom_model_data":{floats:[100411f]}}}}}

        execute if entity @s[nbt={Age:4}] run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force
        execute if entity @s[nbt={Age:12}] run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force
        execute if entity @s[nbt={Age:19}] run particle item{item:"redstone_block"} ~ ~1 ~ 0 0 0 0.1 100 force

        execute if entity @s[nbt={Age:19}] run function lc:champions/yasuo/skills/r.end
    }

    function r.blink {
        function lc:core/motion/cancel_dash

        tp @s ~ ~ ~ ~ ~
    }

    function r.buff.end {
        tag @s remove yasuo.r.buff
        scoreboard players remove @s armor.pen 50
    }

    function r.damage {
        execute if entity @s[team=red] run damage @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!red,limit=1,sort=nearest] 10 lc:core/dmg_physical by @s
        execute if entity @s[team=blue] run damage @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!blue,limit=1,sort=nearest] 10 lc:core/dmg_physical by @s

        scoreboard players set @s dmg_physical.deal 500
        scoreboard players operation dmg temp = @s attack_damage
        scoreboard players operation dmg temp *= 150 integer
        scoreboard players operation dmg temp /= 100 integer

        scoreboard players operation @s dmg_physical.deal += dmg temp

        function lc:champion/dmg/calc.debuff
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=red] run tag @e[team=!red,tag=yasuo.r.target,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=red] if entity @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!red] run function lc:champions/yasuo/skills/r.damage

        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
        execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=yasuo.r.target,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

        execute if entity @s[team=blue] run tag @e[team=!blue,tag=yasuo.r.target,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

        execute if entity @s[team=blue] if entity @e[tag=yasuo.r.target,tag=temp_dmg,type=!#unvalid,team=!blue] run function lc:champions/yasuo/skills/r.damage
    }

    function r.end {
        execute if entity @s[tag=red] on origin at @s run function lc:champions/yasuo/skills/r.end.position

        execute if entity @s[tag=red] run tag @e[tag=yasuo.r.target,type=!#unvalid,team=!red] add temp_dmg

        execute if entity @s[tag=blue] on origin at @s run function lc:champions/yasuo/skills/r.end.position

        execute if entity @s[tag=blue] run tag @e[tag=yasuo.r.target,type=!#unvalid,team=!blue] add temp_dmg

        execute on origin run function lc:champions/yasuo/skills/r.damage

        execute if entity @s[tag=red] on origin run scoreboard players add @s[tag=!yasuo.r.buff] armor.pen 50
        execute if entity @s[tag=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:300,Tags:["yasuo.r.buff","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=red] on origin run tag @s add yasuo.r.buff

        execute if entity @s[tag=red] as @e[tag=airborne,tag=yasuo.r.target,team=!red,type=!#unvalid] run function lc:core/motion/push {x:0,y:-1000,z:0,ticks:0}

        execute if entity @s[tag=red] run tag @e[tag=yasuo.r.target,team=!red] remove yasuo.r.target
        execute on origin as @s[team=red] positioned as @e[tag=yasuo.r.end.position,type=area_effect_cloud,tag=red,limit=1,sort=nearest] run tp @s ~ ~1 ~

        execute if entity @s[tag=blue] on origin run scoreboard players add @s[tag=!yasuo.r.buff] armor.pen 50
        execute if entity @s[tag=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:300,Tags:["yasuo.r.buff","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if entity @s[tag=blue] on origin run tag @s add yasuo.r.buff

        execute if entity @s[tag=blue] as @e[tag=airborne,tag=yasuo.r.target,team=!blue,type=!#unvalid] run function lc:core/motion/push {x:0,y:-1000,z:0,ticks:0}

        execute if entity @s[tag=blue] run tag @e[tag=yasuo.r.target,team=!blue] remove yasuo.r.target
        execute on origin as @s[team=blue] positioned as @e[tag=yasuo.r.end.position,type=area_effect_cloud,tag=blue,limit=1,sort=nearest] run tp @s ~ ~1 ~

        execute on origin at @s run function lc:champions/yasuo/skills/r.end.particle
        execute on origin at @s rotated ~ 0 positioned ~ ~0.2 ~ run function lc:champions/yasuo/skills/r.particle.end
        execute on origin run tag @s remove r.animation
    }

    function r.end.particle {
        particle end_rod ~ ~ ~ 0 0 0 0.1 100 force
        particle cloud ~ ~0.2 ~ 1.5 0 1.5 0.03 100 force
        #particle minecraft:dust 0.5 0.7 1 2 ~ ~ ~ 1.5 0 1.5 1 500 force
        particle campfire_cosy_smoke ~ ~0.2 ~ 1.5 0 1.5 0.05 20 force
    }

    function r.end.position {
        execute unless block ~ ~ ~ #like_air if entity @s[team=red] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:1,Tags:["yasuo.r.end.position","red"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute unless block ~ ~ ~ #like_air if entity @s[team=blue] run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:1,Tags:["yasuo.r.end.position","blue"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
        execute if block ~ ~ ~ #like_air positioned ~ ~-1 ~ run function lc:champions/yasuo/skills/r.end.position
    }

    function r.particle {
        tp @s[tag=up] ~ ~ ~ ~ ~-10
        tp @s[tag=side] ~ ~ ~ ~-10 ~
        tp @s[tag=down] ~ ~ ~ ~ ~10
        data modify entity @s[tag=!side] Pose.Head[0] set from entity @s[tag=!side] Rotation[1]

        execute unless entity @e[tag=yasuo.r.particle.cd,distance=..0.01,type=minecraft:area_effect_cloud] run kill @s
    }

