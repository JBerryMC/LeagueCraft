# lc:animation/  (converted from the 1.20.2 LeagueCraft datapack)

function spin1 {
    execute on passengers run data modify entity @s transformation.right_rotation set value [0.0,1.0,0.0,0.0]
    execute on passengers run data modify entity @s start_interpolation set value -1
    data modify entity @s transformation.right_rotation set value [0.0,1.0,0.0,0.0]
    data modify entity @s start_interpolation set value -1
    tag @s add spin2
    tag @s remove spin1
    execute if entity @s[tag=!spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin2","temp"],Duration:10,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin2","temp"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    ride @e[tag=spin2,type=area_effect_cloud,limit=1,sort=nearest,tag=temp] mount @s
    execute on passengers run tag @s remove temp
}

function spin2 {
    execute on passengers run data modify entity @s transformation.right_rotation set value [0.0,0.0,0.0,-1.0]
    execute on passengers run data modify entity @s start_interpolation set value -1
    data modify entity @s transformation.right_rotation set value [0.0,0.0,0.0,-1.0]
    data modify entity @s start_interpolation set value -1
    tag @s add spin3
    tag @s remove spin2
    execute if entity @s[tag=!spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin3","temp"],Duration:10,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin3","temp"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    ride @e[tag=spin3,type=area_effect_cloud,limit=1,sort=nearest,tag=temp] mount @s
    execute on passengers run tag @s remove temp
}

function spin3 {
    execute on passengers run data modify entity @s transformation.right_rotation set value [0.0,-1.0,0.0,0.0]
    execute on passengers run data modify entity @s start_interpolation set value -1
    data modify entity @s transformation.right_rotation set value [0.0,-1.0,0.0,0.0]
    data modify entity @s start_interpolation set value -1
    tag @s add spin4
    tag @s remove spin3
    execute if entity @s[tag=!spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin4","temp"],Duration:10,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin4","temp"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    ride @e[tag=spin4,type=area_effect_cloud,limit=1,sort=nearest,tag=temp] mount @s
    execute on passengers run tag @s remove temp
}

function spin4 {
    execute on passengers run data modify entity @s transformation.right_rotation set value [0.0,0.0,0.0,1.0]
    execute on passengers run data modify entity @s start_interpolation set value -1
    data modify entity @s transformation.right_rotation set value [0.0,0.0,0.0,1.0]
    data modify entity @s start_interpolation set value -1
    tag @s add spin1
    tag @s remove spin4
    execute if entity @s[tag=!spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin1","temp"],Duration:10,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute if entity @s[tag=spin_lv_2] run summon area_effect_cloud ~ ~ ~ {Tags:["spin1","temp"],Duration:5,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    ride @e[tag=spin1,type=area_effect_cloud,limit=1,sort=nearest,tag=temp] mount @s
    execute on passengers run tag @s remove temp
}

predicate dmg_indicator {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:entity_type": "minecraft:text_display",
        "minecraft:vehicle": {
            "minecraft:entity_type": "minecraft:item"
        }
    }
}

