    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] run tag @e[tag=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[tag=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] run tag @e[tag=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] remove temp_dmg
}

function ranged.hit {
    execute if entity @s[tag=aa,tag=!ashe.q] on passengers as @s[tag=initial] on origin run function lc:champion/aa/ranged.basic

    execute if entity @s[tag=ashe.q,tag=!decor] on passengers as @s[tag=initial] on origin run function lc:champions/ashe/skills/q.hit

    execute if entity @s[tag=ezreal.e.missile] on passengers as @s[tag=initial] on origin run function lc:champions/ezreal/skills/e.hit

    execute if entity @s[tag=soraka.q.refund] on passengers as @s[tag=initial] on origin run scoreboard players set @s soraka.passive 3

    execute if entity @s[tag=malphite.q] on passengers as @s[tag=initial] on origin run function lc:champions/malphite/skills/q.hit

    execute if entity @s[tag=annie.q] on passengers as @s[tag=initial] on origin run function lc:champions/annie/skills/q.hit
}

function ranged.hit_structure {
    execute if entity @s[tag=aa,tag=!ashe.q] on passengers as @s[tag=initial] on origin run function lc:champion/aa/ranged.basic_structure
    execute if entity @s[tag=ashe.q,tag=!decor] on passengers as @s[tag=initial] on origin run function lc:champions/ashe/skills/q.hit_structure
}

function ranged.homing {
    function lc:champion/aa/ranged.particle

    ## STRUCTURE
    execute store success score @s temp on passengers as @s[tag=target] on origin if entity @s[tag=lol.structure.entity]
    execute if score @s temp matches 1 store success score @s temp on passengers as @s[tag=target] on origin positioned ~-0.5 ~-0.5 ~-0.5 if entity @s[dx=0]
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin on vehicle run tag @s[tag=lol.structure] add temp_dmg
    execute if score @s temp matches 1 run function lc:champion/aa/ranged.hit_structure
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin on vehicle run tag @s[tag=lol.structure] remove temp_dmg
    execute if score @s temp matches 1 on passengers run kill @s
    execute if score @s temp matches 1 run kill @s

    ## REGULAR TARGET
    execute store success score @s temp on passengers as @s[tag=target] on origin unless entity @s[tag=lol.structure.entity]
    execute if score @s temp matches 1 store success score @s temp on passengers as @s[tag=target] on origin positioned ~-0.5 ~-0.5 ~-0.5 if entity @s[dx=0]
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin run tag @s add temp_dmg
    execute if score @s temp matches 1 run function lc:champion/aa/ranged.hit
    execute if score @s temp matches 1 on passengers as @s[tag=target] on origin run tag @s remove temp_dmg
    execute if score @s temp matches 1 on passengers run kill @s
    execute if score @s temp matches 1 run kill @s

    ## FOLLOW TARGET
    execute store success score @s temp on passengers as @s[tag=target] on origin positioned ~-0.5 ~-0.5 ~-0.5 if entity @s[dx=0]
    execute if score @s temp matches 0 on passengers as @s[tag=target] on origin run tag @s add temp_owner
    execute if score @s temp matches 0 facing entity @e[tag=temp_owner,limit=1,sort=nearest] eyes rotated ~ ~-10 run tp @s[tag=!feet,tag=!speed.slow] ^ ^ ^1 ~ ~
    execute if score @s temp matches 0 facing entity @e[tag=temp_owner,limit=1,sort=nearest] eyes rotated ~ ~-10 run tp @s[tag=!feet,tag=speed.slow] ^ ^ ^0.5 ~ ~
    execute if score @s temp matches 0 facing entity @e[tag=temp_owner,limit=1,sort=nearest] feet run tp @s[tag=feet] ^ ^ ^1 ~ ~
    execute if score @s temp matches 0 on passengers as @s[tag=target] on origin run tag @s remove temp_owner

    ## NO MORE TARGET
    execute store success score @s temp on passengers as @s[tag=target] if data entity @s Owner
    execute if score @s temp matches 0 on passengers run kill @s
    execute if score @s temp matches 0 run kill @s
}

function ranged.initial {
    execute at @s run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner

    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=!lol.structure,team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] UUID
    execute if entity @s[team=red] run tag @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] remove temp

    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=!lol.structure,team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] UUID
    execute if entity @s[team=blue] run tag @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] remove temp
}

function ranged.initial_structure {
    execute at @s run summon area_effect_cloud ~ ~ ~ {WaitTime:0,Duration:1,Tags:["temp_entity"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    data modify entity @e[tag=temp_entity,limit=1,sort=nearest,type=area_effect_cloud] Owner set from entity @s UUID

    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner
    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=initial] Owner set from entity @e[type=area_effect_cloud,tag=temp_entity,limit=1,sort=nearest] Owner

    execute if entity @s[team=red] as @e[tag=lol.structure,type=interaction,tag=blue,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] add ranged_temp_target
    execute if entity @s[team=red] as @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=ranged_temp_target,type=silverfish,team=blue,limit=1,sort=nearest] UUID
    execute if entity @s[team=red] run tag @e[tag=aa,tag=temp,tag=red,limit=1,sort=nearest] remove temp
    execute if entity @s[team=red] as @e[tag=lol.structure,type=interaction,tag=blue,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] remove ranged_temp_target

    execute if entity @s[team=blue] as @e[tag=lol.structure,type=interaction,tag=red,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] add ranged_temp_target
    execute if entity @s[team=blue] as @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] on passengers run data modify entity @s[type=area_effect_cloud,tag=target] Owner set from entity @e[tag=ranged_temp_target,type=silverfish,team=red,limit=1,sort=nearest] UUID
    execute if entity @s[team=blue] run tag @e[tag=aa,tag=temp,tag=blue,limit=1,sort=nearest] remove temp
    execute if entity @s[team=blue] as @e[tag=lol.structure,type=interaction,tag=red,tag=temp_dmg,limit=1,sort=nearest] on passengers run tag @s[tag=lol.structure.entity,type=silverfish] remove ranged_temp_target
}

function ranged.particle {
    execute if entity @s[tag=aa.ashe] run particle dust{color:[0.5,0.9,1],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.vayne] run particle crit ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.ezreal] run particle dust{color:[1,0.957,0.553],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=ezreal.e.missile] run particle minecraft:dust{color:[1,1,0],scale:1} ^ ^ ^ 0 0 0 0 1 force

    execute if entity @s[tag=aa.jhin] run particle dust{color:[0.5,0.9,1],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.soraka] run particle end_rod ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=soraka.q.refund] run particle happy_villager ~ ~-0.4 ~ 0.1 0.1 0.1 0 2 force

    execute if entity @s[tag=malphite.q] run particle block{block_state:"ancient_debris"} ~ ~ ~ 0.1 0 0.1 0.1 2 force
    execute if entity @s[tag=malphite.q] run particle item{item:"ancient_debris"} ~ ~ ~ 0.1 0 0.1 0.1 2 force

    execute if entity @s[tag=aa.lux] run particle electric_spark ~ ~-0.4 ~ 0 0 0 0 1 force

    execute if entity @s[tag=aa.annie] run particle flame ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=annie.q] run particle flame ~ ~-0.4 ~ 0.2 0.2 0.2 0.01 10 force

    ## Minion
    execute if entity @s[tag=aa.minion.caster,tag=red] run particle dust{color:[1,0,0],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=aa.minion.siege,tag=red] run particle dust{color:[1,0,0],scale:1.5} ~ ~-0.4 ~ 0.1 0.1 0.1 0 2 force

    execute if entity @s[tag=aa.minion.caster,tag=blue] run particle dust{color:[0,0.5,1],scale:1} ~ ~-0.4 ~ 0 0 0 0 1 force
    execute if entity @s[tag=aa.minion.siege,tag=blue] run particle dust{color:[0,0.5,1],scale:1.5} ~ ~-0.4 ~ 0.1 0.1 0.1 0 2 force
}

function ranged.structure {
    function lc:champion/aa/cd
    function lc:champion/aa/sfx

    function lc:champion/aa/ranged.initial_structure
}

function ranged.success {
    function lc:champion/aa/cd
    function lc:champion/aa/sfx

    function lc:champion/aa/ranged.initial
}

function sfx {
    execute if entity @s[tag=yasuo] run function lc:champions/yasuo/aa
    execute if entity @s[tag=yone] run function lc:champions/yone/aa
    execute if entity @s[tag=zed] run function lc:champions/zed/aa
    execute if entity @s[tag=leesin] run function lc:champions/leesin/aa
    execute if entity @s[tag=aatrox] run function lc:champions/aatrox/aa

    execute if entity @s[tag=ashe] run function lc:champions/ashe/aa
    execute if entity @s[tag=vayne] run function lc:champions/vayne/aa
    execute if entity @s[tag=ezreal] run function lc:champions/ezreal/aa
    execute if entity @s[tag=jhin] run function lc:champions/jhin/aa

    execute if entity @s[tag=leona] run function lc:champions/leona/aa
    execute if entity @s[tag=soraka] run function lc:champions/soraka/aa

    execute if entity @s[tag=garen] run function lc:champions/garen/aa
    execute if entity @s[tag=malphite] run function lc:champions/malphite/aa

    execute if entity @s[tag=lux] run function lc:champions/lux/aa
    execute if entity @s[tag=annie] run function lc:champions/annie/aa
    execute if entity @s[tag=annie.r] run function lc:champions/annie/skills/r.aa

    ## Minion
    execute if entity @s[tag=minion.melee] run function lc:core/minion/melee/aa
    execute if entity @s[tag=minion.super] run function lc:core/minion/super/aa
    execute if entity @s[tag=minion.caster] run function lc:core/minion/caster/aa
    execute if entity @s[tag=minion.siege] run function lc:core/minion/siege/aa
}

function special_modifiers {
    execute if entity @s[tag=ashe] run function lc:champions/ashe/skills/q.stack.gain

    execute if entity @s[tag=ezreal,team=red] if entity @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] positioned as @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] run function lc:champions/ezreal/skills/w.detonate
    execute if entity @s[tag=ezreal,team=blue] if entity @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] positioned as @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,tag=ezreal.w.target] run function lc:champions/ezreal/skills/w.detonate

    execute if entity @s[tag=yone] run function lc:champions/yone/passive

    execute if entity @s[tag=leesin] if score @s stack_p matches 1.. run function lc:champions/leesin/skills/passive.aa

    execute if entity @s[tag=zed,team=red] if score @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] hp.percentage matches ..50 unless score @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] zed_p_cd matches 1.. run function lc:champions/zed/passive
    execute if entity @s[tag=zed,team=blue] if score @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] hp.percentage matches ..50 unless score @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] zed_p_cd matches 1.. run function lc:champions/zed/passive

    execute if entity @s[tag=aatrox] if score @s cd_p matches 0 run function lc:champions/aatrox/passive
    execute if entity @s[tag=aatrox] if score @s cd_p matches 1.. run scoreboard players remove @s cd_p 2

    execute if entity @s[tag=leona,tag=leona.q] run function lc:champions/leona/skills/q.damage
    execute if entity @s[tag=garen,tag=garen.q] run function lc:champions/garen/skills/q.damage

    execute if entity @s[tag=lux,team=red] if entity @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] positioned as @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] run function lc:champions/lux/passive
    execute if entity @s[tag=lux,team=blue] if entity @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] positioned as @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest,scores={lux.passive=1..}] run function lc:champions/lux/passive

    execute if entity @s[tag=annie.r] if score @s aa.spd matches 10.. run scoreboard players remove @s aa.spd 4
}

# ---- The plugin's basic attack ------------------------------------------------------------------
# The plugin picks the targets (a cone in front for melee, the first target on the crosshair for
# ranged) and keeps the cooldown and ammo itself, so these skip lc:champion/aa/cd: that would also
# set channeling, which roots the attacker.

# Once per attack, as the attacker: the attack sound (and Aatrox's attack animation).
function plugin.attack {
    execute if entity @s[tag=melee] run return run function lc:champion/aa/sfx
    execute if entity @s[tag=ashe] if score @s cd_q matches 1.. run return run playsound ashe.sfx.q.active master @a ~ ~ ~
    execute if entity @s[tag=ashe] run return run playsound ashe.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=annie] run return run playsound annie.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=ezreal] run return run playsound ezreal.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=jhin] run return run playsound jhin.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=lux] run return run playsound lux.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=soraka] run return run playsound soraka.sfx.aa master @a ~ ~ ~
    execute if entity @s[tag=vayne] run return run playsound vayne.sfx.aa master @a ~ ~ ~
}

# Once per target hit, as the attacker, positioned at the target, which is tagged temp_dmg.
function plugin.hit {
    execute if entity @e[tag=temp_dmg,tag=lol.structure,limit=1,sort=nearest] run return run function lc:champion/aa/plugin.structure
    function lc:champion/aa/hit
}

function plugin.structure {
    function lc:champion/aa/on_hit_structure
    function lc:champion/aa/hit.structure
}
