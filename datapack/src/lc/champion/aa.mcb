    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 lc:core/dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 0
    scoreboard players set @s dmg_magic.deal 0

    scoreboard players operation @s dmg_physical.deal = @s attack_damage
