# lc:core/lang/  (converted from the 1.20.2 LeagueCraft datapack)

function eng.choose {
    scoreboard players set .world lang 0
    reload
}

function eng.load {
    tellraw @a {text:"\n\n",color:"gold"}
    tellraw @a {text:"LeagueCraft",color:"gold",bold:true}
    tellraw @a {text:"Version: 6.1.2 | by Chè Rí Minecraft\n",color:"gold"}
    tellraw @a [{text:"If you are an ADMIN click ",color:"yellow"},{text:"[ THIS ]",color:"yellow",bold:true,click_event:{action:"run_command",command:"/tag @s add admin"}}]
    tellraw @a {text:"\n",color:"gold"}
}

function eng.settings {
    give @s written_book[minecraft:written_book_content={title:Settings,author:JBerry367,pages:[{raw:["",{text:"League of Legends Datapack v5.1.1",bold:true,color:"dark_gray"},{text:"\n"},{text:"Made by @JBerry367",color:"dark_green"},{text:"\n"},{text:"YouTube: Chè Rí",bold:true,underlined:true,color:"dark_green",click_event:{action:"open_url",url:"https://www.youtube.com/jberry367"},hover_event:{action:"show_text",value:"Visit my YouTube channel!"}},{text:"\n\n"},{text:"General:",bold:true,color:"dark_gray"},{text:"\n"},{text:"[Reload]",color:"blue",click_event:{action:"run_command",command:"/reload"}},{text:" "},{text:"[Uninstall]",color:"red",click_event:{action:"run_command",command:"/function lc:core/uninstall"}},{text:"\n\n"},{text:"Language:",bold:true,color:"dark_gray"},{text:"\n"},{text:"►[English]",color:"blue"},{text:"\n"},{text:"►",color:"gray"},{text:"[Tiếng Việt]",color:"gray",click_event:{action:"run_command",command:"/function lc:core/lang/vie.choose"}}]},{raw:["",{text:"Spawn",bold:true,color:"dark_gray"},{text:"\n"},{text:"[Red Dummy]",color:"red",click_event:{action:"run_command",command:"/trigger st.dummy set 1"}},{text:"\n"},{text:"[Blue Dummy]",color:"blue",click_event:{action:"run_command",command:"/trigger st.dummy set 2"}},{text:"\n"},{text:"[Clear]",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.dummy set 3"}},{text:"\n\n"},{text:"Skill",bold:true},{text:"\n"},{text:"[Reset]",color:"dark_red",click_event:{action:"run_command",command:"/trigger st.set set 1"}},{text:"\n"},{text:"[Infinite Mana]",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.set set 2"}},{text:"\n"},{text:"[No Cooldown]",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.set set 3"}},{text:"\n "}]},{raw:["",{text:"Team Select",bold:true,color:"dark_gray"},{text:"\n"},{text:"[Red]",color:"red",click_event:{action:"run_command",command:"/trigger st.team set 1"}},{text:" ",color:"dark_gray"},{text:"[Blue]",color:"blue",click_event:{action:"run_command",command:"/trigger st.team set 2"}},{text:"\n\n"},{text:"Champion Select",bold:true,color:"dark_gray"},{text:"\n"},{text:"► [Reset]",color:"dark_red",click_event:{action:"run_command",command:"/trigger st.champ set -1"}},{text:"\n"},{text:"► Ashe",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 5"}},{text:"\n"},{text:"► Ezreal",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 7"}},{text:"\n"},{text:"► Jhin",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 8"}},{text:"\n"},{text:"► Lee Sin",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 2"}},{text:"\n"},{text:"► Vayne",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 6"}},{text:"\n"},{text:"► Yasuo",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 1"}},{text:"\n"},{text:"► Yone",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 4"}},{text:"\n"},{text:"► Zed",color:"dark_aqua",click_event:{action:"run_command",command:"/trigger st.champ set 3"}}]}]},minecraft:custom_data={settings:1}]
