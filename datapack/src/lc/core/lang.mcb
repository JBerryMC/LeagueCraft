dir champion {
    function eng.aatrox {
        title @s reset
        title @s title {text:"Aatrox",color:"dark_red"}
        title @s subtitle {text:"The Darkin Blade",italic:false}
        execute if entity @s[team=red] run tellraw @a[team=red] ["\n",{selector:"@s",color:"yellow"},{text:" has picked the champion: Aatrox - The Darkin Blade\n",color:"gold"}]
        execute if entity @s[team=blue] run tellraw @a[team=blue] ["\n",{selector:"@s",color:"yellow"},{text:" has picked the champion: Aatrox - The Darkin Blade\n",color:"gold"}]
    }

