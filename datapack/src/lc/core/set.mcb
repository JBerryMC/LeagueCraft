# lc:core/set/  (converted from the 1.20.2 LeagueCraft datapack)

function practice.cd {
    scoreboard players set @s[scores={cd_p=1..}] cd_p 0

    scoreboard players set @s[tag=!ashe,scores={cd_q=1..}] cd_q 0
    scoreboard players set @s[scores={cd_w=1..}] cd_w 0
    scoreboard players set @s[scores={cd_e=1..}] cd_e 0
    scoreboard players set @s[scores={cd_r=1..}] cd_r 0

    scoreboard players set @s[scores={cd_spell.1=1..}] cd_spell.1 0
    scoreboard players set @s[scores={cd_spell.2=1..}] cd_spell.2 0
}

function practice.hp {
    scoreboard players operation @s hp.left = @s hp.max
}

function practice.mana {
    scoreboard players operation @s[tag=useMana] mana = @s mana.max
    scoreboard players operation @s[tag=useEnergy] mana = @s mana.max
}

function settings {
    execute if score .world lang matches 0 run function lc:core/lang/eng.settings
    execute if score .world lang matches 1 run function lc:core/lang/vie.settings

    scoreboard players enable @s st.set
    scoreboard players set @s st.set 0
}
