# lc:game/  (converted from the 1.20.2 LeagueCraft datapack)

function load {
    say LeagueCraft Game Control reloaded

    setworldspawn 0 187 0 -90 0
    ## INGAME
    scoreboard objectives add game dummy

    ## MINION WAVE
    scoreboard objectives add minion_wave dummy

    ## LOBBY & MENU
    scoreboard objectives add hotbar dummy
    scoreboard objectives add hotbar_old dummy
    scoreboard objectives add hotbar_menu dummy

    scoreboard objectives add use_button minecraft.used:minecraft.warped_fungus_on_a_stick
    scoreboard objectives add left_game minecraft.custom:minecraft.leave_game

    ## QUEUE
    scoreboard objectives add queue dummy
    scoreboard players set max queue 10

    bossbar add queue ""
}

function tick {
    ## SPAWN
    execute as @a if score _ingame game matches 1 if score @s[tag=champion] left_game matches 1 at @s run function lc:game/lobby/respawn
    execute as @a if score _ingame game matches 1 if score @s[tag=!champion] left_game matches 1 at @s run function lc:game/lobby/spawn
    execute as @a if score _ingame game matches 0 if score @s left_game matches 1 at @s run function lc:game/lobby/spawn

    ## Settings
    execute as @a[tag=see_settings] run function lc:menu/main

    ## INGAME
    execute if score _ingame game matches 1 unless score _endgame game matches 1
    execute if score _ingame game matches 1 unless score _endgame game matches 1 run function lc:core/loop
    execute if score _ingame game matches 1 if score waittime queue matches 0 run schedule function lc:game/game/start 1s replace

    ## MENU
    execute if entity @e[type=item,nbt={Item:{components:{"minecraft:custom_data":{kill_item:1}}}}] run kill @e[type=item,nbt={Item:{components:{"minecraft:custom_data":{kill_item:1}}}}]
    execute unless score _ingame game matches 1 as @a unless predicate lc:game/hotbar_check run function lc:game/hotbar/update_menu

    execute unless score _ingame game matches 1 as @a store result score @s hotbar run data get entity @s SelectedItemSlot
    execute unless score _ingame game matches 1 as @a unless score @s hotbar_old = @s hotbar run function lc:game/hotbar/check

    execute if score _ingame game matches 1 as @a[tag=!champion,tag=!is_ingame] if score @s hotbar_menu matches 0 run title @s[tag=is_in_queue] actionbar [{translate:"space.2"},{text:"Leave the queue",bold:true,color:"#f2b71a"},{translate:"space.-310"},{text:"",font:"minecraft:lol",color:"white"}]
    execute unless score _ingame game matches 1 as @a[tag=!champion] if score @s hotbar_menu matches 0 run title @s[tag=is_in_queue] actionbar [{translate:"space.2"},{text:"Leave the queue",bold:true,color:"#f2b71a"},{translate:"space.-310"},{text:"",font:"minecraft:lol",color:"white"}]
    execute unless score _ingame game matches 1 as @a[tag=!champion] if score @s hotbar_menu matches 0 run title @s[tag=!is_in_queue] actionbar [{translate:"space.2"},{text:"Join the queue",bold:true,color:"#f2b71a"},{translate:"space.-300"},{text:"",font:"minecraft:lol",color:"white"}]

    execute as @a[tag=!champion,tag=!is_ingame] if score @s hotbar_menu matches 1 run title @s actionbar [{translate:"space.16"},{text:"How to play",bold:true,color:"#f2b71a"},{translate:"space.-293"},{text:"",font:"minecraft:lol",color:"white"}]
    execute as @a[tag=!champion,tag=!is_ingame] if score @s hotbar_menu matches 2 run title @s actionbar [{translate:"space.28"},{text:"Credits",bold:true,color:"#f2b71a"},{translate:"space.-280"},{text:"",font:"minecraft:lol",color:"white"}]

    ## MINION WAVE
    execute if score intervals minion_wave matches 0 run function lc:game/minion_wave/check
    execute if score unit_intervals minion_wave matches 0 run function lc:game/minion_wave/intervals

    execute if score intervals minion_wave matches 0.. run scoreboard players remove intervals minion_wave 1
    execute if score unit_intervals minion_wave matches 0.. run scoreboard players remove unit_intervals minion_wave 1

    ## MENU
    execute unless score _ingame game matches 1 as @a[tag=!champion] if score @s hotbar_menu matches 1 if score @s use_button matches 1 run function lc:game/menu/how_to_play
    execute unless score _ingame game matches 1 as @a[tag=!champion] if score @s hotbar_menu matches 2 if score @s use_button matches 1 run function lc:game/menu/credits

    ## QUEUE
    execute if score _inqueue game matches 1 as @a[tag=is_in_queue] run ride @s mount @e[tag=map_tour,limit=1,sort=nearest,type=item_display]
    execute if score _inqueue game matches 1 as @e[tag=map_tour,limit=1,sort=nearest,type=item_display] at @s run tp @s ~ ~ ~-0.267

    execute unless score _ingame game matches 1 as @a[tag=!champion] if score @s hotbar_menu matches 0 if score @s use_button matches 1 if entity @s[tag=!is_in_queue] if score players queue < max queue run function lc:game/queue/join
    execute unless score _ingame game matches 1 as @a[tag=!champion] if score @s hotbar_menu matches 0 if score @s use_button matches 1 if entity @s[tag=is_in_queue] run function lc:game/queue/leave
    execute store result bossbar queue value run scoreboard players get waittime queue
    execute if score _inqueue game matches 1 run bossbar set queue players @a[tag=is_in_queue]
    execute if score waittime queue matches 0.. run scoreboard players remove waittime queue 1

    execute if score waittime queue matches 200 run tellraw @a [{text:"Game starts in 10 seconds!",color:"gold"}]
    execute if score waittime queue matches 100 run tellraw @a [{text:"Game starts in 5 seconds!",color:"gold"}]
    execute if score waittime queue matches 80 run tellraw @a [{text:"Game starts in 4 seconds!",color:"gold"}]
    execute if score waittime queue matches 60 run tellraw @a [{text:"Game starts in 3 seconds!",color:"gold"}]
    execute if score waittime queue matches 40 run tellraw @a [{text:"Game starts in 2 seconds!",color:"gold"}]
    execute if score waittime queue matches 20 run tellraw @a [{text:"Game starts in 1 second!",color:"gold"}]
    execute if score waittime queue matches 5 run title @a times 20 20 5
    execute if score waittime queue matches 5 run title @a title [{text:"W",font:"minecraft:lol"}]

    execute if score _inqueue game matches 1 if score waittime queue matches 0 run schedule function lc:game/queue/start 1s replace

    ## ENDGAME
    execute if score _ingame game matches 1 as @a[tag=is_ingame] at @s run spectate @e[tag=endgame_pov,limit=1,sort=nearest]

    execute if score _ingame game matches 1 as @e[tag=endgame_animation,type=area_effect_cloud,limit=1] at @s as @e[tag=endgame_pov,type=item_display,distance=50..] at @s facing entity @e[tag=endgame_animation,type=area_effect_cloud,limit=1] feet run tp @s ^ ^ ^10 facing entity @e[tag=endgame,type=interaction,limit=1] feet
    execute if score _ingame game matches 1 as @e[tag=endgame_animation,type=area_effect_cloud,limit=1] at @s as @e[tag=endgame_pov,type=item_display,distance=5..50] at @s facing entity @e[tag=endgame_animation,type=area_effect_cloud,limit=1] feet run tp @s ^ ^ ^5 facing entity @e[tag=endgame,type=interaction,limit=1] feet
    execute if score _ingame game matches 1 as @e[tag=endgame_animation,type=area_effect_cloud,limit=1] at @s as @e[tag=endgame_pov,type=item_display,distance=..5] at @s facing entity @e[tag=endgame_animation,type=area_effect_cloud,limit=1] feet run tp @s ^ ^ ^1 facing entity @e[tag=endgame,type=interaction,limit=1] feet
    execute if score _ingame game matches 1 as @e[tag=endgame_animation,type=area_effect_cloud,limit=1] at @s run tp @e[tag=endgame_pov,type=item_display,distance=..1] ~ ~ ~ facing entity @e[tag=endgame,type=interaction,limit=1] feet

    scoreboard players set @a[scores={use_button=1..}] use_button 0
}

predicate hotbar_check {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:type_specific/player": {},
        "minecraft:nbt": "{Inventory:[{Slot:0b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:1b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:2b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:3b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:4b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:5b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:6b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:7b,components:{\"minecraft:custom_data\":{menu:1}}},{Slot:8b,components:{\"minecraft:custom_data\":{menu:1}}}]}"
    }
}

advancement load {
    "criteria": {
        "requirement": {
            "trigger": "minecraft:tick"
        }
    },
    "rewards": {
        "function": "lc:game/lobby/spawn"
    }
}
