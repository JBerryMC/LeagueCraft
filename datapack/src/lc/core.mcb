function uninstall {
    # Setup Scoreboard ( Run ONCE per world )
    # General Scoreboard
    tag @a remove admin
    clear @a structure_void

    execute as @e[tag=lol.bar_display,type=block_display] on passengers run kill @s
    kill @e[tag=lol.bar_display,type=block_display]

    execute as @a run function lc:core/champion/_reset
    function lc:core/dummy/clear
    execute at @s as @e[tag=lol.structure] if entity @s[tag=lol.structure.tower] at @s run function lc:core/structure/tower/remove

    function animated_java:aatrox/uninstall
    function animated_java:lol.structure.tower/uninstall

    execute if score .world lang matches 0 run tellraw @a {text:"\n\n\n\n\n\n\n\n\nLeagueCraft Datapack has been uninstalled",color:"red",bold:true}
    execute if score .world lang matches 1 run tellraw @a {text:"Datapack Liên Minh Huyền Thoại đã được gỡ cài đặt",color:"red",bold:true}

    gamerule send_command_feedback true
    gamerule natural_health_regeneration true
    gamerule fall_damage true
    gamerule fire_damage true

    execute as @e[tag=has_health_bar] on passengers run kill @s

    effect clear @e
    tag @e remove has_health_bar
    tag @e remove has_display_bar
    tag @e remove remove.bar
    tag @e remove update.shield.yasuo
    tag @e remove update.shield.leesin
    tag @e remove update.shield.yone
    tag @e remove update.shield.barrier
    tag @e remove update.shield_all
    tag @e remove update.bar.hp
    tag @e remove update.bar.mana

    scoreboard objectives remove uuid.1
    scoreboard objectives remove uuid.2
    scoreboard objectives remove uuid.3
    scoreboard objectives remove uuid.4

    scoreboard objectives remove aa.cd
    scoreboard objectives remove aa.spd
    scoreboard objectives remove aa.range
    scoreboard objectives remove aa.range.count

    scoreboard objectives remove spell
    scoreboard objectives remove mana_q
    scoreboard objectives remove mana_w
    scoreboard objectives remove mana_e
    scoreboard objectives remove mana_r

    scoreboard objectives remove haste

    scoreboard objectives remove base_cd.p
