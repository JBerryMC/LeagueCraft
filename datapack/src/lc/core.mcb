# lc:core/  (converted from the 1.20.2 LeagueCraft datapack)

function loop {
    # [26.3] drop-to-cast: refill the hand before hold_<x> checks (1.20.2 matched the dropped, count-0 stack)
    execute as @a[tag=champion,scores={use_ability=1..}] unless items entity @s weapon.mainhand * run function lc:champion/abilities/reload
    execute as @a[tag=champion,tag=!offhand_temp] unless predicate lc:champion/slot/offhand at @s run function lc:champion/spell/check_2

    ## Champion | Yasuo
    execute if entity @a[tag=yasuo] as @a[tag=yasuo] at @s run function lc:champions/yasuo/main
    execute if entity @a[tag=yasuo] run function lc:champions/yasuo/loop

    ## Champion | Lee Sin
    execute if entity @a[tag=leesin] as @a[tag=leesin] at @s run function lc:champions/leesin/main
    execute if entity @a[tag=leesin] run function lc:champions/leesin/loop

    ## Chaimpion | Zed
    execute if entity @a[tag=zed] as @a[tag=zed] at @s run function lc:champions/zed/main
    execute if entity @a[tag=zed] run function lc:champions/zed/loop

    ## Champion | Yone
    execute if entity @a[tag=yone] as @a[tag=yone] at @s run function lc:champions/yone/main
    execute if entity @a[tag=yone] run function lc:champions/yone/loop

    ## Champion | Ashe
    execute if entity @a[tag=ashe] as @a[tag=ashe] at @s run function lc:champions/ashe/main
    execute if entity @a[tag=ashe] run function lc:champions/ashe/loop

    ## Champion | Vayne
    execute if entity @a[tag=vayne] as @a[tag=vayne] at @s run function lc:champions/vayne/main
    execute if entity @a[tag=vayne] run function lc:champions/vayne/loop

    ## Champion | Ezreal
    execute if entity @a[tag=ezreal] as @a[tag=ezreal] at @s run function lc:champions/ezreal/main
    execute if entity @a[tag=ezreal] run function lc:champions/ezreal/loop

    ## Champion | Jhin
    execute if entity @a[tag=jhin] as @a[tag=jhin] at @s run function lc:champions/jhin/main
    execute if entity @a[tag=jhin] run function lc:champions/jhin/loop

    ## Champion | Aatrox
    execute if entity @a[tag=aatrox] as @a[tag=aatrox] at @s run function lc:champions/aatrox/main
    execute if entity @a[tag=aatrox] run function lc:champions/aatrox/loop

    ## Champion | Leona
    execute if entity @a[tag=leona] as @a[tag=leona] at @s run function lc:champions/leona/main
    execute if entity @a[tag=leona] run function lc:champions/leona/loop

    ## Champion | Soraka
    execute if entity @a[tag=soraka] as @a[tag=soraka] at @s run function lc:champions/soraka/main
    execute if entity @a[tag=soraka] run function lc:champions/soraka/loop

    ## Champion | Garen
    execute if entity @a[tag=garen] as @a[tag=garen] at @s run function lc:champions/garen/main
    execute if entity @a[tag=garen] run function lc:champions/garen/loop

    ## Champion | Malphite
    execute if entity @a[tag=malphite] as @a[tag=malphite] at @s run function lc:champions/malphite/main
    execute if entity @a[tag=malphite] run function lc:champions/malphite/loop

    ## Champion | Lux
    execute if entity @a[tag=lux] as @a[tag=lux] at @s run function lc:champions/lux/main
    execute if entity @a[tag=lux] run function lc:champions/lux/loop

    ## Champion | Annie
    execute if entity @a[tag=annie] as @a[tag=annie] at @s run function lc:champions/annie/main
    execute if entity @a[tag=annie] run function lc:champions/annie/loop

    # General
    function lc:mobs/main
    function lc:core/main
}

function main {
    ## Hotbar Handling

    execute as @a[tag=champion] unless predicate lc:champion/slot/hotbar.0 unless score @s use_ability matches 1.. run function lc:champion/abilities/reload
    execute as @a[tag=champion] unless predicate lc:champion/slot/hotbar.1 unless score @s use_ability matches 1.. run function lc:champion/abilities/reload
    execute as @a[tag=champion] unless predicate lc:champion/slot/hotbar.2 unless score @s use_ability matches 1.. run function lc:champion/abilities/reload
    execute as @a[tag=champion] unless predicate lc:champion/slot/hotbar.3 unless score @s use_ability matches 1.. run function lc:champion/abilities/reload
    execute as @a[tag=champion] unless predicate lc:champion/slot/hotbar.4 run function lc:champion/abilities/reload
    execute as @a[tag=champion] unless score @s status.weapon = @s status.weapon_old run function lc:champion/abilities/model

    ## Hurt and Damage
    execute as @e[type=text_display,tag=dmg_text] unless predicate lc:animation/dmg_indicator run kill @s
    execute as @e[type=#has_health_bar,tag=has_health_bar] if score @s dmg_physical.raw matches 1.. run function lc:champion/dmg/calc.physical
    execute as @e[type=#has_health_bar,tag=has_health_bar] if score @s dmg_physical.taken matches 1.. run function lc:champion/dmg/taken/physical

    execute as @e[type=#has_health_bar,tag=has_health_bar] if score @s dmg_magic.raw matches 1.. run function lc:champion/dmg/calc.magic
    execute as @e[type=#has_health_bar,tag=has_health_bar] if score @s dmg_magic.taken matches 1.. run function lc:champion/dmg/taken/magic

    execute as @e[type=#has_health_bar,tag=has_health_bar] if score @s dmg_true.raw matches 1.. run function lc:champion/dmg/calc.true
    execute as @e[type=#has_health_bar,tag=has_health_bar] if score @s dmg_true.taken matches 1.. run function lc:champion/dmg/taken/true

    execute as @e[type=#has_health_bar,tag=has_health_bar] if score @s healing matches 1.. run function lc:champion/dmg/calc.healing

    ##
    execute if entity @e[type=item_display,tag=lol.auto_clear] as @e[type=item_display,tag=lol.auto_clear] unless data entity @s Passengers[{Tags:["cd"]}] run function lc:animation/abilities/clear
    execute if entity @e[type=area_effect_cloud,tag=shield.all] as @e[type=area_effect_cloud,tag=shield.all] unless data entity @s Passengers run function lc:champion/dmg/shield/off

    ## Crowd Control and Bonus Effects

    execute as @e[type=#has_health_bar] at @s if score @s channeling matches 0.. run function lc:core/effect/channeling

    execute as @e[type=#has_health_bar] at @s if score @s fx.invis matches 0.. run function lc:core/effect/invis
    execute as @e[type=#has_health_bar] at @s if score @s fx.ghost matches 0.. run function lc:core/effect/ghost

    execute as @e[type=#has_health_bar] at @s if score @s cc.silence matches 0.. run function lc:core/effect/silence
    execute as @e[type=#has_health_bar] at @s if score @s cc.stun matches 0.. run function lc:core/effect/stun
    execute as @e[type=#has_health_bar] at @s if score @s cc.root matches 0.. run function lc:core/effect/root
    execute as @e[type=#has_health_bar] at @s if score @s cc.airborne matches 0.. run function lc:core/effect/airborne
    execute as @e[type=#has_health_bar] at @s if score @s cc.exhaust matches 0.. run function lc:core/effect/exhaust
    execute as @e[type=#has_health_bar] at @s if score @s cc.cripple matches 0.. run function lc:core/effect/cripple
    execute as @e[type=#has_health_bar] at @s if score @s cc.ignite matches 0.. run function lc:core/effect/ignite

    ## Status Effect
    execute as @e[type=#has_health_bar] at @s if score @s fx.cc_immune matches 0.. run function lc:core/effect/cc_immune
    execute as @e[type=#has_health_bar] at @s if score @s fx.sight matches 0.. run function lc:core/effect/sight

    ## STRUCTURE | Tower
    execute if entity @e[type=interaction,tag=lol.structure.tower,tag=!is_stunned,tag=!is_destroyed] as @e[type=interaction,tag=lol.structure.tower,tag=!is_stunned,tag=!is_destroyed] at @s run function lc:core/structure/tower/main
    execute if entity @e[type=interaction,tag=lol.structure.tower,tag=!is_destroyed] as @e[type=interaction,tag=lol.structure.tower,tag=!is_destroyed] at @s if score @s cc.stun matches 0.. run function lc:core/structure/tower/stun

    execute if entity @e[type=area_effect_cloud,tag=tower.shot,tag=!temp] as @e[type=area_effect_cloud,tag=tower.shot,tag=!temp] at @s run function lc:core/structure/tower/shot.find_target

    ## STRUCTURE | Inhibitor
    execute if entity @e[type=interaction,tag=lol.structure.inhib,tag=is_destroyed] as @e[type=interaction,tag=lol.structure.inhib,tag=is_destroyed] at @s if score @s death_time matches 0 run function lc:core/structure/inhib/rebuild

    ## NPC | Minion
    execute if entity @e[type=#can_aggro,tag=lol.minion] as @e[type=#can_aggro,tag=lol.minion] at @s run function lc:core/minion/ai

    ## Settings
    execute if entity @a[tag=champion,scores={settings.refresh_mana=1}] as @a[tag=champion,scores={settings.refresh_mana=1}] run function lc:core/set/practice.mana
    execute if entity @a[tag=champion,scores={settings.refresh_cd=1}] as @a[tag=champion,scores={settings.refresh_cd=1}] run function lc:core/set/practice.cd
    execute if entity @a[tag=champion,scores={settings.refresh_hp=1}] as @a[tag=champion,scores={settings.refresh_hp=1}] run function lc:core/set/practice.hp

    ## Animation
    ### Spinning
    execute if entity @e[type=item_display,tag=spin1] as @e[type=item_display,tag=spin1] at @s unless predicate lc:animation/spin1 run function lc:animation/spin1
    execute if entity @e[type=item_display,tag=spin2] as @e[type=item_display,tag=spin2] at @s unless predicate lc:animation/spin2 run function lc:animation/spin2
    execute if entity @e[type=item_display,tag=spin3] as @e[type=item_display,tag=spin3] at @s unless predicate lc:animation/spin3 run function lc:animation/spin3
    execute if entity @e[type=item_display,tag=spin4] as @e[type=item_display,tag=spin4] at @s unless predicate lc:animation/spin4 run function lc:animation/spin4

    ## Auto Attack (champions' basic attack is the plugin's hitscan)
    #execute as @a[tag=champion] at @s anchored eyes positioned ^ ^ ^1 run particle flame ~ ~ ~ 0 0 0 0 1

    execute if entity @e[tag=homing,type=#unvalid] as @e[tag=homing,type=#unvalid] at @s run function lc:champion/aa/ranged.homing

    #execute as @e[tag=aa,tag=set] at @s run function lc:champion/aa/loop

    ## Stats Bar
    execute as @e[scores={shield.all=1..},type=#has_health_bar] run function lc:champion/hp/percentage_shield_all
    execute as @e[tag=has_health_bar,type=#has_health_bar] run function lc:champion/hp/percentage
    execute as @e[tag=has_health_bar,tag=champion,type=#has_health_bar] run function lc:champion/mana/percentage

    execute as @e[tag=lol.bar_display,type=block_display] at @s run function lc:champion/bar_display

    ## Death and Respawn
    execute as @a[tag=dead,scores={death_time=0..}] run title @s title {score:{name:"@s",objective:"death_time"}}
    execute as @a[tag=dead,scores={death_time=0}] at @s run function lc:champion/respawn

    ## Scoreboard Control
    scoreboard players remove @e[scores={aa.cd=1..},type=#has_health_bar] aa.cd 1

    scoreboard players remove @e[scores={channeling=0..},type=#has_health_bar] channeling 1
    scoreboard players remove @e[scores={wound=0..},type=#has_health_bar] wound 1

    scoreboard players remove @e[scores={fx.ghost=0..},type=#has_health_bar] fx.ghost 1
    scoreboard players remove @e[scores={fx.cc_immune=0..},type=#has_health_bar] fx.cc_immune 1
    scoreboard players remove @e[scores={fx.invis=0..},type=#has_health_bar] fx.invis 1
    scoreboard players remove @e[scores={fx.sight=0..},type=#has_health_bar] fx.sight 1

    scoreboard players remove @e[scores={cc.silence=0..},type=#has_health_bar] cc.silence 1
    scoreboard players remove @e[scores={cc.airborne=0..},type=#has_health_bar] cc.airborne 1
    scoreboard players remove @e[scores={cc.stun=0..},type=#has_health_bar] cc.stun 1
    scoreboard players remove @e[scores={cc.root=0..},type=#has_health_bar] cc.root 1
    scoreboard players remove @e[scores={cc.cripple=0..},type=#has_health_bar] cc.cripple 1
    scoreboard players remove @e[scores={cc.exhaust=0..},type=#has_health_bar] cc.exhaust 1
    scoreboard players remove @e[scores={cc.ignite=0..},type=#has_health_bar] cc.ignite 1

    scoreboard players remove @e[scores={death_time=0..},type=#has_health_bar] death_time 1

    scoreboard players remove @a[scores={garen.e.duration=1..}] garen.e.duration 1

    scoreboard players set @a[scores={_mc.dmg_resist=1..}] _mc.dmg_resist 0

    scoreboard players set @a[scores={use_sword=1..}] use_sword 0
    scoreboard players set @a[scores={drop_sword=1..}] drop_sword 0
    scoreboard players set @a[scores={use_trident=1..}] use_trident 0
    scoreboard players set @a[scores={use_ability=1..}] use_ability 0
    scoreboard players set @a[scores={rclick=1..}] rclick 0
    scoreboard players set @a[scores={shift=1..}] shift 0

    scoreboard players set @a[scores={sneak=1..}] sneak 0
    scoreboard players set @a[scores={walk=1..}] walk 0
    scoreboard players set @a[scores={run=1..}] run 0

    scoreboard players set @a[scores={dmgdeal=1..}] dmgdeal 0
    scoreboard players set @a[scores={hurt=1..}] hurt 0
    scoreboard players set @a[scores={resist=1..}] resist 0
    scoreboard players set @a[scores={absorb=1..}] absorb 0

    scoreboard players set @a[scores={death=1..}] death 0

    scoreboard players set @a[scores={cd_spell.1=..-1}] cd_spell.1 0
    scoreboard players set @a[scores={cd_spell.2=..-1}] cd_spell.2 0
    scoreboard players set @e[scores={cd_p=..-1}] cd_p 1
    scoreboard players set @a[scores={cd_q=..-1}] cd_q 0
    scoreboard players set @a[scores={cd_w=..-1}] cd_w 0
    scoreboard players set @a[scores={cd_e=..-1}] cd_e 0
    scoreboard players set @a[scores={cd_r=..-1}] cd_r 0
}

function main_10t {
    schedule function lc:core/main_10t 10t replace
}

function main_20t {
    schedule function lc:core/main_20t 20t replace

    execute as @a[tag=champion,tag=!dead] unless score @s mana >= @s mana.max run scoreboard players operation @s mana += @s mana.regen
    execute as @e[tag=has_health_bar,tag=!dead,type=#has_health_bar] unless score @s hp.left >= @s hp.max run scoreboard players operation @s hp.left += @s hp.regen

    execute as @a[tag=champion,tag=!dead] if score @s mana > @s mana.max run scoreboard players operation @s mana = @s mana.max
    execute as @e[tag=has_health_bar,tag=!dead,type=#has_health_bar] if score @s hp.left > @s hp.max run scoreboard players operation @s hp.left = @s hp.max

    scoreboard players remove @e[scores={cd_spell.1=1..},type=#has_health_bar] cd_spell.1 1
    scoreboard players remove @e[scores={cd_spell.2=1..},type=#has_health_bar] cd_spell.2 1
    scoreboard players remove @e[scores={cd_p=1..},type=#has_health_bar] cd_p 1
    scoreboard players remove @e[scores={cd_q=1..},type=#has_health_bar] cd_q 1
    scoreboard players remove @e[scores={cd_w=1..},type=#has_health_bar] cd_w 1
    scoreboard players remove @e[scores={cd_e=1..},type=#has_health_bar] cd_e 1
    scoreboard players remove @e[scores={cd_r=1..},type=#has_health_bar] cd_r 1

    execute as @e[tag=dummy,type=#has_health_bar] if score @s mana matches 1.. run scoreboard players remove @s mana 1
    execute as @e[tag=dummy,type=#has_health_bar] if score @s mana matches 0 on passengers if score @s[tag=dmg_check] dmg_total.taken matches 1.. on vehicle as @s[tag=dummy] run function lc:core/dummy/reset

    # Champion Scoreboard | Zed
    scoreboard players remove @e[scores={zed_p_cd=1..},type=#has_health_bar] zed_p_cd 1

    # Champion Scoreboard | Leona
    scoreboard players remove @e[scores={leona.passive=1..},type=#has_health_bar] leona.passive 1

    # Champion Scoreboard | Soraka
    effect give @e[scores={soraka.passive=1..},type=#has_health_bar] speed 1 1 false
    tag @e[scores={soraka.passive=1..},type=#has_health_bar] add is_heal_target
    execute as @e[scores={soraka.passive=1..},team=red,type=#has_health_bar] as @p[tag=soraka,team=red] run function lc:champions/soraka/skills/passive.healing
    execute as @e[scores={soraka.passive=1..},team=blue,type=#has_health_bar] as @p[tag=soraka,team=blue] run function lc:champions/soraka/skills/passive.healing
    scoreboard players remove @e[scores={soraka.passive=1..},type=#has_health_bar] soraka.passive 1

    # Champion Scoreboard | Garen
    execute as @a[tag=garen,scores={cd_p=0}] if score @s hp.left < @s hp.max run tag @s add is_heal_target
    execute as @a[tag=garen,scores={cd_p=0},tag=is_heal_target,team=red] run function lc:champions/garen/skills/passive.healing
    execute as @a[tag=garen,scores={cd_p=0},tag=is_heal_target,team=blue] run function lc:champions/garen/skills/passive.healing

    # Champion Scoreboard | Lux
    scoreboard players remove @e[scores={lux.passive=1..},type=#has_health_bar] lux.passive 1

    # Champion Scoreboard | Annie
    scoreboard players remove @e[scores={annie.r.duration=1..},type=#has_health_bar] annie.r.duration 1
    scoreboard players remove @e[scores={annie.r.skill=1..},type=#has_health_bar] annie.r.skill 1
}

function main_2t {
    schedule function lc:core/main_2t 2t replace

    execute as @e[type=#has_health_bar,tag=!dead,tag=!unvalid,type=!interaction] at @s if predicate lc:core/hide_on_bush if score @s fx.invis matches ..2 run scoreboard players set @s fx.invis 2
}

function reload {
    # Head bars are off for now: remove any left from before.
    execute as @e[tag=lol.bar_display,type=block_display] on passengers run kill @s
    kill @e[tag=lol.bar_display,type=block_display]
    function lc:core/setup
    #execute if score .world lang matches 0 run function lc:core/lang/eng.load
    #execute if score .world lang matches 1 run function lc:core/lang/vie.load
    say LoL Datapack reloaded

    scoreboard players set @a cd_p 0
    scoreboard players set @a cd_q 0
    scoreboard players set @a cd_w 0
    scoreboard players set @a cd_e 0
    scoreboard players set @a cd_r 0

    scoreboard players set @a cd_spell.1 0
    scoreboard players set @a cd_spell.2 0

    scoreboard players set @a mana 0

    scoreboard players set @a rclick 0
    scoreboard players set @a use_sword 0
    scoreboard players set @a use_ability 0
    scoreboard players set @a shift 0

    scoreboard players set @a sneak 0
    scoreboard players set @a walk 0
    scoreboard players set @a run 0
}

function setup {
    # Setup Scoreboard ( Run ONCE per world )
    # General Scoreboard
    gamerule mob_drops false
    gamerule spawn_mobs false
    gamerule keep_inventory true
    gamerule block_drops false
    gamerule mob_griefing false
    gamerule command_block_output false
    gamerule send_command_feedback false
    gamerule natural_health_regeneration false
    gamerule fall_damage false
    gamerule fire_damage false
    gamerule immediate_respawn true

    ## Minecraft Scoreboard
    scoreboard objectives add _mc.dmg_resist minecraft.custom:minecraft.damage_resisted

    ## Auto Attack
    scoreboard objectives add aa.spd dummy
    scoreboard objectives add aa.cd dummy
    scoreboard objectives add aa.range dummy
    scoreboard objectives add aa.range.count dummy
    scoreboard objectives add ammo.max dummy
    scoreboard objectives add ammo.reload dummy
    scoreboard objectives add aim.q dummy
    scoreboard objectives add aim.q.radius dummy
    scoreboard objectives add aim.w dummy
    scoreboard objectives add aim.w.radius dummy
    scoreboard objectives add aim.e dummy
    scoreboard objectives add aim.e.radius dummy
    scoreboard objectives add aim.r dummy
    scoreboard objectives add aim.r.radius dummy
    scoreboard objectives add ammo.left dummy
    scoreboard objectives add ammo.reloading dummy
    scoreboard objectives add motion.x dummy
    scoreboard objectives add motion.y dummy
    scoreboard objectives add motion.z dummy
    scoreboard objectives add motion.ticks dummy
    scoreboard objectives add motion.px dummy
    scoreboard objectives add motion.py dummy
    scoreboard objectives add motion.pz dummy

    ## Abilities
    scoreboard objectives add spell.1 dummy
    scoreboard objectives add spell.2 dummy
    scoreboard objectives add mana_q dummy
    scoreboard objectives add mana_w dummy
    scoreboard objectives add mana_e dummy
    scoreboard objectives add mana_r dummy

    ## Cooldown
    scoreboard objectives add haste dummy

    scoreboard objectives add base_cd.p dummy
    scoreboard objectives add base_cd.q dummy
    scoreboard objectives add base_cd.w dummy
    scoreboard objectives add base_cd.e dummy
    scoreboard objectives add base_cd.r dummy

    scoreboard objectives add cd_p dummy
    scoreboard objectives add cd_q dummy
    scoreboard objectives add cd_w dummy
    scoreboard objectives add cd_e dummy
    scoreboard objectives add cd_r dummy

    scoreboard objectives add cd_spell.1 dummy
    scoreboard objectives add cd_spell.2 dummy

    ## HUD display
    scoreboard objectives add status.hotbar dummy
    scoreboard objectives add status.weapon dummy
    scoreboard objectives add status.weapon_old dummy

    scoreboard objectives add status.p dummy
    scoreboard objectives add status.q dummy
    scoreboard objectives add status.w dummy
    scoreboard objectives add status.e dummy
    scoreboard objectives add status.r dummy

    scoreboard objectives add status.spell.1 dummy
    scoreboard objectives add status.spell.2 dummy

    scoreboard objectives add space.passive dummy
    scoreboard objectives add space.q dummy
    scoreboard objectives add space.w dummy
    scoreboard objectives add space.e dummy
    scoreboard objectives add space.r dummy
    scoreboard objectives add space.spell.1 dummy
    scoreboard objectives add space.spell.2 dummy
    scoreboard objectives add space.hp1 dummy
    scoreboard objectives add space.hp2 dummy
    scoreboard objectives add space.mana1 dummy
    scoreboard objectives add space.mana2 dummy

    ## Crowd Control
    scoreboard objectives add fx.ghost dummy
    scoreboard objectives add fx.invis dummy
    scoreboard objectives add fx.sight dummy
    scoreboard objectives add fx.cc_immune dummy
    scoreboard objectives add channeling dummy
    scoreboard objectives add cc.ignite dummy
    scoreboard objectives add cc.silence dummy
    scoreboard objectives add cc.airborne dummy
    scoreboard objectives add cc.root dummy
    scoreboard objectives add cc.stun dummy
    scoreboard objectives add cc.exhaust dummy
    scoreboard objectives add cc.cripple dummy

    ## Motion
    scoreboard objectives add pos_x1 dummy
    scoreboard objectives add pos_y1 dummy
    scoreboard objectives add pos_z1 dummy
    scoreboard objectives add pos_x2 dummy
    scoreboard objectives add pos_y2 dummy
    scoreboard objectives add pos_z2 dummy

    scoreboard objectives add rot.x dummy

    scoreboard objectives add mot_x dummy
    scoreboard objectives add mot_y dummy
    scoreboard objectives add mot_z dummy

    ## Statistics
    scoreboard objectives add attack_damage dummy
    scoreboard objectives add ability_power dummy
    scoreboard objectives add magic_resist dummy
    scoreboard objectives add armor dummy
    scoreboard objectives add shield.all dummy
    scoreboard objectives add shield_all.percentage dummy
    scoreboard objectives add shield_all.percentage_old dummy
    scoreboard objectives add shield.physical dummy
    scoreboard objectives add shield_physical.percentage dummy
    scoreboard objectives add shield_physical.percentage_old dummy
    scoreboard objectives add shield.magic dummy
    scoreboard objectives add shield_magic.percentage dummy
    scoreboard objectives add shield_magic.percentage_old dummy

    scoreboard objectives add armor.reduced dummy
    scoreboard objectives add armor.base dummy
    scoreboard objectives add armor.pen dummy
    scoreboard objectives add magic_resist.reduced dummy
    scoreboard objectives add magic_resist.pen dummy
    scoreboard objectives add magic_resist.base dummy

    scoreboard objectives add healing dummy
    scoreboard objectives add healnshield_power dummy
    scoreboard objectives add omnivamp dummy
    scoreboard objectives add wound dummy

    scoreboard objectives add hp.regen dummy
    scoreboard objectives add hp.max dummy
    scoreboard objectives add hp.left dummy
    scoreboard objectives add hp.percentage dummy
    scoreboard objectives add hp.percentage_old dummy
    scoreboard objectives add hp.percentage_lost dummy
    scoreboard objectives add mana dummy
    scoreboard objectives add mana.regen dummy
    scoreboard objectives add mana.max dummy
    scoreboard objectives add mana.percentage dummy
    scoreboard objectives add mana.percentage_old dummy

    scoreboard objectives add death_time dummy

    ## Damage
    scoreboard objectives add dmg_debuff dummy
    scoreboard objectives add dmg_reduction dummy
    scoreboard objectives add dmg_total.taken dummy
    scoreboard objectives add dmg_physical.deal dummy
    scoreboard objectives add dmg_physical.raw dummy
    scoreboard objectives add dmg_physical.taken dummy
    scoreboard objectives add dmg_magic.deal dummy
    scoreboard objectives add dmg_magic.raw dummy
    scoreboard objectives add dmg_magic.taken dummy
    scoreboard objectives add dmg_true.deal dummy
    scoreboard objectives add dmg_true.raw dummy
    scoreboard objectives add dmg_true.taken dummy

    ## DoT
    scoreboard objectives add dot.tick dummy

    ## Mechanics
    scoreboard objectives add timer dummy
    scoreboard objectives add temp dummy

    scoreboard objectives add rclick minecraft.used:minecraft.carrot_on_a_stick
    scoreboard objectives add use_sword minecraft.used:minecraft.iron_sword
    scoreboard objectives add drop_sword minecraft.dropped:minecraft.iron_sword
    scoreboard objectives add use_trident minecraft.used:minecraft.trident
    scoreboard objectives add use_ability minecraft.custom:minecraft.drop
    scoreboard objectives add shift minecraft.custom:minecraft.sneak_time

    scoreboard objectives add sneak minecraft.custom:minecraft.crouch_one_cm
    scoreboard objectives add walk minecraft.custom:minecraft.walk_one_cm
    scoreboard objectives add run minecraft.custom:minecraft.sprint_one_cm

    scoreboard objectives add dmgdeal minecraft.custom:minecraft.damage_dealt
    scoreboard objectives add hurt minecraft.custom:minecraft.damage_taken
    scoreboard objectives add resist minecraft.custom:minecraft.damage_resisted
    scoreboard objectives add absorb minecraft.custom:minecraft.damage_absorbed

    #scoreboard objectives setdisplay below_name hp.left
    #scoreboard objectives modify hp.left displayname {"text":"❤","color":"red"}
    scoreboard objectives add death deathCount

    ## Language
    scoreboard objectives add lang dummy
    execute unless score .world lang matches 0.. run scoreboard players set .world lang 0

    ## Settings
    scoreboard objectives add settings.page dummy
    scoreboard objectives add settings.refresh_hp dummy
    scoreboard objectives add settings.refresh_mana dummy
    scoreboard objectives add settings.refresh_cd dummy

    scoreboard objectives add settings.show_stats dummy
    execute unless score .world settings.show_stats matches 0.. run scoreboard players set .world settings.show_stats 1

    scoreboard objectives add settings.show_dmg dummy
    execute unless score .world settings.show_dmg matches 0.. run scoreboard players set .world settings.show_dmg 1

    ## Integer
    scoreboard objectives add integer dummy
    scoreboard players set 1 integer 1
    scoreboard players set 2 integer 2
    scoreboard players set 3 integer 3
    scoreboard players set 6 integer 6
    scoreboard players set 7 integer 7
    scoreboard players set 8 integer 8
    scoreboard players set 9 integer 9
