    scoreboard players set 75 integer 75
    scoreboard players set 85 integer 85
    scoreboard players set 90 integer 90
    scoreboard players set 100 integer 100
    scoreboard players set 120 integer 120
    scoreboard players set 125 integer 125
    scoreboard players set 130 integer 130
    scoreboard players set 150 integer 150
    scoreboard players set 200 integer 200
    scoreboard players set 15625 integer 15625
    scoreboard players set 10000 integer 10000
    scoreboard players set -1 integer -1

    ## Team Scoreboard
    team add red {"text":"Red"}
    team add blue {"text":"Blue"}
    team modify red nametagVisibility never
    team modify red collisionRule always
    team modify blue collisionRule always
    team modify blue nametagVisibility never
    team modify red friendlyFire false
    team modify blue friendlyFire false
    team modify red seeFriendlyInvisibles false
    team modify blue seeFriendlyInvisibles false
    team modify red color red
    team modify blue color blue

    team add noname
    team modify noname nametagVisibility never
    team add nocollision
    team modify nocollision collisionRule never

    # Champion Scoreboard | Yasuo
    scoreboard objectives add stack_q dummy

    # Champion Scoreboard | LeeSin
    scoreboard objectives add stack_p dummy

    # Champion Scoreboard | Zed
    scoreboard objectives add zed_p_cd dummy
    scoreboard objectives add zed.r.dmg dummy

