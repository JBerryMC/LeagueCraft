    scoreboard objectives remove resist
    scoreboard objectives remove absorb

    scoreboard objectives remove death

    scoreboard objectives remove lang

    scoreboard objectives remove _mc.dmg_resist
    scoreboard objectives remove cc.airborne
    scoreboard objectives remove cc.exhaust
    scoreboard objectives remove cc.root
    scoreboard objectives remove cc.stun
    scoreboard objectives remove channeling
    scoreboard objectives remove fx.cc_immune
    scoreboard objectives remove fx.invis
    scoreboard objectives remove fx.sight

    scoreboard objectives remove settings.page
    scoreboard objectives remove settings.refresh_cd
    scoreboard objectives remove settings.refresh_hp
    scoreboard objectives remove settings.refresh_mana
    scoreboard objectives remove settings.show_dmg
    scoreboard objectives remove settings.show_stats

    scoreboard objectives remove death_time

    scoreboard objectives remove integer
    data remove storage lol:main hp
    data remove storage lol:main keybind
    data remove storage lol:main mana
    data remove storage lol:main temp

    # Team Scoreboard
    team remove red
    team remove blue

    # Champion Scoreboard | Yasuo
    scoreboard objectives remove stack_q

    # Champion Scoreboard | LeeSin
    scoreboard objectives remove stack_p

    # Champion Scoreboard | Zed
    scoreboard objectives remove zed_p_cd
    scoreboard objectives remove zed.r.dmg

    # Champion Scoreboard | Yone
    scoreboard objectives remove yone.passive
    scoreboard objectives remove yone.w.count
    scoreboard objectives remove yone.e.dmg

    # Champion Scoreboard | Ashe
    scoreboard objectives remove ashe.e.stack
    scoreboard objectives remove ashe.q.stack

    # Champion Scorebaord | Vayne
    scoreboard objectives remove vayne.w.stack
    scoreboard objectives remove vayne.r.duration
    bossbar remove red.vayne.r
    bossbar remove blue.vayne.r

    # Champion Scoreboard | Ezreal

    # CHampion Scoreboard | Jhin
    scoreboard objectives remove jhin.aa.count
    scoreboard objectives remove jhin.q.count
    scoreboard objectives remove jhin.r.count
    scoreboard objectives remove jhin.r.channel
}

predicate hide_on_bush {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:location": {
            "block": {
                "blocks": [
                    "short_grass",
                    "minecraft:tall_grass",
                    "minecraft:fern",
                    "minecraft:large_fern"
                ]
            }
        }
    }
}

predicate is_flying {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:type_specific/player": {},
        "minecraft:vehicle": {
            "minecraft:entity_type": "minecraft:horse",
            "minecraft:nbt": "{Tags:[\"lol.is_flying\"]}"
        }
    }
}

