    scoreboard objectives remove cd_w
    scoreboard objectives remove cd_e
    scoreboard objectives remove cd_r

    scoreboard objectives remove cd_spell.1
    scoreboard objectives remove cd_spell.2

    scoreboard objectives remove status.hotbar
