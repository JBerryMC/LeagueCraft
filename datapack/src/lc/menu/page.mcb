    item replace entity @s inventory.6 with structure_void[minecraft:custom_name={text:"Rotate Structure",italic:false},minecraft:custom_model_data={floats:[100212f]},minecraft:custom_data={kill_item:1}]
    item replace entity @s inventory.15 with structure_void[minecraft:custom_name={text:"[PLACEHOLDER]",italic:false},minecraft:custom_model_data={floats:[100212f]},minecraft:custom_data={kill_item:1}]
