    execute if score .world settings.show_stats matches 1 run item modify entity @s inventory.6 lc:menu/active

    item replace entity @s inventory.15 with structure_void[minecraft:custom_name={text:"Damage Display",italic:false},minecraft:lore=[{text:"False",color:"red",italic:false}],minecraft:custom_model_data={floats:[100208f]},minecraft:custom_data={kill_item:1}]
    execute if score .world settings.show_dmg matches 1 run item modify entity @s inventory.15 lc:menu/active
}

function 21 {
    ## ----------------------------------------------------------------------------------------------------------------- ##
    #   Spawn ( Red | Blue ) Tower
    #   Spawn ( Red | Blue ) Inhibitor
    #   Spawn ( Red | Blue ) Nexus
    #   -Toggle- Tower Invincible
    #   -Toggle- Tower Fire
    #   -Toggle- Minion Spawn
    #   ( Destroy | Rebuild | Remove ) a structure
    #   ( Destroy | Rebuild | Remove ) ALL structure
    #   Rotate structure ( Clockwise | Counter-Clockwise )

    item replace entity @s inventory.2 with structure_void[minecraft:custom_name={text:"Spawn Red Tower",italic:false},minecraft:custom_model_data={floats:[100210f]},minecraft:custom_data={kill_item:1}]
