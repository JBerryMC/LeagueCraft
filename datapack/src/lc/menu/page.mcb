function 20 {
    item replace entity @s inventory.2 with structure_void[minecraft:custom_name={text:"Auto-Refresh HP",italic:false},minecraft:lore=[{text:"False",color:"red",italic:false}],minecraft:custom_model_data={floats:[100201f]},minecraft:custom_data={kill_item:1}]
    item modify entity @s[scores={settings.refresh_hp=1..}] inventory.2 lc:menu/active

    item replace entity @s inventory.11 with structure_void[minecraft:custom_name={text:"Auto-Refresh Mana/Energy",italic:false},minecraft:lore=[{text:"False",color:"red",italic:false}],minecraft:custom_model_data={floats:[100202f]},minecraft:custom_data={kill_item:1}]
    item modify entity @s[scores={settings.refresh_mana=1..}] inventory.11 lc:menu/active

    item replace entity @s inventory.20 with structure_void[minecraft:custom_name={text:"Auto-Refresh Cooldowns",italic:false},minecraft:lore=[{text:"False",color:"red",italic:false}],minecraft:custom_model_data={floats:[100203f]},minecraft:custom_data={kill_item:1}]
    item modify entity @s[scores={settings.refresh_cd=1..}] inventory.20 lc:menu/active

    item replace entity @s inventory.4 with structure_void[minecraft:custom_name={text:"Spawn Enemy Dummy",italic:false},minecraft:custom_model_data={floats:[100204f]},minecraft:custom_data={kill_item:1}]
    item replace entity @s inventory.13 with structure_void[minecraft:custom_name={text:"Spawn Ally Dummy",italic:false},minecraft:custom_model_data={floats:[100205f]},minecraft:custom_data={kill_item:1}]
