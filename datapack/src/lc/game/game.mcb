# lc:game/game/  (converted from the 1.20.2 LeagueCraft datapack)

function clean_up {
    tag @s remove unvalid
    tag @s remove red_tower.is_in_range
    tag @s remove blue_tower.is_in_range
    tag @s remove red_tower.target
    tag @s remove blue_tower.target
    tag @s add remove.shield
    execute as @e[type=area_effect_cloud,tag=shield.all] run function lc:champion/dmg/shield/check_origin

    scoreboard players operation @s hp.left = @s hp.maxw
    execute unless entity @s[tag=!useMana,tag=!useEnergy] run scoreboard players operation @s mana = @s mana.max

    scoreboard players set @s wound 0
    scoreboard players set @s dmg_magic.deal 0
    scoreboard players set @s dmg_physical.deal 0
    scoreboard players set @s dmg_true.deal 0

    #Yasuo & Yone
    tag @s remove full_p
    tag @s remove full_q
    scoreboard players set @s stack_q 0
    execute if entity @s[tag=yasuo] run scoreboard players set @s mana 0

    execute if entity @s[tag=yone,team=red] as @e[tag=yone.e.body,tag=red] on passengers run kill @s
    execute if entity @s[tag=yone,team=blue] as @e[tag=yone.e.body,tag=blue] on passengers run kill @s

    #LeeSin
    scoreboard players set @s stack_p 0

    ## Zed
    execute if entity @s[tag=zed,team=red] as @e[tag=!red,tag=zed.r.mark] at @s run function lc:champions/zed/skills/r.end
    execute if entity @s[tag=zed,team=blue] as @e[tag=!blue,tag=zed.r.mark] at @s run function lc:champions/zed/skills/r.end
    execute if entity @s[tag=zed,team=red] run kill @e[tag=zed.shadow,tag=red]
    execute if entity @s[tag=zed,team=red] as @e[tag=zed.shadow.model,team=red] at @s run function lc:champions/zed/skills/shadow.model
    execute if entity @s[tag=zed,team=blue] run kill @e[tag=zed.shadow,tag=blue]
    execute if entity @s[tag=zed,team=blue] as @e[tag=zed.shadow.model,team=blue] at @s run function lc:champions/zed/skills/shadow.model

    #Pyke
    tag @s remove pyke

    #Ashe
    execute if entity @s[tag=ashe,team=red] run kill @e[team=red,tag=ashe.e,type=item_display]
    execute if entity @s[tag=ashe,team=blue] run kill @e[team=blue,tag=ashe.e,type=item_display]

    scoreboard players set @s ashe.q.stack 0

    #Vayne
    execute if entity @s[tag=vayne,team=red] run kill @e[team=red,tag=vayne.w.passive,type=armor_stand]
    execute if entity @s[tag=vayne,team=blue] run kill @e[team=blue,tag=vayne.w.passive,type=armor_stand]
    tag @s remove vayne
    scoreboard players set @s vayne.w.stack 0

    #Ezreal

    #Jhin
    execute if entity @s[tag=jhin,team=red] run kill @e[tag=red,tag=jhin.r.limit,type=area_effect_cloud]
    execute if entity @s[tag=jhin,team=red] run bossbar remove red.jhin.r
    execute if entity @s[tag=jhin,team=red] run kill @e[team=red,tag=jhin.trap,type=armor_stand]
    execute if entity @s[tag=jhin,team=red] run kill @e[team=red,tag=jhin.r.dummy,type=armor_stand]
    execute if entity @s[tag=jhin,team=blue] run kill @e[tag=blue,tag=jhin.r.limit,type=area_effect_cloud]
    execute if entity @s[tag=jhin,team=blue] run bossbar remove blue.jhin.r
    execute if entity @s[tag=jhin,team=blue] run kill @e[team=blue,tag=jhin.trap,type=armor_stand]
    execute if entity @s[tag=jhin,team=blue] run kill @e[team=blue,tag=jhin.r.dummy,type=armor_stand]
    tag @s remove jhin
    scoreboard players set @s jhin.aa.count 1

    ## Aatrox
    execute as @e[tag=aatrox.r,type=horse] at @s run function lc:champions/aatrox/skills/r.end

    ## Leona
    execute if entity @s[tag=leona.q] at @s run function lc:champions/leona/skills/q.end
    execute if entity @s[tag=leona.w] at @s run function lc:champions/leona/skills/w.end

    ## Garen
    execute if entity @s[tag=garen.q] at @s run function lc:champions/garen/skills/q.end
    execute if entity @s[tag=garen.w] at @s run function lc:champions/garen/skills/w.end
    execute if entity @s[tag=garen.e] at @s run function lc:champions/garen/skills/e.end

    ## Malphite
    execute if entity @s[tag=malphite.w] at @s run function lc:champions/malphite/skills/w.end

    ## Lux
    execute if entity @s[tag=lux,team=red] as @e[tag=lux.e.area,tag=red,type=item_display] at @s run function lc:champions/lux/skills/e.end
    execute if entity @s[tag=lux,team=blue] as @e[tag=lux.e.area,tag=blue,type=item_display] at @s run function lc:champions/lux/skills/e.end

    ## Annie
    execute if entity @s[tag=annie,team=red] as @e[tag=annie.r,team=red,type=#can_aggro] at @s run function lc:champions/annie/skills/r.end
    execute if entity @s[tag=annie,team=blue] as @e[tag=annie.r,team=blue,type=#can_aggro] at @s run function lc:champions/annie/skills/r.end

    tag @s remove r.animation
    tag @s remove w.animation

    scoreboard players set @s cd_p 0
    scoreboard players set @s cd_q 0
    scoreboard players set @s cd_w 0
    scoreboard players set @s cd_e 0
    scoreboard players set @s cd_r 0

    scoreboard players set @s cd_spell.1 0
    scoreboard players set @s cd_spell.2 0

    scoreboard players set @s rclick 0
    scoreboard players set @s use_sword 0
    scoreboard players set @s use_ability 0
    scoreboard players set @s shift 0

    scoreboard players set @s sneak 0
    scoreboard players set @s walk 0
    scoreboard players set @s run 0
}

function end {
    fill -14 187 231 -14 200 179 barrier keep
    fill 14 187 231 14 200 179 barrier keep
    fill -14 187 179 14 200 179 barrier keep

    fill -24 187 114 24 200 114 barrier keep

    fill -14 187 -231 -14 200 -179 barrier keep
    fill 14 187 -231 14 200 -179 barrier keep
    fill -14 187 -179 14 200 -179 barrier keep

    fill -24 187 -114 24 200 -114 barrier keep

    scoreboard players set intervals minion_wave -1
    scoreboard players set wave_count minion_wave 0
    scoreboard players set unit_count minion_wave 0
    scoreboard players set unit_intervals minion_wave -1

    execute as @e[tag=lol.minion,type=#can_aggro] on passengers run kill @s
    execute as @e[tag=lol.minion,type=#can_aggro] run kill @s

    tp @e[tag=dummy,type=pillager] 0 0 0
    function lc:core/dummy/clear

    kill @e[type=block_display]
    kill @e[type=text_display]
    kill @e[type=item_display]
    kill @e[type=area_effect_cloud]

    tag @a remove has_display_bar
    tag @a remove has_health_bar

    function animated_java:minion.melee/remove/all
    function animated_java:minion.caster/remove/all
    function animated_java:minion.siege/remove/all
    function animated_java:minion.super/remove/all

    scoreboard players set _endgame game 0
    scoreboard players set red game 0
    scoreboard players set blue game 0

    execute as @e[tag=lol.structure,type=interaction] if entity @s[tag=lol.structure.tower] at @s run function lc:core/structure/tower/remove
    execute as @e[tag=lol.structure,type=interaction] if entity @s[tag=lol.structure.inhib] at @s run function lc:core/structure/inhib/remove
    execute as @e[tag=lol.structure,type=interaction] if entity @s[tag=lol.structure.nexus] at @s run function lc:core/structure/nexus/remove

    ## BLUE SIDE
    execute positioned 0 187 -179 run function lc:core/structure/nexus/spawn.blue
    execute positioned 0 187 -126 run function lc:core/structure/inhib/spawn.blue

    execute positioned 12 187 -160 run function lc:core/structure/tower/spawn.blue
    execute positioned -12 187 -160 run function lc:core/structure/tower/spawn.blue

    execute positioned 0 188 -99 run function lc:core/structure/tower/spawn.blue
    execute positioned 0 188 -48 run function lc:core/structure/tower/spawn.blue

    ## RED SIDE
    execute positioned 0 187 179 run function lc:core/structure/nexus/spawn.red
    execute positioned 0 187 126 run function lc:core/structure/inhib/spawn.red

    execute positioned 12 187 160 run function lc:core/structure/tower/spawn.red
    execute positioned 12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned 12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    execute positioned -12 187 160 run function lc:core/structure/tower/spawn.red
    execute positioned -12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned -12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    execute positioned 0 188 99 run function lc:core/structure/tower/spawn.red
    execute positioned 0 188 99 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned 0 188 99 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    execute positioned 0 188 48 run function lc:core/structure/tower/spawn.red
    execute positioned 0 188 48 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned 0 188 48 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    bossbar set queue max 3000
    bossbar set queue color blue
    bossbar set queue name {text:"Waiting for players",color:"aqua",bold:true}

    scoreboard players set waittime queue -1
    scoreboard players set _ingame game 0
    scoreboard players set _inqueue game 0

    bossbar set queue visible false
    execute as @a[tag=is_ingame] at @s run function lc:game/lobby/spawn
}

function endgame_animation {
    scoreboard players set _endgame game 1
    tag @s add endgame

    stopsound @a master music.ingame
    stopsound @a master music.champion
    stopsound @a master music.queue

    kill @e[tag=lol.structure.entity,type=silverfish]
    function lc:menu/move/practice/show_stats

    execute rotated as @s positioned ^10 ^10 ^10 run summon area_effect_cloud ~ ~ ~ {Tags:["endgame_animation"],Duration:300,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}
    execute as @a[tag=is_ingame] at @s run summon item_display ~ ~ ~ {teleport_duration:1,Tags:["endgame_pov","lol.auto_clear"],Passengers:[{id:"area_effect_cloud",Tags:["cd"],Duration:300,custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}

    execute as @a[tag=is_ingame] at @s run function lc:core/effect/cleanse
    scoreboard players set @a[tag=is_ingame] channeling 0

    gamemode spectator @a[tag=is_ingame]
    tag @a[tag=is_ingame] add unvalid
    effect clear @a[tag=is_ingame]
    title @a[tag=is_ingame] actionbar " "

    execute if entity @s[tag=red] run scoreboard players set red game 1
    execute if entity @s[tag=blue] run scoreboard players set blue game 1

    schedule function lc:game/game/end 15s replace
    schedule function lc:game/game/endgame_title 6s replace
}

function endgame_title {
    title @a times 20 200 0

    execute if score red game matches 1 run playsound announcer.combat.defeat master @a[team=red] 0 0 0 1 1 1
    execute if score red game matches 1 run playsound announcer.combat.victory master @a[team=blue] 0 0 0 1 1 1
    execute if score red game matches 1 run title @a[team=red] title {text:"Defeat",color:"dark_red",bold:true}
    execute if score red game matches 1 run title @a[team=blue] title {text:"Victory",color:"gold",bold:true}

    execute if score blue game matches 1 run playsound announcer.combat.defeat master @a[team=blue] 0 0 0 1 1 1
    execute if score blue game matches 1 run playsound announcer.combat.victory master @a[team=red] 0 0 0 1 1 1
    execute if score blue game matches 1 run title @a[team=blue] title {text:"Defeat",color:"dark_red",bold:true}
    execute if score blue game matches 1 run title @a[team=red] title {text:"Victory",color:"gold",bold:true}
}

function start {
    bossbar set queue visible false
    tp @e[tag=dummy,type=pillager] 0 0 0
    function lc:core/dummy/clear

    stopsound @a master music.champion
    playsound music.ingame master @a 0 0 0 1 1 1
    schedule function lc:game/announce/game/start 5s replace

    scoreboard players set @a[tag=is_ingame] channeling 100
    scoreboard players set @a[tag=is_ingame] cc.silence 100
    effect give @a[tag=is_ingame] speed 20 4

    tag @a[tag=is_ingame] remove see_champ
    clear @a[tag=is_ingame] structure_void
    scoreboard players set @a[tag=is_ingame] settings.page 0
    execute as @a[tag=is_ingame] run function lc:menu/reset
    execute as @a[tag=is_ingame] run function lc:game/game/clean_up

    execute as @a[tag=is_ingame,tag=!champion] at @s run function lc:menu/champion/_random

    tp @a[team=red] 0 188 210 180 0
    tp @a[team=blue] 0 188 -210 0 0

    fill -14 187 231 -14 200 179 air replace barrier
    fill 14 187 231 14 200 179 air replace barrier
    fill -14 187 179 14 200 179 air replace barrier

    fill -24 187 114 24 200 114 air replace barrier

    fill -14 187 -231 -14 200 -179 air replace barrier
    fill 14 187 -231 14 200 -179 air replace barrier
    fill -14 187 -179 14 200 -179 air replace barrier

    fill -24 187 -114 24 200 -114 air replace barrier

    execute as @e[tag=lol.structure,type=interaction] if entity @s[tag=lol.structure.tower] run function lc:core/structure/tower/remove
    execute as @e[tag=lol.structure,type=interaction] if entity @s[tag=lol.structure.inhib] at @s run function lc:core/structure/inhib/remove
    execute as @e[tag=lol.structure,type=interaction] if entity @s[tag=lol.structure.nexus] at @s run function lc:core/structure/nexus/remove

    ## BLUE SIDE
    execute positioned 0 187 -179 run function lc:core/structure/nexus/spawn.blue
    execute positioned 0 187 -126 run function lc:core/structure/inhib/spawn.blue

    execute positioned 12 187 -160 run function lc:core/structure/tower/spawn.blue
    execute positioned -12 187 -160 run function lc:core/structure/tower/spawn.blue

    execute positioned 0 188 -99 run function lc:core/structure/tower/spawn.blue
    execute positioned 0 188 -48 run function lc:core/structure/tower/spawn.blue

    execute as @e[tag=lol.structure.nexus,type=interaction,tag=blue] at @s run tag @e[tag=lol.structure,type=interaction,tag=blue,sort=furthest,limit=1] add minion_origin

    ## RED SIDE
    execute positioned 0 187 179 run function lc:core/structure/nexus/spawn.red
    execute positioned 0 187 179 as @e[tag=lol.structure.nexus,limit=1,sort=nearest] at @s run function lc:core/structure/rotate
    execute positioned 0 187 179 as @e[tag=lol.structure.nexus,limit=1,sort=nearest] at @s run function lc:core/structure/rotate

    execute positioned 0 187 126 run function lc:core/structure/inhib/spawn.red
    execute positioned 0 187 126 as @e[tag=lol.structure.inhib,limit=1,sort=nearest] at @s run function lc:core/structure/rotate
    execute positioned 0 187 126 as @e[tag=lol.structure.inhib,limit=1,sort=nearest] at @s run function lc:core/structure/rotate

    execute positioned 12 187 160 run function lc:core/structure/tower/spawn.red
    execute positioned 12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned 12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    execute positioned -12 187 160 run function lc:core/structure/tower/spawn.red
    execute positioned -12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned -12 187 160 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    execute positioned 0 188 99 run function lc:core/structure/tower/spawn.red
    execute positioned 0 188 99 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned 0 188 99 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    execute positioned 0 188 48 run function lc:core/structure/tower/spawn.red
    execute positioned 0 188 48 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate
    execute positioned 0 188 48 as @e[tag=lol.structure.tower,limit=1,sort=nearest] at @s run function lc:core/structure/tower/rotate

    execute as @e[tag=lol.structure.nexus,type=interaction,tag=red] at @s run tag @e[tag=lol.structure,type=interaction,tag=red,sort=furthest,limit=1] add minion_origin

    scoreboard players set intervals minion_wave 100
}
