# lc:game/menu/  (converted from the 1.20.2 LeagueCraft datapack)

function credits {
    tellraw @s [{text:" ◀ Credits ▶ \n",color:"yellow",bold:true}]
    tellraw @s [{text:"Map Creator: ",color:"white"},{text:"JBerry367",color:"gold",hover_event:{action:"show_text",value:"Buy me a coffee!"},click_event:{action:"open_url",url:"https://ko-fi.com/jberry367"}}]
    tellraw @s [{text:"Builder: ",color:"white"},{text:"ChaosCrafter",color:"gold"}]
    tellraw @s [{text:"Feedbacks and bug reports here: ",color:"white"},{text:"Discord",color:"gold",hover_event:{action:"show_text",value:"Join the Discord server!"},click_event:{action:"open_url",url:"https://discord.gg/MFPVYtWxvT"}}]
    tellraw @s [{text:"This project is a fan-made creation inspired by League of Legends and is not affiliated with or endorsed by Riot Games. All trademarks and copyrights belong to their respective owners.",color:"gray"}]
}

function how_to_play {
    tellraw @s [{text:"\n ◀ How to play ▶ ",color:"yellow",bold:true}]
    tellraw @s [{text:"\nPlayers are formed into two even teams primarily comprised of five members. Each team starts at opposing sides of a map, near what is called a ",color:"white"},{text:"Nexus",color:"gold"},{text:". To win a match, a team must destroy the opposing team's Nexus. To do so, each team must work through a series of towers called 'turrets' that are placed along the path to each base.",color:"white"}]
    tellraw @s {text:"\n"}
}

function page_0 {
    item modify entity @s hotbar.0 lc:game/menu/page_0
    item modify entity @s hotbar.1 lc:game/menu/page_0
    item modify entity @s hotbar.2 lc:game/menu/page_0
    item modify entity @s hotbar.3 lc:game/menu/page_0
    item modify entity @s hotbar.4 lc:game/menu/page_0
    item modify entity @s hotbar.5 lc:game/menu/page_0
    item modify entity @s hotbar.6 lc:game/menu/page_0
    item modify entity @s hotbar.7 lc:game/menu/page_0
    item modify entity @s hotbar.8 lc:game/menu/page_0
}

