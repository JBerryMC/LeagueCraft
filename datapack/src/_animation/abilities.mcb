# _animation:abilities/  (converted from the 1.20.2 LeagueCraft datapack)

function clear {
    ## CHAMPION SKILLS
    execute if entity @s[tag=ashe.e] at @s run function ashe:skills/e.end

    execute if entity @s[tag=ezreal.w.mark] at @s run function ezreal:skills/w.end
    execute if entity @s[tag=ezreal.e] at @s run function ezreal:skills/e.animation
    execute if entity @s[tag=ezreal.r] at @s run function ezreal:skills/r.clear

    execute if entity @s[tag=yasuo.q.tornado] run function yasuo:skills/q.tornado.clear
    execute if entity @s[tag=yasuo.e.tornado] run function yasuo:skills/q.tornado.clear
    execute if entity @s[tag=yasuo.e,tag=q_buffer] at @s run function yasuo:skills/e.dash_q
    execute if entity @s[tag=yasuo.e] run function yasuo:skills/e.dash.clear

    execute if entity @s[tag=yone.q.tornado] run function yone:skills/q.tornado.clear
    execute if entity @s[tag=yone.e.body] run tag @s add unbound.buffer

    execute if entity @s[tag=zed.q] run function zed:skills/q.clear

    execute if entity @s[tag=leona.w] run function leona:skills/w.end
    execute if entity @s[tag=leona.w.fx] run function leona:skills/w.particle
    execute if entity @s[tag=leona.e] run function leona:skills/e.end
    execute if entity @s[tag=leona.r,tag=can_remove] at @s run function leona:skills/r.spawn
    execute if entity @s[tag=leona.r,tag=do_not_clear] at @s run function leona:skills/r.cast.particle

    execute if entity @s[tag=garen.w] run function garen:skills/w.end
    execute if entity @s[tag=garen.r] run function garen:skills/r.spawn
    execute if entity @s[tag=garen.e.cd] run function garen:skills/e.end
    execute if entity @s[tag=garen.e,tag=red] as @p[tag=garen.e,team=red] at @s run function garen:skills/e.spin
    execute if entity @s[tag=garen.e,tag=blue] as @p[tag=garen.e,team=blue] at @s run function garen:skills/e.spin

    execute if entity @s[tag=lux.q] run function lux:skills/q.clear
    execute if entity @s[tag=lux.w,tag=is_returning] run function lux:skills/w.end
    execute if entity @s[tag=lux.w,tag=!is_returning] run function lux:skills/w.return
    execute if entity @s[tag=lux.e.area] at @s run function lux:skills/e.end

    execute if entity @s[tag=lux.r.anim] at @s run function lux:skills/r.spawn
    execute if entity @s[tag=lux.r,tag=do_not_clear] at @s run function lux:skills/r.particle

    ## DoT
    execute if entity @s[tag=dot] at @s run function _champion:dot/tick

    ## DO NOT CLEAR
    execute if entity @s[tag=!do_not_clear] on passengers run kill @s[type=#unvalid]
    kill @s[tag=!yone.e.body,tag=!do_not_clear]
}

function interrupt {
    tp @s ~ ~ ~
    execute on passengers run tp @s ~ ~ ~

    execute if entity @s[tag=leesin.q2] run function leesin:skills/q2.dash.cancel
    execute if entity @s[tag=leesin.w] run function leesin:skills/w.dash.cancel

    #execute if entity @s[tag=aatrox.e] on passengers run kill @s[tag=cd]
}
