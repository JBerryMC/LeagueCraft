# _animation:dmg/  (converted from the 1.20.2 LeagueCraft datapack)

function magic {
    execute on attacker facing entity @s eyes run summon item ^0.1 ^1 ^1.5 {Passengers:[{id:"text_display",background:0,billboard:"center",shadow:1,Tags:["dmg_text"]}],Tags:["dmg_indicator","temp"],Item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[100000f]}}},Age:5985,PickupDelay:32767,Motion:[0.0,0.2,0.0]}
    scoreboard players operation @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] temp = @s dmg_magic.taken
    execute as @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] on passengers store result score @s temp on vehicle run scoreboard players get @s temp
    execute as @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] on passengers run data modify entity @s text set value {score:{name:"@s",objective:"temp"},color:"#1DCCFF"}

    tag @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] remove temp
}

function physical {
    execute on attacker facing entity @s eyes run summon item ^-0.1 ^1 ^1.5 {Passengers:[{id:"text_display",background:0,billboard:"center",shadow:1,Tags:["dmg_text"]}],Tags:["dmg_indicator","temp"],Item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[100000f]}}},Age:5985,PickupDelay:32767,Motion:[0.0,0.2,0.0]}

    scoreboard players operation @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] temp = @s dmg_physical.taken
    execute as @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] on passengers store result score @s temp on vehicle run scoreboard players get @s temp
    execute as @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] on passengers run data modify entity @s text set value {score:{name:"@s",objective:"temp"},color:"#FF511D"}

    tag @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] remove temp
}

function true {
    execute on attacker facing entity @s eyes run summon item ^ ^1 ^1.5 {Passengers:[{id:"text_display",background:0,billboard:"center",shadow:1,Tags:["dmg_text"]}],Tags:["dmg_indicator","temp"],Item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[100000f]}}},Age:5985,PickupDelay:32767,Motion:[0.0,0.2,0.0]}

    scoreboard players operation @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] temp = @s dmg_true.taken
    execute as @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] on passengers store result score @s temp on vehicle run scoreboard players get @s temp
    execute as @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] on passengers run data modify entity @s text set value {score:{name:"@s",objective:"temp"},color:"white",bold:false}

    tag @e[type=item,tag=temp,tag=dmg_indicator,limit=1,sort=nearest] remove temp
}
