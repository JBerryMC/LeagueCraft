# _settings:stats/  (converted from the 1.20.2 LeagueCraft datapack)

function check_id {
    execute if score @s champ_id matches 1 run function _settings:stats/champ/yasuo
    execute if score @s champ_id matches 2 run function _settings:stats/champ/leesin
    execute if score @s champ_id matches 3 run function _settings:stats/champ/zed
    execute if score @s champ_id matches 4 run function _settings:stats/champ/yone
    execute if score @s champ_id matches 5 run function _settings:stats/champ/ashe
    execute if score @s champ_id matches 7 run function _settings:stats/champ/ezreal
    execute if score @s champ_id matches 9 run function _settings:stats/champ/aatrox
    execute if score @s champ_id matches 10 run function _settings:stats/champ/leona
    execute if score @s champ_id matches 11 run function _settings:stats/champ/soraka
    execute if score @s champ_id matches 12 run function _settings:stats/champ/garen
    execute if score @s champ_id matches 13 run function _settings:stats/champ/malphite
    execute if score @s champ_id matches 14 run function _settings:stats/champ/lux
    execute if score @s champ_id matches 15 run function _settings:stats/champ/annie

    execute if score @s spell.1 matches 1 run item modify entity @s inventory.4 _settings:spell/flash
    execute if score @s spell.1 matches 2 run item modify entity @s inventory.4 _settings:spell/barrier
    execute if score @s spell.1 matches 3 run item modify entity @s inventory.4 _settings:spell/cleanse
    execute if score @s spell.1 matches 4 run item modify entity @s inventory.4 _settings:spell/exhaust
    execute if score @s spell.1 matches 5 run item modify entity @s inventory.4 _settings:spell/smite
    execute if score @s spell.1 matches 6 run item modify entity @s inventory.4 _settings:spell/ghost
    execute if score @s spell.1 matches 7 run item modify entity @s inventory.4 _settings:spell/ignite
    execute if score @s spell.1 matches 8 run item modify entity @s inventory.4 _settings:spell/heal

    execute if score @s spell.2 matches 1 run item modify entity @s inventory.5 _settings:spell/flash
    execute if score @s spell.2 matches 2 run item modify entity @s inventory.5 _settings:spell/barrier
    execute if score @s spell.2 matches 3 run item modify entity @s inventory.5 _settings:spell/cleanse
    execute if score @s spell.2 matches 4 run item modify entity @s inventory.5 _settings:spell/exhaust
    execute if score @s spell.2 matches 5 run item modify entity @s inventory.5 _settings:spell/smite
    execute if score @s spell.2 matches 6 run item modify entity @s inventory.5 _settings:spell/ghost
    execute if score @s spell.2 matches 7 run item modify entity @s inventory.5 _settings:spell/ignite
    execute if score @s spell.2 matches 8 run item modify entity @s inventory.5 _settings:spell/heal
}

dir champ {
    function aatrox {
        item modify entity @s inventory.1 _settings:champ/aatrox/icon
        item modify entity @s inventory.2 _settings:champ/aatrox/icon_copy
        item modify entity @s inventory.10 _settings:champ/aatrox/icon_copy
        item modify entity @s inventory.11 _settings:champ/aatrox/icon_copy

        item modify entity @s inventory.20 _settings:champ/aatrox/passive
        item modify entity @s inventory.21 _settings:champ/aatrox/skill_q
        item modify entity @s inventory.22 _settings:champ/aatrox/skill_w
        item modify entity @s inventory.23 _settings:champ/aatrox/skill_e
        item modify entity @s inventory.24 _settings:champ/aatrox/skill_r
    }

