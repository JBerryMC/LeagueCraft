# _settings:queue/  (converted from the 1.20.2 LeagueCraft datapack)

function update {
    execute as @p[tag=is_in_queue,scores={queue=1}] run item modify entity @a[tag=is_in_queue] inventory.2 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=2}] run item modify entity @a[tag=is_in_queue] inventory.3 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=3}] run item modify entity @a[tag=is_in_queue] inventory.4 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=4}] run item modify entity @a[tag=is_in_queue] inventory.5 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=5}] run item modify entity @a[tag=is_in_queue] inventory.6 _settings:queue_up

    execute as @p[tag=is_in_queue,scores={queue=6}] run item modify entity @a[tag=is_in_queue] inventory.20 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=7}] run item modify entity @a[tag=is_in_queue] inventory.21 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=8}] run item modify entity @a[tag=is_in_queue] inventory.22 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=9}] run item modify entity @a[tag=is_in_queue] inventory.23 _settings:queue_up
    execute as @p[tag=is_in_queue,scores={queue=10}] run item modify entity @a[tag=is_in_queue] inventory.24 _settings:queue_up
}

dir team.1 {
    function slot.1 {
        execute unless entity @a[tag=is_in_queue,scores={queue=1}] run team join blue @s
        execute unless entity @a[tag=is_in_queue,scores={queue=1}] run scoreboard players set @s queue 1

        clear @s structure_void
        function _settings:reset
    }

    function slot.2 {
        execute unless entity @a[tag=is_in_queue,scores={queue=2}] run team join blue @s
        execute unless entity @a[tag=is_in_queue,scores={queue=2}] run scoreboard players set @s queue 2

        clear @s structure_void
        function _settings:reset
    }

    function slot.3 {
