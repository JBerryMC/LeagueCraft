        execute unless entity @a[tag=is_in_queue,scores={queue=3}] run scoreboard players set @s queue 3

        clear @s structure_void
        function _settings:reset
    }

    function slot.4 {
        execute unless entity @a[tag=is_in_queue,scores={queue=4}] run team join blue @s
        execute unless entity @a[tag=is_in_queue,scores={queue=4}] run scoreboard players set @s queue 4

        clear @s structure_void
        function _settings:reset
    }

    function slot.5 {
        execute unless entity @a[tag=is_in_queue,scores={queue=5}] run team join blue @s
        execute unless entity @a[tag=is_in_queue,scores={queue=5}] run scoreboard players set @s queue 5

        clear @s structure_void
        function _settings:reset
    }
}

