function q.damage.1 {
    execute if entity @s[team=red] run damage @e[team=!red,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s
    execute if entity @s[team=blue] run damage @e[team=!blue,type=!#unvalid,tag=temp_dmg,limit=1,sort=nearest] 1 _lol:dmg_physical by @s

    scoreboard players set @s dmg_physical.deal 0
    scoreboard players set @s dmg_magic.deal 0

    scoreboard players operation temp attack_damage = @s attack_damage
    scoreboard players operation temp attack_damage *= 25 integer
    scoreboard players operation temp attack_damage /= 100 integer

    scoreboard players operation @s dmg_physical.deal = temp attack_damage
    function _champion:aa/on_hit
    function _champion:dmg/calc.debuff

    ## RED
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=red] run scoreboard players operation @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function _champion:dmg/calc.physical
    execute if entity @s[team=red] as @e[team=!red,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function _champion:dmg/taken/physical

    ## BLUE
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] armor.reduced = @s armor.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_physical.raw = @s dmg_physical.deal

    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] magic_resist.reduced = @s magic_resist.pen
    execute if entity @s[team=blue] run scoreboard players operation @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] dmg_magic.raw = @s dmg_magic.deal
    execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function _champion:dmg/calc.physical
    execute if entity @s[team=blue] as @e[team=!blue,tag=has_health_bar,tag=temp_dmg,limit=1,sort=nearest] run function _champion:dmg/taken/physical
}

