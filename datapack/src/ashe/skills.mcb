    execute if entity @e[tag=temp_dmg,tag=lol.structure] run function _champion:aa/ranged.initial_structure

    #say 2
    execute if entity @s[team=red] at @s anchored eyes run summon item_display ^-0.5 ^ ^-.25 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","red","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^-0.5 ^ ^-.25 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","blue","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @e[tag=temp_dmg,tag=!lol.structure] run function _champion:aa/ranged.initial
    execute if entity @e[tag=temp_dmg,tag=lol.structure] run function _champion:aa/ranged.initial_structure

    #say 3
    execute if entity @s[team=red] at @s anchored eyes run summon item_display ^-1 ^ ^-.5 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","red","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @s[team=blue] at @s anchored eyes run summon item_display ^-1 ^ ^-.5 {teleport_duration:1,Tags:["decor","ashe.q","aa","aa.ashe","homing","blue","temp"],item:{id:"carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{floats:[500001f]}}},Passengers:[{id:"area_effect_cloud",Duration:2147483647,Tags:["initial"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}},{id:"area_effect_cloud",Duration:2147483647,Tags:["target"],custom_particle:{type:"minecraft:block",block_state:"minecraft:air"}}]}
    execute if entity @e[tag=temp_dmg,tag=!lol.structure] run function _champion:aa/ranged.initial
